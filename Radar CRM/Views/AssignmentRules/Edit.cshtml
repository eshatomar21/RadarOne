@model IEnumerable<Radar_CRM.Models.AssignmentRule>

@{
    ViewData["Title"] = "Assignment Rules";
}

<style>
    .pastel-page-bg {
        background-color: #f4fbf8;
        padding: 25px;
        border-radius: 12px;
    }

    .pastel-btn-create {
        background-color: #a8d5ba;
        color: #1e4620;
        border: none;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 6px;
        transition: background-color 0.2s;
    }

        .pastel-btn-create:hover {
            background-color: #8fbc9f;
            color: #1e4620;
        }

    .pastel-table {
        background-color: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        margin-top: 20px;
        border: 1px solid #e8f5e9;
    }

        .pastel-table thead {
            background-color: #e0f2f1;
        }

        .pastel-table th {
            color: #004d40;
            border-bottom: 2px solid #b2dfdb;
            font-weight: 600;
            padding: 15px;
        }

        .pastel-table td {
            vertical-align: middle;
            padding: 15px;
            color: #445955;
            border-bottom: 1px solid #f0f7f4;
        }

        .pastel-table tbody tr:hover {
            background-color: #f9fdfa;
        }
</style>

<div class="pastel-page-bg shadow-sm">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1" style="color: #2e5c54; font-weight: 700;">Assignment Rules</h3>
            <p class="text-muted mb-0">Automatically route incoming records to specific users based on conditions.</p>
        </div>
        <a asp-action="Create" class="btn pastel-btn-create shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Create Rule
        </a>
    </div>

    <div class="table-responsive">
        <table class="table pastel-table">
            <thead>
                <tr>
                    <th>Rule Name</th>
                    <th>Module</th>
                    <th>Condition</th>
                    <th>Assigned User ID</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold" style="color: #4a8c7b;">@item.RuleName</td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.TargetModule</span>
                            </td>
                            <td>
                                <span>@item.ConditionField</span>
                                <strong class="text-secondary mx-1">@item.ConditionOperator.ToLower()</strong>
                                <span class="badge bg-secondary bg-opacity-10 text-dark border">@item.ConditionValue</span>
                            </td>
                            <td>
                                <i class="fa-regular fa-user me-1 text-muted"></i> @item.AssignToUserId
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-75 rounded-pill px-3">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this assignment rule?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Rule">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-clipboard-list fa-3x mb-3 text-light"></i>
                            <br />
                            No assignment rules configured yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>