@model Radar_CRM.Models.CallRecord

@{
    ViewData["Title"] = "AI Call Analysis";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

    body {
        background-color: #f8fafc;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .analysis-header {
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        padding: 24px 32px;
        margin-bottom: 24px;
        border-radius: 0 0 12px 12px;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.02);
    }

    .stat-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        letter-spacing: 0.05em;
    }

    .stat-value {
        font-size: 1.05rem;
        font-weight: 600;
        color: #0f172a;
    }

    .card-custom {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .card-header-custom {
        padding: 18px 24px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 12px 12px 0 0;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.1rem;
    }

    .summary-content {
        padding: 24px;
        font-size: 1rem;
        line-height: 1.8;
        color: #334155;
        white-space: pre-wrap;
    }

    /* Chat UI Styling for Transcript */
    .transcript-box {
        padding: 24px;
        height: 800px;
        overflow-y: auto;
        background-color: #f8fafc;
        flex-grow: 1;
        border-radius: 0 0 12px 12px;
    }

    .chat-bubble {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        padding: 16px 20px;
        border-radius: 12px 12px 12px 0;
        margin-bottom: 16px;
        box-shadow: 0 2px 4px 0 rgb(0 0 0 / 0.02);
        font-size: 0.95rem;
        line-height: 1.7;
        color: #1e293b;
        max-width: 100%;
    }

    .audio-full {
        width: 100%;
        height: 44px;
        outline: none;
        border-radius: 50rem;
    }

    /* AI Insights Styles */
    .score-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        text-align: center;
        height: 100%;
    }

    .score-value {
        font-size: 1.15rem;
        font-weight: 800;
        margin-top: 6px;
    }

    .insight-box {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-left: 4px solid var(--primary);
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
        font-size: 0.95rem;
        color: #334155;
    }

    .insight-title {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 6px;
    }
</style>

<div class="container-fluid px-4 pb-4 mt-3">

    <!-- Top Navigation & Details Header -->
    <div class="analysis-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="@Url.Action("Index", "CallRecordings")" class="text-decoration-none text-muted fw-semibold" style="transition: color 0.2s;">
                <i class="fa-solid fa-arrow-left me-2"></i> Back to Logs
            </a>
            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill" style="font-size: 0.85rem;">
                <i class="fa-solid fa-microchip me-1"></i> AI Processed
            </span>
        </div>

        <div class="row align-items-center">
            <div class="col-md-2">
                <div class="stat-block">
                    <span class="stat-label">Call Date</span>
                    <span class="stat-value"><i class="fa-regular fa-calendar text-primary me-2"></i>@Model.CallDate.ToString("dd MMM yyyy")</span>
                </div>
            </div>
            <div class="col-md-2">
                <div class="stat-block">
                    <span class="stat-label">Duration</span>
                    <span class="stat-value"><i class="fa-regular fa-clock text-primary me-2"></i>@(Model.DurationSeconds / 60)m @(Model.DurationSeconds % 60)s</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-block">
                    <span class="stat-label">Sales Agent</span>
                    <span class="stat-value"><i class="fa-solid fa-user-tie text-primary me-2"></i>@Model.SalespersonPhone</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-block">
                    <span class="stat-label">Customer</span>
                    <span class="stat-value"><i class="fa-solid fa-phone text-primary me-2"></i>@Model.CustomerPhone</span>
                </div>
            </div>
            <div class="col-md-2">
                <div class="stat-block">
                    <span class="stat-label">CRM Match</span>
                    <span class="stat-value">
                        @if (Model.Account != null)
                        {
                            <a asp-controller="Accounts" asp-action="Edit" asp-route-id="@Model.AccountId" class="text-decoration-none">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">@Model.Account.AccountName</span>
                            </a>
                        }
                        else if (Model.Lead != null)
                        {
                            <a asp-controller="Leads" asp-action="Edit" asp-route-id="@Model.LeadId" class="text-decoration-none">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success">@Model.Lead.LeadName</span>
                            </a>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Unlinked</span>
                        }
                    </span>
                </div>
            </div>
        </div>

        <!-- Audio Player (Fixed to Stream Directly) -->
        <div class="mt-4 pt-4 border-top">
            @if (!string.IsNullOrEmpty(Model.RecordingUrl))
            {
                <audio controls class="audio-full shadow-sm">
                    <source src="@Model.RecordingUrl" type="audio/mpeg">
                    Your browser does not support the audio element.
                </audio>
            }
            else
            {
                <div class="alert alert-warning mb-0 border-0 shadow-sm rounded-3">
                    <i class="fa-solid fa-microphone-slash me-2"></i> No audio recording available for this call.
                </div>
            }
        </div>
    </div>

    <!-- AI Layout -->
    <div class="row g-4">

        <!-- Left Column: AI Analytics, Profile, & Summary -->
        <div class="col-lg-5 d-flex flex-column gap-4">

            <!-- Agent Score Card -->
            <div class="card-custom">
                <div class="card-header-custom">
                    <i class="fa-solid fa-clipboard-check text-success"></i> Agent Score Card
                </div>
                <div class="p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="score-box shadow-sm">
                                <div class="insight-title"><i class="fa-solid fa-bolt text-warning me-1"></i> Confidence</div>
                                <div class="score-value text-primary">@(Model.SalespersonConfidence ?? "Processing...")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="score-box shadow-sm">
                                <div class="insight-title"><i class="fa-solid fa-hand-holding-heart text-danger me-1"></i> Empathy</div>
                                <div class="score-value text-success">@(Model.SalespersonEmpathy ?? "Processing...")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="score-box shadow-sm">
                                <div class="insight-title"><i class="fa-solid fa-wave-square text-info me-1"></i> Tone</div>
                                <div class="score-value" style="color: #7c3aed;">@(Model.SalespersonTone ?? "Processing...")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Conversation Insights -->
            <div class="card-custom">
                <div class="card-header-custom">
                    <i class="fa-solid fa-brain text-primary"></i> Call Analytics
                </div>
                <div class="p-4 pb-2">
                    <div class="insight-box shadow-sm" style="border-left-color: #3b82f6;">
                        <div class="insight-title text-primary"><i class="fa-solid fa-user-tag me-1"></i> User Needs</div>
                        <div>@Html.Raw(Model.UserNeeds?.Replace("\n", "<br/>") ?? "<span class='text-muted fst-italic'>Analyzing conversation...</span>")</div>
                    </div>

                    <div class="insight-box shadow-sm" style="border-left-color: #059669;">
                        <div class="insight-title text-success"><i class="fa-solid fa-cart-arrow-down me-1"></i> Recommended Products</div>
                        <div>@Html.Raw(Model.RecommendedProducts?.Replace("\n", "<br/>") ?? "<span class='text-muted fst-italic'>Analyzing conversation...</span>")</div>
                    </div>

                    <div class="insight-box shadow-sm" style="border-left-color: #dc2626;">
                        <div class="insight-title text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Gap Analysis</div>
                        <div>@Html.Raw(Model.GapAnalysis?.Replace("\n", "<br/>") ?? "<span class='text-muted fst-italic'>Analyzing conversation...</span>")</div>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- PROFESSIONAL PROFILE & SOFTWARE (AI DATA)  -->
            <!-- ========================================== -->
            <div class="card-custom">
                <div class="card-header-custom">
                    <i class="fa-solid fa-user-doctor text-info"></i> Customer Profile (AI Extracted)
                </div>
                <div class="p-4 pb-2">
                    <div class="row g-4">
                        
                        <!-- General Profile -->
                        <div class="col-md-6">
                            <h6 class="fw-bold text-muted border-bottom pb-2 mb-3" style="font-size: 0.85rem; text-transform: uppercase;">General Details</h6>
                            <div class="mb-2">
                                <span class="text-muted small fw-semibold d-block">Doctor Status</span>
                                <span class="text-dark fw-bold">@(string.IsNullOrEmpty(Model.IsHomeopathicDoctor) ? "N/A" : Model.IsHomeopathicDoctor)</span>
                            </div>
                            <div class="mb-2">
                                <span class="text-muted small fw-semibold d-block">Qualification</span>
                                <span class="text-dark">@(string.IsNullOrEmpty(Model.Qualification) ? "N/A" : Model.Qualification)</span>
                            </div>
                            <div class="mb-2">
                                <span class="text-muted small fw-semibold d-block">Passing Year / College</span>
                                <span class="text-dark">
                                    @(string.IsNullOrEmpty(Model.YearOfPassing) ? "N/A" : Model.YearOfPassing) -
                                    @(string.IsNullOrEmpty(Model.CollegeName) ? "N/A" : Model.CollegeName)
                                </span>
                            </div>
                            <div class="mb-2">
                                <span class="text-muted small fw-semibold d-block">DOB / Age</span>
                                <span class="text-dark">
                                    @(string.IsNullOrEmpty(Model.DateOfBirth) ? "N/A" : Model.DateOfBirth) /
                                    @(string.IsNullOrEmpty(Model.Age) ? "N/A" : Model.Age)
                                </span>
                            </div>
                        </div>

                        <!-- Practice & Software -->
                        <div class="col-md-6 border-start px-3">
                            <h6 class="fw-bold text-muted border-bottom pb-2 mb-3" style="font-size: 0.85rem; text-transform: uppercase;">Practice & Tech</h6>
                            <div class="mb-2">
                                <span class="text-muted small fw-semibold d-block">Clinic & Work Type</span>
                                <span class="text-dark">
                                    @(string.IsNullOrEmpty(Model.ClinicType) ? "N/A" : Model.ClinicType) /
                                    @(string.IsNullOrEmpty(Model.WorkType) ? "N/A" : Model.WorkType)
                                </span>
                            </div>
                            <div class="mb-2">
                                <span class="text-muted small fw-semibold d-block">Total Experience</span>
                                <span class="text-dark">@(string.IsNullOrEmpty(Model.TotalExperience) ? "0" : Model.TotalExperience) yrs total</span>
                            </div>
                            <div class="mb-2">
                                <span class="text-muted small fw-semibold d-block">Patients/Day (Avg Fee)</span>
                                <span class="text-dark">
                                    @(string.IsNullOrEmpty(Model.PatientsPerDay) ? "N/A" : Model.PatientsPerDay)
                                    (₹@(string.IsNullOrEmpty(Model.AveragePatientFee) ? "N/A" : Model.AveragePatientFee))
                                </span>
                            </div>
                            <div class="mb-2 mt-3 pt-3 border-top">
                                <span class="text-muted small fw-semibold d-block">Software Used</span>
                                @if (Model.CurrentlyUsingSoftware != null && Model.CurrentlyUsingSoftware.Contains("Yes", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary mb-1"><i class="fa-solid fa-code me-1"></i> Yes</span>
                                    <div class="text-dark fw-bold" style="font-size: 0.9rem;">@(string.IsNullOrEmpty(Model.CurrentSoftwareName) ? "N/A" : Model.CurrentSoftwareName)</div>
                                }
                                else
                                {
                                    <span class="text-dark">@(string.IsNullOrEmpty(Model.CurrentlyUsingSoftware) ? "N/A" : Model.CurrentlyUsingSoftware)</span>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Executive Summary -->
            <div class="card-custom h-auto">
                <div class="card-header-custom">
                    <i class="fa-solid fa-file-lines text-secondary"></i> Executive Summary
                </div>
                <div class="summary-content">
                    @Html.Raw(Model.AiSummary?.Replace("\n", "<br/>") ?? "No summary generated yet.")
                </div>
            </div>

        </div>

        <!-- Right Column: Raw Transcript Box -->
        <div class="col-lg-7">
            <div class="card-custom">
                <div class="card-header-custom">
                    <i class="fa-solid fa-align-left text-primary"></i> Full Transcript
                </div>
                <div class="transcript-box custom-scrollbar">
                    @{
                        bool isJson = false;
                        System.Text.Json.JsonDocument chatArray = null;

                        try
                        {
                            if (!string.IsNullOrEmpty(Model.TranscriptionText) && Model.TranscriptionText.Trim().StartsWith("["))
                            {
                                chatArray = System.Text.Json.JsonDocument.Parse(Model.TranscriptionText);
                                isJson = true;
                            }
                        }
                        catch { }
                    }

                    @if (isJson && chatArray != null)
                    {
                        <div class="d-flex flex-column px-2 py-3">
                            @foreach (var msg in chatArray.RootElement.EnumerateArray())
                            {
                                string speaker = msg.GetProperty("Speaker").GetString();
                                string text = msg.GetProperty("Text").GetString();
                                bool isSales = speaker.IndexOf("Sales", StringComparison.OrdinalIgnoreCase) >= 0;

                                <div class="mb-3 d-flex flex-column @(isSales ? "align-items-end" : "align-items-start")">
                                    <span class="text-muted mb-1 px-1" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">
                                        @(isSales ? "Sales Agent" : "Customer")
                                    </span>
                                    <div class="shadow-sm" style="max-width: 85%; padding: 14px 18px; font-size: 0.95rem; line-height: 1.6; border-radius: 16px;
                                        @(isSales ? "background-color: #4f46e5; color: #ffffff; border-bottom-right-radius: 4px;" : "background-color: #ffffff; color: #334155; border: 1px solid #e2e8f0; border-bottom-left-radius: 4px;")">
                                        @text
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.TranscriptionText) && Model.TranscriptionText.Contains("Pending"))
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                            <i class="fa-solid fa-cloud-arrow-down fa-bounce mb-3" style="font-size: 2.5rem; color: #cbd5e1;"></i>
                            <h5 class="fw-bold text-dark">Processing Audio</h5>
                            <p>The AI is currently analyzing this call. Check back in a moment.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            <div class="text-muted fw-bold ms-1" style="font-size: 0.8rem; text-transform: uppercase;"><i class="fa-solid fa-robot me-1"></i> AI Raw Output</div>
                            <div class="chat-bubble">
                                @Model.TranscriptionText
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>