@model IEnumerable<Radar_CRM.Models.CallRecord>

@{
    ViewData["Title"] = "Call Intelligence Logs";
    // Filter out rows that do not have a recording
    var validCalls = Model.Where(c => !string.IsNullOrEmpty(c.RecordingUrl) || !string.IsNullOrEmpty(c.LocalFilePath)).OrderByDescending(c => c.CallDate);
    int totalRecords = validCalls.Count();
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

    :root {
        --bg-body: #f8fafc;
        --bg-surface: #ffffff;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --text-dark: #0f172a;
        --text-muted: #64748b;
        --border-soft: #e2e8f0;
    }

    body {
        background-color: var(--bg-body);
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .crm-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 70px);
        background: var(--bg-surface);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
        margin: 16px;
        overflow: hidden;
    }

    .table-toolbar {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-soft);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #ffffff;
    }

    .toolbar-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-dark);
        margin: 0;
        display: flex;
        align-items: center;
    }

    .record-count-badge {
        font-size: 0.8rem;
        padding: 4px 12px;
        margin-left: 12px;
        font-weight: 700;
        vertical-align: middle;
    }

    .table-custom {
        margin: 0;
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-custom thead th {
        background-color: #f8fafc;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-soft);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .table-custom tbody td {
        padding: 16px 24px;
        font-size: 0.875rem;
        vertical-align: middle;
        color: var(--text-dark);
        border-bottom: 1px solid #f1f5f9;
        transition: background-color 0.2s;
    }

    .table-custom tbody tr:hover td {
        background-color: #f8fafc;
    }

    .btn-action {
        background-color: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        padding: 6px 12px;
        font-weight: 600;
        font-size: 0.8rem;
        text-decoration: none;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-action:hover {
        background-color: #2563eb;
        color: #ffffff;
    }

    .audio-compact {
        height: 32px;
        width: 180px;
    }

    .linked-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .agent-highlight {
        background-color: #eef2ff;
        color: #4338ca;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        border: 1px solid #c7d2fe;
    }
</style>

<div class="crm-container">
    <div class="table-toolbar">
        <h4 class="toolbar-title">
            <i class="fa-solid fa-headset text-primary me-2"></i> Call Intelligence Logs
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill record-count-badge">
                @totalRecords Total Recordings
            </span>
        </h4>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary border-0 fw-semibold px-3 shadow-sm" style="background-color: var(--primary);" onclick="syncHistoricalCalls(this)">
                <i class="fa-solid fa-cloud-arrow-down me-1"></i> Sync Old Calls
            </button>
            <button class="btn btn-sm btn-light border fw-semibold text-muted px-3" onclick="window.location.reload();">
                <i class="fa-solid fa-rotate-right me-1"></i> Refresh
            </button>
        </div>
    </div>

    <div class="table-container custom-scrollbar" style="overflow-y: auto;">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Sales Agent</th>
                    <th>Customer Contact</th>
                    <th>Duration</th>
                    <th>Recording</th>
                    <th>CRM Link</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (validCalls.Any())
                {
                    foreach (var call in validCalls)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@call.CallDate.ToString("dd MMM yyyy")</div>
                                <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                    <i class="fa-regular fa-clock"></i> @call.CallDate.ToString("hh:mm tt")
                                </div>
                            </td>
                            <td>
                                <div class="agent-highlight">
                                    <i class="fa-solid fa-user-tie me-2"></i>
                                    @(string.IsNullOrEmpty(call.SalespersonName) ? "Unknown Agent" : call.SalespersonName)
                                </div>
                                <div class="text-muted mt-1 ms-1" style="font-size: 0.8rem; font-weight: 600;">
                                    <i class="fa-solid fa-phone me-1"></i> @(string.IsNullOrEmpty(call.SalespersonPhone) ? "N/A" : call.SalespersonPhone)
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    <i class="fa-solid fa-phone text-muted me-2"></i>@call.CustomerPhone
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border shadow-sm px-2 py-1">
                                    @(call.DurationSeconds / 60)m @(call.DurationSeconds % 60)s
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(call.LocalFilePath))
                                {
                                    <audio controls class="audio-compact">
                                        <source src="/api/webhook/play-audio/@call.Id" type="audio/mpeg">
                                    </audio>
                                }
                                else
                                {
                                    <span class="status-badge bg-warning bg-opacity-10 text-warning border border-warning">Downloading...</span>
                                }
                            </td>
                            <td>
                                @if (call.Account != null)
                                {
                                    <span class="linked-badge"><i class="fa-regular fa-building"></i> @call.Account.AccountName</span>
                                }
                                else if (call.Lead != null)
                                {
                                    <span class="linked-badge"><i class="fa-regular fa-user"></i> @call.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic" style="font-size: 0.75rem;">Unlinked</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="CallRecordings" asp-action="CallAnalysis" asp-route-id="@call.Id" class="btn-action shadow-sm">
                                    <i class="fa-solid fa-chart-line"></i> View Analysis
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-microphone-slash mb-3" style="font-size:2.5rem; color:#cbd5e1;"></i>
                            <h5 class="fw-bold text-dark">No Call Recordings Found</h5>
                            <p class="mb-0">Only calls with valid recordings are displayed here.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function syncHistoricalCalls(btn) {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Syncing...';
            btn.disabled = true;

            fetch('/api/webhook/import-historical-callyzer', { method: 'POST' })
            .then(async response => {
                if (!response.ok) {
                    const err = await response.text();
                    throw new Error(err);
                }
                return response.json();
            })
            .then(data => {
                if(data.success) {
                    alert(data.message); 
                    window.location.reload(); 
                } else {
                    alert("Import Failed: " + data.message);
                }
            })
            .catch(error => {
                console.error("Sync Error:", error);
                alert("Network error occurred while trying to sync historical data.");
            })
            .finally(() => {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            });
        }
    </script>
}