@model Radar_CRM.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<!-- Select2 CSS for Vendor Lookup -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-shadow-float: 0 20px 40px -10px rgba(30, 58, 138, 0.08);
    }

    body {
        background-color: var(--theme-bg-cream);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--theme-text-main);
    }

    .sf-container {
        background-color: var(--theme-surface);
        width: 98%;
        max-width: 1400px;
        margin: 30px auto;
        border-radius: 16px;
        box-shadow: var(--theme-shadow-float);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .sf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
        border-bottom: 1px solid var(--theme-border);
    }

    .sf-header-title h1 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .entity-type {
        background: var(--theme-navy-light);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .btn-sf-primary {
        background-color: var(--theme-navy-primary);
        color: white;
        border: none;
        padding: 10px 28px;
        border-radius: 8px;
        font-weight: 500;
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);
    }

        .btn-sf-primary:hover {
            background-color: var(--theme-navy-hover);
        }

    .pane-section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        margin-top: 16px;
    }

    .sf-label {
        display: block;
        font-size: 0.85rem;
        color: var(--theme-text-muted);
        margin-bottom: 8px;
        font-weight: 500;
    }

    .sf-input, .sf-select {
        width: 100%;
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        padding: 6px 12px;
        height: 38px;
        font-size: 0.85rem;
        background-color: #fafaf9;
    }

        .sf-input:focus, .sf-select:focus {
            border-color: var(--theme-navy-primary);
            background-color: var(--theme-surface);
            outline: none;
            box-shadow: 0 0 0 3px var(--theme-navy-light);
        }

    .form-group {
        margin-bottom: 24px;
    }

    /* Select2 specific overrides to match your theme */
    .select2-container--default .select2-selection--single {
        height: 38px;
        padding: 4px;
        border-color: var(--theme-border);
        border-radius: 6px;
        background-color: #fafaf9;
    }

        .select2-container--default .select2-selection--single:focus {
            border-color: var(--theme-navy-primary);
            outline: none;
            box-shadow: 0 0 0 3px var(--theme-navy-light);
        }
</style>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <!-- Crucial for Edit: Passes the unique Product ID back to the controller -->
    <input type="hidden" asp-for="Id" />

    <div class="sf-container">
        <!-- HEADER -->
        <div class="sf-header">
            <div class="sf-header-title">
                <button type="button" class="btn btn-light rounded-circle p-2 me-3 border" onclick="window.history.back();">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <h1><span class="entity-type">Product</span> Edit</h1>
            </div>
            <div class="sf-header-actions">
                <button type="submit" class="btn-sf-primary">Update Product</button>
            </div>
        </div>

        <!-- FORM BODY -->
        <div style="padding: 32px 40px; overflow-y:auto; max-height: 75vh;">

            <h3 class="pane-section-title">Product Information</h3>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="sf-label">Product Name <span class="text-danger">*</span></label>
                    <input asp-for="ProductName" class="sf-input" required style="font-weight: 600;" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Product Code</label>
                    <input asp-for="ProductCode" class="sf-input" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Product Owner</label>
                    <select asp-for="ProductOwner" asp-items="@ViewBag.UsersList" class="sf-select">
                        <option value="">- Select -</option>
                    </select>
                </div>

                <!-- Vendor Name (Select2 Lookup) -->
                <div class="col-md-4 form-group">
                    <label class="sf-label">Vendor Name</label>
                    <select asp-for="VendorName" id="VendorLookup" class="sf-select">
                        <option value="">- Search Vendor -</option>
                        @if (!string.IsNullOrEmpty(Model?.VendorName))
                        {
                            <option value="@Model.VendorName" selected>@Model.VendorName</option>
                        }
                    </select>
                </div>

                <!-- Manufacturer (Dropdown) -->
                <div class="col-md-4 form-group">
                    <label class="sf-label">Manufacturer</label>
                    <select asp-for="Manufacturer" class="sf-select">
                        <option value="">-None-</option>
                        <option value="AltvetPet Inc.">AltvetPet Inc.</option>
                        <option value="LexPon Inc.">LexPon Inc.</option>
                        <option value="MetBeat Corp.">MetBeat Corp.</option>
                    </select>
                </div>

                <div class="col-md-4 form-group">
                    <label class="sf-label">Product Category</label>
                    <select asp-for="ProductCategory" class="sf-select">
                        <option value="">- None -</option>
                        <option value="Additional">Additional</option>
                        <option value="Addons">Addons</option>
                        <option value="HW Key">HW Key</option>
                        <option value="Module">Module</option>
                        <option value="Repertory">Repertory</option>
                        <option value="SW Key">SW Key</option>
                        <option value="Update New">Update New</option>
                        <option value="Package New">Package New</option>
                        <option value="Upgrade New">Upgrade New</option>
                        <option value="Old Package / Upgrade">Old Package / Upgrade</option>
                        <option value="Package">Package</option>
                        <option value="Upgarde to starter">Upgarde to starter</option>
                        <option value="Upgrade to Core">Upgrade to Core</option>
                        <option value="Upgrade to Plus">Upgrade to Plus</option>
                        <option value="Upgrade to Advance">Upgrade to Advance</option>
                        <option value="Upgrade to Expert">Upgrade to Expert</option>
                        <option value="Add On">Add On</option>
                        <option value="Wibu (USB) Key">Wibu (USB) Key</option>
                        <option value="Radar Update Version">Radar Update Version</option>
                        <option value="Tool">Tool</option>
                        <option value="Update">Update</option>
                        <option value="Map">Map</option>
                        <option value="Keynotes">Keynotes</option>
                        <option value="Family">Family</option>
                        <option value="Bundle">Bundle</option>
                        <option value="Upgrade">Upgrade</option>
                    </select>
                </div>

                <div class="col-md-4 form-group d-flex align-items-center mt-3">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="ProductActive" id="ProductActive">
                        <label class="form-check-label fs-6 fw-semibold text-dark ms-2" for="ProductActive">Product is Active</label>
                    </div>
                </div>
            </div>

            <hr class="my-4" style="border-color: var(--theme-border);" />

            <h3 class="pane-section-title">Pricing & Stock Information</h3>
            <div class="row">
                <div class="col-md-3 form-group">
                    <label class="sf-label">Unit Price (₹)</label>
                    <input asp-for="UnitPrice" type="number" step="0.01" class="sf-input" />
                </div>

                <!-- Unit Price (USD) -->
                <div class="col-md-3 form-group">
                    <label class="sf-label">Unit Price (USD)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-secondary text-muted" style="font-size: 0.85rem; border-color: var(--theme-border) !important;">$</span>
                        <input asp-for="UnitPriceUsd" type="number" step="0.01" class="form-control sf-input" style="border-left: 0; border-top-left-radius: 0; border-bottom-left-radius: 0;" />
                    </div>
                </div>

                <div class="col-md-3 form-group">
                    <label class="sf-label">Commission Rate (%)</label>
                    <input asp-for="CommissionRate" type="number" step="0.01" class="sf-input" />
                </div>

                <!-- Tax (Dropdown) -->
                <div class="col-md-3 form-group">
                    <label class="sf-label">Tax</label>
                    <select asp-for="Tax" class="sf-select">
                        <option value="">- None -</option>
                        <option value="0.00">0.00 %</option>
                        <option value="5.00">5.00 %</option>
                        <option value="12.00">12.00 %</option>
                        <option value="18.00">18.00 %</option>
                        <option value="28.00">28.00 %</option>
                    </select>
                </div>

                <div class="col-md-3 form-group d-flex align-items-center mt-3">
                    <div class="form-check">
                        <input class="form-check-input border-secondary" type="checkbox" asp-for="Taxable" id="Taxable">
                        <label class="form-check-label fw-medium text-dark ms-1" for="Taxable">Taxable Item</label>
                    </div>
                </div>

                <!-- Usage Unit (Dropdown) -->
                <div class="col-md-3 form-group">
                    <label class="sf-label">Usage Unit</label>
                    <select asp-for="UsageUnit" class="sf-select">
                        <option value="">- None -</option>
                        <option value="Box">Box</option>
                        <option value="Carton">Carton</option>
                        <option value="Dozen">Dozen</option>
                        <option value="Each">Each</option>
                        <option value="Hour(s)">Hour(s)</option>
                        <option value="Impressions">Impressions</option>
                        <option value="Lb">Lb</option>
                        <option value="M">M</option>
                        <option value="Pack">Pack</option>
                        <option value="Pages">Pages</option>
                        <option value="Pieces">Pieces</option>
                        <option value="Quantity">Quantity</option>
                        <option value="Reams">Reams</option>
                        <option value="Sheet">Sheet</option>
                        <option value="Spiral Binder">Spiral Binder</option>
                        <option value="Square Feet">Square Feet</option>
                    </select>
                </div>

                <div class="col-md-3 form-group">
                    <label class="sf-label">Quantity in Stock</label>
                    <input asp-for="QuantityInStock" type="number" class="sf-input" />
                </div>

                <div class="col-md-3 form-group">
                    <label class="sf-label">Qty Ordered</label>
                    <input asp-for="QtyOrdered" type="number" class="sf-input" />
                </div>

                <!-- Quantity in Demand -->
                <div class="col-md-3 form-group">
                    <label class="sf-label">Quantity in Demand</label>
                    <input asp-for="QtyInDemand" type="number" class="sf-input" />
                </div>

                <div class="col-md-3 form-group">
                    <label class="sf-label">Reorder Level</label>
                    <input asp-for="ReorderLevel" type="number" class="sf-input" />
                </div>
            </div>

            <hr class="my-4" style="border-color: var(--theme-border);" />

            <h3 class="pane-section-title">Sales & Support Dates</h3>
            <div class="row">
                <div class="col-md-3 form-group">
                    <label class="sf-label">Sales Start Date</label>
                    <input asp-for="SalesStartDate" type="date" class="sf-input" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="sf-label">Sales End Date</label>
                    <input asp-for="SalesEndDate" type="date" class="sf-input" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="sf-label">Support Start Date</label>
                    <input asp-for="SupportStartDate" type="date" class="sf-input" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="sf-label">Support End Date</label>
                    <input asp-for="SupportEndDate" type="date" class="sf-input" />
                </div>
            </div>

            <hr class="my-4" style="border-color: var(--theme-border);" />

            <h3 class="pane-section-title">Description & Details</h3>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="sf-label">Handler</label>
                    <select asp-for="Handler" asp-items="@ViewBag.UsersList" class="sf-select">
                        <option value="">- Select -</option>
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Tag</label>
                    <input asp-for="Tag" class="sf-input" placeholder="e.g. Featured, B2B..." />
                </div>
                <div class="col-md-12 form-group mt-2">
                    <label class="sf-label">Product Description</label>
                    <textarea asp-for="Description" rows="4" class="sf-input" style="height: auto; resize: vertical; padding: 12px;"></textarea>
                </div>
            </div>

        </div>

        <!-- Footer Area -->
        <div style="padding: 16px 40px; border-top: 1px solid var(--theme-border); background-color: #fafaf9; display: flex; justify-content: flex-end; gap: 16px;">
            <a asp-action="Index" class="btn" style="background: white; border: 1px solid var(--theme-border); color: var(--theme-text-muted); font-weight: 500; font-size: 0.95rem; padding: 8px 24px; border-radius: 8px; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn-sf-primary">Update Product</button>
        </div>

    </div>
</form>

<!-- REQUIRED SCRIPTS FOR VENDOR LOOKUP -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    $(document).ready(function() {
    // Initialize the Vendor Lookup Field using Select2
    $('#VendorLookup').select2({
    placeholder: "-- Search Vendor --",
    allowClear: true,
    width: '100%'
    // Uncomment the AJAX block below if you have a backend endpoint to dynamically search vendors
    /*
    , ajax: {
    url: '/Vendors/Search', // Replace with your actual endpoint
    dataType: 'json',
    delay: 250,
    data: function (params) {
    return { q: params.term };
    },
    processResults: function (data) {
    return { results: data.results };
    },
    cache: true
    }
    */
    });
    });
</script>