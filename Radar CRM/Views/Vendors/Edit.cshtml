@model Radar_CRM.Models.Vendor

@{
    ViewData["Title"] = ViewContext.RouteData.Values["action"]?.ToString() + " Vendor";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-shadow-float: 0 20px 40px -10px rgba(30, 58, 138, 0.08);
    }

    body {
        background-color: var(--theme-bg-cream);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--theme-text-main);
    }

    .sf-container {
        background-color: var(--theme-surface);
        width: 98%;
        max-width: 1400px;
        margin: 30px auto;
        border-radius: 16px;
        box-shadow: var(--theme-shadow-float);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .sf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
        border-bottom: 1px solid var(--theme-border);
    }

    .sf-header-title h1 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .entity-type {
        background: var(--theme-navy-light);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .btn-sf-primary {
        background-color: var(--theme-navy-primary);
        color: white;
        border: none;
        padding: 10px 28px;
        border-radius: 8px;
        font-weight: 500;
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);
        transition: 0.2s;
    }

        .btn-sf-primary:hover {
            background-color: var(--theme-navy-hover);
        }

    .pane-section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        margin-top: 16px;
    }

    .sf-label {
        display: block;
        font-size: 0.85rem;
        color: var(--theme-text-muted);
        margin-bottom: 8px;
        font-weight: 500;
    }

    .sf-input, .sf-select {
        width: 100%;
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        padding: 6px 12px;
        height: 38px;
        font-size: 0.85rem;
        background-color: #fafaf9;
    }

        .sf-input:focus, .sf-select:focus {
            border-color: var(--theme-navy-primary);
            background-color: var(--theme-surface);
            outline: none;
            box-shadow: 0 0 0 3px var(--theme-navy-light);
        }

    .form-group {
        margin-bottom: 24px;
    }
</style>

<!-- 1. Change the action to "Edit" -->
<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <!-- 2. ADD THIS: The hidden ID is required so the database knows which record to update -->
    <input type="hidden" asp-for="Id" />

    <div class="sf-container">
        <!-- HEADER -->
        <div class="sf-header">
            <div class="sf-header-title">
                <button type="button" class="btn btn-light rounded-circle p-2 me-3 border" onclick="window.history.back();">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <h1><span class="entity-type">Vendor</span> Edit Vendor</h1>
            </div>
            <div class="sf-header-actions">
                <button type="submit" class="btn-sf-primary">Save Vendor</button>
            </div>
        </div>
        <!-- FORM BODY -->
        <div style="padding: 32px 40px; overflow-y:auto; max-height: 75vh;">

            <h3 class="pane-section-title">Basic Information</h3>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="sf-label">Vendor Name <span class="text-danger">*</span></label>
                    <input asp-for="VendorName" class="sf-input" required style="font-weight: 600;" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Vendor Owner</label>
                    <select asp-for="VendorOwner" asp-items="@ViewBag.UsersList" class="sf-select">
                        <option value="">- Select -</option>
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Category</label>
                    <select asp-for="Category" class="sf-select">
                        <option value="">- None -</option>
                        <option value="Hardware">Hardware</option>
                        <option value="Software">Software</option>
                        <option value="Services">Services</option>
                        <option value="Logistics">Logistics</option>
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Phone</label>
                    <input asp-for="Phone" class="sf-input" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Email</label>
                    <input asp-for="Email" class="sf-input" type="email" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Website</label>
                    <input asp-for="Website" class="sf-input" placeholder="https://" />
                </div>
            </div>

            <hr class="my-4" style="border-color: var(--theme-border);" />

            <h3 class="pane-section-title">Accounting & Tax Details</h3>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="sf-label">GL Account</label>
                    <select asp-for="GLAccount" class="sf-select">
                        <option value="">- None -</option>
                        <option value="Sales Revenue">Sales Revenue</option>
                        <option value="Cost of Goods Sold">Cost of Goods Sold</option>
                        <option value="Inventory Asset">Inventory Asset</option>
                    </select>
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">PAN No.</label>
                    <input asp-for="PanNo" class="sf-input" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">GST No.</label>
                    <input asp-for="GstNo" class="sf-input" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Vendor Type</label>
                    <select asp-for="VendorType" class="sf-select">
                        <option value="">- None -</option>
                        <option value="Registered">Registered</option>
                        <option value="Unregistered">Unregistered</option>
                    </select>
                </div>
            </div>

            <hr class="my-4" style="border-color: var(--theme-border);" />

            <h3 class="pane-section-title">Address Information</h3>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="sf-label">Street</label>
                    <input asp-for="Street" class="sf-input" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">City</label>
                    <input asp-for="City" class="sf-input" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">State</label>
                    <input asp-for="State" class="sf-input" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Zip Code</label>
                    <input asp-for="ZipCode" class="sf-input" />
                </div>
                <div class="col-md-4 form-group">
                    <label class="sf-label">Country</label>
                    <input asp-for="Country" class="sf-input" />
                </div>
            </div>

            <hr class="my-4" style="border-color: var(--theme-border);" />

            <h3 class="pane-section-title">Additional Details</h3>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label class="sf-label">Tag</label>
                    <input asp-for="Tag" class="sf-input" placeholder="e.g. VIP, Local..." />
                </div>
                <div class="col-md-4 form-group d-flex align-items-center mt-3">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="EmailOptOut" id="EmailOptOut">
                        <label class="form-check-label fs-6 fw-semibold text-dark ms-2" for="EmailOptOut">Email Opt Out</label>
                    </div>
                </div>
                <div class="col-md-12 form-group mt-2">
                    <label class="sf-label">Description</label>
                    <textarea asp-for="Description" rows="4" class="sf-input" style="height: auto; resize: vertical; padding: 12px;"></textarea>
                </div>
            </div>

        </div>

        <!-- Footer Area -->
        <div style="padding: 16px 40px; border-top: 1px solid var(--theme-border); background-color: #fafaf9; display: flex; justify-content: flex-end; gap: 16px;">
            <a asp-action="Index" class="btn" style="background: white; border: 1px solid var(--theme-border); color: var(--theme-text-muted); font-weight: 500; font-size: 0.95rem; padding: 8px 24px; border-radius: 8px; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn-sf-primary">Save Vendor</button>
        </div>

    </div>
</form>