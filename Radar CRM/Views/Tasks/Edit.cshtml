@model Radar_CRM.Models.Task

@{
    ViewData["Title"] = "Edit Task";
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<!-- Select2 CSS for Type and Search -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    /* Premium Enterprise CRM Typography & Base - Navy & Cream Theme */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-green: #16a34a; /* Added for info panel */
        --theme-zoho-green: #4caf50; /* Specific for the Done buttons */
    }

    body {
        background-color: var(--theme-surface);
        font-family: 'Inter', sans-serif;
        color: var(--theme-text-main);
        -webkit-font-smoothing: antialiased;
        margin: 0;
        padding: 0;
        overflow: hidden; /* Manage scrolling internally */
    }

    /* Full Width & Height Container */
    .sf-container {
        background-color: var(--theme-surface);
        width: 100%;
        max-width: 100%;
        margin: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        border: none;
        border-radius: 0;
        box-shadow: none;
    }

    /* Sticky Full-Width Header */
    .sf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 40px;
        background-color: var(--theme-surface);
        border-bottom: 1px solid var(--theme-border);
        z-index: 100;
        flex-shrink: 0;
    }

    .sf-header-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .sf-header-title h1 {
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--theme-navy-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: -0.02em;
        }

    .sf-close-btn {
        background: transparent;
        border: 1px solid var(--theme-border);
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--theme-text-muted);
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .sf-close-btn:hover {
            background: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            border-color: var(--theme-navy-light);
        }

    .btn-sf-primary {
        background-color: var(--theme-navy-primary);
        color: var(--theme-surface);
        border: none;
        padding: 8px 24px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-sf-primary:hover {
            background-color: var(--theme-navy-hover);
        }

    /* Layout Structure for Form vs Sidebar */
    .layout-wrapper {
        display: flex;
        flex-grow: 1;
        overflow: hidden;
    }

    .main-form-area {
        flex-grow: 1;
        padding: 32px 60px;
        overflow-y: auto;
        background-color: var(--theme-surface);
    }

    .info-sidebar {
        width: 340px;
        flex-shrink: 0;
        background-color: var(--theme-bg-cream);
        border-left: 1px solid var(--theme-border);
        padding: 24px;
        overflow-y: auto;
    }

    /* Form Fields */
    .form-group {
        margin-bottom: 24px;
        display: flex;
        align-items: center;
    }

    .sf-label {
        font-size: 0.9rem;
        color: var(--theme-text-muted);
        font-weight: 500;
        width: 180px;
        flex-shrink: 0;
        margin-bottom: 0;
    }

    .sf-input, .sf-select, .select2-container {
        flex-grow: 1;
        max-width: 700px;
    }

    .sf-input, .sf-select {
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 0.9rem;
        color: var(--theme-text-main);
        background-color: #fafaf9;
        transition: all 0.2s ease;
    }

        .sf-input:focus, .sf-select:focus {
            outline: none;
            border-color: var(--theme-navy-primary);
            background-color: var(--theme-surface);
            box-shadow: 0 0 0 3px var(--theme-navy-light);
        }

    /* Select2 Theme Adjustments */
    .select2-container--default .select2-selection--single {
        background-color: #fafaf9;
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        height: 38px;
        padding: 4px 6px;
    }

        .select2-container--default .select2-selection--single:focus {
            border-color: var(--theme-navy-primary);
        }

    .pane-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        margin-top: 32px;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--theme-navy-light);
        max-width: 880px;
    }

    /* Repeat/Reminder Custom Panels */
    .expandable-panel {
        display: none;
        background-color: #ffffff;
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        padding: 20px;
        margin-top: 10px;
        margin-left: 180px;
        margin-bottom: 24px;
        max-width: 550px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    }

    .panel-footer {
        border-top: 1px solid var(--theme-border);
        padding-top: 15px;
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-panel-cancel {
        background-color: #fff;
        border: 1px solid var(--theme-border);
        color: var(--theme-text-main);
        padding: 6px 16px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
    }

        .btn-panel-cancel:hover {
            background-color: #f8fafc;
        }

    .btn-panel-done {
        background-color: var(--theme-zoho-green);
        border: 1px solid var(--theme-zoho-green);
        color: white;
        padding: 6px 16px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-panel-done:hover {
            background-color: #43a047;
        }

    .custom-radio-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .inline-input-control {
        display: inline-block;
        width: 60px;
        padding: 4px 8px;
        margin: 0 8px;
        border: 1px solid var(--theme-border);
        border-radius: 4px;
        background-color: #fafaf9;
        text-align: center;
    }

    .inline-date-control {
        display: inline-block;
        padding: 4px 8px;
        margin: 0 8px;
        border: 1px solid var(--theme-border);
        border-radius: 4px;
        background-color: #fafaf9;
    }

    /* Info Sidebar Specific Styling */
    .info-header-tab {
        border-bottom: 3px solid var(--theme-green);
        display: inline-block;
        padding-bottom: 4px;
        font-size: 1.1rem;
        color: var(--theme-text-main);
        font-weight: 600;
        margin-bottom: 24px;
    }

    .info-table td {
        padding: 6px 4px;
        font-size: 0.85rem;
    }

        .info-table td:first-child {
            color: var(--theme-text-muted);
            text-align: right;
            padding-right: 16px;
            width: 45%;
        }

        .info-table td:last-child {
            color: var(--theme-text-main);
            font-weight: 500;
        }

    /* Notes Section Styles */
    .notes-section {
        background-color: var(--theme-bg-cream);
        border: 1px solid var(--theme-border);
        border-radius: 8px;
        padding: 24px;
        margin-top: 20px;
        max-width: 880px;
    }
</style>

<form asp-action="Edit" method="post" id="taskForm" style="height: 100%;">

    <!-- Hidden IDs -->
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedTime" />

    <div class="sf-container">

        <!-- Fixed Header -->
        <div class="sf-header">
            <div class="sf-header-title">
                <button type="button" class="sf-close-btn" onclick="window.history.back();">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
                <h1>Task Edit: @Model.Subject</h1>
            </div>
            <div class="sf-header-actions d-flex gap-2">
                <a asp-action="Index" class="btn btn-light border fw-medium" style="font-size: 0.95rem;">Cancel</a>
                <button type="submit" class="btn-sf-primary">Update Task</button>
            </div>
        </div>

        <!-- Layout Body -->
        <div class="layout-wrapper">

            <!-- Left: Main Form Area -->
            <div class="main-form-area">
                <h3 class="pane-section-title mt-0">Task Information</h3>

                <!-- Task Owner -->
                <div class="form-group">
                    <label class="sf-label">Task Owner</label>
                    <select asp-for="TaskOwnerId" class="sf-select" id="TaskOwnerId">
                        @if (!string.IsNullOrEmpty(Model?.TaskOwnerId))
                        {
                            <option value="@Model.TaskOwnerId" selected>@(Model.TaskOwner ?? "Current Owner")</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="sf-label">Subject <span class="text-danger">*</span></label>
                    <input asp-for="Subject" class="sf-input" required />
                </div>

                <div class="form-group">
                    <label class="sf-label">Due Date</label>
                    <input asp-for="DueDate" type="date" class="sf-input" id="dueDateInput" />
                </div>

                <!-- Accounts -->
                <div class="form-group">
                    <label class="sf-label">Accounts</label>
                    <select asp-for="AccountId" class="sf-select" id="AccountId" asp-items="ViewBag.AccountsList">
                        <option value="">-- Select Account --</option>
                    </select>
                </div>

                <!-- Leads -->
                <div class="form-group">
                    <label class="sf-label">Leads</label>
                    <select asp-for="LeadId" class="sf-select" id="LeadId" asp-items="ViewBag.LeadsList">
                        <option value="">-- Select Lead --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="sf-label">Mobile</label>
                    <input asp-for="Mobile" class="sf-input" />
                </div>

                <div class="form-group">
                    <label class="sf-label">Lead Status</label>
                    <select asp-for="LeadStatus" class="sf-select">
                        <option value="">-None-</option>
                        <option value="New">New</option>
                        <option value="Contacted">Contacted</option>
                        <option value="Qualified">Qualified</option>
                        <option value="Lost">Lost</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="sf-label">Status</label>
                    <select asp-for="Status" class="sf-select">
                        <option value="Not Started">Not Started</option>
                        <option value="Deferred">Deferred</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Waiting on input">Waiting on input</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="sf-label">Priority</label>
                    <select asp-for="Priority" class="sf-select">
                        <option value="Highest">Highest</option>
                        <option value="High">High</option>
                        <option value="Normal">Normal</option>
                        <option value="Low">Low</option>
                        <option value="Lowest">Lowest</option>
                    </select>
                </div>

                <!-- ============================================== -->
                <!-- REPEAT TOGGLE AND PANEL                        -->
                <!-- ============================================== -->
                <div class="form-group mb-1">
                    <label class="sf-label">Repeat</label>
                    <div class="form-check form-switch m-0 d-flex align-items-center">
                        <input class="form-check-input mt-0" type="checkbox" id="repeatToggle" @(Model.DueDate.HasValue ? "" : "disabled")>
                        <span class="text-muted ms-2" style="font-size:0.8rem; display: @(Model.DueDate.HasValue ? "none" : "inline");" id="repeatHelpText">(Select Due Date first)</span>
                        <span id="repeatSummaryText" class="ms-3 fw-medium" style="display:none; font-size: 0.85rem; color: var(--theme-navy-primary);">
                            Daily, Ends Never
                            <a href="javascript:void(0)" class="ms-2 text-decoration-underline text-muted" onclick="openRepeatPanel()">Edit</a>
                        </span>
                    </div>
                </div>

                <div class="expandable-panel" id="repeatPanel">
                    <div class="row align-items-center mb-3">
                        <div class="col-3 text-muted" style="font-size:0.9rem;">Repeat type</div>
                        <div class="col-9">
                            <select asp-for="Repeat" class="sf-select" style="width: 150px; border:none; border-bottom: 1px solid #ccc; border-radius:0; padding: 2px 4px; background: transparent;">
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Monthly">Monthly</option>
                                <option value="Yearly">Yearly</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-3"></div>
                        <div class="col-9">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="exceptWeekends" name="ExceptWeekends">
                                <label class="form-check-label text-dark" for="exceptWeekends" style="font-size:0.9rem;">
                                    Except weekends and holidays.
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3 text-muted pt-1" style="font-size:0.9rem;">Ends</div>
                        <div class="col-9">
                            <div class="custom-radio-group">
                                <div class="form-check d-flex align-items-center">
                                    <input class="form-check-input mt-0" type="radio" name="RepeatEnds" id="endsNever" value="Never" checked>
                                    <label class="form-check-label ms-2 text-dark" for="endsNever" style="font-size:0.9rem;">Never</label>
                                </div>
                                <div class="form-check d-flex align-items-center">
                                    <input class="form-check-input mt-0" type="radio" name="RepeatEnds" id="endsAfter" value="After">
                                    <label class="form-check-label ms-2 text-dark" for="endsAfter" style="font-size:0.9rem;">
                                        After <input type="number" class="inline-input-control" value="1" min="1" name="RepeatEndsAfterTimes"> Times
                                    </label>
                                </div>
                                <div class="form-check d-flex align-items-center">
                                    <input class="form-check-input mt-0" type="radio" name="RepeatEnds" id="endsOn" value="On">
                                    <label class="form-check-label ms-2 text-dark" for="endsOn" style="font-size:0.9rem;">
                                        On <input type="date" class="inline-date-control text-muted" name="RepeatEndsOnDate">
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <button type="button" class="btn-panel-cancel" onclick="cancelRepeatPanel()">Cancel</button>
                        <button type="button" class="btn-panel-done" onclick="saveRepeatPanel()">Done</button>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- REMINDER TOGGLE AND PANEL                      -->
                <!-- ============================================== -->
                <div class="form-group mt-3 mb-1">
                    <label class="sf-label">Reminder</label>
                    <div class="form-check form-switch m-0 d-flex align-items-center">
                        <input class="form-check-input mt-0" type="checkbox" id="reminderToggle" @(Model.DueDate.HasValue ? "" : "disabled")>
                        <span id="reminderSummaryText" class="ms-3 fw-medium" style="display:none; font-size: 0.85rem; color: var(--theme-navy-primary);">
                            Reminder Set
                            <a href="javascript:void(0)" class="ms-2 text-decoration-underline text-muted" onclick="openReminderPanel()">Edit</a>
                        </span>
                    </div>
                </div>

                <div class="expandable-panel" id="reminderPanel">
                    <div class="d-flex align-items-center gap-2 mb-4" style="font-size:0.9rem; color: var(--theme-navy-primary);">
                        <span class="text-muted">On</span>
                        <input type="date" class="inline-date-control" id="reminderDateInput" name="ReminderDatePart">
                        <span class="text-muted">at</span>
                        <input type="time" class="inline-date-control" id="reminderTimeInput" name="ReminderTimePart">
                    </div>
                    <div class="row align-items-center">
                        <div class="col-3 text-muted" style="font-size:0.9rem;">Notify</div>
                        <div class="col-9 border-bottom pb-1">
                            <select class="sf-select w-50" name="ReminderNotifyType" style="border:none; background: transparent; padding: 2px 4px;">
                                <option value="Email">Email</option>
                                <option value="Popup">Popup</option>
                            </select>
                        </div>
                    </div>
                    <div class="panel-footer mt-4">
                        <button type="button" class="btn-panel-cancel" onclick="cancelReminderPanel()">Cancel</button>
                        <button type="button" class="btn-panel-done" onclick="saveReminderPanel()">Done</button>
                    </div>
                </div>

                <!-- 🚀 NEW: Audit Information Section -->
                <h3 class="pane-section-title">Audit Information</h3>
                <div class="sf-grid-2">
                    <div class="form-group">
                        <label class="sf-label" asp-for="CreatedBy">Created By</label>
                        <input class="sf-input text-muted" style="background-color: #f3f4f6; cursor: not-allowed;" value="@(!string.IsNullOrEmpty(Model.CreatedBy) ? Model.CreatedBy : Model.CreatedById ?? "System")" readonly tabindex="-1" />
                    </div>
                    <div class="form-group">
                        <label class="sf-label" asp-for="CreatedTime">Created Time</label>
                        <input class="sf-input text-muted" style="background-color: #f3f4f6; cursor: not-allowed;" value="@Model.CreatedTime.ToString("MMM dd, yyyy hh:mm tt")" readonly tabindex="-1" />
                    </div>
                    <div class="form-group">
                        <label class="sf-label" asp-for="ModifiedBy">Modified By</label>
                        <input class="sf-input text-muted" style="background-color: #f3f4f6; cursor: not-allowed;" value="@(!string.IsNullOrEmpty(Model.ModifiedBy) ? Model.ModifiedBy : Model.ModifiedById ?? "-")" readonly tabindex="-1" />
                    </div>
                    <div class="form-group">
                        <label class="sf-label" asp-for="ModifiedTime">Modified Time</label>
                        <input class="sf-input text-muted" style="background-color: #f3f4f6; cursor: not-allowed;" value="@(Model.ModifiedTime.HasValue ? Model.ModifiedTime.Value.ToString("MMM dd, yyyy hh:mm tt") : "-")" readonly tabindex="-1" />
                    </div>
                </div>
                <!-- End of Audit Information Section -->

                <h3 class="pane-section-title">Description Information</h3>
                <div class="form-group" style="align-items: flex-start;">
                    <label class="sf-label" style="padding-top: 8px;">Description</label>
                    <textarea asp-for="Description" class="sf-input" rows="4"></textarea>
                </div>
                <!-- Notes Section -->
                <div class="notes-section">
                    <div class="notes-header">
                        <h5 style="color: var(--theme-navy-primary); font-weight: 600; margin: 0;">Notes & Attachments</h5>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded" data-bs-toggle="modal" data-bs-target="#addNoteModal">
                            <i class="fa-solid fa-plus"></i> Add Note
                        </button>
                    </div>
                    <hr style="border-color: var(--theme-border);" />
                    <div id="notesContainer">
                        @if (ViewBag.ExistingNotes != null && ((IEnumerable<dynamic>)ViewBag.ExistingNotes).Any())
                        {
                            foreach (var note in ViewBag.ExistingNotes)
                            {
                                <div class="mb-2 p-3 bg-white border rounded shadow-sm d-flex justify-content-between">
                                    <div>
                                        <strong style="color: var(--theme-navy-primary); font-size: 0.9rem;">@note.NoteOwnerId</strong>
                                        <div style="font-size: 0.85rem; color: var(--theme-text-main); margin-top:4px;">@note.Description</div>
                                    </div>
                                    <span class="text-muted" style="font-size: 0.75rem;">@note.CreatedDateTime.ToString("MM/dd/yyyy, h:mm tt")</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted text-center py-3" style="font-size:0.9rem;" id="noNotesPlaceholder">
                                No notes added yet.
                            </div>
                        }
                    </div>
                </div>

                <br><br><br> <!-- Bottom Spacing for Scrolling -->
            </div>

            <!-- Right: Info Sidebar -->
            <div class="info-sidebar">
                <div class="info-header-tab">Info</div>

                @if (ViewBag.RelatedLead != null)
                {
                    var lead = ViewBag.RelatedLead;
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span style="color: var(--theme-green); font-size: 1.15rem; font-weight: 500;">@lead.LeadName</span>
                        <span class="badge" style="background-color: #f0fdf4; color: var(--theme-green); border: 1px solid #bbf7d0;">Leads</span>
                    </div>

                    <button type="button" class="btn btn-success btn-sm fw-bold mb-4 w-100" style="background-color: var(--theme-green); border: none;">Send Email</button>

                    <table class="table table-borderless info-table m-0">
                        <tr><td>Lead Owner</td><td>@lead.LeadOwner</td></tr>
                        <tr><td>Mobile Number</td><td>@lead.MobileNumber <i class="fa-solid fa-phone text-muted ms-1" style="font-size:0.75rem;"></i></td></tr>
                        <tr><td>Email ID</td><td><a href="mailto:@lead.EmailID" style="color: var(--theme-green); text-decoration:none;">@lead.EmailID</a></td></tr>
                        <tr><td>Data Sources</td><td>@lead.DataSources</td></tr>
                        <tr><td>Lead Status</td><td>@lead.CurrentStatus</td></tr>
                    </table>

                    <div class="text-end mt-4">
                        <a href="@Url.Action("Edit", "Leads", new { id = lead.Id })" style="color: var(--theme-green); font-weight: 500; text-decoration: none;">More Info</a>
                    </div>
                }
                else if (ViewBag.RelatedAccount != null)
                {
                    var acc = ViewBag.RelatedAccount;
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span style="color: var(--theme-green); font-size: 1.15rem; font-weight: 500;">@acc.AccountName</span>
                        <span class="badge" style="background-color: #f0fdf4; color: var(--theme-green); border: 1px solid #bbf7d0;">Accounts</span>
                    </div>

                    <button type="button" class="btn btn-success btn-sm fw-bold mb-4 w-100" style="background-color: var(--theme-green); border: none;">Send Email</button>

                    <table class="table table-borderless info-table m-0">
                        <tr><td>Account Owner</td><td>@acc.AccountOwner</td></tr>
                        <tr><td>Mobile Number</td><td>@acc.MobileNumber <i class="fa-solid fa-phone text-muted ms-1" style="font-size:0.75rem;"></i></td></tr>
                        <tr><td>Email ID</td><td><a href="mailto:@acc.Email" style="color: var(--theme-green); text-decoration:none;">@acc.Email</a></td></tr>
                        <tr><td>Data Sources</td><td>@acc.DataSource</td></tr>
                        <tr><td>Current Status</td><td>@acc.CurrentStatus</td></tr>
                    </table>

                    <div class="text-end mt-4">
                        <a href="@Url.Action("Edit", "Accounts", new { id = acc.Id })" style="color: var(--theme-green); font-weight: 500; text-decoration: none;">More Info</a>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted" style="margin-top: 40px; font-size: 0.9rem;">
                        <i class="fa-regular fa-folder-open mb-2" style="font-size: 2rem; color: #cbd5e1;"></i><br />
                        No Account or Lead<br>connected to this Task.
                    </div>
                }
            </div>

        </div>
    </div>
</form>

<!-- Add Note Modal -->
<div class="modal fade" id="addNoteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header" style="background-color: var(--theme-surface); border-bottom: 1px solid var(--theme-border);">
                <h5 class="modal-title" style="color: var(--theme-navy-primary); font-weight: 600;">
                    <i class="fa-regular fa-pen-to-square me-2"></i> Add New Note
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="background-color: var(--theme-bg-cream);">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Note Owner</label>
                        <select class="form-select" id="modalNoteOwner">
                            <option>System User</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Date & Time</label>
                        <input type="text" class="form-control bg-light" id="modalDateTime" readonly />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Attachment</label>
                    <input type="file" class="form-control" id="modalNoteFile" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Note Description</label>
                    <textarea class="form-control" id="modalNoteText" rows="4" placeholder="Write your note details here..."></textarea>
                </div>
            </div>
            <div class="modal-footer" style="background-color: var(--theme-surface); border-top: 1px solid var(--theme-border);">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-sf-primary" onclick="appendNoteUI()" data-bs-dismiss="modal">Save Note</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    $(document).ready(function() {
    // Apply 'Type and Search' to User Dropdown using AJAX
    $('#TaskOwnerId').select2({
    placeholder: "-- Select Owner --",
    allowClear: true,
    width: '100%',
    ajax: {
    url: '/Tasks/SearchUsers',
    dataType: 'json',
    delay: 250,
    data: function (params) { return { q: params.term }; },
    processResults: function (data) { return { results: data.results }; },
    cache: true
    }
    });

    // Apply 'Type and Search' to Account Dropdown using AJAX
    $('#AccountId').select2({
    placeholder: "-- Search Accounts --",
    allowClear: true,
    width: '100%',
    ajax: {
    url: '/Tasks/SearchAccounts',
    dataType: 'json',
    delay: 250,
    data: function (params) { return { q: params.term }; },
    processResults: function (data) { return { results: data.results }; },
    cache: true
    }
    });

    // Apply 'Type and Search' to Lead Dropdown using AJAX
    $('#LeadId').select2({
    placeholder: "-- Search Leads --",
    allowClear: true,
    width: '100%',
    ajax: {
    url: '/Tasks/SearchLeads',
    dataType: 'json',
    delay: 250,
    data: function (params) { return { q: params.term }; },
    processResults: function (data) { return { results: data.results }; },
    cache: true
    }
    });
    });

    // Panel Elements
    const repeatPanel = document.getElementById('repeatPanel');
    const reminderPanel = document.getElementById('reminderPanel');
    const repeatToggle = document.getElementById('repeatToggle');
    const reminderToggle = document.getElementById('reminderToggle');
    const repeatSummaryText = document.getElementById('repeatSummaryText');
    const reminderSummaryText = document.getElementById('reminderSummaryText');

    document.addEventListener('DOMContentLoaded', function () {
    const dueDateInput = document.getElementById('dueDateInput');
    const repeatHelpText = document.getElementById('repeatHelpText');

    // Modal Date initialization
    const addNoteModal = document.getElementById('addNoteModal');
    addNoteModal.addEventListener('show.bs.modal', function () {
    const now = new Date();
    document.getElementById('modalDateTime').value = now.toLocaleString();
    });

    // Due Date logic - Disables toggles if no date is set
    dueDateInput.addEventListener('change', function () {
    const hasDate = !!this.value;
    repeatToggle.disabled = !hasDate;
    reminderToggle.disabled = !hasDate;

    if (hasDate) {
    repeatHelpText.style.display = 'none';
    } else {
    repeatHelpText.style.display = 'inline';

    // Turn everything off if date is cleared
    repeatToggle.checked = false;
    reminderToggle.checked = false;
    repeatPanel.style.display = 'none';
    reminderPanel.style.display = 'none';
    repeatSummaryText.style.display = 'none';
    reminderSummaryText.style.display = 'none';
    }
    });

    // Toggle Listeners
    repeatToggle.addEventListener('change', function () {
    if(this.checked) {
    openRepeatPanel();
    } else {
    repeatPanel.style.display = 'none';
    repeatSummaryText.style.display = 'none';
    }
    });

    reminderToggle.addEventListener('change', function () {
    if(this.checked) {
    openReminderPanel();
    } else {
    reminderPanel.style.display = 'none';
    reminderSummaryText.style.display = 'none';
    }
    });
    });

    // --- Panel Control Functions ---

    function openRepeatPanel() {
    repeatToggle.checked = true;
    repeatPanel.style.display = 'block';
    repeatSummaryText.style.display = 'none';
    }

    function cancelRepeatPanel() {
    repeatToggle.checked = false;
    repeatPanel.style.display = 'none';
    repeatSummaryText.style.display = 'none';
    }

    function saveRepeatPanel() {
    repeatPanel.style.display = 'none';
    repeatSummaryText.style.display = 'inline';
    }

    function openReminderPanel() {
    reminderToggle.checked = true;
    reminderPanel.style.display = 'block';
    reminderSummaryText.style.display = 'none';
    }

    function cancelReminderPanel() {
    reminderToggle.checked = false;
    reminderPanel.style.display = 'none';
    reminderSummaryText.style.display = 'none';
    }

    function saveReminderPanel() {
    reminderPanel.style.display = 'none';
    reminderSummaryText.style.display = 'inline';
    }

    function appendNoteUI() {
    const text = document.getElementById('modalNoteText').value;
    const time = document.getElementById('modalDateTime').value;
    const container = document.getElementById('notesContainer');
    const placeholder = document.getElementById('noNotesPlaceholder');

    if(!text.trim()) return;

    if (placeholder) placeholder.remove();

    const html = `
    <div class="mb-2 p-3 bg-white border rounded shadow-sm d-flex justify-content-between">
    <div>
    <strong style="color: var(--theme-navy-primary); font-size: 0.9rem;">System User</strong>
    <div style="font-size: 0.85rem; color: var(--theme-text-main); margin-top:4px;">${text}</div>

    <input type="hidden" name="SavedNoteDesc[]" value="${text}" />
    <input type="hidden" name="SavedNoteDateTime[]" value="${time}" />
    </div>
    <span class="text-muted" style="font-size: 0.75rem;">${time}</span>
    </div>`;

    container.insertAdjacentHTML('afterbegin', html);

    // Reset Modal
    document.getElementById('modalNoteText').value = '';
    document.getElementById('modalNoteFile').value = '';
    }
</script>