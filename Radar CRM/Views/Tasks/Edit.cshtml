@model Radar_CRM.Models.Task

@{
    ViewData["Title"] = "Edit Task";
}

<!-- Include exactly the same <style> block as Create.cshtml here! -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Add the <style> block from Create.cshtml here -->
<style>
    /* Premium Enterprise CRM Typography & Base - Navy & Cream Theme */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-shadow-float: 0 20px 40px -10px rgba(30, 58, 138, 0.08);
    }

    body {
        background-color: var(--theme-bg-cream);
        font-family: 'Inter', sans-serif;
        color: var(--theme-text-main);
        -webkit-font-smoothing: antialiased;
    }

    .sf-container {
        background-color: var(--theme-surface);
        width: 98%;
        max-width: 1200px;
        margin: 30px auto;
        min-height: 90vh;
        border-radius: 16px;
        box-shadow: var(--theme-shadow-float);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.5);
        overflow: hidden;
    }

    .sf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
        background-color: var(--theme-surface);
        border-bottom: 1px solid var(--theme-border);
    }

    .sf-header-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .sf-header-title h1 {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--theme-navy-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: -0.02em;
        }

        .sf-header-title .entity-type {
            color: var(--theme-navy-primary);
            font-weight: 600;
            font-size: 0.85rem;
            background: var(--theme-navy-light);
            padding: 6px 14px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

    .sf-close-btn {
        background: transparent;
        border: 1px solid var(--theme-border);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--theme-text-muted);
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .sf-close-btn:hover {
            background: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            border-color: var(--theme-navy-light);
            transform: rotate(90deg);
        }

    .btn-sf-primary {
        background-color: var(--theme-navy-primary);
        color: var(--theme-surface);
        border: none;
        padding: 10px 28px;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);
    }

        .btn-sf-primary:hover {
            background-color: var(--theme-navy-hover);
            box-shadow: 0 6px 16px rgba(30, 58, 138, 0.25);
            transform: translateY(-1px);
        }

    .form-group {
        margin-bottom: 24px;
    }

    .sf-label {
        display: block;
        font-size: 0.85rem;
        color: var(--theme-text-muted);
        margin-bottom: 8px;
        font-weight: 500;
    }

    .sf-input, .sf-select {
        width: 100%;
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        padding: 6px 12px;
        height: 36px;
        font-size: 0.85rem;
        color: var(--theme-text-main);
        background-color: #fafaf9;
        transition: all 0.2s ease-in-out;
    }

        .sf-input:hover, .sf-select:hover {
            border-color: #cbd5e1;
            background-color: var(--theme-surface);
        }

        .sf-input:focus, .sf-select:focus {
            outline: none;
            border-color: var(--theme-navy-primary);
            background-color: var(--theme-surface);
            box-shadow: 0 0 0 3px var(--theme-navy-light);
        }

        .sf-input[readonly] {
            background-color: transparent;
            border-color: transparent;
            border-bottom: 1px dashed var(--theme-border);
            border-radius: 0;
            padding-left: 0;
            cursor: default;
            height: auto;
        }

            .sf-input[readonly]:focus {
                box-shadow: none;
            }

    textarea.sf-input {
        height: auto;
    }

    .pane-section-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 20px;
        margin-top: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--theme-border);
        letter-spacing: -0.01em;
    }
</style>

<form asp-action="Edit" method="post" id="taskForm">

    <!-- IMPORTANT: Hidden ID to bind to the existing database record -->
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedTime" />

    <div class="sf-container">

        <div class="sf-header">
            <div class="sf-header-title">
                <button type="button" class="sf-close-btn" onclick="window.history.back();">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
                <!-- Dynamic Header -->
                <h1><span class="entity-type">Task</span> Edit: @Model.Subject</h1>
            </div>
            <div class="sf-header-actions">
                <button type="submit" class="btn-sf-primary">Update Task</button>
            </div>
        </div>

        <div style="padding: 32px 40px; flex-grow: 1; overflow-y: auto;">

            <!-- Paste the exact same form fields from Create.cshtml here -->
            <h3 class="pane-section-title mt-0">Task Information</h3>
            <div class="row">
                <div class="col-md-6 form-group"><label class="sf-label">Task Owner</label><input asp-for="TaskOwner" class="sf-input" /></div>
                <div class="col-md-6 form-group"><label class="sf-label">Subject <span class="text-danger">*</span></label><input asp-for="Subject" class="sf-input" required style="font-weight: 600;" /></div>
                <div class="col-md-6 form-group"><label class="sf-label">Due Date</label><input asp-for="DueDate" type="date" class="sf-input" /></div>
                <div class="col-md-6 form-group"><label class="sf-label">Contact Name</label><input asp-for="ContactName" class="sf-input" /></div>
                <div class="col-md-6 form-group"><label class="sf-label">Related To</label><input asp-for="RelatedTo" class="sf-input" /></div>
                <div class="col-md-6 form-group"><label class="sf-label">Mobile</label><input asp-for="Mobile" class="sf-input" /></div>
            </div>

            <h3 class="pane-section-title">Status & Priority</h3>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label class="sf-label">Status</label>
                    <select asp-for="Status" class="sf-select">
                        <option value="Not Started">Not Started</option>
                        <option value="Deferred">Deferred</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Waiting on input">Waiting on input</option>
                    </select>
                </div>
                <div class="col-md-6 form-group">
                    <label class="sf-label">Priority</label>
                    <select asp-for="Priority" class="sf-select">
                        <option value="Highest">Highest</option>
                        <option value="High">High</option>
                        <option value="Normal">Normal</option>
                        <option value="Low">Low</option>
                        <option value="Lowest">Lowest</option>
                    </select>
                </div>
                <div class="col-md-6 form-group">
                    <label class="sf-label">Repeat</label>
                    <select asp-for="Repeat" class="sf-select">
                        <option value="None">None</option>
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Yearly">Yearly</option>
                    </select>
                </div>
                <div class="col-md-6 form-group"><label class="sf-label">Reminder</label><input asp-for="Reminder" type="datetime-local" class="sf-input" /></div>
                <div class="col-md-6 form-group"><label class="sf-label">Closed Time</label><input asp-for="ClosedTime" type="datetime-local" class="sf-input" /></div>
            </div>

            <h3 class="pane-section-title">Additional Information</h3>
            <div class="row">
                <div class="col-md-6 form-group"><label class="sf-label">Tag</label><input asp-for="Tag" class="sf-input" /></div>
                <div class="col-md-6 form-group"><label class="sf-label">Lead Status</label><input asp-for="LeadStatus" class="sf-input" /></div>
                <div class="col-md-12 form-group"><label class="sf-label">Description</label><textarea asp-for="Description" class="sf-input" rows="5"></textarea></div>
            </div>

            <!-- Audit Trail (Read-only on Edit) -->
            <h3 class="pane-section-title">System Information</h3>
            <div class="row">
                <div class="col-md-6 form-group"><label class="sf-label">Created Time</label><input value="@Model.CreatedTime.ToString("yyyy-MM-dd HH:mm")" class="sf-input" readonly /></div>
                <div class="col-md-6 form-group"><label class="sf-label">Modified Time</label><input value="@Model.ModifiedTime?.ToString("yyyy-MM-dd HH:mm")" class="sf-input" readonly /></div>
            </div>

        </div>

        <div style="padding: 16px 40px; border-top: 1px solid var(--theme-border); background-color: #fafaf9; display: flex; justify-content: flex-end; gap: 16px;">
            <a asp-action="Index" class="btn" style="background: white; border: 1px solid var(--theme-border); color: var(--theme-text-muted); font-weight: 500; font-size: 0.95rem; padding: 6px 24px; border-radius: 8px; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn-sf-primary">Update Task</button>
        </div>

    </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>