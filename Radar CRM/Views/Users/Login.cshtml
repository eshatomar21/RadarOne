@model Radar_CRM.Models.User

@{
    ViewData["Title"] = "Login";
    Layout = null; // Standalone login page layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Radar CRM</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

            :root {
                --theme-bg-cream: #Fdfbf7;
                --theme-surface: #ffffff;
                --theme-navy: #1e3a8a;
                --theme-navy-hover: #1e40af;
                --theme-navy-light: #eff6ff;
                --theme-brown: #a16207;
                --theme-brown-light: #fef3c7;
                --text-main: #1f2937;
                --text-muted: #64748b;
                --border-color: #e2e8f0;
            }

            body {
                background-color: var(--theme-bg-cream);
                font-family: 'Plus Jakarta Sans', sans-serif;
                color: var(--text-main);
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
            }

            .login-card {
                background: var(--theme-surface);
                border: 1px solid var(--border-color);
                border-radius: 16px;
                box-shadow: 0 20px 40px -15px rgba(30, 58, 138, 0.1);
                width: 100%;
                max-width: 440px;
                padding: 40px;
            }

            .login-header {
                text-align: center;
                margin-bottom: 30px;
            }

                .login-header h2 {
                    color: var(--theme-navy);
                    font-weight: 700;
                    font-size: 1.6rem;
                    margin-top: 10px;
                    letter-spacing: -0.02em;
                }

                .login-header p {
                    color: var(--text-muted);
                    font-size: 0.9rem;
                    margin: 0;
                }

            .brand-logo-box {
                width: 54px;
                height: 54px;
                background: var(--theme-navy-light);
                color: var(--theme-navy);
                border-radius: 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.5rem;
                margin-bottom: 10px;
            }

            .sf-label {
                display: block;
                font-size: 0.85rem;
                color: var(--text-muted);
                margin-bottom: 8px;
                font-weight: 600;
            }

            .sf-input-group {
                position: relative;
            }

            .sf-input {
                width: 100%;
                border: 1px solid var(--border-color);
                border-radius: 8px;
                padding: 10px 14px;
                font-size: 0.95rem;
                color: var(--text-main);
                background-color: #fafaf9;
                transition: all 0.2s ease-in-out;
            }

                .sf-input:focus {
                    outline: none;
                    border-color: var(--theme-navy);
                    background-color: var(--theme-surface);
                    box-shadow: 0 0 0 3px var(--theme-navy-light);
                }

            .password-toggle-btn {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: var(--text-muted);
                cursor: pointer;
                font-size: 0.9rem;
            }

                .password-toggle-btn:hover {
                    color: var(--theme-navy);
                }

            .btn-login {
                background-color: var(--theme-navy);
                color: var(--theme-surface);
                border: none;
                width: 100%;
                padding: 12px;
                border-radius: 8px;
                font-weight: 600;
                font-size: 0.95rem;
                cursor: pointer;
                transition: all 0.3s ease;
                box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);
                margin-top: 10px;
            }

                .btn-login:hover {
                    background-color: var(--theme-navy-hover);
                    box-shadow: 0 6px 16px rgba(30, 58, 138, 0.25);
                    transform: translateY(-1px);
                }

            .validation-summary-errors {
                font-size: 0.85rem;
                color: #b91c1c;
                background-color: #fef2f2;
                border: 1px solid #fee2e2;
                border-radius: 8px;
                padding: 10px 14px;
                margin-bottom: 20px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 15px;
                }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-header">
            <div class="brand-logo-box">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <h2>Radar CRM</h2>
            <p>Please sign in to access your dashboard</p>
        </div>

        <form asp-action="Login" method="post">

            <!-- Displays validation errors from controller -->
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-group mb-3">
                <label class="sf-label" asp-for="Email">Email Address</label>
                <input asp-for="Email" type="email" class="sf-input" placeholder="name@radar.com" required autofocus />
            </div>

            <div class="form-group mb-4">
                <label class="sf-label" asp-for="Password">Password</label>
                <div class="sf-input-group">
                    <!-- ID matches the toggle script below -->
                    <input asp-for="Password" type="password" class="sf-input" id="passwordInput" placeholder="Enter your password" required style="padding-right: 40px;" />
                    <button type="button" class="password-toggle-btn" id="togglePasswordBtn" onclick="togglePasswordVisibility()" title="Show/Hide Password">
                        <i class="fa-solid fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-login">
                Sign In <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
            </button>
        </form>
    </div>

    <!-- JavaScript for Show/Hide Password Toggle -->
    <script>
            function togglePasswordVisibility() {
                const passwordInput = document.getElementById('passwordInput');
                const toggleIcon = document.getElementById('toggleIcon');

                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    toggleIcon.classList.replace('fa-eye', 'fa-eye-slash');
                } else {
                    passwordInput.type = 'password';
                    toggleIcon.classList.replace('fa-eye-slash', 'fa-eye');
                }
            }
    </script>
</body>
</html>