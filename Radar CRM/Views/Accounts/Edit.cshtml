                        <th>Subject</th>
                        <th>Task Owner</th>
                        <th>Due Date</th>
                        <th>Priority</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="openTasksTbody">
                    @foreach (var t in openTasks)
                    {
                        <tr data-task-id="@t.Id">
                            <td>
                                <a href="@Url.Action("Edit", "Tasks", new { id = t.Id })" class="text-primary fw-semibold text-decoration-none">@t.Subject</a>
                            </td>
                            <td><span class="text-muted fw-medium"><i class="fa-solid fa-circle-user me-1"></i>@(t.TaskOwner ?? "System User")</span></td>
                            <td>@(t.DueDate != null ? t.DueDate.Value.ToString("dd MMM yyyy") : "-")</td>
                            <td>@t.Priority</td>
                            <td>
                                <select class="form-select form-select-sm border task-status-dropdown shadow-none" onchange="updateTaskStatus(this, '@t.Id')" style="width: 130px; font-size: 0.8rem; background-color: #ffffff; color: #1e3a8a; font-weight: 600;">
                                    <option value="Not Started" selected="@(t.Status == "Not Started" ? "selected" : null)">Not Started</option>
                                    <option value="In Progress" selected="@(t.Status == "In Progress" ? "selected" : null)">In Progress</option>
                                    <option value="Waiting" selected="@(t.Status == "Waiting" ? "selected" : null)">Waiting</option>
                                    <option value="Deferred" selected="@(t.Status == "Deferred" ? "selected" : null)">Deferred</option>
                                    <option value="Completed" selected="@(t.Status == "Completed" ? "selected" : null)">Completed</option>
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center text-muted py-4 bg-white" id="emptyOpenTasksPlaceholder"><i class="fa-regular fa-folder-open mb-2 fs-4"></i><br />No open activities</div>
        }
    </div>
</div>

