            if (fieldId === 'AlternateEmailID' && mainEmail && altEmail && mainEmail.toLowerCase() === altEmail.toLowerCase()) {
                alert('❌ Email and Alternate Email cannot be the exact same!');
                return;
            }

            const btn = window.event ? (window.event.target || window.event.srcElement) : null;
            let originalBtnText = 'Verify';
            if (btn) {
                originalBtnText = btn.innerText;
                btn.innerText = '...';
                btn.disabled = true;
            }

            fetch('@Url.Action("CheckEmailDuplicate", "Accounts")?email=' + encodeURIComponent(email))
            .then(async response => {
                if (!response.ok) throw new Error("HTTP Status " + response.status);
                return response.json();
            })
            .then(data => {
                if (data.error) {
                    alert('⚠️ Database Error: ' + data.message);
                } else if (data.isDuplicate) {
                    alert('⚠️ WARNING: This email exists in the database!\n\n(Note: If this is the current email for this account, you can ignore this warning).');
                } else {
                    alert('✅ This email is valid and unique in the system.');
                }
            })
            .catch(error => {
                console.error("Error verifying email:", error);
                alert("Could not connect to the server. Check your browser console (F12) for details.");
