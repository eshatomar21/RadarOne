    function moveTaskToClosed(row) {
        const subjectHtml = row.cells[0].innerHTML; 
        const ownerName = row.cells[1] ? row.cells[1].textContent.trim() : "System User";
        const dueDate = row.cells[2].innerText;

        const newRow = document.createElement('tr');
        newRow.innerHTML = `
            <td class="text-secondary text-decoration-line-through">${subjectHtml}</td>
            <td><span class="text-muted fw-medium">${ownerName}</span></td>
            <td>${dueDate}</td>
            <td class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i> Completed</td>
        `;

        let closedSection = document.getElementById('detailClosedTasksSection');
        let closedTbody = closedSection.querySelector('tbody');
        const emptyPlaceholder = document.getElementById('emptyClosedTasksPlaceholder');

        if (emptyPlaceholder) emptyPlaceholder.remove();

        if (!closedTbody) {
            closedSection.innerHTML = `
                <h6 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--theme-navy-primary);">Closed Task</h6>
                <table class="zoho-task-table" id="closedTasksTable">
                    <thead><tr><th>Subject</th><th>Task Owner</th><th>Due Date</th><th>Status</th></tr></thead>
                    <tbody></tbody>
                </table>
            `;
            closedTbody = closedSection.querySelector('tbody');
        }

        closedTbody.insertBefore(newRow, closedTbody.firstChild);
        row.remove(); 

        const openTbody = document.getElementById('openTasksTbody');
        if (openTbody && openTbody.children.length === 0) {
            const nextActionEl = document.getElementById('nextActionDisplay');
            if (nextActionEl) nextActionEl.innerText = "No upcoming actions scheduled.";
            const openTasksTable = openTbody.closest('table');
            if (openTasksTable) {
                openTasksTable.outerHTML = '<div class="text-center text-muted py-4 bg-white" id="emptyOpenTasksPlaceholder"><i class="fa-regular fa-folder-open mb-2 fs-4"></i><br />No open activities</div>';
            }
        } else if (openTbody && openTbody.children.length > 0) {
            const nextRow = openTbody.children[0];
            const nextActionEl = document.getElementById('nextActionDisplay');
            if (nextActionEl) nextActionEl.innerText = `${nextRow.cells[0].innerText} - Due: ${nextRow.cells[2].innerText}`;
        }
    }

    // 🚀 FIX: Missing helper function required by the form submission script
    window.getFieldValue = function (elementIdOrName) {
        // Find the element by ID or by Name attribute
        const el = document.getElementById(elementIdOrName) || document.querySelector(`[name="${elementIdOrName}"]`);
        if (!el) return "";

        // Handle Checkboxes safely
        if (el.type === "checkbox") {
            return el.checked ? (el.value === "on" ? "true" : el.value) : "false";
        }

        // Handle Radio buttons
        if (el.type === "radio") {
            const checkedRadio = document.querySelector(`input[name="${el.name}"]:checked`);
            return checkedRadio ? checkedRadio.value : "";
        }

        // Return standard values for text, dates, and selects
        return el.value || "";
    };

 window.verifyPhone = function(fieldId) {
        const phoneInput = document.getElementById(fieldId);
        if (!phoneInput) { alert("Error: Input field not found."); return; }

        let phone = phoneInput.value.trim();
        if (!phone) { Swal.fire("Wait", "Please enter a phone number first before verifying.", "warning"); return; }

        // Extract digits for validation checking (No UI mutation)
        let digitsOnly = phone.replace(/\D/g, '');
        if (digitsOnly.length < 10) {
            Swal.fire("Invalid!", "Phone number must have at least 10 digits.", "error"); 
            return;
        }

        // 🚀 CROSS-CHECK WITHIN THE FORM (Main vs Alternate)
        const mainMobileEl = document.getElementById('MobileNumber');
        const altMobileEl = document.getElementById('AlternateMobile');
        
        let main10 = mainMobileEl && mainMobileEl.value ? mainMobileEl.value.replace(/\D/g, '').slice(-10) : '';
        let alt10 = altMobileEl && altMobileEl.value ? altMobileEl.value.replace(/\D/g, '').slice(-10) : '';

        if (fieldId === 'AlternateMobile' && main10 === alt10 && alt10 !== '') {
            Swal.fire("Error", "Alternate Mobile cannot be the exact same as the main Mobile Number!", "error"); 
            phoneInput.value = ''; // clear it
            return;
        }
        if (fieldId === 'MobileNumber' && main10 === alt10 && main10 !== '') {
            Swal.fire("Error", "Main Mobile cannot be the exact same as the Alternate Mobile!", "error"); 
            return;
        }

        // UI Loading state
        const btn = window.event ? (window.event.target || window.event.srcElement) : null;
        let originalBtnText = 'Verify';
        if (btn) { originalBtnText = btn.innerText; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>'; btn.disabled = true; }

        // 🚀 SEND ONLY LAST 10 DIGITS TO BACKEND FOR FOOLPROOF DB CHECK
        let searchPhone = digitsOnly.slice(-10);

        fetch('@Url.Action("CheckDuplicatePhone", "Accounts")?phone=' + encodeURIComponent(searchPhone))
        .then(async response => {
            if (!response.ok) throw new Error("HTTP Status " + response.status);
            return response.json();
        })
        .then(data => {
            if (data.error) {
                Swal.fire('Error', 'Database Error: ' + data.message, 'error');
            } else if (data.isDuplicate) {
                Swal.fire('Warning', 'This phone number already exists in another account record in the database!', 'warning');
            } else {
                Swal.fire('Success', 'This number is valid and unique in the system.', 'success');
            }
        })
        .catch(error => {
            console.error("Error verifying phone:", error);
            Swal.fire("Error", "Could not connect to the server.", "error");
        })
        .finally(() => {
            if (btn) { btn.innerText = originalBtnText; btn.disabled = false; }
        });
    };


    function verifyEmail(fieldId) {
        const emailInput = document.getElementById(fieldId) || document.querySelector(`[name="${fieldId}"]`);
        if (!emailInput) { alert("Error: Input field not found."); return; }
        const email = (emailInput.value || '').trim();
        const mainEmail = document.getElementById('Email')?.value?.trim() || '';
        const altEmail = document.getElementById('AlternateEmailID')?.value?.trim() || '';

        if (!email) { Swal.fire("Wait", "Please enter an email address first before verifying.", "warning"); return; }
        if (fieldId === 'AlternateEmailID' && mainEmail && altEmail && mainEmail.toLowerCase() === altEmail.toLowerCase()) {
            Swal.fire("Error", "Email and Alternate Email cannot be the exact same!", "error"); return;
        }

        const btn = window.event ? (window.event.target || window.event.srcElement) : null;
        let originalBtnText = 'Verify';
        if (btn) { originalBtnText = btn.innerText; btn.innerText = '...'; btn.disabled = true; }

        fetch('@Url.Action("CheckEmailDuplicate", "Accounts")?email=' + encodeURIComponent(email))
        .then(async response => {
            if (!response.ok) throw new Error("HTTP Status " + response.status);
            return response.json();
        })
        .then(data => {
            if (data.error) Swal.fire("Error", 'Database Error: ' + data.message, "error");
            else if (data.isDuplicate) Swal.fire("Warning", 'This email exists in the database!\n\n(If this is the current email for this account, you can ignore this).', "warning");
            else Swal.fire("Success", 'This email is valid and unique.', "success");
        })
        .catch(error => { Swal.fire("Error", "Could not connect to the server.", "error"); })
        .finally(() => { if (btn) { btn.innerText = originalBtnText; btn.disabled = false; } });
    }

    function submitQuickTask(event, form) {
        event.preventDefault();

        // =======================================================
        // 🚀 CRITICAL FIX: COMPILE REMINDER & REPEAT FOR ASP.NET
        // =======================================================
        // 1. Process Reminder Date/Time Safely
        const reminderToggle = document.getElementById('modalReminderToggle');
        if (reminderToggle && reminderToggle.checked) {
            const dateEl = document.getElementById('reminderDateInput');
            const timeEl = document.getElementById('reminderTimeInput');
            const notifyEl = document.getElementById('modalNotifyType');

            if (dateEl && timeEl) {
                const rDate = dateEl.value;
                const rTime = timeEl.value;
                if (rDate && rTime) {
                    let hiddenRem = document.createElement('input');
                    hiddenRem.type = 'hidden';
                    hiddenRem.name = 'Reminder';
                    hiddenRem.value = `${rDate}T${rTime}`;
                    form.appendChild(hiddenRem);
                }
            }

            if (notifyEl) {
                let hiddenNotify = document.createElement('input');
                hiddenNotify.type = 'hidden';
                hiddenNotify.name = 'ReminderNotifyType';
                hiddenNotify.value = notifyEl.value;
                form.appendChild(hiddenNotify);
            }
        }

        // 2. Process Repeat string Safely
        const repeatToggle = document.getElementById('modalRepeatToggle');
        if (repeatToggle && repeatToggle.checked) {
            const repeatSelect = document.getElementById('repeatTypeSelect');
            if (repeatSelect && repeatSelect.value !== "None") {
                let hiddenRep = document.createElement('input');
                hiddenRep.type = 'hidden';
                hiddenRep.name = 'Repeat'; // Matches backend model
                hiddenRep.value = repeatSelect.value;
                form.appendChild(hiddenRep);
            }
        }

        // Standard Submit Logic
        const submitBtn = form.querySelector('button[type="submit"]');
        const origText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Saving...';
        submitBtn.disabled = true;
        const formData = new FormData(form);

        fetch('@Url.Action("Create", "Tasks")', {
            method: 'POST',
            body: formData
        })
            .then(async response => {
                if (response.ok || response.redirected) {
                    window.location.reload();
                } else {
                    Swal.fire("Error", "Failed to create the task.", "error");
                    submitBtn.innerHTML = origText;
                    submitBtn.disabled = false;
                }
            })
            .catch(error => {
                console.error("Error creating task:", error);
                Swal.fire("Error", "A server error occurred while saving the task.", "error");
                submitBtn.innerHTML = origText;
                submitBtn.disabled = false;
            });
    }

    function submitEditFormAjax(formElement, isNewLead) {
        const submitBtns = formElement.querySelectorAll('button[type="submit"]');
        const originalTexts = [];
        submitBtns.forEach((btn, idx) => {
            originalTexts[idx] = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Saving...';
            btn.disabled = true;
        });

        const formData = new FormData(formElement);

        // 🚀 CRITICAL FIX: Explicitly force the ProfilePendingReason to '-None-' if State is selected
        // This prevents ASP.NET from rejecting the form!
        const stateVal = formData.get('Addr1_State');
        if (stateVal && stateVal.trim() !== "" && stateVal !== "-None-" && stateVal !== "- Select State -") {
            formData.set('ProfilePendingReason', '-None-');
        }

        // Clean up dummy dropdown text
        if (formData.get('Addr1_Country') === '- Select Country -') formData.set('Addr1_Country', '');
        if (formData.get('Addr1_State') === '- Select State -') formData.set('Addr1_State', '');
        if (formData.get('Addr1_City') === '- Select City -') formData.set('Addr1_City', '');
        if (formData.get('Addr1_Zip') === '- Select Zip Code -') formData.set('Addr1_Zip', '');

        fetch(formElement.action, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(async response => {
                // Detect if ASP.NET Core returned an HTML validation error view instead of a real success
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("text/html")) {
                    const htmlText = await response.text();
                    if (htmlText.includes("input-validation-error") || htmlText.includes("field-validation-error")) {
                        throw new Error("Validation failed on the server. Please check required fields.");
                    }
                }

                if (!response.ok && !response.redirected) {
                    throw new Error("Server returned an error.");
                }

                Swal.fire({
                    title: 'Success!',
                    text: isNewLead ? 'Account updated and Lead created successfully!' : 'Account updated successfully.',
                    icon: 'success',
                    showConfirmButton: false,
                    timer: 2000,
                    timerProgressBar: true
                }).then(() => {
                    window.location.reload();
                });
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Oops!', error.message || 'Something went wrong while saving.', 'error');
                submitBtns.forEach((btn, idx) => {
                    btn.innerHTML = originalTexts[idx];
                    btn.disabled = false;
                });
            });
    }

     // =====================================
       // 3. INITIALIZATION & EVENT LISTENERS
       // =====================================
       document.addEventListener("DOMContentLoaded", function () {

           // 1. Initial Quick Status Setups
           const quickOwner = document.getElementById('QuickAccountOwnerId');
           if (quickOwner) quickOwner.value = '@Model.AccountOwnerId';

           const quickStatus = document.getElementById('QuickCurrentStatus');
           if (quickStatus) quickStatus.value = '@Model.CurrentStatus';

           const loggedInUser = '@currentUserId';
           const inlineNoteOwner = document.getElementById('inlineNoteOwner');
           if (inlineNoteOwner) inlineNoteOwner.value = loggedInUser;
           const modalNoteOwner = document.getElementById('modalNoteOwner');
           if (modalNoteOwner) modalNoteOwner.value = loggedInUser;

           // ==========================================
           // 🚀 NEW: TASK DUE DATE <-> DUE DAYS SYNC
           // ==========================================
           const dueDaysInput = document.getElementById('TaskDueDays');
           const dueDateInput = document.getElementById('TaskDueDate');

           if (dueDaysInput && dueDateInput) {
               // User types number of days -> Auto-fill the Date
               dueDaysInput.addEventListener('input', function () {
                   const days = parseInt(this.value);
                   if (!isNaN(days)) {
                       const targetDate = new Date();
                       targetDate.setDate(targetDate.getDate() + days);

                       const yyyy = targetDate.getFullYear();
                       const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
                       const dd = String(targetDate.getDate()).padStart(2, '0');

                       dueDateInput.value = `${yyyy}-${mm}-${dd}`;
                   } else {
                       dueDateInput.value = '';
                   }
               });

               // User picks a date -> Auto-fill the number of Days
               dueDateInput.addEventListener('change', function () {
                   if (this.value) {
                       const selectedDate = new Date(this.value);
                       const today = new Date();

                       // Set both to midnight to avoid timezone shifting issues
                       today.setHours(0, 0, 0, 0);
                       selectedDate.setHours(0, 0, 0, 0);

                       const diffTime = selectedDate - today;
                       const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                       dueDaysInput.value = diffDays;
                   } else {
                       dueDaysInput.value = '';
                   }
               });
           }

           // 2. Profile Rating Calculation
           const profileFields = [
               'IsHomeopathicDoctor', 'WorkType', 'HasComputer', 'ClinicType',
               'Qualification', 'CollegeName', 'YearOfPassing', 'TotalExperience',
               'YearsOfPractice', 'AveragePatientFee', 'NumberOfClinics',
               'DateOfBirth', 'Age', 'PatientsPerDay'
           ];

        function calculateProfileMetrics() {
            let filledFieldsCount = 0;
            profileFields.forEach(id => {
                const el = document.getElementById(id);
                if (el && el.value.trim() !== '') filledFieldsCount++;
            });

            const isHomeopath = document.getElementById('IsHomeopathicDoctor')?.value || '';
            const hasComputer = document.getElementById('HasComputer')?.value || '';

            const isHomeopathNo = (isHomeopath === 'No' || isHomeopath === 'नहीं' || isHomeopath === 'Not a Homeopath Doctor' || isHomeopath === 'Not a Homeopathy Doctor');
            const hasComputerNo = (hasComputer === 'No');

            let calculatedStatus = "Not Completed";
            if (filledFieldsCount > 4 && !hasComputerNo && !isHomeopathNo) {
                calculatedStatus = "Strongly Completed";
            } else if (filledFieldsCount === 4 && !hasComputerNo && !isHomeopathNo) {
                calculatedStatus = "Completed";
            } else if (filledFieldsCount >= 4 && (hasComputerNo || isHomeopathNo)) {
                calculatedStatus = "Not-Qualified";
            }

            const statusField = document.getElementById('Profilestatus');
            const rateField = document.getElementById('ProfileRate');

            if (statusField) statusField.value = calculatedStatus;
            if (rateField) rateField.value = filledFieldsCount;
        }

        profileFields.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('change', calculateProfileMetrics);
                if (el.tagName === 'INPUT') el.addEventListener('input', calculateProfileMetrics);
            }
        });

        // 3. Form Field Toggles
        function toggleAccountTypeFields() {
            const accountTypeSelect = document.getElementById('AccountType');
            const divGroupName = document.getElementById('divGroupName');
            if (accountTypeSelect && divGroupName) {
                if (accountTypeSelect.value === 'Group') divGroupName.style.display = 'block';
                else {
                    divGroupName.style.display = 'none';
                    const groupNameInput = document.getElementById('GroupName');
                    if(groupNameInput) groupNameInput.value = '';
                }
            }
        }
        const accountTypeEl = document.getElementById('AccountType');
        if (accountTypeEl) accountTypeEl.addEventListener('change', toggleAccountTypeFields);
        toggleAccountTypeFields();

           function toggleDataSourceFields() {
        const dsElement = document.getElementById('DataSource');
        if (!dsElement) return;
        const val = dsElement.value;
        const divMeta = document.getElementById('divMetaCampaign');
        const divSeminar = document.getElementById('divSeminarName');
        if (divMeta) divMeta.style.display = (val === 'Meta Ads') ? 'block' : 'none';
        if (divSeminar) divSeminar.style.display = (val === 'Seminar Conference') ? 'block' : 'none';
    }
    const dataSourceEl = document.getElementById('DataSource');
    if (dataSourceEl) {
        dataSourceEl.addEventListener('change', toggleDataSourceFields);
        toggleDataSourceFields(); // <-- ADD THIS LINE to run it on initial page load
    }

        // 4. Cascading Addresses
        function populateDropdown(dropdownId, dataList, defaultText, selectedValue = "") {
            const dropdown = document.getElementById(dropdownId);
            if (!dropdown) return;
            dropdown.innerHTML = '<option value="">- ' + defaultText + ' -</option>';
            dataList.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item;
                opt.textContent = item;
                if (item === selectedValue) opt.selected = true;
                dropdown.appendChild(opt);
            });
        }

        function setupCascadingDropdowns(countryId, stateId, cityId, zipId, defaultState = "", defaultCity = "", defaultZip = "") {
            const countryEl = document.getElementById(countryId);
            const stateEl = document.getElementById(stateId);
            const cityEl = document.getElementById(cityId);
            const zipEl = document.getElementById(zipId);

            if (countryEl) {
                countryEl.addEventListener('change', function () {
                    const country = this.value;
                    if (stateEl) stateEl.innerHTML = '<option value="">- Select State -</option>';
                    if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (country) {
                        fetch('@Url.Action("GetStates", "Postcode")?country=' + encodeURIComponent(country))
                        .then(res => res.json())
                        .then(states => {
                            populateDropdown(stateId, states, 'Select State', defaultState);
                            if (defaultState) { 
                                const el = document.getElementById(stateId);
                                if (el) el.dispatchEvent(new Event('change'));
                                defaultState = ""; 
                            }
                        });
                    }
                });
            }

            if (stateEl) {
                stateEl.addEventListener('change', function () {
                    const state = this.value;
                    if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (state) {
                        fetch('@Url.Action("GetCities", "Postcode")?state=' + encodeURIComponent(state))
                        .then(res => res.json())
                        .then(cities => {
                            populateDropdown(cityId, cities, 'Select City', defaultCity);
                            if (defaultCity) { 
                                const el = document.getElementById(cityId);
                                if (el) el.dispatchEvent(new Event('change'));
                                defaultCity = ""; 
                            }
                        });
                    }
                });
            }

            if (cityEl) {
                cityEl.addEventListener('change', function () {
                    const city = this.value;
                    const state = stateEl ? stateEl.value : '';
                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (city && state) {
                        fetch('@Url.Action("GetZipCodes", "Postcode")?city=' + encodeURIComponent(city) + '&state=' + encodeURIComponent(state))
                        .then(res => res.json())
                        .then(zipCodes => {
                            populateDropdown(zipId, zipCodes, 'Select Zip Code', defaultZip);
                            defaultZip = ""; 
                        });
                    }
                });
            }
        }

        const existingCountry1 = '@Html.Raw(Model?.Addr1_Country ?? "")';
        const existingCountry2 = '@Html.Raw(Model?.Addr2_Country ?? "")';
        const existingState1 = '@Html.Raw(Model?.Addr1_State ?? "")';
        const existingState2 = '@Html.Raw(Model?.Addr2_State ?? "")';
        const existingCity1 = '@Html.Raw(Model?.Addr1_City ?? "")';
        const existingCity2 = '@Html.Raw(Model?.Addr2_City ?? "")';
        const existingZip1 = '@Html.Raw(Model?.Addr1_Zip ?? "")';
        const existingZip2 = '@Html.Raw(Model?.Addr2_Zip ?? "")';

        fetch('@Url.Action("GetCountries", "Postcode")')
        .then(res => res.json())
        .then(countries => {
            populateDropdown('Addr1_Country', countries, 'Select Country', existingCountry1);
            populateDropdown('Addr2_Country', countries, 'Select Country', existingCountry2);

            if (existingCountry1) {
                const el = document.getElementById('Addr1_Country');
                if (el) el.dispatchEvent(new Event('change'));
            }
            if (existingCountry2) {
                const el = document.getElementById('Addr2_Country');
                if (el) el.dispatchEvent(new Event('change'));
            }
        });

        setupCascadingDropdowns('Addr1_Country', 'Addr1_State', 'Addr1_City', 'Addr1_Zip', existingState1, existingCity1, existingZip1);
        setupCascadingDropdowns('Addr2_Country', 'Addr2_State', 'Addr2_City', 'Addr2_Zip', existingState2, existingCity2, existingZip2);

        // 5. MAIN FORM EDIT SUBMISSION & YES/NO POPUPS
        const accountForm = document.getElementById('accountForm');
        if (accountForm) {
            accountForm.addEventListener('submit', function (e) {
                e.preventDefault();

                function getFieldValue(fieldName) {
                    const el = document.getElementById(fieldName) || document.querySelector(`[name="${fieldName}"]`);
                    return el ? el.value.trim() : "";
                }

                let mobileNumber = getFieldValue('MobileNumber');
                if (mobileNumber !== "") {
                    let digitsOnly = mobileNumber.replace(/\D/g, '');
                    if (digitsOnly.length < 10) {
                        Swal.fire("Invalid!", "Mobile Number must contain a valid 10-digit number.", "error");
                        document.getElementById('MobileNumber')?.focus();
                        return;
                    }
                }

                let altMobile = getFieldValue('AlternateMobile');
                if (altMobile !== "") {
                    let altDigitsOnly = altMobile.replace(/\D/g, '');
                    if (altDigitsOnly.length > 0 && altDigitsOnly.length < 10) {
                        Swal.fire("Invalid!", "Alternate Mobile Number must contain at least 10 digits.", "error");
                        document.getElementById('AlternateMobile')?.focus();
                        return;
                    }
                }


                //  2. STATE OR PENDING REASON LOGIC
                const stateValue = getFieldValue('Addr1_State');
                const pendingReason = getFieldValue('ProfilePendingReason');

                // Ensure dummy dropdown text isn't evaluated as a real state
                const hasState = stateValue !== "" && stateValue !== "-None-" && stateValue !== "- Select State -";
                const hasReason = pendingReason !== "" && pendingReason !== "-None-";

                // 🚀 CRITICAL FIX: If person fills State, visually set the pending reason to '-None-' in UI
                if (hasState) {
                    const reasonField = document.getElementById('ProfilePendingReason') || document.querySelector('[name="ProfilePendingReason"]');
                    if (reasonField) {
                        reasonField.value = "-None-";
                    }
                }
                else if (!hasState && !hasReason) {
                    Swal.fire("Required", "You must provide either a State OR a Profile Pending Reason.", "warning");
                    document.getElementById('ProfilePendingReason')?.focus();
                    return;
                }

                //  3. PROFILE COMPLETION CHECK
                const q1 = getFieldValue('IsHomeopathicDoctor');
                const q2 = getFieldValue('WorkType');
                const q3 = getFieldValue('ClinicType');
                const q4 = getFieldValue('HasComputer');

                const isProfileIncomplete = (
                    q1 === "" || q1 === "-None-" || q1 === "false" ||
                    q2 === "" || q2 === "-None-" || q2 === "false" ||
                    q3 === "" || q3 === "-None-" || q3 === "false" ||
                    q4 === "" || q4 === "-None-" || q4 === "false"
                );

                if (isProfileIncomplete && !hasState && !hasReason) {
                    Swal.fire("Incomplete Profile", "Your professional profile is incomplete! Please select a Profile Pending Reason.", "warning");
                    const reasonField = document.getElementById('ProfilePendingReason') || document.querySelector('[name="ProfilePendingReason"]');
                    if (reasonField) {
                        reasonField.focus();
                        reasonField.style.boxShadow = "0 0 0 3px #ef4444";
                        setTimeout(() => reasonField.style.boxShadow = "none", 3500);
                    }
                    return;
                }

                //  4. QUALIFIED CONFIRMATION POPUP
                const qualStatus = getFieldValue('QualificationStatus');
                const origQualStatus = '@(Model?.QualificationStatus ?? "")';

                if (qualStatus === 'Qualified' && origQualStatus !== 'Qualified') {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: 'Marking this as Qualified will automatically create a Lead. Do you want to proceed?',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#2563eb',
                        cancelButtonColor: '#ef4444',
                        confirmButtonText: 'Yes, create lead!',
                        cancelButtonText: 'No, cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            submitEditFormAjax(accountForm, true);
                        } else {
                            const dropDown = document.getElementById('QualificationStatus');
                            if (dropDown) dropDown.value = "-None-";
                        }
                    });
                } else {
                    submitEditFormAjax(accountForm, false);
                }
            });
        }
    });

    function openEditNoteModal(btnElement) {
        // 1. Extract data safely from the button's attributes
        const noteId = btnElement.getAttribute('data-note-id');
        const title = btnElement.getAttribute('data-note-title') || "";
        const desc = btnElement.getAttribute('data-note-desc') || "";

        // 2. Populate the modal fields
        document.getElementById('editNoteId').value = noteId;
        document.getElementById('editNoteTitle').value = title;
        document.getElementById('editNoteDesc').value = desc;

        // 3. 🚀 CRITICAL FIX: Move the modal to the document body!
        // This prevents the screen from freezing or blurring by breaking the modal out of any parent containers.
        const modalEl = document.getElementById('editNoteModal');
        if (modalEl && modalEl.parentNode !== document.body) {
            document.body.appendChild(modalEl);
        }

        // 4. Show modal safely
        const editModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        editModal.show();
    }

    function saveEditedNote() {
        const noteId = document.getElementById('editNoteId').value;
        const title = document.getElementById('editNoteTitle').value.trim();
        const desc = document.getElementById('editNoteDesc').value.trim();

        if (!desc && !title) {
            Swal.fire("Wait!", "Note cannot be empty.", "warning");
            return;
        }

        // Set button to loading state
        const saveBtn = document.getElementById('btnSaveEditedNote');
        const origText = saveBtn.innerHTML;
        saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        saveBtn.disabled = true;

        const formData = new FormData();
        formData.append('noteId', noteId);
        formData.append('noteTitle', title);
        formData.append('description', desc);

        fetch('@Url.Action("EditNoteAjax", "Accounts")', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Safely hide the modal and remove backdrop before reloading
                    const modalEl = document.getElementById('editNoteModal');
                    const editModal = bootstrap.Modal.getInstance(modalEl);
                    if (editModal) editModal.hide();

                    Swal.fire({
                        title: "Updated!",
                        text: "Note has been successfully edited.",
                        icon: "success",
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire("Error", "Failed to update note: " + data.message, "error");
                    saveBtn.innerHTML = origText;
                    saveBtn.disabled = false;
                }
            })
            .catch(err => {
                console.error('Edit Note Error:', err);
                Swal.fire("Error", "Server error while updating the note.", "error");
                saveBtn.innerHTML = origText;
                saveBtn.disabled = false;
            });
    }
</script>