// QUICK INFO AUTO-SAVE FOR ACCOUNTS
// =====================================
function updateQuickField(fieldName, fieldValue) {
        // 1. Sync data to the main hidden edit form
        const editFormInput = document.getElementById(fieldName) || document.querySelector(`[name="${fieldName}"]`);
        if (editFormInput) {
            editFormInput.value = fieldValue;
            editFormInput.dispatchEvent(new Event('change')); 
        }

        // 2. Format data for the Controller [FromForm] attributes
        const formData = new URLSearchParams();
        formData.append('id', '@Model.Id');
        formData.append('field', fieldName);
        formData.append('newValue', fieldValue); 

        // 3. Send to Database
        fetch('/Accounts/UpdateQuickInfo', { 
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
        .then(response => {
            if (!response.ok) {
                alert("Failed to automatically update " + fieldName + " in the database.");
            } else {
                console.log("Successfully saved " + fieldName);
            }
        })
        .catch(err => {
            console.error('Error updating quick info:', err);
        });
    }

