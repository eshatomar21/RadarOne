        window.verifyPhone = function(fieldId) {
            const phoneInput = document.getElementById(fieldId);
            if (!phoneInput) {
                alert("Error: Input field not found.");
                return;
            }

            const phone = phoneInput.value.trim();
            const mainMobile = document.getElementById('MobileNumber')?.value?.trim() || '';
            const altMobile = document.getElementById('AlternateMobile')?.value?.trim() || '';

            if (!phone) {
                alert('Please enter a phone number first before verifying.');
                return;
            }

            if (fieldId === 'AlternateMobile' && mainMobile && altMobile && mainMobile === altMobile) {
                alert('❌ Mobile Number and Alternate Mobile cannot be the exact same!');
                return;
            }

            const btn = window.event ? (window.event.target || window.event.srcElement) : null;
            let originalBtnText = 'Verify';
            if (btn) {
                originalBtnText = btn.innerText;
                btn.innerText = '...';
                btn.disabled = true;
            }

            fetch('@Url.Action("CheckDuplicatePhone", "Accounts")?phone=' + encodeURIComponent(phone))
            .then(async response => {
                if (!response.ok) throw new Error("HTTP Status " + response.status);
                return response.json();
            })
            .then(data => {
                if (data.error) {
                    alert('⚠️ Database Error: ' + data.message);
                } else if (data.isDuplicate) {
                    alert('⚠️ WARNING: This phone number exists in the database!\n\n(Note: If this is the current number for this account, you can ignore this warning).');
                } else {
                    alert('✅ This number is valid and unique in the system.');
                }
            })
            .catch(error => {
                console.error("Error verifying phone:", error);
                alert("Could not connect to the server. Check your browser console (F12) for details.");
            })
            .finally(() => {
                if (btn) {
                    btn.innerText = originalBtnText;
                    btn.disabled = false;
                }
            });
        };

