@model Radar_CRM.Models.Account

@{
    ViewData["Title"] = "Create Account";
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Premium Enterprise CRM Typography & Base - Navy & Cream Theme */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7; /* Soft cream background */
        --theme-surface: #ffffff; /* Pure white for cards/modals */
        --theme-navy-primary: #1e3a8a; /* Deep Navy Blue */
        --theme-navy-hover: #1e40af; /* Slightly lighter Navy for hover */
        --theme-navy-light: #eff6ff; /* Very pale blue/cream hybrid for accents */
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-shadow-float: 0 20px 40px -10px rgba(30, 58, 138, 0.08); /* Navy-tinted shadow */
    }

    body {
        background-color: var(--theme-bg-cream);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--theme-text-main);
        -webkit-font-smoothing: antialiased;
    }

    /* Main Modal/Drawer Container - Floating Document Vibe */
    .sf-container {
        background-color: var(--theme-surface);
        width: 98%;
        max-width: 1800px;
        margin: 30px auto;
        min-height: 90vh;
        border-radius: 16px;
        box-shadow: var(--theme-shadow-float);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.5); /* Seamless edge */
        overflow: hidden;
    }

    /* 1. Header Area */
    .sf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
        background-color: var(--theme-surface);
        border-bottom: 1px solid var(--theme-border);
    }

    .sf-header-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .sf-header-title h1 {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--theme-navy-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: -0.02em;
        }

        .sf-header-title .entity-type {
            color: var(--theme-navy-primary);
            font-weight: 600;
            font-size: 0.85rem;
            background: var(--theme-navy-light);
            padding: 6px 14px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

    .sf-close-btn {
        background: transparent;
        border: 1px solid var(--theme-border);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--theme-text-muted);
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .sf-close-btn:hover {
            background: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            border-color: var(--theme-navy-light);
            transform: rotate(90deg);
        }

    /* Primary Button */
    .btn-sf-primary {
        background-color: var(--theme-navy-primary);
        color: var(--theme-surface);
        border: none;
        padding: 10px 28px;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);
    }

        .btn-sf-primary:hover {
            background-color: var(--theme-navy-hover);
            box-shadow: 0 6px 16px rgba(30, 58, 138, 0.25);
            transform: translateY(-1px);
        }

    /* 2. Tabs - Minimalist like the reference image */
    .sf-tabs {
        display: flex;
        border-bottom: 1px solid var(--theme-border);
        padding: 0 40px;
        background-color: var(--theme-surface);
        gap: 40px;
        margin: 0;
    }

    .sf-tab {
        background: none;
        border: none;
        padding: 20px 0;
        color: var(--theme-text-muted);
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        margin-bottom: -1px;
        transition: all 0.2s;
    }

        .sf-tab:hover {
            color: var(--theme-navy-primary);
        }

        .sf-tab.active {
            color: var(--theme-navy-primary);
            border-bottom: 3px solid var(--theme-navy-primary);
            font-weight: 600;
        }

    /* Form Inputs - Clean, airy layout */
    .form-group {
        margin-bottom: 28px;
    }

    .sf-label {
        display: block;
        font-size: 0.85rem;
        color: var(--theme-text-muted);
        margin-bottom: 8px;
        font-weight: 500;
    }

    .sf-input, .sf-select {
        width: 100%;
        border: 1px solid var(--theme-border);
        border-radius: 6px; /* Slightly smaller radius to match the thinner profile */
        padding: 6px 12px; /* Reduced vertical padding to thin out the box */
        height: 36px; /* Fixed thinner height */
        font-size: 0.85rem; /* Adjusted font size to fit the compact box perfectly */
        color: var(--theme-text-main);
        background-color: #fafaf9;
        transition: all 0.2s ease-in-out;
    }

        .sf-input:hover, .sf-select:hover {
            border-color: #cbd5e1;
            background-color: var(--theme-surface);
        }

        .sf-input:focus, .sf-select:focus {
            outline: none;
            border-color: var(--theme-navy-primary);
            background-color: var(--theme-surface);
            box-shadow: 0 0 0 3px var(--theme-navy-light); /* Slightly thinner shadow */
        }

        .sf-input[readonly] {
            background-color: transparent;
            border-color: transparent;
            border-bottom: 1px dashed var(--theme-border);
            border-radius: 0;
            padding-left: 0;
            color: var(--theme-text-main);
            font-weight: 500;
            cursor: default;
            height: auto; /* Allow readonly fields to rest naturally */
        }

            .sf-input[readonly]:focus {
                box-shadow: none;
            }
    /* Section Headers */
    .pane-section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        margin-top: 16px;
        padding-bottom: 0;
        border-bottom: none;
        letter-spacing: -0.01em;
    }

    /* Cards - Layered effect */
    .sf-card {
        border: 1px solid var(--theme-border);
        border-radius: 12px;
        padding: 32px;
        margin-bottom: 24px;
        background-color: var(--theme-surface);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        transition: box-shadow 0.3s ease;
    }

        .sf-card:hover {
            box-shadow: var(--theme-shadow-float);
        }

    .sf-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid var(--theme-border);
        padding-bottom: 16px;
    }

    /* Input Group for Verify Buttons */
    .verify-group {
        display: flex;
        position: relative;
    }

        .verify-group .sf-input {
            padding-right: 90px; /* Space for the button inside */
        }

    /* --- NEW SIDEBAR LAYOUT STYLES --- */
    .page-wrapper {
        display: flex;
        gap: 24px;
        max-width: 1800px;
        margin: 30px auto;
        width: 98%;
        align-items: flex-start;
    }

        /* Override your existing sf-container margin to fit inside the wrapper */
        .page-wrapper .sf-container {
            margin: 0;
            width: 100%;
            flex-grow: 1;
        }

    .sf-sidebar {
        width: 280px;
        flex-shrink: 0;
        background-color: var(--theme-surface);
        border-radius: 16px;
        box-shadow: var(--theme-shadow-float);
        border: 1px solid rgba(255, 255, 255, 0.5);
        padding: 24px 16px;
        position: sticky;
        top: 30px; /* Keeps sidebar in view when scrolling down */
    }

    .sidebar-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--theme-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 16px;
        padding-left: 8px;
    }

    .rl-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        margin-bottom: 8px;
        border-radius: 10px;
        color: var(--theme-text-main);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        border: 1px solid transparent;
        transition: all 0.2s ease;
        background: transparent;
        cursor: pointer;
        width: 100%;
        text-align: left;
    }

        .rl-item i {
            color: var(--theme-text-muted);
            width: 24px;
            transition: all 0.2s;
        }

        .rl-item:hover {
            background-color: var(--theme-navy-light);
            border-color: #dbeafe;
            color: var(--theme-navy-primary);
            transform: translateX(4px);
        }

            .rl-item:hover i {
                color: var(--theme-navy-primary);
            }

    .rl-badge {
        background: var(--theme-navy-primary);
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 12px;
        min-width: 24px;
        text-align: center;
    }

        .verify-group .btn-verify {
            position: absolute;
            right: 4px;
            top: 4px;
            bottom: 4px;
            border: none;
            background: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            font-weight: 600;
            border-radius: 6px;
            padding: 0 16px;
            font-size: 0.8rem;
            transition: all 0.2s;
            cursor: pointer;
        }

            .verify-group .btn-verify:hover {
                background: var(--theme-navy-primary);
                color: var(--theme-surface);
            }
</style>
<form asp-action="Edit" method="post" id="accountForm" enctype="multipart/form-data">
    <!-- CRITICAL: Hidden ID field to bind the existing record -->
    <input type="hidden" asp-for="Id" />
    <div class="sf-container">
        <!-- 1. Header -->
        <div class="sf-header">
            <div class="sf-header-title">
                <button type="button" class="sf-close-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
                <h1><span class="entity-type">Account</span> New Account</h1>
            </div>
        </div>

        <!-- 2. Tabs -->
        <ul class="nav sf-tabs" id="accountTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="sf-tab active" id="main-tab" data-bs-toggle="tab" data-bs-target="#main" type="button" role="tab">Main Details</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="sf-tab" id="address-tab" data-bs-toggle="tab" data-bs-target="#address" type="button" role="tab">Address Info</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="sf-tab" id="professional-tab" data-bs-toggle="tab" data-bs-target="#professional" type="button" role="tab">Professional & Software</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="sf-tab" id="purchase-tab" data-bs-toggle="tab" data-bs-target="#purchase" type="button" role="tab">Purchases & Tracking</button>
            </li>
        </ul>

        <!-- 4. Tab Content Area -->
        <div class="tab-content" id="accountTabsContent" style="flex-grow: 1; display: flex; flex-direction: column;">

            <!-- MAIN TAB -->
            <div class="tab-pane fade show active" id="main" role="tabpanel" style="padding: 32px 40px;">

                <!-- Master Details -->
                <h3 class="pane-section-title">Master Details</h3>
                <div class="row">

                    <div class="col-md-6 form-group">
                        <label class="sf-label">Data Source <span class="text-danger">*</span></label>
                        <select asp-for="DataSource" class="sf-select" id="DataSource" required>
                            <option value="">-None-</option>
                            <option value="InboundCall">-InboundCall-</option>
                            <option value="Referral/Dealer">-Referral/Dealer-</option>
                            <option value="Meta Ads">Meta Ads</option>
                            <option value="Google AdWords">-Google AdWords-</option>
                            <option value="Outreach">-Outreach-</option>
                            <option value="Group Lead">-Group Lead-</option>
                            <option value="Institutiona">-Institutional-</option>
                            <option value="Webinar">Webinar</option>
                            <option value="KOMMO">KOMMO</option>
                            <option value="Google Organic SEO">Google Organic SEO</option>
                            <option value="Website Direct">Website Direct</option>
                            <option value="YouTube">YouTube</option>
                            <option value="LinkedIn">LinkedIn</option>
                            <option value="Instagram Organic">Instagram Organic</option>
                            <option value="Zoho Webinar">Zoho Webinar</option>
                            <option value="Reference Doctor">Reference Doctor</option>
                            <option value="Reference Dealer Partner">Reference Dealer Partner</option>
                            <option value="Free Trial Self Register">Free Trial Self Register</option>
                            <option value="Seminar Conference">Seminar Conference</option>
                            <option value="Cold Calling">Cold Calling</option>
                            <option value="WhatsApp Campaign">WhatsApp Campaign</option>
                            <option value="Email Campaign">Email Campaign</option>
                            <option value="Data Import Old DB">Data Import Old DB</option>
                            <option value="WHATSAPP - BJAIN RX LLP">WHATSAPP - BJAIN RX LLP</option>
                        </select>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="sf-label">Co-Owner</label>
                        <select asp-for="CoOwnerId" asp-items="ViewBag.UsersList" class="sf-select">
                            <option value="">- Select Co-Owner -</option>
                        </select>
                    </div>


                    <!-- Conditional Fields (Hidden by default) -->
                    <div class="col-md-6 form-group" id="divMetaCampaign" style="display:none;">
                        <label class="sf-label">Meta Campaign Name</label>
                        <input name="MetaCampaignName" class="sf-input" placeholder="Enter campaign name..." />
                    </div>
                    <div class="col-md-6 form-group" id="divSeminarName" style="display:none;">
                        <label class="sf-label">Seminar Name</label>
                        <input name="SeminarName" class="sf-input" placeholder="Enter seminar name..." />
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="sf-label">Account Type</label>
                        <select asp-for="AccountType" class="sf-select">
                            <option value="None">None</option>
                            <option value="Individual">Individual</option>
                            <option value="Group">Group</option>
                            <option value="Institution">Institution</option>
                            <option value="Government Organisation">Government Organisation</option>
                        </select>
                    </div>

             

                    <div class="col-md-6 form-group">
                        <label class="sf-label">Current Status</label>
                        <select asp-for="CurrentStatus" class="sf-select">
                            <option value="None">None</option>
                            <option value="User">User</option>
                            <option value="Non-User">Non-User</option>
                        </select>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="sf-label">Account Owner</label>
                        <select asp-for="AccountOwnerId" asp-items="ViewBag.UsersList" class="sf-select">
                            <option value="">- Select Account Owner -</option>
                        </select>
                    </div>

                    <div class="col-md-6 form-group" id="LeadStatus">
                        <label class="sf-label">LeadStatus</label>
                        <input name="LeadStatus" class="sf-input" placeholder="Enter seminar name..." readonly />
                    </div>



                    <!-- Hidden Date of Entry field -->
                    <div class="col-md-6 form-group" style="display: none;">
                        <label class="sf-label">Date of Entry</label>
                        <input asp-for="DateOfEntry" class="sf-input" type="datetime-local" />
                    </div>
                </div>

                <!-- Primary Details -->
                <h3 class="pane-section-title" style="margin-top: 12px;">Primary Details</h3>
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="sf-label">Account Name <span class="text-danger">*</span></label>
                        <input asp-for="AccountName" class="sf-input" style="font-weight: 600;" placeholder="Enter account name..." required />
                    </div>


                  
                    <div class="col-md-6 form-group">
                        <label class="sf-label">Contact Person Name</label>
                        <input asp-for="ContactPersonName" class="sf-input" placeholder="Enter full name" />
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="sf-label">Mobile Phone <span class="text-danger">*</span></label>
                        <div class="verify-group">
                            <input asp-for="MobileNumber" class="sf-input" id="MobileNumber" placeholder="+1 202-555-0117" required />
                            <button type="button" class="btn-verify" onclick="verifyPhone('MobileNumber')">Verify</button>
                        </div>
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="sf-label">Email</label>
                        <input asp-for="Email" class="sf-input" style="color: #1a56db;" placeholder="email@example.com" />
                    </div>

                    <!-- Removed the duplicate <div class="col-md-6"> that was breaking your grid here! -->
                    <div class="col-md-6 form-group">
                        <label class="sf-label">Alternate Mobile</label>
                        <div class="verify-group">
                            <input asp-for="AlternateMobile" class="sf-input" id="AlternateMobile" placeholder="Optional..." />
                            <button type="button" class="btn-verify" onclick="verifyPhone('AlternateMobile')">Verify</button>
                        </div>
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="sf-label">Alternate Email ID</label>
                        <input asp-for="AlternateEmailID" class="sf-input" placeholder="Optional..." />
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="sf-label">Profile Pending Reason</label>
                            <select asp-for="ProfilePendingReason" class="sf-select">
                                <option value="">-None-</option>
                                <option value="Connected">Connected</option>
                                <option value="Wrong Number/Invalid Number">Wrong Number/Invalid Number</option>
                                <option value="Ringing">Ringing</option>
                                <option value="Switched Off">Switched Off</option>
                                <option value="Busy-Call Back Later">Busy-Call Back Later</option>
                                <option value="Not-Interested">Not-Interested</option>
                                <option value="Not a Doctor">Not a Doctor</option>
                                <option value="Student">Student</option>
                                <option value="Still Ringing Tried 3 times">Still Ringing Tried 3 times</option>
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="sf-label">Qualification Status</label>
                            <select asp-for="QualificationStatus" class="sf-select">
                                <option value="">-None-</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Notqualified">Notqualified</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="sf-label">Profile Status</label>
                                <select asp-for="Profilestatus" class="sf-select">
                                    <option value="">-None-</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Strongly Completed">Strongly Completed</option>
                                    <option value="Not Completed">Not Completed</option>
                                    <option value="Not-Qualified">Not-Qualified</option>
                                </select>
                            </div>

                            <div class="col-md-6 form-group">
                                <label class="sf-label">Profile Rate</label>
                                <!-- Readonly because the backend calculates this automatically -->
                                <input asp-for="ProfileRate" type="number" class="sf-input" readonly style="background-color: #f1f5f9; color: var(--theme-text-muted);" />
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ==========================================
                     NEW MODAL-BASED NOTES & ATTACHMENTS UI
                     ========================================== -->
                <div class="d-flex justify-content-between align-items-center mt-4 border-bottom pb-2 mb-3">
                    <h3 class="pane-section-title border-0 m-0 p-0">Notes & Attachments</h3>
                    <button type="button" class="btn btn-sm" onclick="openNoteModal()" style="background-color: #e0e7ff; color: #1a56db; font-weight: 600; border-radius: 6px; font-size: 0.85rem; padding: 6px 14px;">
                        <i class="fa-solid fa-plus me-1"></i> Add Note
                    </button>
                </div>

                <!-- Container where saved notes will dynamically appear -->
                <div id="savedNotesContainer" class="mb-4">
                    @if (ViewBag.ExistingNotes != null)
                    {
                        foreach (var note in (IEnumerable<Radar_CRM.Models.Notes>)ViewBag.ExistingNotes)
                        {
                            <div class="saved-note-card p-3 mb-3 shadow-sm" style="border: 1px solid var(--theme-border); border-left: 4px solid var(--theme-navy-primary); border-radius: 8px; background: var(--theme-surface);">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold" style="font-size: 0.9rem; color: var(--theme-text-main);">
                                        <i class="fa-solid fa-circle-user text-muted me-2"></i>@note.NoteOwner
                                    </span>
                                    <span class="text-muted" style="font-size: 0.8rem;">
                                        <i class="fa-regular fa-clock me-1"></i> @note.CreatedDateTime.ToString("dd/MM/yyyy hh:mm tt")
                                    </span>
                                </div>

                                <div style="font-size: 0.9rem; color: var(--theme-text-muted); white-space: pre-wrap;">@note.Description</div>

                                @if (!string.IsNullOrEmpty(note.AttachmentFileName))
                                {
                                    <div class="mt-2">
                                        <a href="@Url.Action("DownloadNoteFile", "Accounts", new { noteId = note.Id })" target="_blank" class="text-primary text-decoration-none" style="font-size: 0.85rem; background: var(--theme-navy-light); padding: 4px 12px; border-radius: 4px; display: inline-flex; align-items: center; border: 1px solid #bfdbfe; transition: 0.2s;">
                                            <i class="fa-solid fa-download me-2"></i> Download: @note.AttachmentFileName
                                        </a>
                                    </div>
                                }

                            </div>
                        }
                    }
                </div>

                <!-- Duplication Checkbox -->
                <div class="row">
                    <div class="col-md-12 form-group pt-2 m-0">
                        <div class="form-check d-flex align-items-center gap-2">
                            <input asp-for="IsDuplicated" class="form-check-input m-0" type="checkbox" id="duplicateCheck" style="width: 16px; height: 16px;">
                            <label class="form-check-label m-0" for="duplicateCheck" style="font-size: 0.85rem; color: #b91c1c; font-weight: 600;">Mark as Duplicated Account</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ADDRESS TAB -->
            <div class="tab-pane fade" id="address" role="tabpanel" style="padding: 32px 40px;">
                <div class="row">

                    <!-- Address 1 Card -->
                    <div class="col-lg-6 mb-4">
                        <div class="sf-card h-100">
                            <div class="sf-card-title">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a56db" stroke-width="2.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                                Primary Address
                            </div>

                            <div class="row">
                                <!-- Group 1: Country & State -->
                                <div class="col-md-6 form-group mb-3">
                                    <label class="sf-label">Country</label>
                                    <select asp-for="Addr1_Country" class="sf-select" id="Addr1_Country">
                                        <option value="">- Select Country -</option>
                                    </select>
