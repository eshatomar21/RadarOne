            const existingState1 = '@Html.Raw(Model?.Addr1_State ?? "")';
            const existingState2 = '@Html.Raw(Model?.Addr2_State ?? "")';
            const existingCity1 = '@Html.Raw(Model?.Addr1_City ?? "")';
            const existingCity2 = '@Html.Raw(Model?.Addr2_City ?? "")';
            const existingZip1 = '@Html.Raw(Model?.Addr1_Zip ?? "")';
            const existingZip2 = '@Html.Raw(Model?.Addr2_Zip ?? "")';

            // 1. Fetch Countries on page load
            fetch('@Url.Action("GetCountries", "Postcode")')
            .then(res => {
                if (!res.ok) throw new Error("Server returned status: " + res.status);
                return res.json();
            })
            .then(countries => {
                populateDropdown('Addr1_Country', countries, 'Select Country', existingCountry1);
                populateDropdown('Addr2_Country', countries, 'Select Country', existingCountry2);

                // Trigger the cascade automatically if editing a saved record
                if (existingCountry1) triggerChange('Addr1_Country');
                if (existingCountry2) triggerChange('Addr2_Country');
            })
            .catch(err => console.error("Error loading countries:", err));

            // 2. Initialize Cascading Logic for both addresses
            setupCascadingDropdowns('Addr1_Country', 'Addr1_State', 'Addr1_City', 'Addr1_Zip', existingState1, existingCity1, existingZip1);
            setupCascadingDropdowns('Addr2_Country', 'Addr2_State', 'Addr2_City', 'Addr2_Zip', existingState2, existingCity2, existingZip2);
        });

        // Helper function to build dropdown options and pre-select if editing
        function populateDropdown(dropdownId, dataList, defaultText, selectedValue = "") {
            const dropdown = document.getElementById(dropdownId);
            if (!dropdown) return;

            dropdown.innerHTML = '<option value="">- ' + defaultText + ' -</option>';
            dataList.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item;
                opt.textContent = item;
                if (item === selectedValue) {
                    opt.selected = true;
                }
                dropdown.appendChild(opt);
            });
        }

        // Helper to manually trigger a change event programmatically
        function triggerChange(elementId) {
            const el = document.getElementById(elementId);
            if (el) el.dispatchEvent(new Event('change'));
        }

        // Master function to handle the Country -> State -> City -> Zip flow
        function setupCascadingDropdowns(countryId, stateId, cityId, zipId, defaultState = "", defaultCity = "", defaultZip = "") {
            const countryEl = document.getElementById(countryId);
            const stateEl = document.getElementById(stateId);
            const cityEl = document.getElementById(cityId);
            const zipEl = document.getElementById(zipId);

            // Country Change -> Load States
            if (countryEl) {
                countryEl.addEventListener('change', function () {
                    const country = this.value;
                    if (stateEl) stateEl.innerHTML = '<option value="">- Select State -</option>';
                    if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (country) {
                        fetch('@Url.Action("GetStates", "Postcode")?country=' + encodeURIComponent(country))
                        .then(res => res.json())
                        .then(states => {
                            populateDropdown(stateId, states, 'Select State', defaultState);
                            if (defaultState) {
                                triggerChange(stateId);
                                defaultState = ""; // clear after first load
                            }
                        })
                        .catch(err => console.error("Error fetching States:", err));
                    }
                });
            }

            // State Change -> Load Cities
            if (stateEl) {
                stateEl.addEventListener('change', function () {
                    const state = this.value;
                    if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (state) {
                        fetch('@Url.Action("GetCities", "Postcode")?state=' + encodeURIComponent(state))
                        .then(res => res.json())
                        .then(cities => {
                            populateDropdown(cityId, cities, 'Select City', defaultCity);
                            if (defaultCity) {
                                triggerChange(cityId);
                                defaultCity = ""; // clear after first load
                            }
                        })
                        .catch(err => console.error("Error fetching Cities:", err));
                    }
                });
            }

            // City Change -> Fetch and Populate Zip Code Dropdown
            if (cityEl) {
                cityEl.addEventListener('change', function () {
                    const city = this.value;
                    const state = stateEl ? stateEl.value : '';

                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (city && state) {
                        fetch('@Url.Action("GetZipCodes", "Postcode")?city=' + encodeURIComponent(city) + '&state=' + encodeURIComponent(state))
                        .then(res => res.json())
                        .then(zipCodes => {
                            populateDropdown(zipId, zipCodes, 'Select Zip Code', defaultZip);
                            defaultZip = ""; // clear after first load
                        })
                        .catch(err => console.error("Error fetching Zip Codes:", err));
                    }
                });
            }
        }

        const accountForm = document.getElementById('accountForm');
        if (accountForm) {
            accountForm.addEventListener('submit', function (e) {
                function getFieldValue(fieldName) {
                    const el = document.getElementById(fieldName) || document.querySelector(`[name="${fieldName}"]`);
                    return el ? el.value.trim() : "";
