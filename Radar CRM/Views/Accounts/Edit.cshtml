<!-- Bootstrap JS bundle required for Tab switching & Modals -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
     

        function clearInlineNote() {
        const titleInput = document.getElementById('inlineNoteTitle');
        const descInput = document.getElementById('inlineNoteDesc');
        const fileInput = document.getElementById('inlineNoteFile');
        if (titleInput) titleInput.value = '';
        if (descInput) descInput.value = '';
        if (fileInput) fileInput.value = '';
    }

       function saveInlineNote() {
        const titleEl = document.getElementById('inlineNoteTitle');
        const descEl = document.getElementById('inlineNoteDesc');
        const fileInput = document.getElementById('inlineNoteFile');
        const ownerDropdown = document.getElementById('inlineNoteOwner');

        const title = titleEl ? titleEl.value.trim() : '';
        const desc = descEl ? descEl.value.trim() : '';
        const ownerId = ownerDropdown ? ownerDropdown.value : '';
        const ownerName = ownerDropdown && ownerDropdown.selectedIndex > -1 ? ownerDropdown.options[ownerDropdown.selectedIndex].text : 'System User';
        const dateTime = new Date().toLocaleString();

        if (!desc && (!fileInput || fileInput.files.length === 0) && !title) {
            alert('Please enter a title, content, or attach a file.');
            return;
        }

        const formData = new FormData();
        formData.append('accountId', '@Model.Id'); // Make sure your controller expects accountId
        formData.append('noteTitle', title);
        formData.append('description', desc);
        formData.append('ownerId', ownerId);

        if (fileInput && fileInput.files.length > 0) {
            formData.append('attachment', fileInput.files[0]);
        }

        const saveBtn = document.querySelector('button[onclick="saveInlineNote()"]');
        const origText = saveBtn.innerHTML;
        saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        saveBtn.disabled = true;

        fetch('@Url.Action("SaveNoteAjax", "Accounts")', { // Ensure Account Controller has this
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                saveBtn.innerHTML = origText;
                saveBtn.disabled = false;

                if (data.success) {
                    const note = data.note;
                    let titleHtml = note.noteTitle ? `<div class="fw-bold mb-1" style="font-size: 0.95rem; color: #431407;">${note.noteTitle}</div>` : '';
                    let fileHtml = note.attachmentFileName ? `
                    <div class="mt-2">
                        <a href="@Url.Action("DownloadNoteAttachment", "Accounts")?fileName=${encodeURIComponent(note.attachmentFileName)}" target="_blank" class="text-decoration-none fw-semibold shadow-sm" style="font-size: 0.75rem; color: #ffffff; background: var(--theme-navy-primary); padding: 4px 10px; border-radius: 4px; display: inline-flex; align-items: center;">
                            <i class="fa-solid fa-paperclip me-2"></i> ${note.attachmentFileName}
                        </a>
                    </div>` : '';

                    const mainNoteHtml = `
                    <div class="p-3 mb-3 rounded shadow-sm" style="border-left: 4px solid var(--theme-navy-primary); background: #ffffff; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-1" style="border-bottom: 1px solid #e2e8f0;">
                            <span class="fw-bold text-dark" style="font-size: 0.85rem;">
                                <i class="fa-solid fa-circle-user me-1 text-muted"></i> ${note.ownerName}
                            </span>
                            <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">${note.createdDateTime}</span>
                        </div>
                        ${titleHtml}
                        <div style="font-size: 0.85rem; color: #475569; white-space: pre-wrap; line-height: 1.4;">${note.description}</div>
                        ${fileHtml}
                    </div>`;

                    const mainContainer = document.getElementById('notesContainer');
                    if (mainContainer) mainContainer.insertAdjacentHTML('afterbegin', mainNoteHtml);

                    clearInlineNote();
                } else {
                    alert("Failed to save note: " + data.message);
                }
            })
            .catch(err => {
                saveBtn.innerHTML = origText;
                saveBtn.disabled = false;
                console.error('Note Save Error:', err);
                alert("An error occurred while saving the note.");
            });
    }

        // ==========================================
        // 2. SAFE TASK MODAL LAUNCHER (Fixes Freeze)
        // ==========================================
               function openTaskModal() {
            const modalEl = document.getElementById('quickTaskModal');
            if (modalEl) {
                // 1. Move modal to the body root to prevent CSS z-index trapping (Fixes the freeze)
                document.body.appendChild(modalEl);

                // 2. Default the Task Owner to the current logged in user
                const ownerDropdown = document.getElementById('taskOwnerDropdown');
                if(ownerDropdown) ownerDropdown.value = '@currentUserId';

                // 3. Open safely via JavaScript
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        // ==========================================
        // 3. AUTO-CALCULATE PROFILE RATE & STATUS
        // ==========================================
        const profileFields = [
            'IsHomeopathicDoctor', 'WorkType', 'HasComputer', 'ClinicType',
            'Qualification', 'CollegeName', 'YearOfPassing', 'TotalExperience',
            'YearsOfPractice', 'AveragePatientFee', 'NumberOfClinics',
            'DateOfBirth', 'Age', 'PatientsPerDay'
        ];

        function calculateProfileMetrics() {
            let filledFieldsCount = 0;

            profileFields.forEach(id => {
                const el = document.getElementById(id);
                if (el && el.value.trim() !== '') {
                    filledFieldsCount++;
                }
            });

            const isHomeopath = document.getElementById('IsHomeopathicDoctor')?.value || '';
            const hasComputer = document.getElementById('HasComputer')?.value || '';

            const isHomeopathNo = (isHomeopath === 'No' || isHomeopath === 'नहीं' || isHomeopath === 'Not a Homeopath Doctor' || isHomeopath === 'Not a Homeopathy Doctor');
            const hasComputerNo = (hasComputer === 'No');

            let calculatedStatus = "Not Completed";

            if (filledFieldsCount > 4 && !hasComputerNo && !isHomeopathNo) {
                calculatedStatus = "Strongly Completed";
            }
            else if (filledFieldsCount === 4 && !hasComputerNo && !isHomeopathNo) {
                calculatedStatus = "Completed";
            }
            else if (filledFieldsCount >= 4 && (hasComputerNo || isHomeopathNo)) {
                calculatedStatus = "Not-Qualified";
            }

            const statusField = document.getElementById('Profilestatus');
