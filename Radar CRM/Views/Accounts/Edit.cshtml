<!-- Bootstrap JS bundle required for Tab switching & Modals -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // ==========================================
    // 1. NOTES POP-UP LOGIC
    // ==========================================

    function openNoteModal() {
    const now = new Date();
    document.getElementById('modalNoteDateTime').value = now.toLocaleString();

    document.getElementById('modalNoteFile').value = '';
    document.getElementById('modalNoteDesc').value = '';

    const modal = new bootstrap.Modal(document.getElementById('noteModal'));
    modal.show();
    }

    function saveNote() {
    const ownerDropdown = document.getElementById('modalNoteOwner');
    const ownerId = ownerDropdown.value;
    const ownerName = ownerDropdown.options[ownerDropdown.selectedIndex].text;
    const dateTime = document.getElementById('modalNoteDateTime').value;
    const desc = document.getElementById('modalNoteDesc').value;
    const fileInput = document.getElementById('modalNoteFile');
    const fileName = fileInput.files.length > 0 ? fileInput.files[0].name : '';

    if (!desc.trim() && !fileName) {
    alert('Please enter a description or attach a file.');
    return;
    }

    let fileHtml = fileName ? `<div class="mt-2 text-primary" style="font-size: 0.85rem;"><i class="fa-solid fa-paperclip me-2"></i>${fileName}</div>` : '';

    const noteHtml = `
    <div class="saved-note-card p-3 mb-3 shadow-sm" style="border: 1px solid #e5e7eb; border-left: 4px solid #1a56db; border-radius: 8px; background: #fff;">
    <div class="d-flex justify-content-between align-items-center mb-2">
    <span class="fw-bold" style="font-size: 0.9rem; color: #111827;">
    <i class="fa-solid fa-circle-user text-muted me-2"></i>${ownerName}
    </span>
    <span class="text-muted" style="font-size: 0.8rem;">
    <i class="fa-regular fa-clock me-1"></i> ${dateTime}
    </span>
    </div>
    <div style="font-size: 0.9rem; color: #374151; white-space: pre-wrap;">${desc}</div>
    ${fileHtml}

    <input type="hidden" name="SavedNoteOwner[]" value="${ownerId}" />
    <input type="hidden" name="SavedNoteDateTime[]" value="${dateTime}" />
    <input type="hidden" name="SavedNoteDesc[]" value="${desc}" />
    </div>
    `;

    document.getElementById('savedNotesContainer').insertAdjacentHTML('beforeend', noteHtml);

    const modalEl = document.getElementById('noteModal');
    const modalInstance = bootstrap.Modal.getInstance(modalEl);
    modalInstance.hide();
    }

    // ==========================================
    // AUTO-CALCULATE PROFILE RATE & STATUS
    // ==========================================
    const profileFields = [
    'IsHomeopathicDoctor', 'WorkType', 'HasComputer', 'ClinicType',
    'Qualification', 'CollegeName', 'YearOfPassing', 'TotalExperience',
    'YearsOfPractice', 'AveragePatientFee', 'NumberOfClinics',
    'DateOfBirth', 'Age', 'PatientsPerDay'
    ];

    function calculateProfileMetrics() {
    let filledFieldsCount = 0;

    profileFields.forEach(id => {
    const el = document.getElementById(id);
    if (el && el.value.trim() !== '') {
    filledFieldsCount++;
    }
    });

    const isHomeopath = document.getElementById('IsHomeopathicDoctor')?.value || '';
    const hasComputer = document.getElementById('HasComputer')?.value || '';

    const isHomeopathNo = (isHomeopath === 'No' || isHomeopath === 'नहीं' || isHomeopath === 'Not a Homeopath Doctor' || isHomeopath === 'Not a Homeopathy Doctor');
    const hasComputerNo = (hasComputer === 'No');

    let calculatedStatus = "Not Completed";

    if (filledFieldsCount > 4 && !hasComputerNo && !isHomeopathNo) {
    calculatedStatus = "Strongly Completed";
    }
    else if (filledFieldsCount === 4 && !hasComputerNo && !isHomeopathNo) {
    calculatedStatus = "Completed";
    }
    else if (filledFieldsCount >= 4 && (hasComputerNo || isHomeopathNo)) {
    calculatedStatus = "Not-Qualified";
    }

    const statusField = document.getElementById('Profilestatus');
    const rateField = document.getElementById('ProfileRate');

    if (statusField) statusField.value = calculatedStatus;
    if (rateField) rateField.value = filledFieldsCount;
    }

    profileFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
    el.addEventListener('change', calculateProfileMetrics);
    if (el.tagName === 'INPUT') {
    el.addEventListener('input', calculateProfileMetrics);
    }
    }
    });

    // ==========================================
    // 2. EXISTING PAGE LOGIC
    // ==========================================

    function toggleDataSourceFields() {
    const dsElement = document.getElementById('DataSource');
    if (!dsElement) return;

    const val = dsElement.value;
    const divMeta = document.getElementById('divMetaCampaign');
    const divSeminar = document.getElementById('divSeminarName');

    if (divMeta) divMeta.style.display = (val === 'Meta Ads') ? 'block' : 'none';
    if (divSeminar) divSeminar.style.display = (val === 'Seminar Conference') ? 'block' : 'none';
    }

    const dataSourceEl = document.getElementById('DataSource');
    if (dataSourceEl) {
    dataSourceEl.addEventListener('change', toggleDataSourceFields);
    }

    function verifyPhone(fieldId) {
    const phone = document.getElementById(fieldId).value.trim();
    const mainMobile = document.getElementById('MobileNumber')?.value.trim() || '';
    const altMobile = document.getElementById('AlternateMobile')?.value.trim() || '';

    if (!phone) {
    alert('Please enter a phone number first before verifying.');
    return;
    }

    if (mainMobile && altMobile && mainMobile === altMobile) {
    alert('❌ Mobile Number and Alternate Mobile cannot be the exact same!');
    return;
    }

    fetch('/Accounts/CheckDuplicatePhone?phone=' + encodeURIComponent(phone))
    .then(response => response.json())
    .then(data => {
    if (data.isDuplicate) {
    alert('⚠️ WARNING: This phone number already exists in another account record!');
    } else {
    alert('✅ This number is valid and unique in the system.');
    }
    })
    .catch(error => {
    console.error("Error verifying phone:", error);
    alert("Could not connect to the database to verify.");
    });
    }

    let globalRegionData = [];

    document.addEventListener("DOMContentLoaded", async function () {
    toggleDataSourceFields();

    try {
    const response = await fetch('https://countriesnow.space/api/v0.1/countries/states');
    const result = await response.json();

    if (!result.error) {
    globalRegionData = result.data;
    populateCountryDropdown();
    }
    } catch (error) {
    console.error("Failed to load country data from API:", error);
    }
    });

    function populateCountryDropdown() {
    const country1 = document.getElementById('Addr1_Country');
    const country2 = document.getElementById('Addr2_Country');

    const existingCountry1 = '@(Model?.Addr1_Country ?? "")';
    const existingCountry2 = '@(Model?.Addr2_Country ?? "")';

    if (country1) country1.innerHTML = '<option value="">-None-</option>';
    if (country2) country2.innerHTML = '<option value="">-None-</option>';

    globalRegionData.forEach(countryObj => {
    if (country1) {
    const opt1 = document.createElement('option');
    opt1.value = countryObj.name;
    opt1.textContent = countryObj.name;
    if (countryObj.name === existingCountry1) opt1.selected = true;
    country1.appendChild(opt1);
    }

    if (country2) {
    const opt2 = document.createElement('option');
    opt2.value = countryObj.name;
    opt2.textContent = countryObj.name;
    if (countryObj.name === existingCountry2) opt2.selected = true;
    country2.appendChild(opt2);
    }
    });

    if (existingCountry1) updateStateDropdown(existingCountry1, '@(Model?.Addr1_State ?? "")', 'Addr1_State');
    if (existingCountry2) updateStateDropdown(existingCountry2, '@(Model?.Addr2_State ?? "")', 'Addr2_State');
    }

    function updateStateDropdown(countryName, existingState, targetDropdownId) {
    const stateDropdown = document.getElementById(targetDropdownId);
    if (!stateDropdown) return;

    stateDropdown.innerHTML = '<option value="">-None-</option>';

    if (!countryName) return;

    const countryObj = globalRegionData.find(c => c.name === countryName);

    if (countryObj && countryObj.states) {
    countryObj.states.forEach(state => {
    const opt = document.createElement('option');
    opt.value = state.name;
    opt.textContent = state.name;

    if (state.name === existingState) {
    opt.selected = true;
    }

    stateDropdown.appendChild(opt);
    });
    }
    }

    const c1 = document.getElementById('Addr1_Country');
    if (c1) {
    c1.addEventListener('change', function() {
    updateStateDropdown(this.value, "", 'Addr1_State');
    });
    }

    const c2 = document.getElementById('Addr2_Country');
    if (c2) {
    c2.addEventListener('change', function() {
    updateStateDropdown(this.value, "", 'Addr2_State');
    });
    }

    const accountForm = document.getElementById('accountForm');
    if (accountForm) {
    accountForm.addEventListener('submit', function (e) {
    function getFieldValue(fieldName) {
    const el = document.getElementById(fieldName) || document.querySelector(`[name="${fieldName}"]`);
    return el ? el.value.trim() : "";
    }

    const q1 = getFieldValue('IsHomeopathicDoctor');
    const q2 = getFieldValue('WorkType');
    const q3 = getFieldValue('ClinicType');
    const q4 = getFieldValue('HasComputer');
    const reasonValue = getFieldValue('ProfilePendingReason');

    const isProfileIncomplete = (
    q1 === "" || q1 === "-None-" || q1 === "false" ||
    q2 === "" || q2 === "-None-" || q2 === "false" ||
    q3 === "" || q3 === "-None-" || q3 === "false" ||
    q4 === "" || q4 === "-None-" || q4 === "false"
    );

    if (isProfileIncomplete && (reasonValue === "" || reasonValue === "-None-")) {
    e.preventDefault();

    const modalEl = document.getElementById('pendingReasonModal');
    if (modalEl) {
    const myModal = new bootstrap.Modal(modalEl);
    myModal.show();
    } else {
    alert("Your profile is incomplete! Please select a Profile Pending Reason.");
    }

    const mainTab = document.getElementById('main-tab');
    if (mainTab) {
    new bootstrap.Tab(mainTab).show();
    }

    const reasonField = document.getElementById('ProfilePendingReason') || document.querySelector('[name="ProfilePendingReason"]');
    if (reasonField) {
    reasonField.focus();
    reasonField.style.boxShadow = "0 0 0 3px #ef4444";
    setTimeout(() => reasonField.style.boxShadow = "none", 3500);
    }
    }
    });
    }

    function openAccountLookup() {
    alert("Lookup UI would open here!");
    }

    function toggleMoreFields() {
    const container = document.getElementById("moreFieldsContainer");
    const btn = document.getElementById("moreFieldsToggle");

    if (container.style.display === "none") {
    container.style.display = "block";
    btn.classList.add("expanded");
    } else {
    container.style.display = "none";
    btn.classList.remove("expanded");
    }
    }
</script>