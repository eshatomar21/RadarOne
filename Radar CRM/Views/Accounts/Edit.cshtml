<div id="detailOpenTasksSection" class="detail-section-card overflow-hidden">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-0">
        <h6 class="fw-bold m-0" style="color: var(--theme-navy-primary);">Open Task</h6>
    </div>

    <div class="table-responsive-wrapper">
        @if (openTasks.Any())
