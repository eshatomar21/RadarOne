<!-- Bootstrap JS bundle required for Tab switching & Modals -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
     

        function clearInlineNote() {
        const titleInput = document.getElementById('inlineNoteTitle');
        const descInput = document.getElementById('inlineNoteDesc');
        const fileInput = document.getElementById('inlineNoteFile');
        if (titleInput) titleInput.value = '';
        if (descInput) descInput.value = '';
        if (fileInput) fileInput.value = '';
    }

       function saveInlineNote() {
        const titleEl = document.getElementById('inlineNoteTitle');
        const descEl = document.getElementById('inlineNoteDesc');
        const fileInput = document.getElementById('inlineNoteFile');
        const ownerDropdown = document.getElementById('inlineNoteOwner');

        const title = titleEl ? titleEl.value.trim() : '';
        const desc = descEl ? descEl.value.trim() : '';
        const ownerId = ownerDropdown ? ownerDropdown.value : '';
        const ownerName = ownerDropdown && ownerDropdown.selectedIndex > -1 ? ownerDropdown.options[ownerDropdown.selectedIndex].text : 'System User';
        const dateTime = new Date().toLocaleString();

        if (!desc && (!fileInput || fileInput.files.length === 0) && !title) {
            alert('Please enter a title, content, or attach a file.');
            return;
        }

        const formData = new FormData();
        formData.append('accountId', '@Model.Id'); // Make sure your controller expects accountId
        formData.append('noteTitle', title);
        formData.append('description', desc);
        formData.append('ownerId', ownerId);

        if (fileInput && fileInput.files.length > 0) {
            formData.append('attachment', fileInput.files[0]);
        }

        const saveBtn = document.querySelector('button[onclick="saveInlineNote()"]');
        const origText = saveBtn.innerHTML;
        saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        saveBtn.disabled = true;

        fetch('@Url.Action("SaveNoteAjax", "Accounts")', { // Ensure Account Controller has this
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                saveBtn.innerHTML = origText;
                saveBtn.disabled = false;

                if (data.success) {
                    const note = data.note;
                    let titleHtml = note.noteTitle ? `<div class="fw-bold mb-1" style="font-size: 0.95rem; color: #431407;">${note.noteTitle}</div>` : '';
                    let fileHtml = note.attachmentFileName ? `
                    <div class="mt-2">
                        <a href="@Url.Action("DownloadNoteAttachment", "Accounts")?fileName=${encodeURIComponent(note.attachmentFileName)}" target="_blank" class="text-decoration-none fw-semibold shadow-sm" style="font-size: 0.75rem; color: #ffffff; background: var(--theme-navy-primary); padding: 4px 10px; border-radius: 4px; display: inline-flex; align-items: center;">
                            <i class="fa-solid fa-paperclip me-2"></i> ${note.attachmentFileName}
                        </a>
                    </div>` : '';

                    const mainNoteHtml = `
                    <div class="p-3 mb-3 rounded shadow-sm" style="border-left: 4px solid var(--theme-navy-primary); background: #ffffff; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-1" style="border-bottom: 1px solid #e2e8f0;">
                            <span class="fw-bold text-dark" style="font-size: 0.85rem;">
                                <i class="fa-solid fa-circle-user me-1 text-muted"></i> ${note.ownerName}
                            </span>
                            <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">${note.createdDateTime}</span>
                        </div>
                        ${titleHtml}
                        <div style="font-size: 0.85rem; color: #475569; white-space: pre-wrap; line-height: 1.4;">${note.description}</div>
                        ${fileHtml}
                    </div>`;

                    const mainContainer = document.getElementById('notesContainer');
                    if (mainContainer) mainContainer.insertAdjacentHTML('afterbegin', mainNoteHtml);

                    clearInlineNote();
                } else {
                    alert("Failed to save note: " + data.message);
                }
            })
            .catch(err => {
                saveBtn.innerHTML = origText;
                saveBtn.disabled = false;
                console.error('Note Save Error:', err);
                alert("An error occurred while saving the note.");
            });
    }

        // ==========================================
        // 2. SAFE TASK MODAL LAUNCHER (Fixes Freeze)
        // ==========================================
               function openTaskModal() {
            const modalEl = document.getElementById('quickTaskModal');
            if (modalEl) {
                // 1. Move modal to the body root to prevent CSS z-index trapping (Fixes the freeze)
                document.body.appendChild(modalEl);

                // 2. Default the Task Owner to the current logged in user
                const ownerDropdown = document.getElementById('taskOwnerDropdown');
                if(ownerDropdown) ownerDropdown.value = '@currentUserId';

                // 3. Open safely via JavaScript
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        // ==========================================
        // 3. AUTO-CALCULATE PROFILE RATE & STATUS
        // ==========================================
        const profileFields = [
            'IsHomeopathicDoctor', 'WorkType', 'HasComputer', 'ClinicType',
            'Qualification', 'CollegeName', 'YearOfPassing', 'TotalExperience',
            'YearsOfPractice', 'AveragePatientFee', 'NumberOfClinics',
            'DateOfBirth', 'Age', 'PatientsPerDay'
        ];

        function calculateProfileMetrics() {
            let filledFieldsCount = 0;

            profileFields.forEach(id => {
                const el = document.getElementById(id);
                if (el && el.value.trim() !== '') {
                    filledFieldsCount++;
                }
            });

            const isHomeopath = document.getElementById('IsHomeopathicDoctor')?.value || '';
            const hasComputer = document.getElementById('HasComputer')?.value || '';

            const isHomeopathNo = (isHomeopath === 'No' || isHomeopath === 'नहीं' || isHomeopath === 'Not a Homeopath Doctor' || isHomeopath === 'Not a Homeopathy Doctor');
            const hasComputerNo = (hasComputer === 'No');

            let calculatedStatus = "Not Completed";

            if (filledFieldsCount > 4 && !hasComputerNo && !isHomeopathNo) {
                calculatedStatus = "Strongly Completed";
            }
            else if (filledFieldsCount === 4 && !hasComputerNo && !isHomeopathNo) {
                calculatedStatus = "Completed";
            }
            else if (filledFieldsCount >= 4 && (hasComputerNo || isHomeopathNo)) {
                calculatedStatus = "Not-Qualified";
            }

            const statusField = document.getElementById('Profilestatus');
            const rateField = document.getElementById('ProfileRate');

            if (statusField) statusField.value = calculatedStatus;
            if (rateField) rateField.value = filledFieldsCount;
        }

        profileFields.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('change', calculateProfileMetrics);
                if (el.tagName === 'INPUT') {
                    el.addEventListener('input', calculateProfileMetrics);
                }
            }
        });

        // Function to Expand/Collapse Form Fields
        function toggleFormFields() {
            const wrapper = document.getElementById("formFieldsWrapper");
            const icon = document.getElementById("formCollapseIcon");
            if (wrapper.style.display === "none") {
                wrapper.style.display = "block";
                icon.style.transform = "rotate(180deg)";
            } else {
                wrapper.style.display = "none";
                icon.style.transform = "rotate(0deg)";
            }
        }

        // ==========================================
        // 4. TOGGLE GROUP NAME BASED ON ACCOUNT TYPE
        // ==========================================
        function toggleAccountTypeFields() {
            const accountTypeSelect = document.getElementById('AccountType');
            const divGroupName = document.getElementById('divGroupName');

            if (accountTypeSelect && divGroupName) {
                // Show only if 'Group' is selected, otherwise hide
                if (accountTypeSelect.value === 'Group') {
                    divGroupName.style.display = 'block';
                } else {
                    divGroupName.style.display = 'none';

                    // Optional: Automatically clear the Group Name selection if they change the type away from Group
                    const groupNameInput = document.getElementById('GroupName');
                    if(groupNameInput) groupNameInput.value = '';
                }
            }
        }

        // Attach the event listener to the dropdown
        const accountTypeEl = document.getElementById('AccountType');
        if (accountTypeEl) {
            accountTypeEl.addEventListener('change', toggleAccountTypeFields);

            // Run once on page load to ensure the correct visibility when editing an existing record
            document.addEventListener("DOMContentLoaded", toggleAccountTypeFields);
        }

        // ==========================================
        // 5. EXISTING PAGE LOGIC & VERIFICATION
        // ==========================================

        function toggleDataSourceFields() {
            const dsElement = document.getElementById('DataSource');
            if (!dsElement) return;

            const val = dsElement.value;
            const divMeta = document.getElementById('divMetaCampaign');
            const divSeminar = document.getElementById('divSeminarName');

            if (divMeta) divMeta.style.display = (val === 'Meta Ads') ? 'block' : 'none';
            if (divSeminar) divSeminar.style.display = (val === 'Seminar Conference') ? 'block' : 'none';
        }

        const dataSourceEl = document.getElementById('DataSource');
        if (dataSourceEl) {
            dataSourceEl.addEventListener('change', toggleDataSourceFields);
        }

        let globalRegionData = [];

        // ==========================================
        // 6. DYNAMIC CASCADING ADDRESS DROPDOWNS
        // ==========================================
        document.addEventListener("DOMContentLoaded", function () {

            // Read existing values from the model if editing a saved account
            const existingCountry1 = '@Html.Raw(Model?.Addr1_Country ?? "")';
            const existingCountry2 = '@Html.Raw(Model?.Addr2_Country ?? "")';
            const existingState1 = '@Html.Raw(Model?.Addr1_State ?? "")';
            const existingState2 = '@Html.Raw(Model?.Addr2_State ?? "")';
            const existingCity1 = '@Html.Raw(Model?.Addr1_City ?? "")';
            const existingCity2 = '@Html.Raw(Model?.Addr2_City ?? "")';
            const existingZip1 = '@Html.Raw(Model?.Addr1_Zip ?? "")';
            const existingZip2 = '@Html.Raw(Model?.Addr2_Zip ?? "")';

            // 1. Fetch Countries on page load
            fetch('@Url.Action("GetCountries", "Postcode")')
            .then(res => {
                if (!res.ok) throw new Error("Server returned status: " + res.status);
                return res.json();
            })
            .then(countries => {
                populateDropdown('Addr1_Country', countries, 'Select Country', existingCountry1);
                populateDropdown('Addr2_Country', countries, 'Select Country', existingCountry2);

                // Trigger the cascade automatically if editing a saved record
                if (existingCountry1) triggerChange('Addr1_Country');
                if (existingCountry2) triggerChange('Addr2_Country');
            })
            .catch(err => console.error("Error loading countries:", err));

            // 2. Initialize Cascading Logic for both addresses
            setupCascadingDropdowns('Addr1_Country', 'Addr1_State', 'Addr1_City', 'Addr1_Zip', existingState1, existingCity1, existingZip1);
            setupCascadingDropdowns('Addr2_Country', 'Addr2_State', 'Addr2_City', 'Addr2_Zip', existingState2, existingCity2, existingZip2);
        });

        // Helper function to build dropdown options and pre-select if editing
        function populateDropdown(dropdownId, dataList, defaultText, selectedValue = "") {
            const dropdown = document.getElementById(dropdownId);
            if (!dropdown) return;

            dropdown.innerHTML = '<option value="">- ' + defaultText + ' -</option>';
            dataList.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item;
                opt.textContent = item;
                if (item === selectedValue) {
                    opt.selected = true;
                }
                dropdown.appendChild(opt);
            });
        }

        // Helper to manually trigger a change event programmatically
        function triggerChange(elementId) {
            const el = document.getElementById(elementId);
            if (el) el.dispatchEvent(new Event('change'));
        }

        // Master function to handle the Country -> State -> City -> Zip flow
        function setupCascadingDropdowns(countryId, stateId, cityId, zipId, defaultState = "", defaultCity = "", defaultZip = "") {
            const countryEl = document.getElementById(countryId);
            const stateEl = document.getElementById(stateId);
            const cityEl = document.getElementById(cityId);
            const zipEl = document.getElementById(zipId);

            // Country Change -> Load States
            if (countryEl) {
                countryEl.addEventListener('change', function () {
                    const country = this.value;
                    if (stateEl) stateEl.innerHTML = '<option value="">- Select State -</option>';
                    if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (country) {
                        fetch('@Url.Action("GetStates", "Postcode")?country=' + encodeURIComponent(country))
                        .then(res => res.json())
                        .then(states => {
                            populateDropdown(stateId, states, 'Select State', defaultState);
                            if (defaultState) {
                                triggerChange(stateId);
                                defaultState = ""; // clear after first load
                            }
                        })
                        .catch(err => console.error("Error fetching States:", err));
                    }
                });
            }

            // State Change -> Load Cities
            if (stateEl) {
                stateEl.addEventListener('change', function () {
                    const state = this.value;
                    if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (state) {
                        fetch('@Url.Action("GetCities", "Postcode")?state=' + encodeURIComponent(state))
                        .then(res => res.json())
                        .then(cities => {
                            populateDropdown(cityId, cities, 'Select City', defaultCity);
                            if (defaultCity) {
                                triggerChange(cityId);
                                defaultCity = ""; // clear after first load
                            }
                        })
                        .catch(err => console.error("Error fetching Cities:", err));
                    }
                });
            }

            // City Change -> Fetch and Populate Zip Code Dropdown
            if (cityEl) {
                cityEl.addEventListener('change', function () {
                    const city = this.value;
                    const state = stateEl ? stateEl.value : '';

                    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                    if (city && state) {
                        fetch('@Url.Action("GetZipCodes", "Postcode")?city=' + encodeURIComponent(city) + '&state=' + encodeURIComponent(state))
                        .then(res => res.json())
                        .then(zipCodes => {
