<div class="offcanvas offcanvas-end" tabindex="-1" id="globalTimelinePanel" style="width: 450px; border-left: 1px solid #e2e8f0; box-shadow: -10px 0 30px rgba(0,0,0,0.05);">
    <div class="offcanvas-header bg-white border-bottom" style="padding: 20px 24px;">
        <h5 class="offcanvas-title fw-bold d-flex align-items-center m-0" style="font-size: 1.15rem; color: #0f172a;">
            <i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i> <span id="timelineEntityTitle">Timeline History</span>
        </h5>
        <button type="button" class="btn-close text-reset shadow-none" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body" style="background-color: #f8fafc; padding: 24px;">
        <!-- Timeline Stream Container -->
        <div class="position-relative ms-2 ps-4" id="universalTimelineList" style="border-left: 2px solid #cbd5e1;">
            <!-- Dynamically populated via JavaScript -->
        </div>
    </div>
</div>

<!-- MUST INCLUDE SWEETALERT -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>

    async function openUniversalTimeline(entityType, entityId, entityName) {
        const titleEl = document.getElementById('timelineEntityTitle');
        const list = document.getElementById('universalTimelineList');

        if (titleEl) titleEl.innerText = `${entityType} Timeline: ${entityName}`;
        if (list) list.innerHTML = '<div class="text-center mt-4 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Loading history...</div>';

        // Show the offcanvas panel
        const panelEl = document.getElementById('globalTimelinePanel');
        if (panelEl.parentNode !== document.body) document.body.appendChild(panelEl);

        let bsOffcanvas = bootstrap.Offcanvas.getInstance(panelEl) || new bootstrap.Offcanvas(panelEl);
        bsOffcanvas.show();

        try {
            // 🚀 CRITICAL FIX: Use Url.Content to safely resolve IIS virtual directories on the live server
            const baseUrl = '@Url.Content("~/api/timeline/")';
            const response = await fetch(`${baseUrl}${entityType}/${entityId}`);

            if (!response.ok) throw new Error("Failed to fetch timeline");

            const events = await response.json();

            if (events && events.length > 0) {
                let html = '';
                events.forEach(ev => {
                    html += `
                        <div class="position-relative mb-4">
                            <!-- Timeline Dot Icon -->
                            <div class="position-absolute d-flex align-items-center justify-content-center bg-white shadow-sm" style="left: -33px; top: 0px; width: 18px; height: 18px; border: 2px solid #2563eb; border-radius: 50%; z-index: 2; font-size: 0.55rem; color: #2563eb;">
                                <i class="fa-solid fa-pen"></i>
                            </div>

