// =====================================
// QUICK INFO AUTO-SAVE FOR ACCOUNTS
// =====================================
function updateQuickField(fieldName, fieldValue) {
        // 1. Sync data to the main hidden edit form
        const editFormInput = document.getElementById(fieldName) || document.querySelector(`[name="${fieldName}"]`);
        if (editFormInput) {
            editFormInput.value = fieldValue;
            editFormInput.dispatchEvent(new Event('change')); 
        }

        // 2. Format data for the Controller [FromForm] attributes
        const formData = new URLSearchParams();
        formData.append('id', '@Model.Id');
        formData.append('field', fieldName);
        formData.append('newValue', fieldValue); 

        // 3. Send to Database
        fetch('/Accounts/UpdateQuickInfo', { 
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
        .then(response => {
            if (!response.ok) {
                alert("Failed to automatically update " + fieldName + " in the database.");
            } else {
                console.log("Successfully saved " + fieldName);
            }
        })
        .catch(err => {
            console.error('Error updating quick info:', err);
        });
    }

    // =====================================
    // AJAX TASK SUBMISSION & STATUS UPDATE
    // =====================================
    function updateTaskStatus(selectElem, taskId) {
        const newStatus = selectElem.value;
        const row = selectElem.closest('tr');

        selectElem.disabled = true; // Lock dropdown while saving

        const formData = new URLSearchParams();
        formData.append('id', taskId);
        formData.append('status', newStatus);

        const targetUrl = '/Tasks/UpdateStatus';

        fetch(targetUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
            .then(response => {
                selectElem.disabled = false;
                if (response.ok) {
                    if (newStatus === 'Completed') {
                        moveTaskToClosed(row);
                    }
                } else {
                    alert('Failed to update task status in DB.');
                    selectElem.value = 'Not Started';
                }
            })
            .catch(err => {
                selectElem.disabled = false;
                console.error('Error updating task:', err);
            });
    }

    // Move row from Open Activities to Closed Activities visually
    function moveTaskToClosed(row) {
        const subject = row.cells[0].innerText;
        const dueDate = row.cells[1].innerText;

        const newRow = document.createElement('tr');
        
        // Formats row exactly like the existing closed tasks list[cite: 8]
        newRow.innerHTML = `
                <td class="text-secondary text-decoration-line-through">${subject}</td>
                <td>${dueDate}</td>
                <td class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i> Completed</td>
            `;

        let closedSection = document.getElementById('detailClosedTasksSection');
        let closedTbody = closedSection.querySelector('tbody');
        const emptyPlaceholder = document.getElementById('emptyClosedTasksPlaceholder');

        // Remove empty state placeholder if it exists
        if (emptyPlaceholder) {
            emptyPlaceholder.remove();
        }

        // If table doesn't exist yet, create it
        if (!closedTbody) {
            closedSection.innerHTML = `
                    <h6 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--theme-navy-primary);">Closed Activities</h6>
                    <table class="zoho-task-table" id="closedTasksTable">
                        <thead><tr><th>Subject</th><th>Due Date</th><th>Status</th></tr></thead>
                        <tbody></tbody>
                    </table>
                `;
            closedTbody = closedSection.querySelector('tbody');
        }

        // Inject into top of closed list
        closedTbody.insertBefore(newRow, closedTbody.firstChild);
        row.remove(); // Remove from open list

        // Update Next action & Empty placeholder if open table becomes empty
        const openTbody = document.getElementById('openTasksTbody');
        if (openTbody && openTbody.children.length === 0) {
            document.getElementById('nextActionDisplay').innerText = "No upcoming actions scheduled.";
            
            const openTasksTable = openTbody.closest('table');
            if (openTasksTable) {
                openTasksTable.outerHTML = '<div class="text-center text-muted py-4" id="emptyOpenTasksPlaceholder"><i class="fa-regular fa-folder-open mb-2 fs-4"></i><br />No open activities</div>';
            }
        } else if (openTbody && openTbody.children.length > 0) {
            const nextRow = openTbody.children[0];
            document.getElementById('nextActionDisplay').innerText = `${nextRow.cells[0].innerText} - Due: ${nextRow.cells[1].innerText}`;
        }
    }
