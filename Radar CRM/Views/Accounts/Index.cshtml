@model IEnumerable<Radar_CRM.Models.Account>

@{
    ViewData["Title"] = "Accounts Master";

    // --- NEW: Catch pagination & state values from Controller ---
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    string currentSearch = Context.Request.Query["search"];
    string currentSortCol = Context.Request.Query["sortCol"];
    string currentSortDir = Context.Request.Query["sortDir"];

    // EXCLUSION LIST: Removed ZohoRecordId, AccountOwnerId, and CoOwnerId as requested
    var excludedFields = new[] { "ZohoRecordId", "AccountOwnerId", "CoOwnerId" };

    // Using reflection to get table properties dynamically, excluding the specified fields
    var tableProps = Model != null && Model.Any() ?
        Model.First().GetType().GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance)
        .Where(p => !excludedFields.Contains(p.Name))
        .ToArray() : Array.Empty<System.Reflection.PropertyInfo>();
}

<style>
    /* Premium Enterprise SaaS Theme */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --bg-body: #f8fafc;
        --bg-surface: #ffffff;
        --primary-blue: #2563eb;
        --primary-hover: #1d4ed8;
        --text-dark: #0f172a;
        --text-main: #334155;
        --text-muted: #64748b;
        --border-soft: #e2e8f0;
        --radius-md: 8px;
        --radius-lg: 12px;
        --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
        --btn-depth: 2px;
    }

    body {
        background-color: var(--bg-body);
        color: var(--text-main);
        font-family: 'Inter', -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    /* Top Page Header */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        background: var(--bg-surface);
        padding: 20px 28px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-soft);
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        font-weight: 700;
        font-size: 1.4rem;
        color: var(--text-dark);
        letter-spacing: -0.02em;
    }

        .page-title i {
            color: var(--primary-blue);
        }

    /* Action Buttons (3D SaaS Style) */
    .btn-saas {
        background-color: var(--bg-surface);
        color: var(--text-dark);
        border: 1px solid #cbd5e1;
        font-weight: 500;
        border-radius: var(--radius-md);
        padding: 8px 16px;
        font-size: 0.85rem;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        box-shadow: 0 var(--btn-depth) 0 #e2e8f0, 0 2px 4px rgba(0,0,0,0.02);
        transform: translateY(0);
    }

        .btn-saas:active {
            transform: translateY(var(--btn-depth));
            box-shadow: 0 0 0 #e2e8f0, 0 1px 2px rgba(0,0,0,0.05);
        }

    .btn-saas-primary {
        background-color: var(--primary-blue);
        color: white;
        font-weight: 600;
        border: 1px solid var(--primary-hover);
        border-radius: var(--radius-md);
        padding: 8px 20px;
        font-size: 0.85rem;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 var(--btn-depth) 0 var(--primary-hover), 0 4px 6px rgba(37,99,235,0.2);
    }

        .btn-saas-primary:hover {
            color: white;
            background-color: var(--primary-hover);
        }

        .btn-saas-primary:active {
            transform: translateY(var(--btn-depth));
            box-shadow: 0 0 0 var(--primary-hover), 0 1px 2px rgba(37,99,235,0.2);
        }

    .btn-saas-danger {
        background-color: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fca5a5;
        box-shadow: 0 var(--btn-depth) 0 #f87171, 0 2px 4px rgba(220,38,38,0.05);
    }

        .btn-saas-danger:active {
            transform: translateY(var(--btn-depth));
            box-shadow: 0 0 0 #f87171, 0 1px 2px rgba(220,38,38,0.1);
        }

    /* Layout Grid */
    .crm-container {
        display: flex;
        height: calc(100vh - 160px);
        gap: 24px;
        width: 100%;
        max-width: 100%;
    }

    /* Fixed Sidebar Filter */
    .filter-sidebar {
        width: 320px;
        min-width: 320px;
        background: var(--bg-surface);
        border: 1px solid var(--border-soft);
        border-radius: var(--radius-lg);
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-sm);
        height: 100%;
    }

    .filter-header {
        padding: 18px 20px;
        border-bottom: 1px solid var(--border-soft);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .filter-header h6 {
            margin: 0;
            font-weight: 600;
            font-size: 0.95rem;
        }

    .filter-search-box {
        padding: 12px 20px;
        border-bottom: 1px solid var(--border-soft);
        background-color: #f8fafc;
    }

    .filter-body {
        overflow-y: auto;
        flex-grow: 1;
        padding: 0;
    }

    .filter-field-item {
        padding: 14px 20px;
        border-bottom: 1px solid #f1f5f9;
        transition: background-color 0.2s;
    }

        .filter-field-item:hover {
            background-color: #f8fafc;
        }

    .filter-expanded-area {
        display: none;
        margin-top: 12px;
        padding-left: 28px;
    }

    .filter-field-item.active .filter-expanded-area {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Main Table Container */
    .table-container {
        flex: 1;
        min-width: 0;
        background: var(--bg-surface);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-soft);
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    /* Table Toolbar */
    .table-toolbar {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border-soft);
        display: flex;
        justify-content: flex-end;
        align-items: center;
        background-color: var(--bg-surface);
    }

    /* The Table */
    .table-responsive {
        overflow: auto;
        flex-grow: 1;
        width: 100%;
    }

    .table {
        margin-bottom: 0;
        white-space: nowrap;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            background-color: #f8fafc;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--border-soft);
            padding: 14px 16px;
        }

    /* Flex Layout for Header Content */
    .th-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        gap: 12px;
    }

    /* Funnel Icon Button */
    .header-menu-btn {
        color: var(--text-muted);
        background: transparent;
        border: 1px solid transparent;
        cursor: pointer;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

        .header-menu-btn:hover, .header-menu-btn[aria-expanded="true"] {
            background: #e2e8f0;
            color: var(--text-dark);
            border-color: #cbd5e1;
        }

    .table tbody td {
        padding: 16px;
        vertical-align: middle;
        color: var(--text-dark);
        font-size: 0.85rem;
        font-weight: 500;
        border-bottom: 1px solid #f1f5f9;
        background-color: var(--bg-surface);
    }

    .table tbody tr:hover td {
        background-color: #f8fafc;
    }

    /* Sticky Columns (Checkboxes & Actions) */
    .sticky-cb {
        position: sticky;
        left: 0;
        width: 40px;
        text-align: center;
        z-index: 11;
        border-right: 1px solid var(--border-soft) !important;
        background-color: var(--bg-surface);
    }

    .sticky-actions {
        position: sticky;
        right: 0;
        width: 100px;
        text-align: center;
        z-index: 11;
        border-left: 1px solid var(--border-soft) !important;
        background-color: var(--bg-surface);
    }

    .table thead th.sticky-cb, .table thead th.sticky-actions {
        z-index: 12;
        background-color: #f8fafc;
    }

    /* Drag and Drop Manage Columns Styles */
    .draggable-col-item {
        transition: background-color 0.2s;
    }

        .draggable-col-item.dragging {
            opacity: 0.4;
            background-color: #f1f5f9;
        }

        .draggable-col-item.over {
            border-top: 2px solid var(--primary-blue);
        }

    .drag-handle {
        cursor: grab;
        padding: 4px;
        color: #94a3b8;
    }

        .drag-handle:active {
            cursor: grabbing;
        }

    /* Badges */
    .badge-soft-success {
        background: #dcfce3;
        color: #166534;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .badge-soft-warning {
        background: #fef3c7;
        color: #92400e;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.75rem;
    }

    /* Pagination */
    .pagination-container {
        padding: 14px 24px;
        border-top: 1px solid var(--border-soft);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: var(--bg-surface);
    }

    /* Mobile Friendly Adjustments */
    @@media (max-width: 992px) {
        .crm-container {
            flex-direction: column;
            height: auto;
        }

        .filter-sidebar {
            width: 100%;
            height: 400px;
        }

        .table-container {
            height: 600px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<!-- Hidden Inputs -->
<input type="file" id="fileUploadInput" accept=".zip,.zpj,.xlsx,.csv" style="display: none;" />

<!-- Top Action Header -->
<div class="page-header">
    <h1 class="page-title"><i class="fa-solid fa-users-rectangle"></i> Accounts Master</h1>

    <div class="d-flex gap-2 align-items-center flex-wrap">
        <!-- Bulk Action Container -->
        <div id="bulkActionsContainer" style="display: none;" class="gap-2 align-items-center">
            <button class="btn-saas btn-saas-danger" onclick="deleteSelected()">
                <i class="fa-regular fa-trash-can"></i> Delete (<span id="selCount">0</span>)
            </button>
            <button class="btn-saas" data-bs-toggle="modal" data-bs-target="#massUpdateModal">
                <i class="fa-solid fa-layer-group"></i> Mass Update
            </button>
            <button class="btn-saas" onclick="alert('Task Creation Module Opened')">
                <i class="fa-solid fa-list-check"></i> Create Task
            </button>
            <div class="vr mx-2 d-none d-md-block"></div>
        </div>

        <button class="btn-saas" onclick="exportTableToCSV('Accounts_Export.csv')">
            <i class="fa-solid fa-file-csv"></i> Export
        </button>
        <button class="btn-saas" onclick="document.getElementById('fileUploadInput').click();">
            <i class="fa-solid fa-cloud-arrow-up"></i> Upload
        </button>
        <a href="@Url.Action("Create", "Accounts")" class="btn-saas-primary">
            <i class="fa-solid fa-plus"></i> Create Account
        </a>
    </div>
</div>

<!-- Main Table Container -->
<div class="crm-container">

    <!-- Fixed Sidebar Filter -->
    <div class="filter-sidebar">
        <div class="filter-header">
            <h6>
                <img src="https://cdn.shopify.com/s/files/1/0578/8198/5133/files/filter.png?v=1789023005" alt="Filter" style="width: 14px; height: 14px; margin-right: 6px; vertical-align: middle;">
                Filters
            </h6>
            <button class="btn btn-sm btn-link text-decoration-none" onclick="clearFilters()">Clear</button>
        </div>
        <div class="filter-search-box">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0 fw-medium" placeholder="Find filter..." id="sidebarSearch" onkeyup="filterSidebarItems()">
            </div>
        </div>

        <!-- ONE UNIFIED SCROLLING BODY -->
        <div class="filter-body">

            <!-- FREQUENTLY USED SECTION -->
            <div id="pinnedFilters" style="display: none; border-bottom: 2px solid #e2e8f0; background-color: #f8fafc; padding-bottom: 8px;">
                <div class="px-3 py-2 text-muted fw-bold d-flex align-items-center" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                    <img src="https://cdn.shopify.com/s/files/1/0578/8198/5133/files/star_1.png?v=1789022857" style="width: 12px; height: 12px; margin-right: 6px;" alt="Star">
                    FREQUENTLY USED
                </div>
                <div id="pinnedItemsContainer">
                    <!-- Pinned filters will be dynamically moved here -->
                </div>
            </div>

            <!-- UNPINNED LIST -->
            <div id="sidebarList">
                @foreach (var prop in tableProps)
                {
                    bool isDate = prop.PropertyType == typeof(DateTime) || prop.PropertyType == typeof(DateTime?) || prop.Name.Contains("Date");

                    <div class="filter-field-item field-item-row" data-field-type="@(isDate ? "date" : "text")">

                        <!-- OVERLAP FIX: Removed 'form-check', using clean Flexbox layout -->
                        <div class="d-flex align-items-center m-0 w-100">

                            <!-- Custom Star Image -->
                            <img src="https://cdn.shopify.com/s/files/1/0578/8198/5133/files/star_1.png?v=1789022857"
                                 class="pin-filter-btn unpinned-star flex-shrink-0"
                                 style="width: 15px; height: 15px; cursor: pointer; filter: grayscale(100%) opacity(0.3); transition: all 0.2s;"
                                 onclick="togglePinFilter(this)" title="Pin this filter" alt="Pin">

                            <input class="form-check-input field-checkbox mx-2 mt-0 flex-shrink-0" type="checkbox" value="@prop.Name" id="chk_@prop.Name" style="cursor: pointer;">

                            <label class="form-check-label flex-grow-1 fw-semibold text-dark text-truncate" for="chk_@prop.Name" style="cursor: pointer; padding-left: 2px;">
                                @prop.Name
                            </label>
                        </div>

                        <div class="filter-expanded-area">
                            @if (isDate)
                            {
                                <select class="form-select form-select-sm mb-2 text-primary border-primary condition-select fw-semibold">
                                    <option value="on" selected>On</option>
                                    <option value="before">before</option>
                                    <option value="after">after</option>
                                    <option value="not_between">not between</option>
                                    <option value="today">Today</option>
                                    <option value="tomorrow">Tomorrow</option>
                                    <option value="this_month">This Month</option>
                                    <option value="current_fq">Current FQ</option>
                                </select>
                                <input type="date" class="form-control form-control-sm condition-val date-val" />
                            }
                            else if (prop.Name == "Id")
                            {
                                <select class="form-select form-select-sm mb-2 text-primary border-primary condition-select fw-semibold">
                                    <option value="is" selected>is exactly</option>
                                    <option value="contains">contains</option>
                                    <option value="is_not">is not</option>
                                </select>
                                <input type="text" class="form-control form-control-sm condition-val" placeholder="Enter ID..." />
                            }
                            else if (prop.Name == "AccountOwner" || prop.Name == "CurrentStatus" || prop.Name == "DataSource")
                            {
                                <select class="form-select form-select-sm mb-2 text-primary border-primary condition-select fw-semibold">
                                    <option value="is" selected>is exactly</option>
                                    <option value="contains">contains</option>
                                    <option value="is_not">is not</option>
                                </select>
                                <input type="text" list="dl_@prop.Name" class="form-control form-control-sm condition-val" placeholder="Select or type..." />
                                <datalist id="dl_@prop.Name"></datalist>
                            }
                            else
                            {
                                <select class="form-select form-select-sm mb-2 text-primary border-primary condition-select fw-semibold">
                                    <option value="contains" selected>contains</option>
                                    <option value="is">is exactly</option>
                                    <option value="is_not">is not</option>
                                    <option value="is_empty">is empty</option>
                                </select>
                                <input type="text" list="dl_@prop.Name" class="form-control form-control-sm condition-val" placeholder="Type or select..." />
                                <datalist id="dl_@prop.Name"></datalist>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="filter-footer p-3 border-top d-flex gap-2 bg-white mt-auto">
            <button class="btn-saas-primary w-100 justify-content-center" onclick="applyFilters()">Apply Filters</button>
        </div>
    </div>
    <!-- Table Area -->
    <div class="table-container">
        <!-- Top Toolbar -->
        <div class="table-toolbar">
            <!-- ADD THIS NEW BLOCK FOR THE TOTAL COUNTER -->
            <div class="me-auto d-flex align-items-center">
                <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm" style="border-radius: var(--radius-md);">
                    <i class="fa-solid fa-database me-2"></i> Total Records: <span id="topTotalCount">@totalRecords</span>
                </span>
            </div>
            <div class="dropdown">
                <button class="btn-saas shadow-sm" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    <i class="fa-solid fa-table-columns text-primary"></i> Manage Columns
                </button>
                <ul class="dropdown-menu dropdown-menu-end p-2 shadow-lg border-0" id="columnToggleMenu" style="max-height: 400px; overflow-y: auto; width: 250px;">
                    <!-- Populated via JS for Drag & Drop -->
                </ul>
            </div>
        </div>

        <!-- The Data Table -->
        <div class="table-responsive" id="tableWrapper">
            <table class="table" id="accountsTable">
                <thead>
                    <tr>
                        <th class="sticky-cb">
                            <input class="form-check-input m-0 border-secondary" type="checkbox" id="selectAllCb" onchange="toggleAllRowCheckboxes(this)">
                        </th>

                        @if (tableProps.Length > 0)
                        {
                            int colIndex = 0;
                            foreach (var prop in tableProps)
                            {
                                <th data-col-index="@colIndex" data-col-name="@prop.Name">
                                    <div class="th-content">
                                        <span>@prop.Name</span>

                                        <div class="dropdown">
                                            <button class="header-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Filter & Sort" style="background: transparent; border: none; padding: 0;">
                                                <img src="https://cdn.shopify.com/s/files/1/0578/8198/5133/files/filter.png?v=1789023005" alt="Filter" style="width: 14px; height: 14px; opacity: 0.7; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">
                                            </button>
                                            <ul class="dropdown-menu shadow-sm border-0 p-2" style="width: 200px;">
                                                <li>
                                                    <input type="text" class="form-control form-control-sm mb-2 col-search-input" data-col-index="@colIndex" placeholder="Search @prop.Name..." onkeyup="filterSingleColumn(this, @colIndex)">
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item d-flex align-items-center rounded" href="#" onclick="sortTableByCol(@colIndex, 'asc')">
                                                        <i class="fa-solid fa-arrow-down-a-z text-muted me-2"></i> Sort A to Z
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item d-flex align-items-center rounded" href="#" onclick="sortTableByCol(@colIndex, 'desc')">
                                                        <i class="fa-solid fa-arrow-up-z-a text-muted me-2"></i> Sort Z to A
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </th>
                                colIndex++;
                            }
                        }

                        <th class="sticky-actions text-center">
                            <i class="fa-solid fa-bolt text-muted me-1"></i> Actions
                        </th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="account-row" data-id="@item.Id">
                                <td class="sticky-cb">
                                    <input class="form-check-input m-0 row-cb border-secondary" type="checkbox" value="@item.Id" onchange="updateSelectedCount()">
                                </td>
                                @{
                                    int tdIndex = 0;
                                    foreach (var prop in tableProps)
                                    {
                                        var value = prop.GetValue(item, null)?.ToString() ?? "";
                                        <td data-col-index="@tdIndex">
                                            @if (prop.Name == "AccountName")
                                            {
                                                <a href="@Url.Action("Edit", "Accounts", new { id = item.Id })" class="text-primary fw-bold text-decoration-none">@value</a>
                                            }
                                            else if (prop.Name.Contains("Status"))
                                            {
                                                @if (value.ToLower() == "completed" || value.ToLower() == "user" || value.ToLower() == "active")
                                                {
                                                    <span class="badge-soft-success">@value</span>
                                                }
                                                else if (!string.IsNullOrEmpty(value))
                                                {
                                                    <span class="badge-soft-warning">@value</span>
                                                }
                                            }
                                            else
                                            {
                                                @value
                                            }
                                        </td>
                                        tdIndex++;
                                    }
                                }
                                <td class="sticky-actions text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-3">
                                        <i class="fa-regular fa-comment-dots row-action-icon text-primary" title="Notes" onclick="openNotesPanel('@item.Id', '@(item.GetType().GetProperty("AccountName")?.GetValue(item, null)?.ToString() ?? "Account")')"></i>

                                        <div class="dropdown">
                                            <i class="fa-solid fa-ellipsis-vertical row-action-icon" data-bs-toggle="dropdown"></i>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                <li><a class="dropdown-item" href="#" onclick="alert('Converting ID @item.Id to Contact record...')"><i class="fa-solid fa-user-plus text-muted me-2"></i> Convert to Contact</a></li>
                                                <li><a class="dropdown-item" href="#" onclick="alert('Task Creation for ID: @item.Id')"><i class="fa-solid fa-list-check text-muted me-2"></i> Create Task</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item text-danger" href="#" onclick="deleteSingleRecord(this, '@item.Id')"><i class="fa-solid fa-trash text-danger me-2"></i> Delete</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="noRecordsRow">
                            <td colspan="50" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-folder-open mb-3" style="font-size:3rem; color:#cbd5e1;"></i>
                                <br /><span class="fw-semibold fs-5 text-dark">No records found.</span>
                                <p class="mt-1">Try adjusting your filters or upload new data.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination (Server-Side Integration) -->
            <div class="pagination-container">
                <span id="pageInfo" class="text-muted fw-semibold" style="font-size: 0.85rem;">
                    Showing page @currentPage of @totalPages (@totalRecords total records)
                </span>
                <div class="d-flex gap-2">
                    @if (currentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { page = currentPage - 1, search = currentSearch, sortCol = currentSortCol, sortDir = currentSortDir })" class="btn-saas text-decoration-none">
                            <i class="fa-solid fa-chevron-left"></i> Prev
                        </a>
                    }
                    else
                    {
                        <button class="btn-saas" disabled><i class="fa-solid fa-chevron-left"></i> Prev</button>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a href="@Url.Action("Index", new { page = currentPage + 1, search = currentSearch, sortCol = currentSortCol, sortDir = currentSortDir })" class="btn-saas text-decoration-none">
                            Next <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn-saas" disabled>Next <i class="fa-solid fa-chevron-right"></i></button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Mass Update Modal -->
    <div class="modal fade" id="massUpdateModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-lg);">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-layer-group text-primary me-2"></i> Mass Update</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-muted mb-3" style="font-size: 0.9rem;">Select a field to update for all checked records.</p>
                    <div class="d-flex gap-3 align-items-center">
                        <select id="massUpdateField" class="form-select fw-semibold" style="width: 200px;">
                            <option value="" disabled selected>Select a field...</option>
                            @foreach (var prop in tableProps)
                            {
                                <option value="@prop.Name">@prop.Name</option>
                            }
                        </select>
                        <input type="text" id="massUpdateValue" class="form-control" placeholder="Enter new value..." />
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0 rounded-bottom">
                    <button type="button" class="btn-saas" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn-saas-primary" onclick="executeMassUpdate()">Update Records</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Notes Offcanvas Panel -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="notesPanel" style="width: 450px; border-left: 1px solid var(--border-soft);">
        <div class="offcanvas-header border-bottom bg-light">
            <h5 class="offcanvas-title fw-bold">
                <i class="fa-regular fa-comments text-primary me-2"></i> <span id="noteAccountName" class="text-dark"></span>
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <!-- Add Note Box -->
            <div class="mb-4">
                <textarea id="newNoteText" class="form-control mb-2 fw-medium text-dark" rows="3" placeholder="Write a note..."></textarea>
                <div class="d-flex justify-content-between align-items-center">
                    <input type="file" id="noteAttachment" class="form-control form-control-sm w-50" />
                    <button class="btn-saas-primary" id="btnSaveNote" onclick="saveNote()">Save Note</button>
                </div>
            </div>

            <!-- Notes Timeline -->
            <h6 class="text-muted fw-bold mb-3" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">Timeline Log</h6>
            <div class="timeline-container" id="notesTimelineList">
                <!-- Notes dynamically appended here via JS -->
            </div>
        </div>
    </div>

    <script>
            // ==========================================
            // 1. GLOBAL VARIABLES & INITIALIZATION
            // ==========================================
            const defaultVisibleColumns = ["AccountName", "MobileNumber", "Email", "CurrentStatus", "DateOfEntry"];
            let currentNoteAccountId = null;

            // CACHE MEMORY: Store all rows in memory once so we don't query the DOM repeatedly
            let allRows = [];
            let currentVisibleRows = [];
            let hiddenCols = new Set();

            document.addEventListener("DOMContentLoaded", function () {
                allRows = Array.from(document.querySelectorAll('tbody tr.account-row'));

                // Create a dynamic style tag for instant CSS-based column hiding
                const style = document.createElement('style');
                style.id = 'dynamic-col-styles';
                document.head.appendChild(style);

                // Hide all rows initially to prevent layout shifts
                allRows.forEach(r => r.style.display = 'none');

                // Initialize all modules
                setupColumnToggles();
                setupFilterInteractions();
                setupLazyDatalists();
                refreshVisibleRows(); // Adapted to apply current filtering logic to the 100 rows
                setupFileUpload();
            });

            // ==========================================
            // 2. JS FILTER/SORT REFRESH (Adapted for 100-record Server Pagination)
            // ==========================================
            function refreshVisibleRows() {
                // Keeps local filters working without fighting the server's pagination
                const filteredRows = allRows.filter(row => !row.classList.contains('filtered-out'));

                currentVisibleRows.forEach(r => r.style.display = 'none');
                currentVisibleRows = [...filteredRows];
                currentVisibleRows.forEach(r => r.style.display = '');

                // Uncheck "Select All" to prevent accidental mass actions on hidden records
                const selectAllCb = document.getElementById('selectAllCb');
                if (selectAllCb) selectAllCb.checked = false;
                updateSelectedCount();
            }

            // ==========================================
            // 3. FILTERING & SEARCHING
            // ==========================================
            function togglePinFilter(imgElement) {
                const item = imgElement.closest('.filter-field-item');
                const pinnedWrapper = document.getElementById('pinnedFilters');
                const pinnedContainer = document.getElementById('pinnedItemsContainer');
                const unpinnedContainer = document.getElementById('sidebarList');

                if (imgElement.classList.contains('unpinned-star')) {
                    imgElement.classList.replace('unpinned-star', 'pinned-star');
                    imgElement.style.filter = "none";
                    imgElement.style.opacity = "1";
                    pinnedContainer.appendChild(item);
                    pinnedWrapper.style.display = 'block';
                } else {
                    imgElement.classList.replace('pinned-star', 'unpinned-star');
                    imgElement.style.filter = "grayscale(100%) opacity(0.3)";
                    unpinnedContainer.appendChild(item);

                    if (pinnedContainer.querySelectorAll('.filter-field-item').length === 0) {
                        pinnedWrapper.style.display = 'none';
                    }
                }
            }

            function setupFilterInteractions() {
                document.querySelectorAll('.field-checkbox').forEach(cb => {
                    cb.addEventListener('change', function() {
                        const item = this.closest('.filter-field-item');
                        if(this.checked) item.classList.add('active');
                        else {
                            item.classList.remove('active');
                            item.querySelector('.condition-val').value = '';
                        }
                    });
                });
            }

            function filterSidebarItems() {
                const q = document.getElementById('sidebarSearch').value.toLowerCase();
                document.querySelectorAll('#sidebarList .filter-field-item').forEach(item => {
                    const label = item.querySelector('label').innerText.toLowerCase();
                    item.style.display = label.includes(q) ? '' : 'none';
                });
            }

                   function applyFilters() {
                const activeFilters = [];
                document.querySelectorAll('.filter-field-item.active').forEach(item => {
                    const cb = item.querySelector('.field-checkbox');
                    if (cb && cb.checked) {
                        const colName = cb.value;
                        const condition = item.querySelector('.condition-select').value;
                        let val = item.querySelector('.condition-val').value;
                        const isDate = item.dataset.fieldType === "date";

                        if(!isDate) val = val.toLowerCase().trim();

                        const th = document.querySelector(`th[data-col-name="${colName}"]`);
                        if(th) activeFilters.push({ index: th.getAttribute('data-col-index'), condition, val, isDate });
                    }
                });

                allRows.forEach(row => {
                    let isMatch = true;
                    for (let f of activeFilters) {
                        const td = row.querySelector(`td[data-col-index="${f.index}"]`);
                        // FIX: Changed innerText to textContent so it can read hidden columns
                        const cellText = td ? td.textContent.trim() : '';

                        if (f.isDate) {
                            if (['today', 'this_month', 'tomorrow', 'current_fq'].includes(f.condition)) {
                                if(!cellText) isMatch = false;
                            } else if (f.val) {
                                let rowDate = new Date(cellText);
                                let filterDate = new Date(f.val);

                                if (!isNaN(rowDate) && !isNaN(filterDate)) {
                                    rowDate.setHours(0,0,0,0);
                                    filterDate.setHours(0,0,0,0);
                                    if (f.condition === 'on' && rowDate.getTime() !== filterDate.getTime()) isMatch = false;
                                    if (f.condition === 'before' && rowDate.getTime() >= filterDate.getTime()) isMatch = false;
                                    if (f.condition === 'after' && rowDate.getTime() <= filterDate.getTime()) isMatch = false;
                                }
                            }
                        } else {
                            const lowerText = cellText.toLowerCase();
                            if (f.condition === 'contains' && !lowerText.includes(f.val)) isMatch = false;
                            if (f.condition === 'is' && lowerText !== f.val) isMatch = false;
                            if (f.condition === 'is_not' && lowerText === f.val) isMatch = false;
                            if (f.condition === 'is_empty' && lowerText !== '') isMatch = false;
                        }
                    }
                    row.classList.toggle('filtered-out', !isMatch);
                });

                refreshVisibleRows();
            }

            function clearFilters() {
                document.querySelectorAll('.field-checkbox').forEach(cb => {
                    cb.checked = false;
                    cb.closest('.filter-field-item').classList.remove('active');
                });
                document.querySelectorAll('.condition-val').forEach(input => input.value = '');
                allRows.forEach(row => row.classList.remove('filtered-out'));

                refreshVisibleRows();
            }

                    function filterSingleColumn(inputEl, colIndex) {
                const filterValue = inputEl.value.toLowerCase().trim();
                allRows.forEach(row => {
                    if(!row.classList.contains('filtered-out')) {
                        const td = row.querySelector(`td[data-col-index="${colIndex}"]`);
                        if (td) {
                            // FIX: Changed innerText to textContent
                            const text = td.textContent.trim().toLowerCase();
                            row.classList.toggle('filtered-out', !text.includes(filterValue));
                        }
                    }
                });
                refreshVisibleRows();
            }

            // ==========================================
            // 4. SORTING
            // ==========================================
            function sortTableByCol(colIndex, direction) {
                document.body.style.cursor = 'wait';
                setTimeout(() => {
                    const tbody = document.getElementById("tableBody");

                    allRows.sort((a, b) => {
                        const aCol = a.querySelector(`td[data-col-index="${colIndex}"]`);
                        const bCol = b.querySelector(`td[data-col-index="${colIndex}"]`);

                        // FIX: Changed innerText to textContent
                        const aText = aCol ? aCol.textContent.trim().toLowerCase() : '';
                        const bText = bCol ? bCol.textContent.trim().toLowerCase() : '';

                        if (!isNaN(aText) && !isNaN(bText) && aText !== '' && bText !== '') {
                            return direction === 'asc' ? Number(aText) - Number(bText) : Number(bText) - Number(aText);
                        }

                        if (aText < bText) return direction === 'asc' ? -1 : 1;
                        if (aText > bText) return direction === 'asc' ? 1 : -1;
                        return 0;
                    });

                    // Re-append sorted rows to DOM
                    allRows.forEach(row => tbody.appendChild(row));

                    refreshVisibleRows();
                    document.body.style.cursor = 'default';
                }, 10);
            }
            // ==========================================
            // 5. COLUMN MANAGEMENT & DRAG-DROP
            // ==========================================
            function toggleColumnVisibility(idx, isVisible) {
                if(isVisible) hiddenCols.delete(idx);
                else hiddenCols.add(idx);

                let css = '';
                hiddenCols.forEach(colIdx => {
                    css += `table#accountsTable th[data-col-index="${colIdx}"], table#accountsTable td[data-col-index="${colIdx}"] { display: none !important; }\n`;
                });
                document.getElementById('dynamic-col-styles').innerHTML = css;
            }

            function setupColumnToggles() {
                const table = document.querySelector("#accountsTable");
                const theadRows = table.querySelectorAll("thead tr:first-child th[data-col-index]");
                const columnMenu = document.getElementById("columnToggleMenu");
                columnMenu.innerHTML = '';

                theadRows.forEach((th) => {
                    const colIndex = th.getAttribute("data-col-index");
                    const colName = th.getAttribute("data-col-name");

                    if(colName) {
                        const isDefault = defaultVisibleColumns.includes(colName) || defaultVisibleColumns.length === 0;
                        const li = document.createElement("li");
                        li.className = "dropdown-item px-3 py-2 d-flex align-items-center gap-2 draggable-col-item rounded";
                        li.draggable = true;
                        li.dataset.colIndex = colIndex;

                        li.innerHTML = `
                            <i class="fa-solid fa-grip-vertical drag-handle text-muted"></i>
                            <div class="form-check m-0 w-100 d-flex align-items-center">
                                <input class="form-check-input col-toggle-cb m-0 border-secondary" type="checkbox" value="${colIndex}" id="colToggle${colIndex}" ${isDefault ? 'checked' : ''}>
                                <label class="form-check-label ms-2 w-100 fw-semibold text-dark" for="colToggle${colIndex}" style="cursor:pointer; user-select:none;">${colName}</label>
                            </div>`;

                        li.addEventListener('click', e => e.stopPropagation());
                        li.addEventListener('dragstart', handleDragStart);
                        li.addEventListener('dragover', handleDragOver);
                        li.addEventListener('dragenter', handleDragEnter);
                        li.addEventListener('dragleave', handleDragLeave);
                        li.addEventListener('drop', handleDrop);
                        li.addEventListener('dragend', handleDragEnd);

                        columnMenu.appendChild(li);

                        if(!isDefault) toggleColumnVisibility(colIndex, false);
                    }
                });

                document.querySelectorAll('.col-toggle-cb').forEach(toggle => {
                    toggle.addEventListener('change', function() {
                        toggleColumnVisibility(this.value, this.checked);
                    });
                });
            }

            let draggedItem = null;
            function handleDragStart(e) {
                draggedItem = this;
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', this.dataset.colIndex);
                setTimeout(() => this.classList.add('dragging'), 0);
            }
            function handleDragOver(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; return false; }
            function handleDragEnter(e) { this.classList.add('over'); }
            function handleDragLeave(e) { this.classList.remove('over'); }
            function handleDrop(e) {
                e.stopPropagation();
                this.classList.remove('over');
                if (draggedItem !== this) {
                    let parent = this.parentNode;
                    let siblings = Array.from(parent.children);
                    let insertAfter = siblings.indexOf(draggedItem) < siblings.indexOf(this);

                    if (insertAfter) this.after(draggedItem);
                    else this.before(draggedItem);

                    reorderTableColumns(draggedItem.dataset.colIndex, this.dataset.colIndex, insertAfter);
                }
                return false;
            }
            function handleDragEnd(e) {
                this.classList.remove('dragging');
                document.querySelectorAll('.draggable-col-item').forEach(item => item.classList.remove('over'));
            }

            function reorderTableColumns(draggedIdx, targetIdx, insertAfter) {
                document.body.style.cursor = 'wait';
                setTimeout(() => {
                    const table = document.querySelector("#accountsTable");
                    const theadRow = table.querySelector("thead tr");
                    const draggedTh = theadRow.querySelector(`th[data-col-index="${draggedIdx}"]`);
                    const targetTh = theadRow.querySelector(`th[data-col-index="${targetIdx}"]`);

                    if (insertAfter) targetTh.after(draggedTh);
                    else targetTh.before(draggedTh);

                    // Process chunks to prevent UI freeze on large datasets
                    const chunkSize = 150;
                    let i = 0;
                    function processChunk() {
                        const end = Math.min(i + chunkSize, allRows.length);
                        for(; i < end; i++) {
                            const row = allRows[i];
                            const draggedTd = row.querySelector(`td[data-col-index="${draggedIdx}"]`);
                            const targetTd = row.querySelector(`td[data-col-index="${targetIdx}"]`);
                            if(draggedTd && targetTd) {
                                if (insertAfter) targetTd.after(draggedTd);
                                else targetTd.before(draggedTd);
                            }
                        }
                        if (i < allRows.length) requestAnimationFrame(processChunk);
                        else document.body.style.cursor = 'default';
                    }
                    requestAnimationFrame(processChunk);
                }, 10);
            }

            // ==========================================
            // 6. BULK ACTIONS, EXPORT & DELETE
            // ==========================================
            function toggleAllRowCheckboxes(sourceCb) {
                currentVisibleRows.forEach(row => {
                    const cb = row.querySelector('.row-cb');
                    if(cb) cb.checked = sourceCb.checked;
                });
                updateSelectedCount();
            }

            function updateSelectedCount() {
                const selected = document.querySelectorAll('tbody .row-cb:checked').length;
                document.getElementById('selCount').innerText = selected;
                document.getElementById('bulkActionsContainer').style.display = selected > 0 ? 'flex' : 'none';

                const totalVisible = currentVisibleRows.length;
                const selectAllCb = document.getElementById('selectAllCb');
                if(selectAllCb) selectAllCb.checked = (selected > 0 && selected === totalVisible);
            }

            function deleteSelected() {
                const selectedCbs = document.querySelectorAll('tbody .row-cb:checked');
                if(selectedCbs.length === 0) return;

                if(confirm(`Are you sure you want to delete ${selectedCbs.length} selected record(s)?`)) {
                    let selectedIds = Array.from(selectedCbs).map(cb => parseInt(cb.value));

                    fetch('/Accounts/BulkDelete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(selectedIds)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            selectedCbs.forEach(cb => {
                                const tr = cb.closest('tr');
                                tr.remove();
                                allRows = allRows.filter(r => r !== tr);
                            });
                            document.getElementById('selectAllCb').checked = false;
                            updateSelectedCount();
                            refreshVisibleRows(); // Refresh current view
                        } else alert("Database Error: " + data.message);
                    }).catch(() => alert("Network error occurred."));
                }
            }

            function deleteSingleRecord(element, id) {
                if(confirm('Are you sure you want to delete this record?')) {
                    fetch('/Accounts/BulkDelete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify([parseInt(id)])
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const row = element.closest('tr.account-row');
                            if(row) {
                                row.remove();
                                allRows = allRows.filter(r => r !== row);
                            }
                            updateSelectedCount();
                            refreshVisibleRows();
                        } else alert("Database Error: " + data.message);
                    }).catch(() => alert("Network error occurred."));
                }
            }

            function executeMassUpdate() {
                const field = document.getElementById('massUpdateField').value;
                const val = document.getElementById('massUpdateValue').value;
                const selectedIds = Array.from(document.querySelectorAll('tbody .row-cb:checked')).map(cb => cb.value);

                if(!field || selectedIds.length === 0) {
                    alert("Please select a field and ensure records are checked.");
                    return;
                }

                alert(`Initiating ZDK Mass Update.\nUpdating ${selectedIds.length} records.\nField: ${field}\nNew Value: ${val}`);
                bootstrap.Modal.getInstance(document.getElementById('massUpdateModal')).hide();
                document.getElementById('selectAllCb').click(); // clear selection
            }

            function exportTableToCSV(filename) {
                let csv = [];
                let headerRow = [];
                const table = document.getElementById("accountsTable");

                table.querySelectorAll("thead th[data-col-name]").forEach(th => {
                    if(th.style.display !== 'none') headerRow.push(`"${th.querySelector('span').innerText.trim()}"`);
                });
                csv.push(headerRow.join(","));

                let targetRows = [];
                const checkedCbs = document.querySelectorAll("tbody .row-cb:checked");
                if (checkedCbs.length > 0) {
                    checkedCbs.forEach(cb => targetRows.push(cb.closest('tr')));
                } else {
                    targetRows = allRows.filter(r => !r.classList.contains('filtered-out'));
                }

                targetRows.forEach(tr => {
                    let rowData = [];
                    tr.querySelectorAll("td[data-col-index]").forEach(td => {
                        if(td.style.display !== 'none') {
                            let text = td.innerText.trim().replace(/"/g, '""');
                            rowData.push(`"${text}"`);
                        }
                    });
                    csv.push(rowData.join(","));
                });

                let csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
                let downloadLink = document.createElement("a");
                downloadLink.download = filename;
                downloadLink.href = window.URL.createObjectURL(csvFile);
                downloadLink.style.display = "none";
                document.body.appendChild(downloadLink);
                downloadLink.click();
                document.body.removeChild(downloadLink);
            }

            // ==========================================
            // 7. FILE UPLOAD & LAZY DATALISTS
            // ==========================================
            function setupFileUpload() {
                const fileInput = document.getElementById('fileUploadInput');
                if(!fileInput) return;

                fileInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (!file) return;

                    const formData = new FormData();
                    formData.append('uploadedFile', file);

                    const uploadBtn = document.querySelector('button[onclick*="fileUploadInput"]');
                    const originalHtml = uploadBtn.innerHTML;
                    uploadBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Uploading...';
                    uploadBtn.disabled = true;

                    fetch('@Url.Action("UploadFile", "Accounts")', {
                        method: 'POST',
                        body: formData
                    })
                    .then(async response => {
                        if (response.ok) {
                            alert("Data uploaded successfully!");
                            window.location.reload();
                        } else {
                            alert("Upload Failed: " + await response.text());
                            uploadBtn.innerHTML = originalHtml;
                            uploadBtn.disabled = false;
                        }
                    })
                    .catch(error => {
                        alert("Network error during upload.");
                        uploadBtn.innerHTML = originalHtml;
                        uploadBtn.disabled = false;
                    });
                    this.value = '';
                });
            }

            function setupLazyDatalists() {
                document.querySelectorAll('.condition-val').forEach(input => {
                    input.addEventListener('focus', function() {
                        const listId = this.getAttribute('list');
                        const datalist = document.getElementById(listId);

                        if(datalist && datalist.children.length === 0) {
                            const colName = listId.replace('dl_', '');
                            const th = document.querySelector(`th[data-col-name="${colName}"]`);

                            if(th) {
                                const colIndex = th.getAttribute('data-col-index');
                                let uniqueValues = new Set();

                                allRows.forEach(row => {
                                    const td = row.querySelector(`td[data-col-index="${colIndex}"]`);
                                    if(td) {
                                        const text = td.innerText.trim();
                                        if(text) uniqueValues.add(text);
                                    }
                                });

                                let fragment = document.createDocumentFragment();
                                uniqueValues.forEach(val => {
                                    let option = document.createElement("option");
                                    option.value = val;
                                    fragment.appendChild(option);
                                });
                                datalist.appendChild(fragment);
                            }
                        }
                    });
                });
            }

            // ==========================================
            // 8. NOTES PANEL UI
            // ==========================================
            async function openNotesPanel(accountId, accountName) {
                currentNoteAccountId = accountId;
                document.getElementById('noteAccountName').innerText = accountName;
                document.getElementById('newNoteText').value = '';
                document.getElementById('noteAttachment').value = '';

                const list = document.getElementById('notesTimelineList');
                list.innerHTML = '<div class="text-center mt-4 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Loading notes...</div>';

                new bootstrap.Offcanvas(document.getElementById('notesPanel')).show();

                setTimeout(() => {
                    list.innerHTML = '<p class="text-muted text-center mt-3" style="font-size:0.85rem;">No historical notes found.</p>';
                }, 600);
            }

            async function saveNote() {
                const text = document.getElementById('newNoteText').value;
                const attachment = document.getElementById('noteAttachment').files[0];
                const btn = document.getElementById('btnSaveNote');

                if (!text.trim() && !attachment) return;

                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
                btn.disabled = true;

                setTimeout(() => {
                    const now = new Date();
                    const timeString = now.toLocaleDateString() + ' ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    const fallbackMsg = document.querySelector('#notesTimelineList p.text-muted');
                    if(fallbackMsg) fallbackMsg.remove();

                    appendNoteToUI("System User", timeString, text, attachment ? attachment.name : null);

                    document.getElementById('newNoteText').value = '';
                    document.getElementById('noteAttachment').value = '';
                    btn.innerHTML = 'Save Note';
                    btn.disabled = false;
                }, 500);
            }

            function appendNoteToUI(ownerName, timeString, text, fileName) {
                let attachmentHtml = fileName ? `<div class="mt-2 p-2 bg-white rounded border border-secondary shadow-sm d-inline-block"><i class="fa-solid fa-paperclip me-2 text-primary"></i> <span class="fw-semibold text-dark" style="font-size:0.8rem;">${fileName}</span></div>` : '';
                const noteHtml = `
                    <div class="timeline-item pb-3">
                        <div class="timeline-icon bg-primary text-white" style="border-color: #bfdbfe;"><i class="fa-solid fa-user" style="font-size: 10px;"></i></div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark" style="font-size:0.9rem;">${ownerName}</span>
                            <small class="text-muted fw-medium"><i class="fa-regular fa-clock me-1"></i>${timeString}</small>
                        </div>
                        <div class="text-main bg-white p-3 rounded border border-soft shadow-sm mt-2" style="font-size:0.85rem; line-height: 1.5;">${text.replace(/\n/g, '<br>')}</div>
                        ${attachmentHtml}
                    </div>`;
                document.getElementById('notesTimelineList').insertAdjacentHTML('afterbegin', noteHtml);
            }
    </script>