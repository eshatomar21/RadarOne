                </div>

                <div class="modal-body" style="padding: 32px 40px; max-height: 75vh; overflow-y: auto;">

                    <!-- Primary Criteria Card -->
                    <div class="criteria-card shadow-sm mb-4">
                        <div class="criteria-header">
                            <h6>Specify Criteria - "Accounts"</h6>
                            <div class="form-check form-switch m-0 ms-2">
                                <input class="form-check-input" type="checkbox" checked style="background-color: #22c55e; border-color: #22c55e; width: 36px; height: 20px;">
                            </div>
                        </div>

                        <div id="criteriaRowsContainer">
                            <!-- First Row (Default) -->
                            <div class="criteria-row-builder d-flex align-items-center gap-2 mb-2">
                                <div class="criteria-num" style="width: 30px; height: 30px; border: 1px solid #cbd5e1; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; color: #64748b; font-weight: 600; flex-shrink: 0;">1</div>

                                <select class="form-select criteria-builder-select cv-module" disabled style="max-width: 150px;">
                                    <option value="Accounts" selected>Accounts</option>
                                </select>

                                <!-- Field Selection (Triggers the dropdown swap) -->
                                <select class="form-select criteria-builder-select cv-field" style="max-width: 200px;" onchange="handleCriteriaFieldChange(this)">
                                    <option value="" disabled selected>None</option>
                                    @foreach (var prop in tableProps)
                                    {
                                        <option value="@prop.Name">@prop.Name</option>
                                    }
                                </select>

                                <select class="form-select criteria-builder-select cv-condition" style="max-width: 150px;">
                                    <option value="" disabled selected>None</option>
                                    <option value="is">is exactly</option>
                                    <option value="is_not">isn't</option>
                                    <option value="contains">contains</option>
                                    <option value="starts_with">starts with</option>
                                    <option value="ends_with">ends with</option>
                                    <option value="is_empty">is empty</option>
                                    <option value="is_not_empty">is not empty</option>
                                </select>

                                <!-- 🚀 FIX: Container allows dynamic swapping to dropdowns -->
                                <div class="cv-value-container d-flex" style="flex-grow:1;">
                                    <input type="text" class="form-control criteria-builder-input cv-value" placeholder="Value" style="width: 100%;">
                                </div>

                                <button type="button" class="btn btn-link text-success p-1 add" onclick="addCriteriaRow()"><i class="fa-solid fa-circle-plus fs-5"></i></button>
                            </div>
                        </div>

                        <div class="criteria-pattern-box mt-3 ps-5">
                            <span class="text-muted fw-semibold me-3" style="font-size: 0.85rem;">Criteria Pattern <i class="fa-regular fa-circle-question"></i></span>
                            <span class="fw-bold" id="criteriaPatternText" style="color: #1e293b;">( 1 )</span>
                            <a href="#" class="ms-2 text-decoration-none fw-semibold" style="color: #16a34a; font-size: 0.85rem;">Edit Pattern</a>
                        </div>
                    </div>

                    <!-- Related Modules Criteria Card -->
                    <div class="related-modules-card shadow-sm mb-4">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <h6 class="m-0 fw-bold" style="color: #1e293b; font-size: 0.95rem;">Related Modules Criteria</h6>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" style="width: 36px; height: 20px;">
                            </div>
                        </div>
                        <p class="text-muted m-0" style="font-size: 0.85rem;">It helps to filter record based on related module values.</p>
                    </div>

                    <!-- Choose Column for Default List View -->
                    <div class="bg-white p-4 rounded-3 border shadow-sm mt-4" style="border-color: var(--border-soft) !important;">
                        <h6 class="fw-bold m-0 text-dark d-flex align-items-center gap-2">Choose Column for Default List View <i class="fa-solid fa-circle-info text-muted fs-6"></i></h6>

                        <div class="columns-container d-flex gap-4 mt-3">
                            <!-- Available Columns -->
                            <div class="columns-box-wrapper w-50">
                                <label class="text-muted fw-semibold mb-2" style="font-size: 0.85rem;">Available</label>
                                <div class="columns-box border rounded p-2" id="availableColumnsBox" style="height: 250px; overflow-y: auto; background: #f8fafc;">
                                    <div class="mb-2" style="position: sticky; top: 0; z-index: 5;">
                                        <div class="input-group input-group-sm border rounded bg-white">
                                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                            <input type="text" class="form-control border-0 shadow-none" placeholder="Search..." id="searchAvailableCols" onkeyup="filterColumns('availableColumnsBox', 'searchAvailableCols')">
                                        </div>
                                    </div>
                                    @foreach (var prop in tableProps)
                                    {
                                        <div class="column-item p-2 mb-1 bg-white border rounded d-flex justify-content-between align-items-center" style="cursor: pointer; font-size: 0.85rem;" onclick="moveColumn(this, 'selectedColumnsBox')">
                                            <span class="flex-grow-1">@prop.Name</span> <i class="fa-solid fa-arrow-right text-primary"></i>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Selected Columns -->
                            <div class="columns-box-wrapper w-50">
                                <label class="text-muted fw-semibold mb-2" style="font-size: 0.85rem;">Selected</label>
                                <div class="columns-box border rounded p-2" id="selectedColumnsBox" style="height: 250px; overflow-y: auto; background: #ffffff;">
                                    <!-- Default starting items -->
                                    <div class="column-item p-2 mb-1 border rounded d-flex justify-content-between align-items-center" style="background: #f1f5f9; cursor: pointer; font-size: 0.85rem;" onclick="moveColumn(this, 'availableColumnsBox')">
                                        <i class="fa-solid fa-grip-vertical text-muted me-2"></i> <span class="flex-grow-1">AccountName</span> <i class="fa-solid fa-xmark text-danger ms-2"></i>
                                    </div>
                                    <div class="column-item p-2 mb-1 border rounded d-flex justify-content-between align-items-center" style="background: #f1f5f9; cursor: pointer; font-size: 0.85rem;" onclick="moveColumn(this, 'availableColumnsBox')">
                                        <i class="fa-solid fa-grip-vertical text-muted me-2"></i> <span class="flex-grow-1">Email</span> <i class="fa-solid fa-xmark text-danger ms-2"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
   
    <script>
        // ==========================================
        // 1. GLOBAL VARIABLES & INITIALIZATION
        // ==========================================
        const defaultVisibleColumns = ["AccountName", "MobileNumber", "Email", "CurrentStatus", "DateOfEntry"];
        let currentNoteAccountId = null;

        let allRows = [];
        let currentVisibleRows = [];
        let hiddenCols = new Set();

        // Cache the options globally so `addCriteriaRow` can access them dynamically
        const criteriaFieldOptions = `@foreach (var prop in tableProps) {
            <option value="@prop.Name">@prop.Name</option>
    }
`;

    // ==========================================
    // 🚀 DYNAMIC CUSTOM VIEWS & CRITERIA BUILDER
    // ==========================================

    // Renders the Tabs and Menu Links from LocalStorage
    function renderCustomViews() {
        const container = document.getElementById('customViewsTabsContainer');
        const menu = document.getElementById('unpinnedViewsMenu');
        const savedViews = JSON.parse(localStorage.getItem('crm_user_views')) || [];

        const urlParams = new URLSearchParams(window.location.search);
        const activeViewName = urlParams.get('activeView') || 'All Accounts';

        if(container) {
            // Base 'All Accounts' Tab
            container.innerHTML = `<a href="#" class="view-tab ${activeViewName === 'All Accounts' ? 'active shadow-sm' : ''}" onclick="applyCustomView('All Accounts', [])">All Accounts</a>`;
        }

        if(menu) {
            // Clear existing dynamically added unpinned items
            const unpinnedItems = menu.querySelectorAll('.unpinned-item');
            unpinnedItems.forEach(item => item.remove());
        }

        // Render user views
        savedViews.forEach(view => {
            const isActive = activeViewName === view.name;
            const filterStr = JSON.stringify(view.filters).replace(/"/g, '&quot;');

            if (view.isPinned !== false) {
                // Generate Pinned Tab Layout
                const tabHtml = `
                    <div class="view-tab ${isActive ? 'active shadow-sm' : ''} d-flex align-items-center gap-2" style="${isActive ? 'background-color: #eff6ff;' : ''}">
                        <i class="fa-solid fa-thumbtack pin-icon" style="color: ${isActive ? 'var(--primary-blue)' : '#64748b'}; cursor: pointer; transform: rotate(-45deg); transition: 0.2s;" onclick="toggleViewPinStatus('${view.name}', event)" title="Unpin View"></i>
                        <a href="#" class="text-decoration-none fw-bold" style="color: ${isActive ? 'var(--primary-blue)' : 'var(--text-muted)'};" onclick="applyCustomView('${view.name}', ${filterStr})">${view.name}</a>
                        <i class="fa-solid fa-xmark ms-2" style="font-size: 0.8rem; cursor: pointer; color: #ef4444; opacity: 0.6;" onclick="deleteCustomView('${view.name}', event)" title="Delete View"></i>
                    </div>
                `;
                if(container) container.insertAdjacentHTML('beforeend', tabHtml);
            } else {
                // Generate Unpinned Dropdown Item Layout
                const liHtml = `
                    <li class="unpinned-item d-flex align-items-center justify-content-between px-3 py-1">
                        <a class="dropdown-item fw-medium text-muted d-flex align-items-center p-0" href="#" onclick="applyCustomView('${view.name}', ${filterStr})">
                            <i class="fa-solid fa-thumbtack me-3" style="opacity: 0.4; cursor: pointer;" onclick="toggleViewPinStatus('${view.name}', event)"></i> ${view.name}
                        </a>
                        <i class="fa-solid fa-xmark" style="font-size: 0.8rem; cursor: pointer; color: #ef4444; opacity: 0.6;" onclick="deleteCustomView('${view.name}', event)" title="Delete View"></i>
                    </li>
                `;
                if(menu) menu.insertBefore(document.createRange().createContextualFragment(liHtml), menu.querySelector('.dropdown-divider').parentElement);
            }
        });
    }

        // ==========================================
        // 🚀 CUSTOM VIEWS & CRITERIA BUILDER LOGIC
        // ==========================================

        // Global options list used for dynamic dropdown creation
        const criteriaFilterOptionsMap = {
            "DataSource": ["InboundCall", "Referral/Dealer", "Meta Ads", "Google AdWords", "Outreach", "Group Lead", "Institutional", "Webinar", "KOMMO", "Google Organic SEO", "Website Direct", "YouTube", "LinkedIn", "Instagram Organic", "Zoho Webinar", "Reference Doctor", "Reference Dealer Partner", "Free Trial Self Register", "Seminar Conference", "Cold Calling", "WhatsApp Campaign", "Email Campaign", "Data Import Old DB"],
            "AccountType": ["Individual", "Group", "Institution", "Government Organisation"],
            "CurrentStatus": ["User", "Non-User"],
            "LeadStatus": ["Important contact", "Not a Doctor", "Warm", "Hot", "Not Interested"],
            "QualificationStatus": ["Qualified", "Notqualified"],
            "Profilestatus": ["Completed", "Strongly Completed", "Not Completed", "Not-Qualified"],
            "IsHomeopathicDoctor": ["Yes — MD(Homeopathy)", "मैं होम्योपैथी डॉक्टर हूँ", "हां- बीएचएमएस", "नहीं", "बीएचएमएस की पढ़ाई कर रहा हूँ", "Yes - BHMS", "Not a Homeopath Doctor", "Yes", "No", "Not a Homeopathy Doctor", "Pursuing BHMS"],
            "WorkType": ["Practicing", "Job", "Research", "others"],
            "ClinicType": ["Own", "Visiting", "Hospital Attached", "Govt.service", "Chain Clinics"],
            "HasComputer": ["Yes", "No"],
            "Qualification": ["BHMS", "MD", "BAMS", "Student"],
            "PaymentType": ["Upfront", "EMI - 3Months", "EMI - 6Months"],
            "PaymentStatus": ["Paid", "Pending", "Partial", "Refunded"],
            "CurrentlyUsingSoftware": ["Yes", "No"]
        };

        // 🚀 FIX: Automatically change input type to Dropdown or Date based on Field selected
        function handleCriteriaFieldChange(selectEl) {
            const row = selectEl.closest('.criteria-row-builder');
            const fieldName = selectEl.value;
            const valueContainer = row.querySelector('.cv-value-container');

            if (criteriaFilterOptionsMap[fieldName]) {
                // It's a predefined dropdown list
                let opts = '<option value="" disabled selected>Select Value</option>';
                criteriaFilterOptionsMap[fieldName].forEach(o => { opts += `<option value="${o}">${o}</option>`; });
                valueContainer.innerHTML = `<select class="form-select criteria-builder-input cv-value" style="width:100%;">${opts}</select>`;
            }
            else if (fieldName.toLowerCase().includes('date')) {
                // It's a date field
                valueContainer.innerHTML = `<input type="date" class="form-control criteria-builder-input cv-value" style="width:100%;">`;
            }
            else {
                // Default text field
                valueContainer.innerHTML = `<input type="text" class="form-control criteria-builder-input cv-value" placeholder="Value" style="width:100%;">`;
            }
        }

    // 🚀 NEW: Update Criteria Pattern Logic dynamically
        function updateCriteriaPattern() {
            const totalRows = document.querySelectorAll('#criteriaRowsContainer .criteria-row-builder').length;
            let patternText = "( 1 )";

            if (totalRows > 1) {
                let elements = ["1"];
                document.querySelectorAll('#criteriaRowsContainer .criteria-connector-vertical .cv-logic').forEach((select, idx) => {
                    elements.push(select.value.toLowerCase());
                    elements.push((idx + 2).toString());
                });
                patternText = "( " + elements.join(" ") + " )";
            }

            const patternEl = document.getElementById('criteriaPatternText');
            if(patternEl) patternEl.innerText = patternText;
        }

            function addCriteriaRow() {
            const container = document.getElementById('criteriaRowsContainer');
            const rowCount = container.querySelectorAll('.criteria-row-builder').length + 1;

            // Safely extract the fields dropdown from the first row so it's always accurate
            const firstRowFields = container.querySelector('.cv-field').innerHTML;

            const andLine = document.createElement('div');
            andLine.className = 'criteria-connector-vertical d-flex align-items-center mb-2';
            andLine.style.marginLeft = '14px';
            andLine.style.borderLeft = '1px solid #cbd5e1';
            andLine.style.padding = '4px 0 4px 12px';

            andLine.innerHTML = `
                <select class="form-select form-select-sm cv-logic shadow-sm" style="width: 80px; font-weight: 700; color: #16a34a; border-color: #bbf7d0; background-color: #f0fdf4; cursor: pointer;" onchange="updateCriteriaPattern()">
                    <option value="AND">AND</option>
                    <option value="OR">OR</option>
                </select>
            `;

            const row = document.createElement('div');
            row.className = 'criteria-row-builder d-flex align-items-center gap-2 mb-2';
            row.innerHTML = `
                <div class="criteria-num" style="width: 30px; height: 30px; border: 1px solid #cbd5e1; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; color: #64748b; font-weight: 600; flex-shrink: 0;">${rowCount}</div>

                <select class="form-select criteria-builder-select cv-module" disabled style="max-width: 150px;">
                    <option value="Accounts" selected>Accounts</option>
                </select>

                <select class="form-select criteria-builder-select cv-field" style="max-width: 200px;" onchange="handleCriteriaFieldChange(this)">
                    ${firstRowFields}
                </select>

                <select class="form-select criteria-builder-select cv-condition" style="max-width: 150px;">
                    <option value="" disabled selected>None</option>
                    <option value="is">is exactly</option>
                    <option value="is_not">isn't</option>
                    <option value="contains">contains</option>
                    <option value="does_not_contain">does not contain</option>
                    <option value="starts_with">starts with</option>
                    <option value="ends_with">ends with</option>
                    <option value="is_empty">is empty</option>
                    <option value="is_not_empty">is not empty</option>
                </select>

                <div class="cv-value-container d-flex" style="flex-grow:1;">
                    <input type="text" class="form-control criteria-builder-input cv-value" placeholder="Value" style="width:100%;">
                </div>

                <button type="button" class="btn btn-link text-success p-1 add" onclick="addCriteriaRow()"><i class="fa-solid fa-circle-plus fs-5"></i></button>
                <button type="button" class="btn btn-link text-danger p-1 remove" onclick="removeCriteriaRow(this)"><i class="fa-solid fa-circle-minus fs-5"></i></button>
            `;

            container.appendChild(andLine);
            container.appendChild(row);

            updateCriteriaPattern();
        }

        function removeCriteriaRow(btn) {
            const row = btn.closest('.criteria-row-builder');
            if (row.previousElementSibling && row.previousElementSibling.classList.contains('criteria-connector-vertical')) {
                row.previousElementSibling.remove();
            }
            row.remove();

            let index = 1;
            document.querySelectorAll('#criteriaRowsContainer .criteria-num').forEach(el => {
                el.innerText = index++;
            });

            updateCriteriaPattern();
        }

            // 🚀 FIX: Smooth transition between Available and Selected Columns
        function moveColumn(item, targetBoxId) {
            const targetBox = document.getElementById(targetBoxId);

            // Clean out existing icons
            const fieldName = item.innerText.trim();

            if (targetBoxId === 'selectedColumnsBox') {
                // Moving to Selected
                item.innerHTML = `<i class="fa-solid fa-grip-vertical text-muted me-2"></i> <span class="flex-grow-1">${fieldName}</span> <i class="fa-solid fa-xmark text-danger ms-2"></i>`;
                item.style.background = "#f1f5f9";
                item.onclick = function() { moveColumn(this, 'availableColumnsBox'); };
            } else {
                // Moving to Available
                item.innerHTML = `<span class="flex-grow-1">${fieldName}</span> <i class="fa-solid fa-arrow-right text-primary"></i>`;
                item.style.background = "#ffffff";
                item.onclick = function() { moveColumn(this, 'selectedColumnsBox'); };
            }

            targetBox.appendChild(item);
        }

        function saveAndApplyCustomView() {
            const viewName = document.getElementById('customViewName').value.trim();
            if (!viewName) {
                alert("Please enter a Custom View Name.");
                return;
            }

            const activeFilters = [];

            document.querySelectorAll('#criteriaRowsContainer .criteria-row-builder').forEach((row, index) => {
                const field = row.querySelector('.cv-field').value;
                const condition = row.querySelector('.cv-condition').value;
                const val = row.querySelector('.cv-value').value;

                let logicOperator = "AND";
                if (row.previousElementSibling && row.previousElementSibling.classList.contains('criteria-connector-vertical')) {
                    logicOperator = row.previousElementSibling.querySelector('.cv-logic').value;
                }

                if (field && condition) {
                    activeFilters.push({
                        LogicalOperator: index === 0 ? "" : logicOperator,
                        ColumnName: field,
                        Condition: condition,
                        Value: val,
                        IsDate: field.toLowerCase().includes('date')
                    });
                }
            });

            if (activeFilters.length === 0) {
                alert("Please specify at least one valid criteria to create a view.");
                return;
            }

            let savedViews = JSON.parse(localStorage.getItem('crm_user_views')) || [];
            savedViews = savedViews.filter(v => v.name !== viewName);
            savedViews.push({
                name: viewName,
                isPinned: true,
                filters: activeFilters
            });
            localStorage.setItem('crm_user_views', JSON.stringify(savedViews));

            bootstrap.Modal.getInstance(document.getElementById('createCustomViewModal')).hide();

