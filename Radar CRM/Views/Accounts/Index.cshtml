            <a href="@Url.Action("Index", "Accounts")" class="btn btn-sm btn-link text-decoration-none">Clear</a>
        </div>
        <div class="filter-search-box">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0 fw-medium" placeholder="Find filter..." id="sidebarSearch" onkeyup="filterSidebarItems()">
            </div>
        </div>

        <div class="filter-body" style="flex-grow: 1; overflow-y: auto; padding-bottom: 20px;">
            <!-- FREQUENTLY USED SECTION -->
            <div id="pinnedFilters" style="display: none; border-bottom: 2px solid #e2e8f0; background-color: #f8fafc; padding-bottom: 8px;">
                <div class="px-3 py-2 text-muted fw-bold d-flex align-items-center" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                    <img src="https://cdn.shopify.com/s/files/1/0578/8198/5133/files/star_1.png?v=1789022857" style="width: 12px; height: 12px; margin-right: 6px;" alt="Star">
                    FREQUENTLY USED
                </div>
                <div id="pinnedItemsContainer"></div>
            </div>

            <!-- UNPINNED LIST -->
            <div id="sidebarList">
                @foreach (var prop in tableProps)
                {
                    bool isDate = prop.PropertyType == typeof(DateTime) || prop.PropertyType == typeof(DateTime?) || prop.Name.Contains("Date");

                    <div class="filter-field-item field-item-row" data-field-type="@(isDate ? "date" : "text")">
                        <div class="d-flex align-items-center m-0 w-100">
                            <i class="fa-regular fa-star pin-filter-btn flex-shrink-0"
                               style="font-size: 15px; cursor: pointer; color: #cbd5e1; transition: all 0.2s;"
                               onclick="togglePinFilter(event, this)" title="Pin this filter"></i>

                            <input class="form-check-input field-checkbox mx-2 mt-0 flex-shrink-0" type="checkbox" value="@prop.Name" id="chk_@prop.Name" style="cursor: pointer;">

                            <label class="form-check-label flex-grow-1 fw-semibold text-dark text-truncate" for="chk_@prop.Name" style="cursor: pointer; padding-left: 2px;">
                                @prop.Name
                            </label>
                        </div>

                        <div class="filter-expanded-area">
                            @if (isDate)
                            {
                                <select class="form-select form-select-sm mb-2 text-primary border-primary condition-select fw-semibold" onchange="toggleDateInputs(this)">
                                    <option value="on" selected>On</option>
                                    <option value="before">before</option>
                                    <option value="after">after</option>
                                    <option value="between">between</option>
                                    <option value="today">Today</option>
                                    <option value="this_month">This Month</option>
                                </select>
                                <div class="d-flex flex-column gap-2">
                                    <input type="date" class="form-control form-control-sm condition-val date-val-1" />
                                    <input type="date" class="form-control form-control-sm condition-val date-val-2" style="display:none;" />
                                </div>
                            }
                            else if (prop.Name.Contains("Owner"))
                            {
                                <select class="form-select form-select-sm mb-2 text-primary border-primary condition-select fw-semibold">
                                    <option value="contains" selected>contains</option>
                                    <option value="does_not_contain">does not contain</option>
                                    <option value="starts_with">starts with</option>
                                    <option value="ends_with">ends with</option>
                                    <option value="is">is exactly</option>
                                    <option value="is_not">is not</option>
                                    <option value="is_empty">is empty</option>
                                    <option value="is_not_empty">is not empty</option>
                                </select>
                                <input type="text" list="dl_users_@prop.Name" class="form-control form-control-sm condition-val text-val" placeholder="Select or type..." />
                                <datalist id="dl_users_@prop.Name">
                                    @if (ViewBag.UsersList != null)
                                    {
                                        foreach (var user in (SelectList)ViewBag.UsersList)
                                        {
                                            <option value="@user.Text">@user.Text</option>
                                        }
                                    }
                                </datalist>
                            }
                            else
                            {
                                <select class="form-select form-select-sm mb-2 text-primary border-primary condition-select fw-semibold">
                                    <option value="contains" selected>contains</option>
                                    <option value="does_not_contain">does not contain</option>
                                    <option value="starts_with">starts with</option>
                                    <option value="ends_with">ends with</option>
                                    <option value="is">is exactly</option>
                                    <option value="is_not">is not</option>
                                    <option value="is_empty">is empty</option>
                                    <option value="is_not_empty">is not empty</option>
                                </select>
                                <input type="text" list="dl_@prop.Name" class="form-control form-control-sm condition-val text-val" placeholder="Type or select..." />
                                <datalist id="dl_@prop.Name"></datalist>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="filter-footer p-3 border-top bg-white mt-auto" style="flex-shrink: 0; z-index: 10;">
            <button class="btn-saas-primary w-100 justify-content-center" onclick="applyFilters()">Apply Filters</button>
        </div>
    </div>

    <!-- Table Area -->
    <div class="table-container" style="display: flex; flex-direction: column; height: 100%; overflow: hidden;">
        <!-- Top Toolbar -->
        <div class="table-toolbar">
            <div class="me-auto d-flex align-items-center gap-3 w-100">
                <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm" style="border-radius: var(--radius-md);">
                    <i class="fa-solid fa-database me-2"></i> Total Records: <span id="topTotalCount">@totalRecords</span>
                </span>

                <!-- 🚀 Custom Views Navigation (Replacing Search Bar) -->
                <!-- DYNAMIC Custom Views Navigation (Replacing Search Bar) -->
                <div class="custom-views-nav m-0 d-flex gap-2 align-items-center flex-grow-1 ms-4" style="max-width: 70%;" id="customViewsTabsContainer">
                    <!-- JS will populate these tabs dynamically -->
                </div>

               

                <!-- Create View Button -->
                <button type="button" class="btn-saas-primary ms-auto" onclick="openCustomViewModal()">
                    <i class="fa-solid fa-plus me-1"></i> Create View
                </button>
            </div> <!-- Closes the left-side flex container -->
            <!-- Manage Columns Dropdown -->
            <div class="dropdown ms-3 flex-shrink-0">
                <button class="btn-saas shadow-sm" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    <i class="fa-solid fa-table-columns text-primary"></i> Manage Columns
                </button>
                <ul class="dropdown-menu dropdown-menu-end p-2 shadow-lg border-0" id="columnToggleMenu" style="max-height: 400px; overflow-y: auto; width: 250px;">
                    <!-- Populated via JS for Drag & Drop -->
                </ul>
            </div>

        </div>
        <!-- Closes the

        <!-- 🚀 FIX: The Data Table (This part scrolls) -->
        <div class="table-responsive" id="tableWrapper" style="flex: 1; overflow-y: auto;">
            <table class="table" id="accountsTable">
                <thead>
                    <tr>
                        <th class="sticky-cb">
                            <input class="form-check-input m-0 border-secondary" type="checkbox" id="selectAllCb" onchange="toggleAllRowCheckboxes(this)">
                        </th>

                        @if (tableProps.Length > 0)
                        {
                            int colIndex = 0;
                            foreach (var prop in tableProps)
                            {
                                <th data-col-index="@colIndex" data-col-name="@prop.Name">
                                    <div class="th-content">
                                        <span>@prop.Name</span>
                                        <div class="dropdown">
                                            <button class="header-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Filter & Sort">
                                                <img src="https://cdn.shopify.com/s/files/1/0578/8198/5133/files/filter.png?v=1789023005" alt="Filter" style="width: 14px; height: 14px; opacity: 0.7; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">
                                            </button>
                                            <ul class="dropdown-menu shadow-sm border-0 p-2" style="width: 200px;">
                                                <li>
                                                    <input type="text" class="form-control form-control-sm mb-2 col-search-input" data-col-index="@colIndex" placeholder="Search @prop.Name..." onkeyup="filterSingleColumn(this, @colIndex)">
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item d-flex align-items-center rounded" href="#" onclick="sortTableByCol(@colIndex, 'asc')">
                                                        <i class="fa-solid fa-arrow-down-a-z text-muted me-2"></i> Sort A to Z
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item d-flex align-items-center rounded" href="#" onclick="sortTableByCol(@colIndex, 'desc')">
                                                        <i class="fa-solid fa-arrow-up-z-a text-muted me-2"></i> Sort Z to A
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </th>
                                colIndex++;
                            }
                        }

                        <th class="sticky-actions text-center">
                            <i class="fa-solid fa-bolt text-muted me-1"></i> Actions
                        </th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="account-row" data-id="@item.Id">
                                <td class="sticky-cb">
                                    <input class="form-check-input m-0 row-cb border-secondary" type="checkbox" value="@item.Id" onchange="updateSelectedCount()">
                                </td>
                                @{

                                    int tdIndex = 0;
                                    foreach (var prop in tableProps)
                                    {
                                        string value = "";
                                        var rawValue = prop.GetValue(item, null);

                                        if (rawValue != null)
                                        {
                                            if (rawValue.GetType().Name.Contains("User"))
                                            {
                                                var nameProp = rawValue.GetType().GetProperty("fullName") ?? rawValue.GetType().GetProperty("FirstName");
                                                value = nameProp?.GetValue(rawValue, null)?.ToString() ?? "Unknown User";
                                            }
                                            else
                                            {
                                                value = rawValue.ToString();
                                            }
                                        }

                                        <td data-col-index="@tdIndex">
                                            @if (prop.Name == "AccountName")
                                            {
                                                <a href="@Url.Action("Edit", "Accounts", new { id = item.Id })" class="text-primary fw-bold text-decoration-none">@value</a>
                                            }
                                            else if (prop.Name.Contains("Status"))
                                            {
                                                @if (value.ToLower() == "completed" || value.ToLower() == "user" || value.ToLower() == "active")
                                                {
                                                    <span class="badge-soft-success">@value</span>
                                                }
                                                else if (!string.IsNullOrEmpty(value))
                                                {
                                                    <span class="badge-soft-warning">@value</span>
                                                }
                                            }
                                            else
                                            {
                                                @value
                                            }
                                        </td>
                                        tdIndex++;
                                    }
                                }
                                <td class="sticky-actions text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <button class="btn btn-sm" style="background-color: #f8fafc; color: #475569; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; padding: 4px 10px; display: inline-flex; align-items: center; gap: 6px; transition: 0.2s;" onclick="openNotesPanel('@item.Id', '@(item.GetType().GetProperty("AccountName")?.GetValue(item, null)?.ToString() ?? "Account")')" onmouseover="this.style.backgroundColor='#e2e8f0'; this.style.color='#0f172a';" onmouseout="this.style.backgroundColor='#f8fafc'; this.style.color='#475569';">
                                            <i class="fa-regular fa-comment-dots"></i> Notes
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="noRecordsRow">
                            <td colspan="50" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-folder-open mb-3" style="font-size:3rem; color:#cbd5e1;"></i>
                                <br /><span class="fw-semibold fs-5 text-dark">No records found.</span>
                                <p class="mt-1">Try adjusting your filters or upload new data.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container" style="flex-shrink: 0;">
            <span id="pageInfo" class="text-muted fw-semibold" style="font-size: 0.85rem;">
                Showing page @currentPage of @totalPages (@totalRecords total records)
            </span>
            <div class="d-flex gap-2">
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("Index", new { page = currentPage - 1, search = currentSearch, sortCol = currentSortCol, sortDir = currentSortDir, advancedFilters = advancedFilters })" class="btn-saas text-decoration-none">
                        <i class="fa-solid fa-chevron-left"></i> Prev
                    </a>
                }
                else
                {
                    <button class="btn-saas" disabled><i class="fa-solid fa-chevron-left"></i> Prev</button>
                }

                @if (currentPage < totalPages)
                {
                    <a href="@Url.Action("Index", new { page = currentPage + 1, search = currentSearch, sortCol = currentSortCol, sortDir = currentSortDir, advancedFilters = advancedFilters })" class="btn-saas text-decoration-none">
                        Next <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }
                else
                {
                    <button class="btn-saas" disabled>Next <i class="fa-solid fa-chevron-right"></i></button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Mass Update Modal -->
<div class="modal fade" id="massUpdateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-lg);">
            <div class="modal-header" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                <h5 class="modal-title fw-bold" style="color: var(--primary-blue);">
                    <i class="fa-solid fa-layer-group me-2"></i> Mass Update Records
                </h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <div class="alert alert-info py-2 px-3 mb-4" style="background-color: var(--light-blue); border-color: #bfdbfe; font-size: 0.9rem;">
                    <i class="fa-solid fa-circle-info me-2"></i> You are about to update <strong id="massUpdateCountDisplay" class="text-primary fs-6">0</strong> selected records.
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-muted" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">1. Select Field to Update</label>
                    <select id="massUpdateField" class="form-select fw-semibold border-secondary shadow-sm" onchange="renderMassUpdateInput()">
                        <option value="" disabled selected>- Choose a field -</option>
                        @foreach (var prop in tableProps)
                        {
                            <option value="@prop.Name" data-type="@(prop.PropertyType.Name)">@prop.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-2" id="massUpdateValueContainer" style="display: none;">
                    <label class="form-label fw-bold text-muted" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">2. Enter New Value</label>
                    <div id="dynamicInputArea">
                        <!-- JS WILL INJECT DROPDOWNS OR TEXTBOXES HERE -->
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0 rounded-bottom">
                <button type="button" class="btn-saas" data-bs-dismiss="modal" style="border: 1px solid #cbd5e1;">Cancel</button>
                <button type="button" class="btn-saas-primary" id="btnExecuteMassUpdate" onclick="executeMassUpdateAjax()">
                    <i class="fa-solid fa-check"></i> Apply Update
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     MODERN SAAS QUICK CREATE TASK MODAL (Navy & Slate Theme)
