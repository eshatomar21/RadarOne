                                    <option>2 Day(s)</option>
                                </select>
                                <span style="font-size:0.85rem;">of due date at</span>
                                <input type="time" class="form-control form-control-sm w-25 d-inline">
                            </div>

                            <div class="row align-items-center mb-3">
                                <div class="col-3 fw-bold text-muted" style="font-size:0.85rem;">Repeat type</div>
                                <div class="col-9">
                                    <select class="task-input w-50" style="padding: 4px 8px;">
                                        <option>None</option>
                                        <option>Daily</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <div class="col-3 fw-bold text-muted" style="font-size:0.85rem;">Notify</div>
                                <div class="col-9">
                                    <select class="task-input w-50" style="padding: 4px 8px;">
                                        <option>Email</option>
                                        <option>Popup</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Expandable "More Fields" Button -->
                        <div class="task-more-fields-btn" id="moreFieldsToggle" onclick="toggleMoreFields()">
                            <span>More Fields</span>
                            <i class="fa-solid fa-chevron-right" id="moreFieldsIcon" style="transition: transform 0.2s;"></i>
                        </div>

                        <!-- Hidden Extended Fields -->
                        <div id="moreFieldsContainer" style="display: none; padding-top: 24px; border-top: 1px dashed #e2e8f0; margin-top: 20px;">
                            <div class="row">
                                <div class="col-md-6 form-group mb-4">
                                    <label class="task-label">Lead Name</label>
