    function renderMassUpdateInput() {
        const fieldSelect = document.getElementById('massUpdateField');
        const container = document.getElementById('massUpdateValueContainer');
        const inputArea = document.getElementById('dynamicInputArea');
        const selectedField = fieldSelect.value;
        const fieldType = fieldSelect.options[fieldSelect.selectedIndex].getAttribute('data-type');

        if (!selectedField) {
            container.style.display = 'none';
            return;
        }

        container.style.display = 'block';
        inputArea.innerHTML = '';

        if (massUpdateOptionsMap[selectedField]) {
            let selectHTML = `<select id="massUpdateValue" class="form-select border-secondary shadow-sm"><option value="" disabled selected>- Select Option -</option>`;
            selectHTML += `<option value="CLEAR_VALUE_COMMAND">[ Clear / Remove Value ]</option>`;
            massUpdateOptionsMap[selectedField].forEach(opt => {
                selectHTML += `<option value="${opt}">${opt}</option>`;
            });
            selectHTML += `</select>`;
            inputArea.innerHTML = selectHTML;
        }
        else if (fieldType.includes('DateTime'))
        {
            inputArea.innerHTML = `<input type="date" id="massUpdateValue" class="form-control border-secondary shadow-sm" />`;
        }
        else if (fieldType.includes('Int') || fieldType.includes('Decimal') || fieldType.includes('Double'))
        {
            inputArea.innerHTML = `<input type="number" id="massUpdateValue" class="form-control border-secondary shadow-sm" placeholder="Enter numeric value..." />`;
        }
        else
        {
            inputArea.innerHTML = `<input type="text" id="massUpdateValue" class="form-control border-secondary shadow-sm" placeholder="Enter text value..." />`;
        }
    }

    function executeMassUpdateAjax() {
         const field = document.getElementById('massUpdateField').value;
         const valInput = document.getElementById('massUpdateValue');
         let val = valInput ? valInput.value : '';

         if (val === "CLEAR_VALUE_COMMAND") val = "";

         const selectedCbs = document.querySelectorAll('tbody .row-cb:checked');
         const selectedIds = Array.from(selectedCbs).map(cb => parseInt(cb.value));

         if (!field || selectedIds.length === 0) {
             alert("Please select a field and ensure records are checked.");
             return;
         }

         if (val === "" && !confirm("You are about to clear/empty this field for all selected records. Are you sure?")) {
             return;
         }

         const btn = document.getElementById('btnExecuteMassUpdate');
         btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Updating...';
         btn.disabled = true;

         fetch('@Url.Action("BulkUpdate", "Accounts")', {
             method: 'POST',
             headers: {
                 'Content-Type': 'application/json',
                 'Accept': 'application/json'
             },
             body: JSON.stringify({ Ids: selectedIds, FieldName: field, NewValue: val })
         })
         .then(async response => {
             if (!response.ok) {
                 const errorText = await response.text();
                 throw new Error(errorText || `HTTP Error ${response.status}`);
             }
             return response.json();
         })
         .then(data => {
             if (data.success) {
                 bootstrap.Modal.getInstance(document.getElementById('massUpdateModal')).hide();
                 alert(`Successfully updated ${selectedIds.length} records!`);
                 window.location.reload();
             } else {
                 alert("Update failed: " + data.message);
                 btn.innerHTML = '<i class="fa-solid fa-check"></i> Apply Update';
                 btn.disabled = false;
             }
         })
         .catch((err) => {
             console.error("Mass Update Error:", err);
             alert("Connection error! Please check the browser console (F12) for exact details.");
             btn.innerHTML = '<i class="fa-solid fa-check"></i> Apply Update';
             btn.disabled = false;
         });
    }

