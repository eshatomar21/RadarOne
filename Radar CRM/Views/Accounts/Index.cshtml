<div class="modal fade" id="quickTaskModal" tabindex="-1" aria-labelledby="quickTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content task-modal-content">

            <div class="modal-header task-modal-header">
                <h5 class="modal-title task-modal-title" id="quickTaskModalLabel">
                    <div style="background: var(--theme-navy-light, #eff6ff); color: var(--theme-navy-primary, #1e3a8a); width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 10px;">
                        <i class="fa-solid fa-check-square"></i>
                    </div>
                    Add New Task
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Tasks" asp-action="Create" method="post">
                <div class="modal-body task-modal-body">
                    <div class="row">
                        <div class="col-md-12 form-group mb-4">
                            <label class="task-label">Subject <span class="text-danger">*</span></label>
                            <input name="Subject" class="task-input" placeholder="E.g., Follow up call..." required />
                        </div>

                        <!-- Dropdown to select Account from the Index List -->
                        <div class="col-md-6 form-group mb-4">
                            <label class="task-label">Related Account</label>
                            <select name="AccountId" id="taskModalAccountId" class="task-input">
                                <option value="">- Select Account -</option>
                                @if (Model != null)
                                {
                                    foreach (var acc in Model)
                                    {
                                        <option value="@acc.Id">@acc.AccountName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label class="task-label">Due Date</label>
                            <input name="DueDate" type="date" id="modalDueDate" class="task-input" />
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label class="task-label">Priority</label>
                            <select name="Priority" class="task-input">
                                <option value="Highest">Highest</option>
                                <option value="High" selected>High</option>
                                <option value="Normal">Normal</option>
                                <option value="Low">Low</option>
                                <option value="Lowest">Lowest</option>
                            </select>
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label class="task-label">Task Owner</label>
                            <select name="TaskOwnerId" asp-items="ViewBag.UsersList" class="task-input">
                                <option value="">- Assign To -</option>
                            </select>
                        </div>

                        <!-- Modern UI Toggles -->
                        <div class="col-md-12 form-group mb-2 d-flex align-items-center gap-4 pt-3">
                            <div class="form-check form-switch task-switch m-0 p-0 ps-4">
                                <input class="form-check-input" type="checkbox" id="modalRepeatToggle" disabled>
                                <label class="form-check-label ms-2" for="modalRepeatToggle">Repeat</label>
                            </div>
                            <div class="form-check form-switch task-switch m-0 p-0 ps-4">
