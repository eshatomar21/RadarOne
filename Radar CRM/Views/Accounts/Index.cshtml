                        </div>

                        <!-- Expandable Repeat Panel -->
                        <div class="col-md-12 expandable-panel" id="modalRepeatPanel">
                            <div class="row align-items-center mb-3">
                                <div class="col-3 fw-bold text-muted" style="font-size:0.85rem;">Repeat type</div>
                                <div class="col-9">
                                    <select class="task-input w-50 mb-2" style="padding: 4px 8px;">
                                        <option>Daily</option>
                                        <option>Weekly</option>
                                        <option>Monthly</option>
                                        <option>Yearly</option>
