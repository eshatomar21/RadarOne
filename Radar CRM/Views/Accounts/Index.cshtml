@model IEnumerable<Radar_CRM.Models.Account>

@{
    ViewData["Title"] = "Accounts Master";

    // --- Catch pagination & state values from Controller ---
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    string currentSearch = Context.Request.Query["search"];
    string currentSortCol = Context.Request.Query["sortCol"];
    string currentSortDir = Context.Request.Query["sortDir"];
    string advancedFilters = Context.Request.Query["advancedFilters"]; // 🚀 MOVED HERE

    // EXCLUSION LIST: Removed ZohoRecordId, AccountOwnerId, and CoOwnerId as requested
    var excludedFields = new[] { "ZohoRecordId" };

    // Using reflection to get table properties dynamically, excluding the specified fields
    var tableProps = typeof(Radar_CRM.Models.Account).GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance)
         .Where(p => !excludedFields.Contains(p.Name))
         .ToArray();
}

