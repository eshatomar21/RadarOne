<script>
    // ==========================================
    // 1. NOTES POP-UP LOGIC
    // ==========================================

    function openNoteModal() {
    // Automatically fetch the current system date and time
    const now = new Date();
    document.getElementById('modalNoteDateTime').value = now.toLocaleString();

    // Clear old inputs out of the pop-up
    document.getElementById('modalNoteFile').value = '';
    document.getElementById('modalNoteDesc').value = '';

    // Open the pop-up modal
    const modal = new bootstrap.Modal(document.getElementById('noteModal'));
    modal.show();
    }
    function saveNote() {
    // Grab the Dropdown element
    const ownerDropdown = document.getElementById('modalNoteOwner');

    // The database ID (e.g., "1234-abcd...") goes to the server
    const ownerId = ownerDropdown.value;

    // The readable name (e.g., "Aman") displays on the screen right away
    const ownerName = ownerDropdown.options[ownerDropdown.selectedIndex].text;

    const dateTime = document.getElementById('modalNoteDateTime').value;
    const desc = document.getElementById('modalNoteDesc').value;

    const fileInput = document.getElementById('modalNoteFile');
    const fileName = fileInput.files.length > 0 ? fileInput.files[0].name : '';

    if (!desc.trim() && !fileName) {
    alert('Please enter a description or attach a file.');
    return;
    }

    let fileHtml = fileName ? `<div class="mt-2 text-primary" style="font-size: 0.85rem;"><i class="fa-solid fa-paperclip me-2"></i>${fileName}</div>` : '';

    const noteHtml = `
    <div class="saved-note-card p-3 mb-3 shadow-sm" style="border: 1px solid #e5e7eb; border-left: 4px solid #1a56db; border-radius: 8px; background: #fff;">
    <div class="d-flex justify-content-between align-items-center mb-2">
    <span class="fw-bold" style="font-size: 0.9rem; color: #111827;">
    <i class="fa-solid fa-circle-user text-muted me-2"></i>${ownerName} <!-- DISPLAY NAME -->
    </span>
    <span class="text-muted" style="font-size: 0.8rem;">
    <i class="fa-regular fa-clock me-1"></i> ${dateTime}
    </span>
    </div>
    <div style="font-size: 0.9rem; color: #374151; white-space: pre-wrap;">${desc}</div>
    ${fileHtml}

    <!-- Hidden inputs so the data is sent to the server on Form Submit -->
    <input type="hidden" name="SavedNoteOwner[]" value="${ownerId}" /> <!-- SUBMIT ID -->
    <input type="hidden" name="SavedNoteDateTime[]" value="${dateTime}" />
    <input type="hidden" name="SavedNoteDesc[]" value="${desc}" />
    </div>
    `;

    document.getElementById('savedNotesContainer').insertAdjacentHTML('beforeend', noteHtml);

    const modalEl = document.getElementById('noteModal');
    const modalInstance = bootstrap.Modal.getInstance(modalEl);
    modalInstance.hide();
    }


    // ==========================================
    // 2. EXISTING PAGE LOGIC (Untouched)
    // ==========================================

    // Show/Hide Conditional Fields based on DataSource
    document.getElementById('DataSource').addEventListener('change', function () {
    const val = this.value;
    document.getElementById('divMetaCampaign').style.display = (val === 'Meta Ads') ? 'block' : 'none';
    document.getElementById('divSeminarName').style.display = (val === 'Seminar Conference') ? 'block' : 'none';
    });

    // Cross-record and Same-record Phone Verification
 function verifyPhone(fieldId) {
        const phone = document.getElementById(fieldId).value.trim();
        const mainMobile = document.getElementById('MobileNumber').value.trim();
        const altMobile = document.getElementById('AlternateMobile').value.trim();

        if (!phone) {
            alert('Please enter a phone number first before verifying.');
            return;
        }

        if (fieldId === 'AlternateMobile' && mainMobile && altMobile && mainMobile === altMobile) {
            alert('❌ Mobile Number and Alternate Mobile cannot be the exact same!');
            return;
        }

        // 🚀 FIX: Using Url.Action for safe server routing
        fetch('@Url.Action("CheckDuplicatePhone", "Accounts")?phone=' + encodeURIComponent(phone))
        .then(async response => {
            if (!response.ok) throw new Error("HTTP Status " + response.status);
            return response.json();
        })
        .then(data => {
            if (data.error) {
                alert('⚠️ Database Error: ' + data.message);
            } else if (data.isDuplicate) {
                alert('⚠️ WARNING: This phone number already exists in another account record!');
            } else {
                alert('✅ This number is valid and unique in the system.');
            }
        })
        .catch(error => {
            console.error("Error verifying phone:", error);
            alert("Could not connect to the server. Check your browser console (F12) for details.");
        });
    }

   // 1. Global variable to store the API data
    let globalRegionData = [];

    // ==========================================
    // 2. ADDRESS CASCADING DROPDOWNS FIX
    // ==========================================
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Fetch Countries on page load
        fetch('@Url.Action("GetCountries", "Postcode")')
        .then(res => {
            if (!res.ok) throw new Error("HTTP Status " + res.status);
            return res.json();
        })
        .then(countries => {
            if (!countries || countries.length === 0) {
                console.warn("0 countries returned from API.");
            } else {
                populateDropdown('Addr1_Country', countries, 'Select Country');
                populateDropdown('Addr2_Country', countries, 'Select Country');
            }
        })
        .catch(err => console.error("Error loading countries:", err));

        // 2. Initialize Cascading Logic for both addresses
        setupCascadingDropdowns('Addr1_Country', 'Addr1_State', 'Addr1_City', 'Addr1_Zip');
        setupCascadingDropdowns('Addr2_Country', 'Addr2_State', 'Addr2_City', 'Addr2_Zip');
    });

    // Helper function to build dropdown options safely
    function populateDropdown(dropdownId, dataList, defaultText) {
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;

        dropdown.innerHTML = '<option value="">- ' + defaultText + ' -</option>';
        
        // Prevent crashes if dataList is wrapped in another object property
        if (!Array.isArray(dataList)) {
            dataList = dataList.data || dataList.results || [];
        }

        dataList.forEach(item => {
            const opt = document.createElement('option');
            opt.value = typeof item === 'object' ? (item.name || item.value || item.id || item.text) : item;
            opt.textContent = typeof item === 'object' ? (item.name || item.text || item.value) : item;
            dropdown.appendChild(opt);
        });
    }

    // Master function to handle the Country -> State -> City -> Zip flow
    function setupCascadingDropdowns(countryId, stateId, cityId, zipId) {
        const countryEl = document.getElementById(countryId);
        const stateEl = document.getElementById(stateId);
        const cityEl = document.getElementById(cityId);
        const zipEl = document.getElementById(zipId);

        // Country Change -> Load States
        if (countryEl) {
            countryEl.addEventListener('change', function () {
                const country = this.value;
                if (stateEl) stateEl.innerHTML = '<option value="">- Select State -</option>';
                if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                if (country) {
                    fetch('@Url.Action("GetStates", "Postcode")?country=' + encodeURIComponent(country))
                    .then(res => res.json())
                    .then(states => populateDropdown(stateId, states, 'Select State'))
                    .catch(err => console.error("Error fetching States:", err));
                }
            });
        }

        // State Change -> Load Cities
        if (stateEl) {
            stateEl.addEventListener('change', function () {
                const state = this.value;
                if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                if (state) {
                    fetch('@Url.Action("GetCities", "Postcode")?state=' + encodeURIComponent(state))
                    .then(res => res.json())
                    .then(cities => populateDropdown(cityId, cities, 'Select City'))
                    .catch(err => console.error("Error fetching Cities:", err));
                }
            });
        }

        // City Change -> Fetch and Populate Zip Code Dropdown
        if (cityEl) {
            cityEl.addEventListener('change', function () {
                const city = this.value;
                const state = stateEl ? stateEl.value : '';

                if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                if (city && state) {
                    fetch('@Url.Action("GetZipCodes", "Postcode")?city=' + encodeURIComponent(city) + '&state=' + encodeURIComponent(state))
                    .then(res => res.json())
                    .then(zipCodes => populateDropdown(zipId, zipCodes, 'Select Zip Code'))
                    .catch(err => console.error("Error fetching Zip Codes:", err));
                }
            });
        }
    }

        // ==========================================
    // 3. AUTO-CALCULATE AGE FROM DOB
    // ==========================================
    document.getElementById('DateOfBirth').addEventListener('change', function () {
    const dobVal = this.value;
    if (dobVal) {
    const dob = new Date(dobVal);
    const today = new Date();
    let age = today.getFullYear() - dob.getFullYear();
    const monthDiff = today.getMonth() - dob.getMonth();
    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
    age--; // Subtract a year if birthday hasn't happened yet this year
    }
    document.getElementById('Age').value = age > 0 ? age : 0;
    } else {
    document.getElementById('Age').value = '';
    }
    });

    // ==========================================
    // AUTO-CALCULATE PROFILE RATE & STATUS
    // ==========================================
    // The 14 exact fields from your Deluge script
    const profileFields = [
    'IsHomeopathicDoctor', 'WorkType', 'HasComputer', 'ClinicType',
    'Qualification', 'CollegeName', 'YearOfPassing', 'TotalExperience',
    'YearsOfPractice', 'AveragePatientFee', 'NumberOfClinics',
    'DateOfBirth', 'Age', 'PatientsPerDay'
    ];

    function calculateProfileMetrics() {
    let filledFieldsCount = 0;

    // 1. Calculate Rate: Count how many of the 14 fields actually have a value
    profileFields.forEach(id => {
    const el = document.getElementById(id);
    if (el && el.value.trim() !== '') {
    filledFieldsCount++;
    }
    });

    // 2. Fetch Field 1 and Field 3 for Status Logic
    const isHomeopath = document.getElementById('IsHomeopathicDoctor')?.value || '';
    const hasComputer = document.getElementById('HasComputer')?.value || '';

    // Adjusting for the specific "No" values in your dropdown
    const isHomeopathNo = (isHomeopath === 'No' || isHomeopath === 'नहीं' || isHomeopath === 'Not a Homeopath Doctor' || isHomeopath === 'Not a Homeopathy Doctor');
    const hasComputerNo = (hasComputer === 'No');

    // 3. Determine Profile Status matching the Deluge logic
    let calculatedStatus = "Not Completed";

    if (filledFieldsCount > 4 && !hasComputerNo && !isHomeopathNo) {
    calculatedStatus = "Strongly Completed";
    }
    else if (filledFieldsCount === 4 && !hasComputerNo && !isHomeopathNo) {
    calculatedStatus = "Completed";
    }
    else if (filledFieldsCount >= 4 && (hasComputerNo || isHomeopathNo)) {
    calculatedStatus = "Not-Qualified";
    }

    // 4. Inject the calculated Rate and Status automatically into the UI
    const statusField = document.getElementById('Profilestatus');
    const rateField = document.getElementById('ProfileRate');

    if (statusField) statusField.value = calculatedStatus;
    if (rateField) rateField.value = filledFieldsCount;
    }

    // 5. Attach listeners to trigger automatically on user input
    profileFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
    el.addEventListener('change', calculateProfileMetrics);
    if (el.tagName === 'INPUT') {
    el.addEventListener('input', calculateProfileMetrics); // Captures typing in real-time
    }
    }
    });

    // ==========================================
    // 4. STAGE FIELD LOGIC & DIRECT DEAL POPUP
    // ==========================================
    const stageSelect = document.getElementById('Stage');
    let previousStage = "";

    // SAFELY check if Stage exists before trying to read its value!
    if (stageSelect) {
    previousStage = stageSelect.value;
    const dealModal = new bootstrap.Modal(document.getElementById('directDealModal'));

    stageSelect.addEventListener('change', function () {
    const val = this.value;
    document.querySelectorAll('.dynamic-stage-field').forEach(el => el.style.display = 'none');

    if (val === 'Demo Scheduled') {
    document.querySelectorAll('.demo-fields').forEach(el => el.style.display = 'block');
    } else if (val === 'Trial Offered') {
    document.querySelectorAll('.trial-fields').forEach(el => el.style.display = 'block');
    } else if (val === 'Direct Deal') {
    dealModal.show();
    }

    if (val !== 'Direct Deal') {
    previousStage = val;
    }
    });

    const btnCancelDeal = document.getElementById('btnCancelDeal');
    if(btnCancelDeal) {
    btnCancelDeal.addEventListener('click', function () {
    stageSelect.value = previousStage;
    dealModal.hide();
    });
    }
    }

    // ==========================================
    // TOGGLE GROUP NAME BASED ON ACCOUNT TYPE
    // ==========================================
    function toggleAccountTypeFields() {
    const accountTypeSelect = document.getElementById('AccountType');
    const divGroupName = document.getElementById('divGroupName');

    if (accountTypeSelect && divGroupName) {
    // Show only if 'Group' is selected, otherwise hide
    if (accountTypeSelect.value === 'Group') {
    divGroupName.style.display = 'block';
    } else {
    divGroupName.style.display = 'none';

    // Optional: Automatically clear the Group Name selection if they change the type away from Group
    const groupNameInput = document.getElementById('GroupName');
    if(groupNameInput) groupNameInput.value = '';
    }
    }
    }

    // Attach the event listener to the dropdown
    const accountTypeEl = document.getElementById('AccountType');
    if (accountTypeEl) {
    accountTypeEl.addEventListener('change', toggleAccountTypeFields);

    // Run once on page load to ensure the correct visibility when editing an existing record
    document.addEventListener("DOMContentLoaded", toggleAccountTypeFields);
    }

 
 // ==========================================
    // 5. FORM SUBMISSION & VALIDATION POPUPS
    // ==========================================
    document.getElementById('accountForm').addEventListener('submit', function (e) {
        e.preventDefault(); // Stop default submission

        // --- STEP 1: CHECK MANDATORY FIELDS ---
        let isMandatoryValid = true;
        const requiredFields = this.querySelectorAll('[required]');
        
        requiredFields.forEach(field => {
            if (!field.value.trim()) {
                isMandatoryValid = false;
                field.style.boxShadow = "0 0 0 3px #ef4444";
                setTimeout(() => field.style.boxShadow = "none", 3500);
            }
        });

        if (!isMandatoryValid) {
            const mandatoryModalEl = document.getElementById('mandatoryFieldsModal');
            if (mandatoryModalEl) new bootstrap.Modal(mandatoryModalEl).show();
            else alert("Please fill in all mandatory fields marked with an asterisk (*).");
            return;
        }

        // --- STEP 2: ADDRESS VALIDATION ---
        const addrCountry = document.getElementById('Addr1_Country')?.value.trim() || "";
        const addrState = document.getElementById('Addr1_State')?.value.trim() || "";
        
        if (addrCountry === "" || addrState === "") {
            const addressModalEl = document.getElementById('addressValidationModal');
            if (addressModalEl) new bootstrap.Modal(addressModalEl).show();
            else alert("You forgot to complete the Primary Address! Please select both a Country and a State.");
            
            const stateField = document.getElementById('Addr1_State');
            if (stateField) {
                stateField.focus();
                stateField.style.boxShadow = "0 0 0 3px #ef4444";
                setTimeout(() => stateField.style.boxShadow = "none", 3500);
            }
            return;
        }

        // --- STEP 3: PROFESSIONAL PROFILE CHECK (< 4 Fields) ---
        const profileFieldsList = [
            'IsHomeopathicDoctor', 'WorkType', 'HasComputer', 'ClinicType',
            'Qualification', 'CollegeName', 'YearOfPassing', 'TotalExperience',
            'YearsOfPractice', 'AveragePatientFee', 'NumberOfClinics',
            'DateOfBirth', 'Age', 'PatientsPerDay'
        ];

        let filledFieldsCount = 0;
        profileFieldsList.forEach(id => {
            const el = document.getElementById(id);
            if (el && el.value.trim() !== '' && el.value.trim() !== '-None-') {
                filledFieldsCount++;
            }
        });

        const reasonValue = document.getElementById('ProfilePendingReason')?.value.trim() || "";

        // If less than 4 fields are filled AND no reason is provided
        if (filledFieldsCount < 4 && (reasonValue === "" || reasonValue === "-None-")) {
            const pendingModalEl = document.getElementById('pendingReasonModal');
            if (pendingModalEl) new bootstrap.Modal(pendingModalEl).show();
            else alert("Your professional profile has fewer than 4 fields filled! Please select a Profile Pending Reason.");
            
            const reasonField = document.getElementById('ProfilePendingReason');
            if (reasonField) {
                reasonField.focus();
                reasonField.style.boxShadow = "0 0 0 3px #ef4444";
                setTimeout(() => reasonField.style.boxShadow = "none", 3500);
            }
            return;
        }

        // --- STEP 4: QUALIFIED STATUS CONFIRMATION ---
        const qualStatus = document.getElementById('QualificationStatus')?.value;
        const formToSubmit = this;

        if (qualStatus === 'Qualified') {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Are you sure you want to make this account a Lead?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#2563eb',
                    cancelButtonColor: '#ef4444',
                    confirmButtonText: 'Yes, make it!',
                    cancelButtonText: 'No, cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        submitFormAjax(formToSubmit);
                    }
                });
                return; // Wait for user's click
            } else {
                if(!confirm('Are you sure you want to make this account a Lead?')) return;
            }
        }

        // If not 'Qualified', submit normally
        submitFormAjax(formToSubmit);
    });

    // Helper function to handle AJAX submission and Redirects
    function submitFormAjax(formElement) {
        const submitBtn = document.getElementById('saveAccountBtn') || formElement.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
        submitBtn.disabled = true;

        const formData = new FormData(formElement);

        fetch(formElement.action, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(response => {
            if (response.redirected) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Awesome!',
                        text: 'Account saved successfully.',
                        icon: 'success',
                        showConfirmButton: false,
                        timer: 2000, 
                        timerProgressBar: true
                    }).then(() => {
                        window.location.href = response.url; // Auto-redirects to Edit Page
                    });
                } else {
                    window.location.href = response.url;
                }
            } else if (response.ok) {
                window.location.href = '@Url.Action("Index", "Accounts")';
            } else {
                throw new Error("Server error");
            }
        })
        .catch(error => {
            console.error('Error:', error);
            if (typeof Swal !== 'undefined') {
                Swal.fire({ title: 'Oops!', text: 'Something went wrong while saving.', icon: 'error' });
            } else {
                alert('Something went wrong while saving.');
            }
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        });
    }

    // ==========================================
    // 🚀 NEW: MISSING EMAIL VERIFICATION LOGIC
    // ==========================================
    function verifyEmail(fieldId) {
        const emailInput = document.getElementById(fieldId);

        if (!emailInput) {
            alert("Error: Input field not found.");
            return;
        }

        const email = emailInput.value.trim();
        const mainEmail = document.getElementById('Email')?.value.trim() || '';
        const altEmail = document.getElementById('AlternateEmailID')?.value.trim() || '';

        if (!email) {
            alert('Please enter an email address first before verifying.');
            return;
        }

        // Prevent Main Email and Alternate Email from being identical
        if (fieldId === 'AlternateEmailID' && mainEmail && altEmail && mainEmail.toLowerCase() === altEmail.toLowerCase()) {
            alert('❌ Email and Alternate Email cannot be the exact same!');
            return;
        }

        // Add a small loading indicator to the button
        const btn = window.event ? (window.event.target || window.event.srcElement) : null;
        let originalBtnText = 'Verify';
        if (btn) {
            originalBtnText = btn.innerText;
            btn.innerText = '...';
            btn.disabled = true;
        }

        fetch('@Url.Action("CheckEmailDuplicate", "Accounts")?email=' + encodeURIComponent(email))
        .then(async response => {
            if (!response.ok) throw new Error("HTTP Status " + response.status);
            return response.json();
        })
        .then(data => {
            if (data.error) {
                alert('⚠️ Database Error: ' + data.message);
            } else if (data.isDuplicate) {
                alert('⚠️ WARNING: This email exists in the database!\n\n(Note: If this is the current email for this account, you can ignore this warning).');
            } else {
                alert('✅ This email is valid and unique in the system.');
            }
        })
        .catch(error => {
            console.error("Error verifying email:", error);
            alert("Could not connect to the server. Check your browser console (F12) for details.");
        })
        .finally(() => {
            if (btn) {
                btn.innerText = originalBtnText;
                btn.disabled = false;
            }
        });
    }
</script>