@model Radar_CRM.Models.Account

@{
    ViewData["Title"] = "Create Account";
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
    }

    body {
        background-color: var(--theme-bg-cream);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--theme-text-main);
        -webkit-font-smoothing: antialiased;
    }

    /* =========================================
       CREATE VIEW CSS (CLEAN ZOHO ALIGNMENT)
       ========================================= */
 .z-edit-container {
        background: #fff;
        max-width: 1400px;
        margin: 40px auto;
        padding: 0 !important; /* Forces edge-to-edge alignment */
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        overflow: hidden;
    }

  .z-edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 30px;
        background-color: var(--theme-navy-primary);
        margin: 0 !important;
        width: 100%;
        border-bottom: none;
    }

    .z-section-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        padding: 15px 30px;
        margin: 0;
        border-bottom: 1px solid var(--theme-border);
        background: #f1f5f9;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .z-form-section {
        padding: 24px 30px;
        background: #fff;
        margin: 0;
        border-bottom: 1px solid var(--theme-border);
    }

    .z-field-row {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
        position: relative;
    }

    .z-label {
        width: 35%;
        text-align: right;
        padding-right: 20px;
        font-size: 0.85rem;
        color: #475569;
        font-weight: 600;
    }

    .z-input-wrapper {
        width: 65%;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .z-input {
        width: 100%;
        border: 1px solid #94a3b8;
        border-radius: 4px;
        padding: 6px 12px;
        font-size: 0.9rem;
        color: #1f2937;
        transition: 0.2s;
        background: #fff;
        height: 38px;
    }

    .z-input:focus {
        border-color: var(--theme-navy-primary);
        box-shadow: 0 0 0 2px var(--theme-navy-light);
        outline: none;
    }

    .z-input[readonly], .z-input:disabled {
        background-color: #f8fafc;
        color: #64748b;
        cursor: not-allowed;
    }

    /* Premium Save Button */
    .btn-save-modern {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        padding: 10px 28px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-save-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.4);
        color: #ffffff;
    }

    .btn-save-modern:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    .verify-btn {
        background: var(--theme-navy-light);
        color: var(--theme-navy-primary);
        border: 1px solid var(--theme-navy-primary);
        font-weight: 600;
        border-radius: 4px;
        padding: 0 16px;
        height: 38px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: 0.2s;
        white-space: nowrap;
    }

    .verify-btn:hover {
        background: var(--theme-navy-primary);
        color: #fff;
    }
</style>

<form asp-action="Create" method="post" id="accountForm" enctype="multipart/form-data">
    <div class="z-edit-container">

        <!-- HEADER -->
        <div class="z-edit-header shadow-sm d-flex align-items-center justify-content-between" style="background-color: var(--theme-navy-primary); padding: 20px 30px; border-bottom: none;">
            <div class="z-header-title d-flex align-items-center m-0">
                <div style="background: rgba(255,255,255,0.15); padding: 8px 14px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                    <i class="fa-solid fa-building text-white fs-5"></i>
                </div>
                <span class="text-white" style="font-size: 1.35rem; font-weight: 600; letter-spacing: 0.02em;">Create New Account</span>
            </div>
            
            <div class="d-flex gap-3 align-items-center">
                <a asp-controller="Accounts" asp-action="Index" class="text-white text-decoration-none d-flex align-items-center pe-4 border-end" style="border-color: rgba(255,255,255,0.2) !important; font-size: 0.95rem; font-weight: 500; transition: 0.2s;" onmouseover="this.style.opacity='0.8';" onmouseout="this.style.opacity='1';">
                    <i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard
                </a>
                <a asp-controller="Accounts" asp-action="Index" class="btn px-4 fw-bold shadow-sm" style="background-color: #f1f3f5; border: 1px solid #e2e8f0; color: #1e293b; transition: 0.2s; font-size: 0.95rem;" onmouseover="this.style.backgroundColor='#e2e8f0'; this.style.color='#0f172a';" onmouseout="this.style.backgroundColor='#f1f3f5'; this.style.color='#1e293b';">
                    Cancel
                </a>
            </div>
        </div>

        <!-- SEC 1: MASTER DETAILS -->
        <h5 class="z-section-title">Master Details</h5>
        <div class="z-form-section row">
            <div class="col-md-6">
                <div class="z-field-row">
                    <div class="z-label">Data Source <span class="text-danger">*</span></div>
                    <div class="z-input-wrapper">
                        <select asp-for="DataSource" class="z-input" id="DataSource" required>
                            <option value="">-None-</option>
                            <option value="InboundCall">-InboundCall-</option>
                            <option value="Referral/Dealer">-Referral/Dealer-</option>
                            <option value="Meta Ads">Meta Ads</option>
                            <option value="Google AdWords">-Google AdWords-</option>
                            <option value="Outreach">-Outreach-</option>
                            <option value="Group Lead">-Group Lead-</option>
                            <option value="Institutiona">-Institutional-</option>
                            <option value="Webinar">Webinar</option>
                            <option value="KOMMO">KOMMO</option>
                            <option value="Google Organic SEO">Google Organic SEO</option>
                            <option value="Website Direct">Website Direct</option>
                            <option value="YouTube">YouTube</option>
                            <option value="LinkedIn">LinkedIn</option>
                            <option value="Instagram Organic">Instagram Organic</option>
                            <option value="Zoho Webinar">Zoho Webinar</option>
                            <option value="Reference Doctor">Reference Doctor</option>
                            <option value="Reference Dealer Partner">Reference Dealer Partner</option>
                            <option value="Free Trial Self Register">Free Trial Self Register</option>
                            <option value="Seminar Conference">Seminar Conference</option>
                            <option value="Cold Calling">Cold Calling</option>
                            <option value="WhatsApp Campaign">WhatsApp Campaign</option>
                            <option value="Email Campaign">Email Campaign</option>
                            <option value="Data Import Old DB">Data Import Old DB</option>
                            <option value="WHATSAPP - BJAIN RX LLP">WHATSAPP - BJAIN RX LLP</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Hidden Fields Preserved -->
            <div class="col-md-6" id="divMetaCampaign" style="display:none;"><div class="z-field-row"><div class="z-label">Meta Campaign Name</div><div class="z-input-wrapper"><input name="MetaCampaignName" class="z-input" placeholder="Enter campaign name..." /></div></div></div>
            <div class="col-md-6" id="divSeminarName" style="display:none;"><div class="z-field-row"><div class="z-label">Seminar Name</div><div class="z-input-wrapper"><input name="SeminarName" class="z-input" placeholder="Enter seminar name..." /></div></div></div>

            <div class="col-md-6">
                <div class="z-field-row">
                    <div class="z-label">Account Type</div>
                    <div class="z-input-wrapper">
                        <select asp-for="AccountType" class="z-input" id="AccountType">
                            <option value="None">None</option>
                            <option value="Individual">Individual</option>
                            <option value="Group">Group</option>
                            <option value="Institution">Institution</option>
                            <option value="Government Organisation">Government Organisation</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-6" id="divGroupName" style="display: none;">
                <div class="z-field-row">
                    <div class="z-label">Group Name</div>
                    <div class="z-input-wrapper">
                        <select asp-for="GroupName" asp-items="ViewBag.VendorsList" class="z-input" id="GroupName">
                            <option value="">-Select Group Name-</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="z-field-row">
                    <div class="z-label">Current Status</div>
                    <div class="z-input-wrapper">
                        <select asp-for="CurrentStatus" class="z-input">
                            <option value="None">None</option>
                            <option value="User">User</option>
                            <option value="Non User" selected>Non User</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="z-field-row">
                    <div class="z-label">Account Owner</div>
                    <div class="z-input-wrapper">
                        <select asp-for="AccountOwnerId" asp-items="ViewBag.UsersList" class="z-input">
                            <option value="">- Select Account Owner -</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-6" style="display: none;">
                <div class="z-field-row">
                    <div class="z-label">Date of Entry</div>
                    <div class="z-input-wrapper"><input asp-for="DateOfEntry" class="z-input" type="datetime-local" /></div>
                </div>
            </div>
        </div>

        <!-- SEC 2: PRIMARY DETAILS -->
        <h5 class="z-section-title">Primary Details</h5>
        <div class="z-form-section row">
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Account Name <span class="text-danger">*</span></div><div class="z-input-wrapper"><input asp-for="AccountName" class="z-input fw-bold" placeholder="Enter account name..." required /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Contact Person Name</div><div class="z-input-wrapper"><input asp-for="ContactPersonName" class="z-input" placeholder="Enter full name" /></div></div></div>
            
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Mobile Phone <span class="text-danger">*</span></div><div class="z-input-wrapper"><input asp-for="MobileNumber" class="z-input" id="MobileNumber" placeholder="+1 202-555-0117" required /><button type="button" class="verify-btn" onclick="verifyPhone('MobileNumber')">Verify</button></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Email <span class="text-danger">*</span></div><div class="z-input-wrapper"><input asp-for="Email" class="z-input text-primary" id="Email" placeholder="email@example.com" required /><button type="button" class="verify-btn" onclick="verifyEmail('Email')">Verify</button></div></div></div>
            
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Alternate Mobile</div><div class="z-input-wrapper"><input asp-for="AlternateMobile" class="z-input" id="AlternateMobile" placeholder="Optional..." /><button type="button" class="verify-btn" onclick="verifyPhone('AlternateMobile')">Verify</button></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Alternate Email</div><div class="z-input-wrapper"><input asp-for="AlternateEmailID" class="z-input" id="AlternateEmailID" placeholder="Alternate email..." /><button type="button" class="verify-btn" onclick="verifyEmail('AlternateEmailID')">Verify</button></div></div></div>

            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Profile Pending Reason</div><div class="z-input-wrapper"><select asp-for="ProfilePendingReason" class="z-input"><option value="">-None-</option><option value="Connected">Connected</option><option value="Wrong Number/Invalid Number">Wrong Number/Invalid Number</option><option value="Ringing">Ringing</option><option value="Switched Off">Switched Off</option><option value="Busy-Call Back Later">Busy-Call Back Later</option><option value="Not-Interested">Not-Interested</option><option value="Not a Doctor">Not a Doctor</option><option value="Student">Student</option><option value="Still Ringing Tried 3 times">Still Ringing Tried 3 times</option></select></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Qualification Status</div><div class="z-input-wrapper"><select asp-for="QualificationStatus" class="z-input"><option value="">-None-</option><option value="Qualified">Qualified</option><option value="Notqualified">Notqualified</option></select></div></div></div>

            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Profile Status</div><div class="z-input-wrapper"><select asp-for="Profilestatus" class="z-input" disabled><option value="">-None-</option><option value="Completed">Completed</option><option value="Strongly Completed">Strongly Completed</option><option value="Not Completed">Not Completed</option><option value="Not-Qualified">Not-Qualified</option></select></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Profile Rate</div><div class="z-input-wrapper"><input asp-for="ProfileRate" type="number" class="z-input" id="ProfileRate" readonly /></div></div></div>
        </div>

    

        <!-- SEC 4: ADDRESS INFORMATION -->
        <h5 class="z-section-title">Address Information</h5>
        <div class="z-form-section row">
            <!-- Primary Address -->
            <div class="col-md-6 pe-4">
                <h6 class="mb-3 text-muted fw-bold border-bottom pb-2">Primary Address</h6>
                <div class="z-field-row"><div class="z-label">Country</div><div class="z-input-wrapper"><select asp-for="Addr1_Country" class="z-input" id="Addr1_Country"></select></div></div>
                <div class="z-field-row"><div class="z-label">State <span class="text-danger">*</span></div><div class="z-input-wrapper"><select asp-for="Addr1_State" class="z-input" id="Addr1_State"></select></div></div>
                <div class="z-field-row"><div class="z-label">City</div><div class="z-input-wrapper"><select asp-for="Addr1_City" class="z-input" id="Addr1_City"></select></div></div>
                <div class="z-field-row"><div class="z-label">Zip / Postal Code</div><div class="z-input-wrapper"><select asp-for="Addr1_Zip" class="z-input" id="Addr1_Zip"></select></div></div>
                <div class="z-field-row"><div class="z-label">Flat / House No.</div><div class="z-input-wrapper"><input asp-for="Addr1_FlatHouse" class="z-input" placeholder="Apt, Suite, etc." /></div></div>
                <div class="z-field-row"><div class="z-label">Street Address</div><div class="z-input-wrapper"><input asp-for="Addr1_Street" class="z-input" placeholder="Street name and number" /></div></div>
                <div class="z-field-row"><div class="z-label">Latitude</div><div class="z-input-wrapper"><input asp-for="Addr1_Latitude" class="z-input" placeholder="e.g. 40.7128" /></div></div>
                <div class="z-field-row"><div class="z-label">Longitude</div><div class="z-input-wrapper"><input asp-for="Addr1_Longitude" class="z-input" placeholder="e.g. -74.0060" /></div></div>
            </div>
            <!-- Secondary Address -->
            <div class="col-md-6 ps-4" style="border-left: 1px solid var(--theme-border);">
                <h6 class="mb-3 text-muted fw-bold border-bottom pb-2">Secondary Address</h6>
                <div class="z-field-row"><div class="z-label">Country</div><div class="z-input-wrapper"><select asp-for="Addr2_Country" class="z-input" id="Addr2_Country"></select></div></div>
                <div class="z-field-row"><div class="z-label">State</div><div class="z-input-wrapper"><select asp-for="Addr2_State" class="z-input" id="Addr2_State"></select></div></div>
                <div class="z-field-row"><div class="z-label">City</div><div class="z-input-wrapper"><select asp-for="Addr2_City" class="z-input" id="Addr2_City"></select></div></div>
                <div class="z-field-row"><div class="z-label">Zip / Postal Code</div><div class="z-input-wrapper"><select asp-for="Addr2_Zip" class="z-input" id="Addr2_Zip"></select></div></div>
                <div class="z-field-row"><div class="z-label">Flat / House No.</div><div class="z-input-wrapper"><input asp-for="Addr2_FlatHouse" class="z-input" placeholder="Apt, Suite, etc." /></div></div>
                <div class="z-field-row"><div class="z-label">Street Address</div><div class="z-input-wrapper"><input asp-for="Addr2_Street" class="z-input" placeholder="Street name and number" /></div></div>
                <div class="z-field-row"><div class="z-label">Latitude</div><div class="z-input-wrapper"><input asp-for="Addr2_Latitude" class="z-input" placeholder="e.g. 40.7128" /></div></div>
                <div class="z-field-row"><div class="z-label">Longitude</div><div class="z-input-wrapper"><input asp-for="Addr2_Longitude" class="z-input" placeholder="e.g. -74.0060" /></div></div>
            </div>
        </div>

        <!-- SEC 5: PROFESSIONAL PROFILE & SOFTWARE -->
        <h5 class="z-section-title">Professional Profile & Software</h5>
        <div class="z-form-section row">
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Homeopathic Doctor</div><div class="z-input-wrapper"><select asp-for="IsHomeopathicDoctor" class="z-input"><option value="">-None-</option><option value="Yes — MD(Homeopathy)">Yes — MD(Homeopathy)</option><option value="मैं होम्योपैथी डॉक्टर नहीं हूँ।">मैं होम्योपैथी डॉक्टर नहीं हूँ।</option><option value="हां- बीएचएमएस">हां- बीएचएमएस</option><option value="नहीं">नहीं</option><option value="बीएचएमएस की पढ़ाई कर रहा हूँ">बीएचएमएस की पढ़ाई कर रहा हूँ</option><option value="Yes - BHMS">Yes - BHMS</option><option value="Not a Homeopath Doctor">Not a Homeopath Doctor</option><option value="Yes">Yes</option><option value="No">No</option><option value="Not a Homeopathy Doctor">Not a Homeopathy Doctor</option><option value="Pursuing BHMS">Pursuing BHMS</option></select></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Clinic Type</div><div class="z-input-wrapper"><select asp-for="ClinicType" class="z-input"><option value="">-None-</option><option value="Own">Own</option><option value="Visiting">Visiting</option><option value="Hospital Attached">Hospital Attached</option><option value="Govt.service">Govt.service</option><option value="Chain Clinics">Chain Clinics</option></select></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Work Type</div><div class="z-input-wrapper"><select asp-for="WorkType" class="z-input"><option value="">-None-</option><option value="Practicing">Practicing</option><option value="Job">Job</option><option value="Research">Research</option><option value="others">others</option></select></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Have computer/Laptop?</div><div class="z-input-wrapper"><select asp-for="HasComputer" class="z-input"><option value="">-Select-</option><option value="Yes">Yes</option><option value="No">No</option></select></div></div></div>
            
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Date of Birth</div><div class="z-input-wrapper"><input asp-for="DateOfBirth" type="date" class="z-input" id="DateOfBirth" /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Age</div><div class="z-input-wrapper"><input asp-for="Age" type="number" class="z-input" id="Age" readonly /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Years of practice</div><div class="z-input-wrapper"><input asp-for="YearsOfPractice" type="number" class="z-input" /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Total experience</div><div class="z-input-wrapper"><input asp-for="TotalExperience" type="number" class="z-input" /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Number of Clinics</div><div class="z-input-wrapper"><input asp-for="NumberOfClinics" type="number" class="z-input" /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Patients per Day</div><div class="z-input-wrapper"><input asp-for="PatientsPerDay" type="number" class="z-input" /></div></div></div>
            
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Qualification</div><div class="z-input-wrapper"><select asp-for="Qualification" class="z-input"><option value="">-Select-</option><option value="BHMS">BHMS</option><option value="MD">MD</option><option value="BAMS">BAMS</option><option value="Student">Student</option></select></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Year of passing</div><div class="z-input-wrapper"><input asp-for="YearOfPassing" class="z-input" /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">College Name</div><div class="z-input-wrapper"><input asp-for="CollegeName" class="z-input" /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Avg Patient Fee (₹)</div><div class="z-input-wrapper"><input asp-for="AveragePatientFee" type="number" class="z-input" /></div></div></div>

            <div class="col-12 mt-3 pt-3 border-top"><h6 class="fw-bold text-muted ps-4 mb-3">Software Tools</h6></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Currently Using Software?</div><div class="z-input-wrapper"><select asp-for="CurrentlyUsingSoftware" class="z-input"><option value="">-Select-</option><option value="Yes">Yes</option><option value="No">No</option></select></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Current Software Name</div><div class="z-input-wrapper"><input asp-for="CurrentSoftwareName" class="z-input" /></div></div></div>
        </div>

        <!-- SEC 6: PURCHASES & TRACKING -->
        <h5 class="z-section-title">Product, Purchases & Tracking</h5>
        <div class="z-form-section row">
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Product Purchased</div><div class="z-input-wrapper"><input asp-for="ProductPurchased" class="z-input" /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Purchase Date</div><div class="z-input-wrapper"><input asp-for="PurchaseDate" type="date" class="z-input" /></div></div></div>
            <div class="col-md-6"><div class="z-field-row"><div class="z-label">Purchase Value (₹)</div><div class="z-input-wrapper"><input asp-for="PurchaseValue" type="number" class="z-input" /></div></div></div>
