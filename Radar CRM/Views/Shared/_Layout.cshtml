    <!-- Define Global Base Path -->
    <script>
            const basePath = '@Url.Content("~/")';
    </script>

   <!-- UI & Search Scripts -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // --- Dynamic Active State Logic based on URL ---
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.sidebar-nav .nav-item-link');

            navLinks.forEach(l => l.classList.remove('active'));

            let matched = false;

            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (!href || href === '#' || link.hasAttribute('data-bs-toggle')) return;

                const linkPath = href.toLowerCase();

                if (currentPath.includes(linkPath) && linkPath !== '/') {
                    link.classList.add('active');
                    matched = true;

                    const parentCollapse = link.closest('.collapse.sub-menu');
                    if (parentCollapse) {
                        parentCollapse.classList.add('show');
                        const trigger = document.querySelector(`[aria-controls="${parentCollapse.id}"]`);
                        if(trigger) trigger.setAttribute('aria-expanded', 'true');

                    }
                }
            });

            if (!matched && (currentPath === '/' || currentPath === '')) {
                const homeLink = document.querySelector('a[href="/"]');
                if (homeLink) homeLink.classList.add('active');
            }

            // --- Mobile Sidebar Toggle ---
            const mobileBtn = document.getElementById('mobileMenuBtn');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');

            if(mobileBtn) {
                mobileBtn.addEventListener('click', () => {
                    sidebar.classList.add('show-sidebar');
                    overlay.classList.add('show-overlay');
                });
            }

            if(overlay) {
                overlay.addEventListener('click', () => {
                    sidebar.classList.remove('show-sidebar');
                    overlay.classList.remove('show-overlay');
                });
            }

            // --- Global Search Logic (Zoho Style) ---
            const searchInput = document.getElementById('globalSearchInput');
            const resultsDropdown = document.getElementById('globalSearchResults');
            let searchTimeout = null;

            // Ensure base path is available for environments with virtual directories
            const searchBasePath = typeof basePath !== 'undefined' ? basePath : '/';

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !resultsDropdown.contains(e.target)) {
                    resultsDropdown.style.display = 'none';
                }
            });

            searchInput.addEventListener('input', function () {
                const query = this.value.trim();

                clearTimeout(searchTimeout);

                if (query.length < 2) {
                    resultsDropdown.style.display = 'none';
                    return;
                }

                resultsDropdown.style.display = 'block';
                resultsDropdown.innerHTML = '<div class="p-3 text-center text-muted fw-medium"><div class="spinner-border spinner-border-sm me-2"></div>Searching...</div>';

                // Debounce API call by 300ms
                searchTimeout = setTimeout(() => {
                    fetch(`${searchBasePath}Search/GlobalSearch?query=${encodeURIComponent(query)}`)
                        .then(response => {
                            if (!response.ok) throw new Error("Search API failed");
                            return response.json();
                        })
                        .then(data => renderSearchResults(data))
                        .catch(error => {
                            console.error("Search Error:", error);
                            resultsDropdown.innerHTML = '<div class="p-3 text-center text-danger fw-medium">Error fetching results.</div>';
                        });
                }, 300);
            });

            function renderSearchResults(data) {
                if (!data || data.length === 0) {
                    resultsDropdown.innerHTML = '<div class="p-3 text-center text-muted fw-medium">No records found.</div>';
                    return;
                }

                let html = '';
                data.forEach(item => {
                    // Render Zoho style: Title on left, Module Name on right
                    html += `
                    <a href="${searchBasePath}${item.url.replace(/^\//, '')}" class="search-result-item">
                        <div class="search-result-left">
                            <div class="search-result-icon"><i class="bi ${item.icon}"></i></div>
                            <div class="search-result-details">
                                <h6>${item.title}</h6>
                                ${item.subtitle ? `<p>${item.subtitle}</p>` : ''}
                            </div>
                        </div>
                        <div class="search-result-module">${item.module}</div>
                    </a>
                    `;
                });

                resultsDropdown.innerHTML = html;
            }
        });
    </script>

    <!-- ========================================== -->
    <!-- LIVE NOTIFICATION POLLING SYSTEM           -->
    <!-- ========================================== -->
    <script>
            document.addEventListener("DOMContentLoaded", function () {
            // Check instantly on load, then every 15 seconds
            checkNewAssignments();
            setInterval(checkNewAssignments, 15000);
            });

            function checkNewAssignments() {
                    fetch(basePath + 'Notifications/GetUnread')
            .then(response => response.json())
            .then(res => {
            if (res.success && res.data && res.data.length > 0) {
            res.data.forEach(notification => {
            // Prevent showing the same popup twice if it's already on screen
            if (!document.getElementById('toast_' + notification.id)) {
            showNotificationPopup(notification);
            }
            });
            }
            })
            .catch(err => console.error("Notification Polling Error:", err));
            }

            function showNotificationPopup(notification) {
            const container = document.getElementById('globalToastContainer');
            if (!container) return;

            const toastId = 'toast_' + notification.id;

            const toastHtml = `
            <div id="${toastId}" class="toast shadow-lg mb-3" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="false" style="border-radius: 12px; border-left: 6px solid #2563eb;">
            <div class="toast-header" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; border-radius: 12px 12px 0 0;">
            <i class="fa-solid fa-bell text-primary me-2 fs-5"></i>
            <strong class="me-auto text-dark" style="font-size: 1rem;">New Assignment</strong>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="toast" aria-label="Close" onclick="markNotificationRead(${notification.id}, '${toastId}')"></button>
            </div>
            <div class="toast-body p-3" style="background-color: #ffffff; border-radius: 0 0 12px 12px; color: #334155; font-size: 0.95rem;">
            ${notification.subject}
            <div class="mt-3 pt-2 text-end">
            <button type="button" class="btn btn-sm" style="background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; font-weight: 600;" onclick="markNotificationRead(${notification.id}, '${toastId}')">
            <i class="fa-solid fa-check me-1"></i> Got it
            </button>
            </div>
            </div>
            </div>`;

            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = new bootstrap.Toast(document.getElementById(toastId));
            toast.show();
            }

            window.markNotificationRead = function(id, toastId) {
                    fetch(basePath + 'Notifications/MarkAsRead?id=' + id, { method: 'POST' })
            .then(() => {
            const toastEl = document.getElementById(toastId);
            if (toastEl) bootstrap.Toast.getInstance(toastEl).hide();
            })
            .catch(err => console.error("Error marking read:", err));
            };

                        function exportTableData(moduleName, format) {
                // 1. Map module names to their respective table IDs
                const tableMap = {
                    'Accounts': 'accountsTable',
                    'Deals': 'dealsTable',
                    'Leads': 'leadsTable',
                    'Products': 'productsTable',
                    'Tasks': 'tasksTable',
                    'Vendors': 'vendorsTable'
                };

                const tableId = tableMap[moduleName];
                const table = document.getElementById(tableId);

                if (!table) {
                    alert("Table not found for module: " + moduleName);
                    return;
                }

                // 2. Gather target rows based on selection
                let targetRows = [];
                const checkedCbs = table.querySelectorAll("tbody .row-cb:checked");

                if (checkedCbs.length > 0) {
                    checkedCbs.forEach(cb => targetRows.push(cb.closest('tr')));
                } else {
                    // Vendor logic: Export all visible if none checked. Others: Require checkboxes.
                    if (moduleName === 'Vendors') {
                        table.querySelectorAll("tbody tr").forEach(tr => {
                            if (!tr.classList.contains('filtered-out') && tr.style.display !== 'none') {
                                targetRows.push(tr);
                            }
                        });
                    } else {
                        alert("Please select at least one record using the checkboxes before exporting.");
                        return;
                    }
                }

                if (targetRows.length === 0) {
                    alert("No data available to export.");
                    return;
                }

                // 3. Extract Headers
                let dataMatrix = [];
                let headerRow = [];
                table.querySelectorAll("thead th[data-col-name]").forEach(th => {
                    if(th.style.display !== 'none') {
                        let span = th.querySelector('span');
                        headerRow.push(span ? span.innerText.trim() : th.innerText.trim());
                    }
                });
                dataMatrix.push(headerRow);

                // 4. Extract Row Data
                targetRows.forEach(tr => {
                    let rowData = [];
                    tr.querySelectorAll("td[data-col-index]").forEach(td => {
                        if(td.style.display !== 'none') {
                            rowData.push(td.innerText.trim());
                        }
                    });
                    dataMatrix.push(rowData);
                });

                // 5. Format filename with current date
                const dateStr = new Date().toISOString().slice(0, 10);
                const filename = `${moduleName}_Export_${dateStr}`;

                // 6. Generate File
                if (format === 'csv') {
                    let csvContent = dataMatrix.map(row =>
                        row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(",")
                    ).join("\n");

                    let blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
                    let link = document.createElement("a");
                    link.href = window.URL.createObjectURL(blob);
                    link.download = filename + ".csv";
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }
                else if (format === 'xlsx') {
                    if (typeof XLSX === 'undefined') {
                        alert("Excel export library is currently loading or unavailable.");
                        return;
                    }
                    let worksheet = XLSX.utils.aoa_to_sheet(dataMatrix);
                    let workbook = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(workbook, worksheet, moduleName);
                    XLSX.writeFile(workbook, filename + ".xlsx");
                }
            }
    </script>

    <script>
            // 1. Immediately check storage on page load
            if (localStorage.getItem('radar_sidebar_collapsed') === 'true') {
                document.body.classList.add('full-view-mode');
            }

            document.addEventListener("DOMContentLoaded", function () {
                const toggleBtn = document.getElementById('hideLayoutBtn');

                if (toggleBtn) {
                    toggleBtn.addEventListener('click', function () {
                        const isCollapsed = document.body.classList.contains('full-view-mode');

                        if (isCollapsed) {
                            // Expand Sidebar
                            document.body.classList.remove('full-view-mode');
                            localStorage.setItem('radar_sidebar_collapsed', 'false');
                        } else {
                            // Collapse Sidebar
                            document.body.classList.add('full-view-mode');
                            localStorage.setItem('radar_sidebar_collapsed', 'true');
                        }
                    });
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
