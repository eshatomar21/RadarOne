<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Radar One</title>
    <script type="importmap"></script>

    <!-- Standard Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            /* --- Premium Enterprise SaaS Palette (Zoho Flat Theme) --- */
            @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

            :root {
                --bg-light: #f3f4f6; /* Lighter Zoho gray background */
                --bg-surface: #ffffff;
                --navbar-bg: #ffffff;
                --navbar-border: #e5e7eb;
                --primary-blue: #2563eb;
                --primary-hover: #1d4ed8;
                --text-dark: #111827;
                --text-main: #374151;
                --text-muted: #6b7280;
                /* Flat Sidebar Theme */
                --sidebar-bg: #ffffff;
                --sidebar-border: #e5e7eb;
                --sidebar-text: #4b5563;
                --sidebar-hover-bg: #f9fafb;
                --sidebar-hover-text: #111827;
                --sidebar-active-bg: #eff6ff;
                --sidebar-active-text: #2563eb;
                --border-soft: #e5e7eb;
                --border-dark: #94a3b8;
                --radius-md: 4px; /* Strict, small corners */
                --radius-lg: 0px;
                --shadow-sm: none; /* Flattening the UI */
                --shadow-soft: none;
                --btn-depth: 0px;
            }

            /* Override layout whitespace */
            body .content-area {
                padding: 0 !important;
                background-color: var(--bg-body);
            }

            body {
                margin: 0;
                padding: 0;
                overflow: hidden;
                background-color: var(--bg-light);
                font-family: 'Inter', sans-serif;
                font-size: 0.85rem;
                color: var(--text-main);
            }

            .app-container {
                display: flex;
                height: 100vh;
                width: 100vw;
            }

            /* --- Flat Sidebar Styling --- */
            .sidebar {
                width: 240px;
                background-color: var(--sidebar-bg);
                border-right: 1px solid var(--sidebar-border);
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                z-index: 1040;
                transition: width 0.3s ease; /* Smooth collapse */
                overflow-x: hidden;
                white-space: nowrap;
            }

            .sidebar-brand {
                padding: 0 1.25rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 60px; /* Slimmer Zoho header height */
                border-bottom: 1px solid var(--sidebar-border);
            }

            .brand-logo-container {
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .brand-logo-container img {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    object-fit: cover;
                }

                .brand-logo-container h5 {
                    font-weight: 700;
                    margin: 0;
                    font-size: 1.1rem;
                    color: #0f172a;
                }

            .sidebar-nav {
                padding: 1rem;
                overflow-y: auto;
                flex-grow: 1;
            }

                .sidebar-nav::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-nav::-webkit-scrollbar-thumb {
                    background-color: #cbd5e1;
                    border-radius: 4px;
                }

            .nav-section-title {
                font-size: 0.75rem;
                text-transform: uppercase;
                font-weight: 800;
                color: #94a3b8;
                letter-spacing: 0.1em;
                margin: 1rem 0 0.5rem 0.5rem;
            }

            .nav-item-link {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0.6rem 1rem;
                color: var(--sidebar-text);
                text-decoration: none;
                border-radius: 6px;
                margin-bottom: 4px;
                font-weight: 500;
                font-size: 0.9rem;
            }

            .nav-item-link-content {
                display: flex;
                align-items: center;
            }

            .nav-item-link:hover:not(.active) {
                background-color: var(--sidebar-hover-bg);
                color: var(--sidebar-hover-text);
            }

            .nav-item-link.active {
                background-color: var(--sidebar-active-bg);
                color: var(--sidebar-active-text);
                font-weight: 600;
            }

            .icon-3d {
                margin-right: 0.75rem;
                font-size: 1.1rem;
                transition: 0.2s;
                filter: none;
            }

            .nav-item-link.active .icon-3d {
                color: var(--sidebar-active-text) !important;
            }

            .toggle-arrow {
                transition: transform 0.3s ease;
                font-size: 0.85rem;
                color: #6b7280;
                font-weight: bold;
            }

            .nav-item-link[aria-expanded="true"] {
                background-color: #e5e7eb;
                color: #111827;
            }

                .nav-item-link[aria-expanded="true"] .toggle-arrow {
                    transform: rotate(180deg);
                }

            .collapse.sub-menu {
                margin-left: 1.5rem;
                padding-left: 0.5rem;
                border-left: 2px solid #e5e7eb;
                margin-top: 4px;
                margin-bottom: 12px;
                transition: all 0.3s ease-in-out;
            }

            .sub-menu .nav-item-link {
                font-size: 0.85rem;
                padding: 0.5rem 1rem;
                margin-bottom: 2px;
            }

            /* --- Collapsed Sidebar Logic --- */
            body.full-view-mode .sidebar {
                width: 64px !important;
            }

            body.full-view-mode .sidebar-brand {
                justify-content: center;
                padding: 0;
            }

            body.full-view-mode .brand-logo-container h5,
            body.full-view-mode .nav-section-title,
            body.full-view-mode .toggle-arrow,
            body.full-view-mode .nav-item-link-text {
                display: none !important;
            }

            body.full-view-mode .nav-item-link {
                padding: 0.75rem 0;
                justify-content: center;
            }

            body.full-view-mode .nav-item-link-content {
                justify-content: center;
                width: 100%;
            }

            body.full-view-mode .icon-3d {
                margin-right: 0 !important;
                font-size: 1.25rem;
            }

            body.full-view-mode .sub-menu {
                display: none !important;
            }

            /* Toggle Button States */
            #showLayoutBtnIcon {
                display: none;
            }

            body.full-view-mode #hideLayoutBtnText {
                display: none;
            }

            body.full-view-mode #showLayoutBtnIcon {
                display: block;
                font-size: 1.1rem;
                color: #6b7280;
                padding: 18px 0;
            }

            body.full-view-mode .brand-logo-container {
                display: none;
            }

            #showLayoutBtn {
                display: none !important;
            }

            /* --- Top Navbar Styling (Slim & Flat) --- */
            .main-wrapper {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .top-navbar {
                height: 60px;
                background-color: var(--navbar-bg);
                border-bottom: 1px solid var(--navbar-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 1.5rem;
                flex-shrink: 0;
                z-index: 10;
            }

            .content-area {
                flex-grow: 1;
                overflow-y: auto;
                padding: 0;
                background-color: var(--bg-light);
                position: relative;
                z-index: 1;
            }

            /* Global Search */
            .search-wrapper {
                position: relative;
                max-width: 480px;
                width: 100%;
                margin: 0 20px;
            }

                .search-wrapper .bi-search {
                    position: absolute;
                    left: 16px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #6b7280;
                    font-size: 1rem;
                    z-index: 2;
                    font-weight: bold;
                }

                .search-wrapper input {
                    width: 100%;
                    padding-left: 46px;
                    border-radius: 6px;
                    background-color: #f3f4f6;
                    border: 1px solid transparent;
                    font-size: 0.9rem;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    color: #111827;
                    font-weight: 500;
                }

                    .search-wrapper input:focus {
                        background-color: #ffffff;
                        border-color: var(--primary-blue);
                        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
                        outline: none;
                    }

                        .search-wrapper input:focus + .bi-search {
                            color: var(--primary-blue);
                        }

            /* Search Dropdown */
            .search-results-dropdown {
                display: none;
                position: absolute;
                top: 110%;
                left: 0;
                width: 100%;
                background: white;
                border: 1px solid var(--navbar-border);
                border-radius: 6px;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
                z-index: 999999 !important;
                max-height: 400px;
                overflow-y: auto;
            }

            .search-result-item {
                padding: 10px 16px;
                border-bottom: 1px solid #f3f4f6;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: space-between;
                text-decoration: none;
                color: inherit;
            }

                .search-result-item:last-child {
                    border-bottom: none;
                }

                .search-result-item:hover {
                    background: #f9fafb;
                }

            .search-result-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .search-result-icon i {
                color: #6b7280;
                font-size: 1.1rem;
            }

            .search-result-details h6 {
                margin: 0;
                font-size: 0.85rem;
                font-weight: 600;
                color: #111827;
            }

            .search-result-details p {
                margin: 2px 0 0 0;
                font-size: 0.7rem;
                color: #6b7280;
            }

            .search-result-module {
                font-size: 0.7rem;
                color: #9ca3af;
                font-weight: 500;
            }

            /* Action Buttons (Flat Zoho Style) */
            .header-actions {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            .btn-signout {
                color: #6b7280;
                font-size: 0.85rem;
                font-weight: 600;
                text-decoration: none;
                padding: 6px 14px;
                border-radius: 6px;
                border: 1px solid var(--navbar-border);
                background: white;
            }

                .btn-signout:hover {
                    background-color: #fef2f2;
                    color: #dc2626;
                    border-color: #fca5a5;
                }

            .btn-saas {
                background-color: #f9fafb;
                color: var(--text-dark);
                border: 1px solid #d1d5db;
                font-weight: 500;
                border-radius: var(--radius-md);
                padding: 5px 14px;
                font-size: 0.8rem;
                transition: all 0.1s ease;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                cursor: pointer;
                box-shadow: none;
            }

                .btn-saas:hover {
                    background-color: #f3f4f6;
                }

            .btn-saas-primary {
                background-color: var(--primary-blue) !important;
                color: #ffffff !important;
                font-weight: 500;
                border: 1px solid var(--primary-hover) !important;
                border-radius: var(--radius-md);
                padding: 5px 18px;
                font-size: 0.8rem;
                box-shadow: none;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .btn-saas-primary:hover {
                    background-color: var(--primary-hover) !important;
                }

            .btn-saas-danger {
                background-color: #fef2f2;
                color: #b91c1c;
                border: 1px solid #fca5a5;
            }

                .btn-saas-danger:hover {
                    background-color: #fee2e2;
                }

            .user-dropdown-btn {
                background: none;
                border: none;
                padding: 0;
                cursor: pointer;
            }

            .avatar-circle {
                width: 36px;
                height: 36px;
                background: linear-gradient(135deg, #1e3a8a, #0ea5e9);
                color: #ffffff;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 600;
                font-size: 1rem;
                border: 2px solid #ffffff;
            }

            /* --- Unified Layout Grid (Zero Gaps like Zoho) --- */
            .crm-container {
                display: flex;
                height: calc(100vh - 60px);
                gap: 0;
                width: 100%;
                max-width: 100%;
                border-top: 1px solid var(--border-soft);
                background: var(--bg-surface);
            }

            /* Flat Sidebar inside CRM Container */
            .filter-sidebar {
                width: 260px;
                min-width: 260px;
                background: var(--bg-surface);
                border-right: 1px solid var(--border-soft);
                display: flex;
                flex-direction: column;
                height: 100%;
                transition: width 0.3s ease, min-width 0.3s ease;
            }

                .filter-sidebar.hidden-sidebar {
                    width: 0 !important;
                    min-width: 0 !important;
                    border-right: none !important;
                    opacity: 0;
                    overflow: hidden;
                }

            .filter-header {
                padding: 12px 16px;
                border-bottom: 1px solid var(--border-soft);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .filter-header h6 {
                    margin: 0;
                    font-weight: 600;
                    font-size: 0.85rem;
                    color: var(--text-dark);
                }

            .filter-search-box {
                padding: 12px 16px;
                border-bottom: 1px solid var(--border-soft);
                background-color: #f8fafc;
            }

            .filter-body {
                overflow-y: auto;
                flex-grow: 1;
                padding: 0;
            }

            .filter-field-item {
                padding: 10px 16px;
                border-bottom: 1px solid #f1f5f9;
                transition: background-color 0.2s;
            }

                .filter-field-item:hover {
                    background-color: #f8fafc;
                }

            .filter-expanded-area {
                display: none;
                margin-top: 10px;
                padding-left: 24px;
            }

            .filter-field-item.active .filter-expanded-area {
                display: block;
                animation: fadeIn 0.3s ease;
            }

            /* Table Area (Flat) */
            .table-container {
                flex: 1;
                min-width: 0;
                background: var(--bg-surface);
                display: flex;
                flex-direction: column;
                height: 100%;
                overflow: hidden;
                border-radius: 0;
                box-shadow: none;
                border: none;
            }

            .table-toolbar {
                padding: 8px 16px;
                border-bottom: 1px solid var(--border-soft);
                display: flex;
                align-items: center;
                background-color: var(--bg-surface);
                gap: 10px;
            }

            /* The Table */
            .table-responsive {
                overflow: auto;
                flex-grow: 1;
                width: 100%;
            }

            .table {
                margin-bottom: 0;
                white-space: nowrap;
                border-collapse: separate;
                border-spacing: 0;
            }

            #accountsTable {
                width: 100% !important;
                min-width: max-content !important;
            }

            .table thead th, .table tbody td {
                border-right: 1px solid var(--border-dark) !important;
            }

                .table thead th:last-child, .table tbody td:last-child {
                    border-right: none !important;
                }

            /* Header Icons */
            .header-action-icon {
                cursor: pointer;
                opacity: 0.4;
                transition: 0.2s;
                padding: 4px;
                font-size: 0.9rem;
            }

                .header-action-icon:hover {
                    opacity: 1;
                    color: var(--primary-blue) !important;
                    background: #e2e8f0;
                    border-radius: 4px;
                }

            /* Tighter Zoho Table Density */
            .table thead th {
                background-color: var(--bg-surface);
                color: #111827;
                font-weight: 600;
                font-size: 0.75rem;
                text-transform: none;
                padding: 8px 12px;
                border-bottom: 2px solid var(--border-soft);
                position: sticky;
                top: 0;
                z-index: 10;
            }

            .th-content {
                display: flex;
                justify-content: space-between;
                align-items: center;
                width: 100%;
                gap: 12px;
            }

            .table tbody td {
                padding: 6px 12px;
                font-size: 0.8rem;
                border-bottom: 1px solid #f3f4f6;
                vertical-align: middle;
                color: var(--text-dark);
                font-weight: 500;
                background-color: var(--bg-surface);
            }

            .table tbody tr:hover td {
                background-color: #f8fafc;
            }

            /* Sticky Columns */
            .sticky-cb {
                position: sticky;
                left: 0;
                width: 40px;
                min-width: 40px;
                text-align: center;
                z-index: 11;
                background-color: var(--bg-surface);
            }

            .sticky-actions {
                position: sticky;
                right: 0;
                width: 100px;
                text-align: center;
                z-index: 11;
                background-color: var(--bg-surface);
            }

            .table thead th.sticky-cb, .table thead th.sticky-actions {
                z-index: 12;
                background-color: var(--bg-surface);
            }

            /* Dummy Filler Column */
            .dummy-filler-col {
                width: auto !important;
                max-width: none !important;
                min-width: 10px !important;
                padding: 0 !important;
                border: none !important;
                background: transparent !important;
                pointer-events: none;
            }

            /* Task Ribbon */
            .task-ribbon {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 16px 4px 8px;
                font-size: 0.75rem;
                font-weight: 700;
                clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 50%, calc(100% - 10px) 100%, 0 100%);
                cursor: pointer;
                white-space: nowrap;
                transition: 0.2s;
            }

                .task-ribbon:hover {
                    opacity: 0.8;
                }

            .task-ribbon-blue {
                background-color: #eff6ff;
                color: #3b82f6;
            }

            .task-ribbon-red {
                background-color: #fef2f2;
                color: #ef4444;
            }

            .task-ribbon-green {
                background-color: #f0fdf4;
                color: #22c55e;
            }

            /* Custom Views Tabs */
            .custom-views-nav {
                display: flex;
                align-items: center;
                gap: 8px;
                overflow-x: auto;
                white-space: nowrap;
                scrollbar-width: none;
            }

                .custom-views-nav::-webkit-scrollbar {
                    display: none;
                }

            .view-tab {
                padding: 6px 12px;
                font-size: 0.85rem;
                font-weight: 500;
                color: var(--text-muted);
                text-decoration: none;
                border-radius: 4px;
                transition: 0.2s;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .view-tab:hover {
                    background-color: #f3f4f6;
                    color: var(--text-dark);
                }

                .view-tab.active {
                    background-color: #eff6ff;
                    color: var(--primary-blue);
                    font-weight: 600;
                }

            /* Modals & Criteria Builder */
            .criteria-card {
                border: 1px solid #e5e7eb;
                border-radius: 6px;
                padding: 20px;
                background-color: #ffffff;
                margin-bottom: 0;
            }

            .criteria-header {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 20px;
            }

                .criteria-header h6 {
                    margin: 0;
                    font-weight: 600;
                    color: #111827;
                    font-size: 0.95rem;
                }

            .criteria-row-builder {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 8px;
            }

            .criteria-num {
                width: 26px;
                height: 26px;
                border: 1px solid #d1d5db;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.8rem;
                color: #6b7280;
                font-weight: 600;
                flex-shrink: 0;
            }

            .criteria-builder-select, .criteria-builder-input {
                border: 1px solid #d1d5db;
                border-radius: 4px;
                padding: 6px 10px;
                font-size: 0.85rem;
                color: #374151;
                background-color: #ffffff;
                outline: none;
            }

                .criteria-builder-input:focus, .criteria-builder-select:focus {
                    border-color: var(--primary-blue);
                }

            .criteria-action-btn {
                background: transparent;
                border: none;
                padding: 4px;
                cursor: pointer;
                transition: 0.2s;
            }

            .criteria-connector-vertical {
                margin-left: 12px;
                border-left: 1px solid #d1d5db;
                padding: 6px 0 6px 10px;
                color: #16a34a;
                font-size: 0.7rem;
                font-weight: 600;
            }

            /* Custom Tooltip Theme */
            .custom-tooltip .tooltip-inner {
                background-color: #ffffff;
                color: #111827;
                border: 1px solid #e5e7eb;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
                text-align: left;
                padding: 10px 14px;
                max-width: 250px;
                border-radius: 6px;
                font-family: 'Inter', sans-serif;
                font-size: 0.8rem;
            }

            .custom-tooltip.bs-tooltip-end .tooltip-arrow::before {
                border-right-color: #d1d5db;
            }

            .custom-tooltip.bs-tooltip-start .tooltip-arrow::before {
                border-left-color: #d1d5db;
            }

            .badge-soft-success {
                background: #dcfce3;
                color: #166534;
                padding: 4px 8px;
                border-radius: 4px;
                font-weight: 600;
                font-size: 0.7rem;
            }

            .badge-soft-warning {
                background: #fef3c7;
                color: #92400e;
                padding: 4px 8px;
                border-radius: 4px;
                font-weight: 600;
                font-size: 0.7rem;
            }

            /* Drag & Drop Columns */
            .columns-container {
                display: flex;
                gap: 20px;
                align-items: stretch;
            }

            .columns-box-wrapper {
                flex: 1;
                display: flex;
                flex-direction: column;
            }

            .columns-box {
                border: 1px solid var(--border-soft);
                border-radius: 4px;
                height: 250px;
                overflow-y: auto;
                background: #f9fafb;
                padding: 8px;
            }

            .column-item {
                padding: 6px 10px;
                background: #ffffff;
                border: 1px solid var(--border-soft);
                border-radius: 4px;
                margin-bottom: 4px;
                font-size: 0.8rem;
                font-weight: 500;
                cursor: pointer;
                display: flex;
                justify-content: space-between;
                align-items: center;
                transition: 0.2s;
            }

                .column-item:hover {
                    border-color: #d1d5db;
                    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
                }

            .draggable-col-item.dragging {
                opacity: 0.4;
                background-color: #f3f4f6;
            }

            .draggable-col-item.over {
                border-top: 2px solid var(--primary-blue);
            }

            /* Simulate 80% Zoom on Laptops Only */
            @@media (min-width: 769px) and (max-width: 1600px) {
                body {
                    zoom: 0.8;
                    margin: 0 !important;
                    padding: 0 !important;
                    overflow: hidden !important;
                }

                .app-container {
                    position: absolute !important;
                    top: 0 !important;
                    left: 0 !important;
                    width: 125vw !important;
                    height: 125vh !important;
                    max-width: none !important;
                    max-height: none !important;
                }

                .sidebar-overlay {
                    width: 125vw !important;
                    height: 125vh !important;
                }

                .offcanvas {
                    height: 125vh !important;
                }

                .crm-container {
                    height: calc(125vh - 75px) !important;
                }

                body.full-view-mode .crm-container {
                    height: 125vh !important;
                }
            }

            /* Mobile Responsive Overlays */
            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background-color: rgba(17, 24, 39, 0.5);
                z-index: 1030;
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            @@media (max-width: 1200px) {
                .sidebar {
                    width: 220px;
                }

                .search-wrapper {
                    max-width: 300px;
                }
            }

            @@media (max-width: 768px) {
                .sidebar {
                    position: fixed;
                    top: 0;
                    left: 0;
                    height: 100%;
                    transform: translateX(-100%);
                }

                    .sidebar.show-sidebar {
                        transform: translateX(0);
                    }

                .sidebar-overlay.show-overlay {
                    display: block;
                    opacity: 1;
                }

                .top-navbar {
                    height: 60px;
                    padding: 0 1rem;
                    position: relative;
                    z-index: 99999;
                }

                .search-wrapper {
                    width: 100%;
                    z-index: 99999;
                }

                .search-results-dropdown {
                    width: calc(100vw - 2rem);
                    top: 60px;
                    left: 1rem;
                }
            }
    </style>
</head>
