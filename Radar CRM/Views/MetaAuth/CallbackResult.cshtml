@{
    ViewData["Title"] = "Facebook Connection";
}

<div class="min-h-screen bg-[#FDFBF7] p-8 font-sans">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md border-t-4 border-[#1E3A8A] p-8 text-center">
        <h2 class="text-2xl font-bold text-[#1E3A8A] mb-4">Facebook Connection Status</h2>

        <div class="p-4 bg-gray-50 border border-gray-200 rounded-md text-gray-700 break-all">
            @ViewBag.Message
        </div>

        <div class="mt-6">
            <a href="@Url.Action("Index", "MetaAuth")" class="text-blue-600 hover:underline">Return to Integrations</a>
        </div>
    </div>
</div>