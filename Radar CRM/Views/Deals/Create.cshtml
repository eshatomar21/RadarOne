@model Radar_CRM.Models.Deal

@{
    ViewData["Title"] = "Create Deal";
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Premium Enterprise CRM Typography & Base - Navy & Cream Theme */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-shadow-float: 0 20px 40px -10px rgba(30, 58, 138, 0.08);
    }

    body { background-color: var(--theme-bg-cream); font-family: 'Inter', -apple-system, sans-serif; color: var(--theme-text-main); -webkit-font-smoothing: antialiased; }
    .sf-container { background-color: var(--theme-surface); width: 98%; max-width: 1600px; margin: 30px auto; min-height: 90vh; border-radius: 16px; box-shadow: var(--theme-shadow-float); display: flex; flex-direction: column; border: 1px solid rgba(255, 255, 255, 0.5); overflow: hidden; }
    .sf-header { display: flex; justify-content: space-between; align-items: center; padding: 24px 40px; background-color: var(--theme-surface); border-bottom: 1px solid var(--theme-border); }
    .sf-header-title { display: flex; align-items: center; gap: 16px; }
    .sf-header-title h1 { font-size: 1.5rem; font-weight: 600; color: var(--theme-navy-primary); margin: 0; display: flex; align-items: center; gap: 12px; letter-spacing: -0.02em; }
    .sf-header-title .entity-type { color: var(--theme-navy-primary); font-weight: 600; font-size: 0.85rem; background: var(--theme-navy-light); padding: 6px 14px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.05em; }
    .sf-close-btn { background: transparent; border: 1px solid var(--theme-border); width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: var(--theme-text-muted); cursor: pointer; transition: all 0.2s ease; }
    .sf-close-btn:hover { background: var(--theme-navy-light); color: var(--theme-navy-primary); border-color: var(--theme-navy-light); transform: rotate(90deg); }
    .btn-sf-primary { background-color: var(--theme-navy-primary); color: var(--theme-surface); border: none; padding: 10px 28px; border-radius: 8px; font-weight: 500; font-size: 0.95rem; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15); }
    .btn-sf-primary:hover { background-color: var(--theme-navy-hover); box-shadow: 0 6px 16px rgba(30, 58, 138, 0.25); transform: translateY(-1px); }
    .sf-tabs { display: flex; border-bottom: 1px solid var(--theme-border); padding: 0 40px; background-color: var(--theme-surface); gap: 40px; margin: 0; }
    .sf-tab { background: none; border: none; padding: 20px 0; color: var(--theme-text-muted); font-weight: 500; font-size: 0.95rem; cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -1px; transition: all 0.2s; }
    .sf-tab:hover { color: var(--theme-navy-primary); }
    .sf-tab.active { color: var(--theme-navy-primary); border-bottom: 3px solid var(--theme-navy-primary); font-weight: 600; }
    .form-group { margin-bottom: 28px; }
    .sf-label { display: block; font-size: 0.85rem; color: var(--theme-text-muted); margin-bottom: 8px; font-weight: 500; }
    .sf-input, .sf-select { width: 100%; border: 1px solid var(--theme-border); border-radius: 6px; padding: 6px 12px; height: 36px; font-size: 0.85rem; color: var(--theme-text-main); background-color: #fafaf9; transition: all 0.2s ease-in-out; }
    .sf-input:hover, .sf-select:hover { border-color: #cbd5e1; background-color: var(--theme-surface); }
    .sf-input:focus, .sf-select:focus { outline: none; border-color: var(--theme-navy-primary); background-color: var(--theme-surface); box-shadow: 0 0 0 3px var(--theme-navy-light); }
    .sf-input[readonly] { background-color: transparent; border-color: transparent; border-bottom: 1px dashed var(--theme-border); border-radius: 0; padding-left: 0; height: auto; }
    .sf-input[readonly]:focus { box-shadow: none; }
    textarea.sf-input { height: auto; }
    .pane-section-title { font-size: 1.25rem; font-weight: 600; color: var(--theme-navy-primary); margin-bottom: 24px; margin-top: 16px; padding-bottom: 0; border-bottom: none; letter-spacing: -0.01em; }

    /* Dynamic Table Styles */
    .table-payments { width: 100%; margin-bottom: 16px; border-collapse: separate; border-spacing: 0; border: 1px solid var(--theme-border); border-radius: 8px; overflow: hidden; background: var(--theme-surface); }
    .table-payments th { background-color: #f8fafc; color: var(--theme-text-main); font-size: 0.85rem; font-weight: 600; padding: 12px; border-bottom: 1px solid var(--theme-border); text-align: left; }
    .table-payments td { padding: 8px 12px; border-bottom: 1px solid var(--theme-border); }
    .btn-add-row { background-color: #ffffff; color: #10b981; border: 1px solid #10b981; padding: 6px 16px; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: 0.2s; }
    .btn-add-row:hover { background-color: #ecfdf5; }

    .summary-box { border: 1px solid var(--theme-border); border-radius: 8px; background: var(--theme-surface); padding: 16px; width: 300px; float: right; margin-top: 16px; }
    .summary-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--theme-bg-cream); }
    .summary-row:last-child { border-bottom: none; font-weight: 700; color: var(--theme-navy-primary); }
    .summary-input { width: 100px; text-align: right; border: 1px solid var(--theme-border); border-radius: 4px; padding: 4px 8px; font-size: 0.85rem; }
</style>

<form asp-action="Create" method="post" id="dealForm" enctype="multipart/form-data">
    <div class="sf-container">

        <!-- Header -->
        <div class="sf-header">
            <div class="sf-header-title">
                <button type="button" class="sf-close-btn" onclick="window.history.back();">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
                <h1><span class="entity-type">Deal</span> Create New Deal</h1>
            </div>
            <div class="sf-header-actions">
                <button type="submit" class="btn-sf-primary">Save Deal</button>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav sf-tabs" id="dealTabs" role="tablist">
            <li class="nav-item"><button class="sf-tab active" data-bs-toggle="tab" data-bs-target="#main" type="button">Main Information</button></li>
            <li class="nav-item"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#financials" type="button">Products & Financials</button></li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="dealTabsContent" style="padding: 32px 40px; flex-grow: 1; overflow-y:auto;">

            <!-- 1. MAIN TAB -->
            <div class="tab-pane fade show active" id="main" role="tabpanel" style="padding: 32px 40px;">

                <h3 class="pane-section-title">Core Details</h3>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Deal Name <span class="text-danger">*</span></label>
                        <input asp-for="DealName" class="sf-input" required style="font-weight: 600;" placeholder="Enter Deal Name..." />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Account Name (Lookup)</label>
                        <!-- 🚀 Binds to the Lookup ID so the data flows properly -->
                        <select asp-for="AccountId" asp-items="ViewBag.AccountsList" class="sf-select">
                            <option value="">- Select Account -</option>
                        </select>
                        <!-- Optional: If you strictly need the text name saved as well, capture it in a hidden field -->
                        <input type="hidden" asp-for="AccountName" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Account Type</label>
                        <select asp-for="AccountType" class="sf-select">
                            <option value="">-None-</option>
                            <option value="Individual">Individual</option>
                            <option value="Group">Group</option>
                            <option value="Institution">Institution</option>
                            <option value="Government Organisation">Government Organisation</option>
                        </select>
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Contact Person Name</label>
                        <input asp-for="ContactPersonName" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Lead Name</label>
                        <input asp-for="LeadName" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Lead Source</label>
                        <select asp-for="LeadSource" class="sf-select">
                            <option value="">-None-</option>
                            <option value="Google Ads">Google Ads</option>
                            <option value="FB Ads">FB Ads</option>
                            <option value="Seminar">Seminar</option>
                            <option value="Refferal">Refferal</option>
                            <option value="Upsell Call">Upsell Call</option>
                            <option value="Walk In">Walk In</option>
                        </select>
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Meta Campaign Name</label>
                        <input asp-for="MetaCampaignName" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Deal Owner</label>
                        <!-- 🚀 Binds to DealOwnerId and populates with ViewBag.UsersList -->
                        <select asp-for="DealOwnerId" asp-items="ViewBag.UsersList" class="sf-select">
                            <option value="">- Select Owner -</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Account Owner</label>
                        <select asp-for="AccountOwner" asp-items="ViewBag.UsersList" class="sf-select"><option value="">- Select -</option></select>
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Demo Owner</label>
                        <select asp-for="DemoOwner" asp-items="ViewBag.UsersList" class="sf-select"><option value="">- Select -</option></select>
                    </div>

                    <!-- 🚀 ADDED: System Auditing Fields (Read Only) -->
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Created By</label>
                        @{
                            string creatorName = !string.IsNullOrEmpty(Model?.CreatedBy) ? Model.CreatedBy : "System User";
                        }
                        <input type="text" class="sf-input" value="@creatorName" readonly style="background-color: #f1f5f9; color: var(--theme-text-muted); font-weight: 600; cursor: not-allowed;" />
                        <input type="hidden" asp-for="CreatedBy" />
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Last Modified By</label>
                        @{
                            string modifierName = !string.IsNullOrEmpty(Model?.ModifiedBy) ? Model.ModifiedBy : "Not modified yet";
                        }
                        <input type="text" class="sf-input" value="@modifierName" readonly style="background-color: #f1f5f9; color: var(--theme-text-muted); font-weight: 600; cursor: not-allowed;" />
                    </div>
                </div> <!-- END OF ROW -->
                <!-- NOTES UI IS NOW SAFELY INSIDE THE TAB -->
                <div class="d-flex justify-content-between align-items-center mt-4 pb-2 mb-3" style="border-bottom: 1px solid var(--theme-border);">
                    <h3 class="pane-section-title border-0 m-0 p-0">Notes & Attachments</h3>
                    <button type="button" class="btn btn-sm" onclick="openNoteModal()" style="background-color: var(--theme-navy-light); color: var(--theme-navy-primary); font-weight: 600; border-radius: 6px; font-size: 0.8rem; padding: 6px 14px; border: 1px solid var(--theme-border); transition: all 0.2s;">
                        <i class="fa-solid fa-plus me-1"></i> Add Note
                    </button>
                </div>

                <!-- Container where saved notes will dynamically appear -->
                <div id="savedNotesContainer" class="mb-4"></div>

            </div> <!-- THIS IS WHERE THE MAIN TAB ACTUALLY CLOSES -->

            <!-- 2. FINANCIALS TAB -->
            <div class="tab-pane fade" id="financials" role="tabpanel">
                <h3 class="pane-section-title mt-0">Payment Details</h3>
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label class="sf-label">Payment Mode</label>
                        <select asp-for="PaymentMode" class="sf-select">
                            <option value="">-None-</option>
                            <option value="NEFT">NEFT</option>
                            <option value="UPI">UPI</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="Cheque">Cheque</option>
                            <option value="Cash">Cash</option>
                            <option value="EMI">EMI</option>
                            <option value="Razorpay">Razorpay</option>
                        </select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="sf-label">Payment Type</label>
                        <select asp-for="PaymentType" class="sf-select">
                            <option value="">-None-</option>
                            <option value="Upfront">Upfront</option>
                            <option value="EMI - 3Months">EMI - 3Months</option>
                            <option value="EMI - 6Months">EMI - 6Months</option>
                            <option value="EMI - 12Months">EMI - 12Months</option>
                            <option value="Deffered">Deffered</option>
                        </select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="sf-label">Payment Status</label>
                        <select asp-for="PaymentStatus" class="sf-select">
                            <option value="">-None-</option>
                            <option value="Paid">Paid</option>
                            <option value="Pending">Pending</option>
                            <option value="Partial">Partial</option>
                            <option value="Refunded">Refunded</option>
                        </select>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="sf-label">Approval Required?</label>
                        <select asp-for="ApprovalRequired" class="sf-select">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="sf-label">Approved By</label>
                        <input asp-for="ApprovedBy" class="sf-input" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="sf-label">Remarks</label>
                        <input asp-for="Remarks" class="sf-input" />
                    </div>
                </div>

                <!-- DYNAMIC PRODUCT PAYMENTS TABLE (MATCHING IMAGE) -->
                <h3 class="pane-section-title mt-4">Product Payments Sections</h3>
                <div class="table-responsive" style="overflow: visible;">
                    <table class="table-payments" id="paymentsTable">
                        <thead>
                            <tr>
                                <th style="width:15%;">Deal Type</th>
                                <th>Product name</th>
                                <th style="width:10%;">Quantity</th>
                                <th style="width:12%;">Unit Price(Rs.)</th>
                                <th style="width:12%;">Amount(Rs.)</th>
                                <th style="width:12%;">Discount(Rs.)</th>
                                <th style="width:15%;">Total (Rs.)(Rs.)</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="paymentTbody">
                            <tr class="payment-row">
                                <td>
                                    <select name="PaymentRows[0].DealType" class="sf-select">
                                        <option value="">-None-</option>
                                        <option value="New">New</option>
                                        <option value="Existing">Existing</option>
                                    </select>
                                </td>
                                <td><input type="text" name="PaymentRows[0].ProductName" class="sf-input" /></td>
                                <td><input type="number" name="PaymentRows[0].Quantity" class="sf-input qty" value="1" onkeyup="calcRow(this)" /></td>
                                <td><input type="number" name="PaymentRows[0].UnitPrice" class="sf-input price" value="0" onkeyup="calcRow(this)" /></td>
                                <td><input type="number" name="PaymentRows[0].Amount" class="sf-input amount" readonly style="background:#f1f5f9;" /></td>
                                <td><input type="number" name="PaymentRows[0].Discount" class="sf-input disc" value="0" onkeyup="calcRow(this)" /></td>
                                <td><input type="number" name="PaymentRows[0].Total" class="sf-input total" readonly style="background:#f1f5f9;" /></td>
                                <td><button type="button" style="width:24px;height:24px;background:transparent;border:none;" onclick="removeRow(this)"><i class="fa-solid fa-trash text-danger"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <button type="button" class="btn-add-row" onclick="addRow()">
                    <i class="fa-solid fa-plus"></i> Add row
                </button>

                <div class="summary-box">
                    <div class="summary-row">
                        <span class="sf-label p-0 m-0">Sub Total (Rs.)</span>
                        <input asp-for="SubTotal" type="number" class="summary-input" id="subTotal" readonly style="background:#f1f5f9;" />
                    </div>
                    <div class="summary-row">
                        <span class="sf-label p-0 m-0">Taxs (Rs.)</span>
                        <input asp-for="Taxes" type="number" class="summary-input" id="taxes" value="0" onkeyup="calcGrand()" />
                    </div>
                    <div class="summary-row">
                        <span class="sf-label p-0 m-0">Adjustment (Rs.)</span>
                        <input asp-for="Adjustment" type="number" class="summary-input" id="adjustment" value="0" onkeyup="calcGrand()" />
                    </div>
                    <div class="summary-row">
                        <span class="sf-label p-0 m-0" style="color:var(--theme-navy-primary);">GrandTotal (Rs.)</span>
                        <input asp-for="GrandTotal" type="number" class="summary-input" id="grandTotal" readonly style="background:#f1f5f9; font-weight:bold; color:var(--theme-navy-primary);" />
                    </div>
                </div>
                <div style="clear:both;"></div>
            </div>

        </div> <!-- End Tab Content -->
        <!-- Footer -->
        <div style="padding: 16px 40px; border-top: 1px solid var(--theme-border); background-color: #fafaf9; display: flex; justify-content: flex-end; gap: 16px;">
            <a asp-action="Index" class="btn" style="background: white; border: 1px solid var(--theme-border); color: var(--theme-text-muted); font-weight: 500; font-size: 0.95rem; padding: 8px 24px; border-radius: 8px; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn-sf-primary">Save Deal</button>
        </div>

    </div>
</form>

<!-- NOTES MODAL (Centered Pop-Up) -->
<div class="modal fade" id="noteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg" style="border: none; border-radius: 12px;">
            <div class="modal-header" style="background-color: #f8fafc; border-bottom: 1px solid var(--border-soft); border-radius: 12px 12px 0 0; padding: 20px 24px;">
                <h5 class="modal-title fw-bold" style="color: var(--text-dark); font-size: 1.15rem;">
                    <i class="fa-regular fa-pen-to-square text-primary me-2"></i> Add New Note
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">Note Owner</label>
                        <select id="modalNoteOwner" class="form-select">
                            <option value="System User">System User</option>
                        </select>
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">Date & Time</label>
                        <input type="text" id="modalNoteDateTime" class="form-control" style="background-color: #f1f5f9; color: var(--text-muted);" readonly />
                    </div>
                    <div class="col-md-12 form-group m-0">
                        <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">Note Description</label>
                        <textarea id="modalNoteDesc" class="form-control" style="height: auto; resize: vertical;" rows="4" placeholder="Write your note details here..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background-color: #f8fafc; border-top: 1px solid var(--border-soft); border-radius: 0 0 12px 12px; padding: 16px 24px;">
                <button type="button" class="btn-saas" style="border: 1px solid #cbd5e1; background:white;" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-saas-primary" onclick="saveNoteViaAjax()">Save Note</button>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // --- NOTES POP-UP LOGIC ---
    function openNoteModal() {
    const now = new Date();
    document.getElementById('modalNoteDateTime').value = now.toLocaleString();
    document.getElementById('modalNoteDesc').value = '';
    const modal = new bootstrap.Modal(document.getElementById('noteModal'));
    modal.show();
    }

    function saveNoteViaAjax() {
    const owner = document.getElementById('modalNoteOwner').value;
    const dateTime = document.getElementById('modalNoteDateTime').value;
    const desc = document.getElementById('modalNoteDesc').value;

    if (!desc.trim()) {
    alert('Please enter a description.');
    return;
    }

    const noteHtml = `
    <div class="saved-note-card p-3 mb-3 shadow-sm" style="border: 1px solid var(--theme-border); border-left: 4px solid var(--theme-navy-primary); border-radius: 8px; background: var(--theme-surface);">
    <div class="d-flex justify-content-between align-items-center mb-2">
    <span class="fw-bold" style="font-size: 0.9rem; color: var(--theme-text-main);">
    <i class="fa-solid fa-circle-user text-muted me-2"></i>${owner}
    </span>
    <span class="text-muted" style="font-size: 0.8rem;">
    <i class="fa-regular fa-clock me-1"></i> ${dateTime}
    </span>
    </div>
    <div style="font-size: 0.9rem; color: var(--theme-text-muted); white-space: pre-wrap;">${desc}</div>

    <input type="hidden" name="SavedNoteOwner[]" value="${owner}" />
    <input type="hidden" name="SavedNoteDateTime[]" value="${dateTime}" />
    <input type="hidden" name="SavedNoteDesc[]" value="${desc}" />
    </div>`;

    document.getElementById('savedNotesContainer').insertAdjacentHTML('beforeend', noteHtml);
    const modalEl = document.getElementById('noteModal');
    bootstrap.Modal.getInstance(modalEl).hide();
    }

    // --- DYNAMIC TABLE LOGIC (Matches Image Exactly) ---
    let rowCount = 1;

    function addRow() {
    const tbody = document.getElementById('paymentTbody');
    const tr = document.createElement('tr');
    tr.className = 'payment-row';
    tr.innerHTML = `
    <td><select name="PaymentRows[${rowCount}].DealType" class="sf-select"><option value="">-None-</option><option value="New">New</option><option value="Existing">Existing</option></select></td>
    <td><input type="text" name="PaymentRows[${rowCount}].ProductName" class="sf-input" /></td>
    <td><input type="number" name="PaymentRows[${rowCount}].Quantity" class="sf-input qty" value="1" onkeyup="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRows[${rowCount}].UnitPrice" class="sf-input price" value="0" onkeyup="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRows[${rowCount}].Amount" class="sf-input amount" readonly style="background:#f1f5f9;" /></td>
    <td><input type="number" name="PaymentRows[${rowCount}].Discount" class="sf-input disc" value="0" onkeyup="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRows[${rowCount}].Total" class="sf-input total" readonly style="background:#f1f5f9;" /></td>
    <td><button type="button" style="width:24px;height:24px;background:transparent;border:none;" onclick="removeRow(this)"><i class="fa-solid fa-trash text-danger"></i></button></td>
    `;
    tbody.appendChild(tr);
    rowCount++;
    }

    function removeRow(btn) {
    btn.closest('tr').remove();
    calcGrand();
    }

    function calcRow(input) {
    const row = input.closest('tr');
    const qty = parseFloat(row.querySelector('.qty').value) || 0;
    const price = parseFloat(row.querySelector('.price').value) || 0;
    const disc = parseFloat(row.querySelector('.disc').value) || 0;

    // Formula based on image: Amount = Qty * UnitPrice. Total = Amount - Discount(Rs.)
    const amount = qty * price;
    const total = amount - disc;

    row.querySelector('.amount').value = amount.toFixed(2);
    row.querySelector('.total').value = total.toFixed(2);

    calcGrand();
    }

    function calcGrand() {
    let sub = 0;
    document.querySelectorAll('.total').forEach(el => {
    sub += parseFloat(el.value) || 0;
    });

    document.getElementById('subTotal').value = sub.toFixed(2);

    const tax = parseFloat(document.getElementById('taxes').value) || 0;
    const adj = parseFloat(document.getElementById('adjustment').value) || 0;

    const grand = sub + tax - adj;
    document.getElementById('grandTotal').value = grand.toFixed(2);
    }
</script>