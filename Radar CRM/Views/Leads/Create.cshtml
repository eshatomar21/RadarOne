<!-- Bootstrap JS bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function openNoteModal() {
    const now = new Date();
    document.getElementById('modalNoteDateTime').value = now.toLocaleString();
    document.getElementById('modalNoteFile').value = '';
    document.getElementById('modalNoteDesc').value = '';
    const modal = new bootstrap.Modal(document.getElementById('noteModal'));
    modal.show();
    }

    function saveNote() {
    const owner = document.getElementById('modalNoteOwner').value;
    const dateTime = document.getElementById('modalNoteDateTime').value;
    const desc = document.getElementById('modalNoteDesc').value;
    const fileInput = document.getElementById('modalNoteFile');
    const fileName = fileInput.files.length > 0 ? fileInput.files[0].name : '';

    if (!desc.trim() && !fileName) {
    alert('Please enter a description or attach a file.');
    return;
    }

    let fileHtml = fileName ? `<div class="mt-2 text-primary" style="font-size: 0.85rem; background: var(--theme-navy-light); padding: 4px 8px; border-radius: 4px; display: inline-block;"><i class="fa-solid fa-paperclip me-2"></i>${fileName}</div>` : '';

    const noteHtml = `
    <div class="saved-note-card p-3 mb-3 shadow-sm" style="border: 1px solid var(--theme-border); border-left: 4px solid var(--theme-navy-primary); border-radius: 8px; background: var(--theme-surface);">
    <div class="d-flex justify-content-between align-items-center mb-2">
    <span class="fw-bold" style="font-size: 0.9rem; color: var(--theme-text-main);">
    <i class="fa-solid fa-circle-user text-muted me-2"></i>${owner}
    </span>
    <span class="text-muted" style="font-size: 0.8rem;"><i class="fa-regular fa-clock me-1"></i> ${dateTime}</span>
    </div>
    <div style="font-size: 0.9rem; color: var(--theme-text-muted); white-space: pre-wrap;">${desc}</div>
    ${fileHtml}
    <input type="hidden" name="SavedNoteOwner[]" value="${owner}" />
    <input type="hidden" name="SavedNoteDateTime[]" value="${dateTime}" />
    <input type="hidden" name="SavedNoteDesc[]" value="${desc}" />
    </div>`;

    document.getElementById('savedNotesContainer').insertAdjacentHTML('beforeend', noteHtml);
    const modalInstance = bootstrap.Modal.getInstance(document.getElementById('noteModal'));
    modalInstance.hide();
    }

    document.getElementById('DataSources').addEventListener('change', function () {
    const val = this.value;
    document.getElementById('divMetaCampaign').style.display = (val === 'Meta Ads') ? 'block' : 'none';
    document.getElementById('divSeminarName').style.display = (val === 'Seminar Conference') ? 'block' : 'none';
    });

    function verifyPhone(fieldId) {
    const phone = document.getElementById(fieldId).value.trim();
    const mainMobile = document.getElementById('MobileNumber').value.trim();
    const altMobile = document.getElementById('AlternateMobile').value.trim();

    if (!phone) {
    alert('Please enter a phone number first before verifying.');
    return;
    }

    if (mainMobile && altMobile && mainMobile === altMobile) {
    alert('❌ Mobile Number and Alternate Mobile cannot be the exact same!');
    return;
    }

    fetch('/Leads/CheckDuplicatePhone?phone=' + encodeURIComponent(phone))
    .then(response => response.json())
    .then(data => {
    if (data.isDuplicate) alert('⚠️ WARNING: This phone number already exists in another lead record!');
    else alert('✅ This number is valid and unique in the system.');
    })
    .catch(error => {
    console.error("Error verifying phone:", error);
    alert("Could not connect to the database to verify.");
    });
    }

    let isDirectDealConfirmed = false;

    document.getElementById('leadForm').addEventListener('submit', function (e) {
    const stageValue = document.getElementById('Stage').value;
    if (stageValue === 'Direct Deal' && !isDirectDealConfirmed) {
    e.preventDefault();
    const confirmModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('directDealConfirmModal'));
    confirmModal.show();
    }
    });

    document.getElementById('btnCancelDirectDeal').addEventListener('click', function () {
    document.getElementById('Stage').value = '';
    });

    document.getElementById('btnConfirmDirectDeal').addEventListener('click', function () {
    bootstrap.Modal.getOrCreateInstance(document.getElementById('directDealConfirmModal')).hide();
    const paymentRows = document.querySelectorAll('#paymentTbody .payment-row');
    let hasValidPayment = false;

    paymentRows.forEach(row => {
    const productName = row.querySelector('input[name*="ProductName"]')?.value.trim() || '';
    const total = parseFloat(row.querySelector('.total')?.value) || 0;
    if (productName !== '' && total > 0) hasValidPayment = true;
    });

    if (!hasValidPayment) {
    document.getElementById('Stage').value = '';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('directDealErrorModal')).show();
    } else {
    isDirectDealConfirmed = true;
    document.getElementById('leadForm').submit();
    }
    });

    // 🚀 FIXED: Extremely safe JSON serialization for Dictionary pricing
    const productPrices = @Html.Raw(Json.Serialize(ViewBag.ProductPrices ?? new Dictionary<int, decimal>()));

    const productOptionsHtml = `
    <option value="0">-Select Product-</option>
    @if (ViewBag.ProductsList != null)
    {
        foreach (var item in (SelectList)ViewBag.ProductsList)
        {
            <option value="@item.Value">@item.Text</option>
        }
    }
    `;

    let rowCount = @(Model?.PaymentRow != null && Model.PaymentRow.Count > 0 ? Model.PaymentRow.Count : 1);
    function addRow() {
    const tbody = document.getElementById('paymentTbody');
    const tr = document.createElement('tr');
    tr.className = 'payment-row';
    tr.innerHTML = `
    <td><select name="PaymentRow[${rowCount}].DealType" class="sf-select"><option value="">-None-</option><option value="New Sale">New Sale</option><option value="Upgrade">Upgrade</option><option value="Add On">Add On</option><option value="Stock Key">Stock Key</option><option value="Existing">Existing</option></select></td>
    <td>
    <select name="PaymentRow[${rowCount}].ProductId" class="sf-select product-select" onchange="productSelected(this)">${productOptionsHtml}</select>
    <input type="hidden" name="PaymentRow[${rowCount}].ProductName" class="product-name-hidden" value="" />
    </td>
    <td><input type="number" name="PaymentRow[${rowCount}].Quantity" class="sf-input qty" value="1" onchange="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRow[${rowCount}].ProductPrice" class="sf-input price" value="0" onchange="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRow[${rowCount}].Total" class="sf-input total" readonly style="background:#F8FAFC;" /></td>
    <td><input type="number" name="PaymentRow[${rowCount}].DiscountPercent" class="sf-input disc" value="0" onchange="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRow[${rowCount}].FinalAmount" class="sf-input final" readonly style="background:#F8FAFC;" /></td>
    <td><button type="button" style="width:24px;height:24px;background:transparent;border:none;" onclick="removeRow(this)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></td>
    `;
    tbody.appendChild(tr);
    rowCount++;
    }

    function productSelected(selectElem) {
    const selectedId = selectElem.value;
    const price = productPrices[selectedId] || 0;
    const productName = selectElem.options[selectElem.selectedIndex].text;
    const row = selectElem.closest('tr');

    const nameHiddenInput = row.querySelector('.product-name-hidden');
    if (nameHiddenInput) {
    nameHiddenInput.value = (selectedId === "0") ? "" : productName;
    }

    const priceInput = row.querySelector('.price');
    priceInput.value = price;
    calcRow(priceInput);
    }

    function removeRow(btn) {
    btn.closest('tr').remove();
    calcGrand();
    }

    function calcRow(input) {
    const row = input.closest('tr');
    const qty = parseFloat(row.querySelector('.qty').value) || 0;
    const price = parseFloat(row.querySelector('.price').value) || 0;
    const disc = parseFloat(row.querySelector('.disc').value) || 0;
    const total = qty * price;
    const discountAmt = total * (disc / 100);
    const finalAmt = total - discountAmt;
    row.querySelector('.total').value = total.toFixed(2);
    row.querySelector('.final').value = finalAmt.toFixed(2);
    calcGrand();
    }

    function calcGrand() {
    let sub = 0;
    document.querySelectorAll('.final').forEach(el => {
    sub += parseFloat(el.value) || 0;
    });
    document.getElementById('subTotal').value = sub.toFixed(2);
    const taxAmount = sub * 0.18;
    document.getElementById('taxes').value = taxAmount.toFixed(2);
    const adj = parseFloat(document.getElementById('adjustment').value) || 0;
    const grand = sub + taxAmount - adj;
    document.getElementById('grandTotal').value = grand.toFixed(2);
    }

    let globalRegionData = [];
    document.addEventListener("DOMContentLoaded", async function () {
    try {
    const response = await fetch('https://countriesnow.space/api/v0.1/countries/states');
    const result = await response.json();
    if (!result.error) {
    globalRegionData = result.data;
    populateCountryDropdown();
    }
    } catch (error) { console.error("Failed to load country data:", error); }
    });

    function populateCountryDropdown() {
    const country1 = document.getElementById('Addr1_Country');
    const country2 = document.getElementById('Addr2_Country');
    const existingCountry1 = '@(Model?.Addr1_Country ?? "")';
    const existingCountry2 = '@(Model?.Addr2_Country ?? "")';

    if (country1) country1.innerHTML = '<option value="">-None-</option>';
    if (country2) country2.innerHTML = '<option value="">-None-</option>';

    globalRegionData.forEach(countryObj => {
    if (country1) {
    const opt1 = document.createElement('option');
    opt1.value = countryObj.name;
    opt1.textContent = countryObj.name;
    if (countryObj.name === existingCountry1) opt1.selected = true;
    country1.appendChild(opt1);
    }
    if (country2) {
    const opt2 = document.createElement('option');
    opt2.value = countryObj.name;
    opt2.textContent = countryObj.name;
    if (countryObj.name === existingCountry2) opt2.selected = true;
    country2.appendChild(opt2);
    }
    });

    if (existingCountry1) updateStateDropdown(existingCountry1, '@(Model?.Addr1_State ?? "")', 'Addr1_State');
    if (existingCountry2) updateStateDropdown(existingCountry2, '@(Model?.Addr2_State ?? "")', 'Addr2_State');
    }

    const c1 = document.getElementById('Addr1_Country');
    if (c1) c1.addEventListener('change', function() { updateStateDropdown(this.value, "", 'Addr1_State'); });
    const c2 = document.getElementById('Addr2_Country');
    if (c2) c2.addEventListener('change', function() { updateStateDropdown(this.value, "", 'Addr2_State'); });

    function updateStateDropdown(selectedCountryName, selectedStateValue, targetSelectId) {
    const stateSelect = document.getElementById(targetSelectId);
    if (!stateSelect) return;
    stateSelect.innerHTML = '<option value="">-None-</option>';
    if (!selectedCountryName) return;
    const countryData = globalRegionData.find(c => c.name === selectedCountryName);
    if (countryData && countryData.states) {
    countryData.states.forEach(stateObj => {
    const option = document.createElement('option');
    option.value = stateObj.name;
    option.textContent = stateObj.name;
    if (stateObj.name === selectedStateValue) option.selected = true;
    stateSelect.appendChild(option);
    });
    }
    }
</script>