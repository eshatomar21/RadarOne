                                <th>Product Name</th>
                                <th style="width:10%;">Quantity</th>
                                <th style="width:12%;">Product Price(Rs.)</th>
                                <th style="width:12%;">Total(Rs.)</th>
                                <th style="width:12%;">Discount %(Rs.)</th>
                                <th style="width:15%;">Final Amount(Rs.)</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="paymentTbody">
                            @if (Model?.PaymentRow != null && Model.PaymentRow.Count > 0)
                            {
                                for (int i = 0; i < Model.PaymentRow.Count; i++)
                                {
                                    <tr class="payment-row">
                                        <input type="hidden" name="PaymentRow[@i].Id" value="@Model.PaymentRow[i].Id" />
                                        <td>
                                            <select name="PaymentRow[@i].DealType" class="sf-select">
                                                <option value="">-None-</option>
                                                <option value="New Sale" selected="@(Model.PaymentRow[i].DealType == "New Sale" ? "selected" : null)">New Sale</option>
                                                <option value="Upgrade" selected="@(Model.PaymentRow[i].DealType == "Upgrade" ? "selected" : null)">Upgrade</option>
                                                <option value="Add On" selected="@(Model.PaymentRow[i].DealType == "Add On" ? "selected" : null)">Add On</option>
                                                <option value="Stock Key" selected="@(Model.PaymentRow[i].DealType == "Stock Key" ? "selected" : null)">Stock Key</option>
                                                <option value="Existing" selected="@(Model.PaymentRow[i].DealType == "Existing" ? "selected" : null)">Existing</option>
                                            </select>
                                        </td>
                                        <td>
                                            <!-- 🚀 FIXED: Loop row logic successfully passing Id -->
                                            <select asp-for="@Model.PaymentRow[i].ProductId" name="PaymentRow[@i].ProductId" asp-items="ViewBag.ProductsList" class="sf-select product-select" onchange="productSelected(this)">
                                                <option value="0">-Select Product-</option>
                                            </select>
                                            <input type="hidden" name="PaymentRow[@i].ProductName" class="product-name-hidden" value="@Model.PaymentRow[i].ProductName" />
                                        </td>
                                        <td><input type="number" name="PaymentRow[@i].Quantity" value="@Model.PaymentRow[i].Quantity" class="sf-input qty" onchange="calcRow(this)" /></td>
                                        <td><input type="number" name="PaymentRow[@i].ProductPrice" value="@Model.PaymentRow[i].ProductPrice" class="sf-input price" onchange="calcRow(this)" /></td>
                                        <td><input type="number" name="PaymentRow[@i].Total" value="@Model.PaymentRow[i].Total" class="sf-input total" readonly style="background:#F8FAFC;" /></td>
                                        <td><input type="number" name="PaymentRow[@i].DiscountPercent" value="@Model.PaymentRow[i].DiscountPercent" class="sf-input disc" onchange="calcRow(this)" /></td>
                                        <td><input type="number" name="PaymentRow[@i].FinalAmount" value="@Model.PaymentRow[i].FinalAmount" class="sf-input final" readonly style="background:#F8FAFC;" /></td>
                                        <td>
                                            <button type="button" style="width:24px;height:24px;background:transparent;border:none;" onclick="removeRow(this)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <!-- 🚀 FIXED: Fallback empty row index is securely 0 (fixes the 'i' error) -->
                                <tr class="payment-row">
                                    <td>
                                        <select name="PaymentRow[0].DealType" class="sf-select">
                                            <option value="">-None-</option>
                                            <option value="New Sale">New Sale</option>
                                            <option value="Upgrade">Upgrade</option>
                                            <option value="Add On">Add On</option>
                                            <option value="Stock Key">Stock Key</option>
                                            <option value="Existing">Existing</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select name="PaymentRow[0].ProductId" asp-items="ViewBag.ProductsList" class="sf-select product-select" onchange="productSelected(this)">
                                            <option value="0">-Select Product-</option>
                                        </select>
                                        <input type="hidden" name="PaymentRow[0].ProductName" class="product-name-hidden" value="" />
                                    </td>
                                    <td><input type="number" name="PaymentRow[0].Quantity" class="sf-input qty" value="1" onchange="calcRow(this)" /></td>
                                    <td><input type="number" name="PaymentRow[0].ProductPrice" class="sf-input price" value="0" onchange="calcRow(this)" /></td>
                                    <td><input type="number" name="PaymentRow[0].Total" class="sf-input total" readonly style="background:#F8FAFC;" /></td>
                                    <td><input type="number" name="PaymentRow[0].DiscountPercent" class="sf-input disc" value="0" onchange="calcRow(this)" /></td>
                                    <td><input type="number" name="PaymentRow[0].FinalAmount" class="sf-input final" readonly style="background:#F8FAFC;" /></td>
                                    <td>
                                        <button type="button" style="width:24px;height:24px;background:transparent;border:none;" onclick="removeRow(this)">
