            <div class="modal-footer" style="border-top: none; justify-content: flex-end; padding-top: 20px;">
                <button type="button" class="btn btn-success" id="btnConfirmDirectDeal" style="padding: 6px 20px; font-weight: 500; border-radius: 4px;">OK</button>
                <button type="button" class="btn btn-light" id="btnCancelDirectDeal" data-bs-dismiss="modal" style="border: 1px solid #ccc; padding: 6px 16px; font-weight: 500; border-radius: 4px;">Cancel</button>
            </div>
        </div>
