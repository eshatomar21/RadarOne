@model Radar_CRM.Models.Lead

@{
    ViewData["Title"] = "Create Lead";
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Premium Enterprise CRM Typography & Base - Navy & Cream Theme */
   @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-shadow-float: 0 20px 40px -10px rgba(30, 58, 138, 0.08);
    }

    body {
        background-color: var(--theme-bg-cream);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--theme-text-main);
        -webkit-font-smoothing: antialiased;
    }

    .sf-container {
        background-color: var(--theme-surface);
        width: 98%;
        max-width: 1800px;
        margin: 30px auto;
        min-height: 90vh;
        border-radius: 16px;
        box-shadow: var(--theme-shadow-float);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.5);
        overflow: hidden;
    }

    .sf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
        background-color: var(--theme-surface);
        border-bottom: 1px solid var(--theme-border);
    }

    .sf-header-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .sf-header-title h1 {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--theme-navy-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: -0.02em;
        }

        .sf-header-title .entity-type {
            color: var(--theme-navy-primary);
            font-weight: 600;
            font-size: 0.85rem;
            background: var(--theme-navy-light);
            padding: 6px 14px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

    .sf-close-btn {
        background: transparent;
        border: 1px solid var(--theme-border);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--theme-text-muted);
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .sf-close-btn:hover {
            background: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            border-color: var(--theme-navy-light);
            transform: rotate(90deg);
        }

    .btn-sf-primary {
        background-color: var(--theme-navy-primary);
        color: var(--theme-surface);
        border: none;
        padding: 10px 28px;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);
    }

        .btn-sf-primary:hover {
            background-color: var(--theme-navy-hover);
            box-shadow: 0 6px 16px rgba(30, 58, 138, 0.25);
            transform: translateY(-1px);
        }

    .sf-tabs {
        display: flex;
        border-bottom: 1px solid var(--theme-border);
        padding: 0 40px;
        background-color: var(--theme-surface);
        gap: 40px;
        margin: 0;
    }

    .sf-tab {
        background: none;
        border: none;
        padding: 20px 0;
        color: var(--theme-text-muted);
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        margin-bottom: -1px;
        transition: all 0.2s;
    }

        .sf-tab:hover {
            color: var(--theme-navy-primary);
        }

        .sf-tab.active {
            color: var(--theme-navy-primary);
            border-bottom: 3px solid var(--theme-navy-primary);
            font-weight: 600;
        }

    .form-group {
        margin-bottom: 28px;
    }

    .sf-label {
        display: block;
        font-size: 0.85rem;
        color: var(--theme-text-muted);
        margin-bottom: 8px;
        font-weight: 500;
    }

    .sf-input, .sf-select {
        width: 100%;
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        padding: 6px 12px;
        height: 36px;
        font-size: 0.85rem;
        color: var(--theme-text-main);
        background-color: #fafaf9;
        transition: all 0.2s ease-in-out;
    }

        .sf-input:hover, .sf-select:hover {
            border-color: #cbd5e1;
            background-color: var(--theme-surface);
        }

        .sf-input:focus, .sf-select:focus {
            outline: none;
            border-color: var(--theme-navy-primary);
            background-color: var(--theme-surface);
            box-shadow: 0 0 0 3px var(--theme-navy-light);
        }

        .sf-input[readonly] {
            background-color: transparent;
            border-color: transparent;
            border-bottom: 1px dashed var(--theme-border);
            border-radius: 0;
            padding-left: 0;
            color: var(--theme-text-main);
            font-weight: 500;
            cursor: default;
            height: auto;
        }

            .sf-input[readonly]:focus {
                box-shadow: none;
            }

    textarea.sf-input {
        height: auto;
    }

    .pane-section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        margin-top: 16px;
        padding-bottom: 0;
        border-bottom: none;
        letter-spacing: -0.01em;
    }

    .sf-card {
        border: 1px solid var(--theme-border);
        border-radius: 12px;
        padding: 32px;
        margin-bottom: 24px;
        background-color: var(--theme-surface);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        transition: box-shadow 0.3s ease;
    }

        .sf-card:hover {
            box-shadow: var(--theme-shadow-float);
        }

    .sf-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid var(--theme-border);
        padding-bottom: 16px;
    }

    .verify-group {
        display: flex;
        position: relative;
    }

        .verify-group .sf-input {
            padding-right: 90px;
        }

        .verify-group .btn-verify {
            position: absolute;
            right: 3px;
            top: 3px;
            bottom: 3px;
            border: none;
            background: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            font-weight: 600;
            border-radius: 4px;
            padding: 0 12px;
            font-size: 0.75rem;
            transition: all 0.2s;
            cursor: pointer;
        }

            .verify-group .btn-verify:hover {
                background: var(--theme-navy-primary);
                color: var(--theme-surface);
            }

    .table-payments {
        width: 100%;
        margin-bottom: 16px;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid var(--theme-border);
        border-radius: 8px;
        overflow: hidden;
        background: var(--theme-surface);
    }

        .table-payments th {
            background-color: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 12px;
            border-bottom: 1px solid var(--theme-border);
            text-align: left;
        }

        .table-payments td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--theme-border);
        }

        .table-payments .sf-input {
            margin-bottom: 0;
        }

    .btn-add-row {
        background-color: #ffffff;
        color: #10b981;
        border: 1px solid #10b981;
        padding: 6px 16px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: 0.2s;
    }

        .btn-add-row:hover {
            background-color: #ecfdf5;
        }

    .summary-box {
        border: 1px solid var(--theme-border);
        border-radius: 8px;
        background: var(--theme-surface);
        padding: 16px;
        width: 300px;
        float: right;
        margin-top: 16px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--theme-bg-cream);
    }

        .summary-row:last-child {
            border-bottom: none;
            font-weight: 700;
            color: var(--theme-navy-primary);
        }

    .summary-input {
        width: 100px;
        text-align: right;
        border: 1px solid var(--theme-border);
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 0.85rem;
    }
</style>

<form asp-action="Create" novalidate method="post" id="leadForm" enctype="multipart/form-data">
    <div class="sf-container">

        <!-- HEADER -->
        <div class="sf-header">
            <div class="sf-header-title">
                <button type="button" class="sf-close-btn" onclick="window.history.back();">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <h1><span class="entity-type">Lead</span> New Lead</h1>
            </div>
            <div class="sf-header-actions">
                <button type="submit" class="btn-sf-primary">Save Lead</button>
            </div>
        </div>

        <!-- TABS -->
        <ul class="nav sf-tabs" id="leadTabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="sf-tab active" data-bs-toggle="tab" data-bs-target="#main" type="button" role="tab">Main Info</button></li>
            <li class="nav-item" role="presentation"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#address" type="button" role="tab">Address Info</button></li>
            <li class="nav-item" role="presentation"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#professional" type="button" role="tab">Professional Details</button></li>
            <li class="nav-item" role="presentation"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#deals" type="button" role="tab">Deals & Purchases</button></li>
            <li class="nav-item" role="presentation"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#tracking" type="button" role="tab">Tracking & More</button></li>
        </ul>

        <div class="tab-content" id="leadTabsContent" style="padding: 32px 40px; flex-grow: 1;">

            <!-- ==============================
         1. MAIN INFO TAB
    =============================== -->
            <div class="tab-pane fade show active" id="main" role="tabpanel">
                <h3 class="pane-section-title">Master Details</h3>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Lead Owner</label>
                        <select asp-for="LeadOwnerId" asp-items="@ViewBag.UsersList" class="sf-select">
                            <option value="">- Select -</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Co-Owner</label>
                        <select asp-for="CoOwnerId" asp-items="@ViewBag.UsersList" class="sf-select">
                            <option value="">- Select -</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Account Owner</label>
                        <select asp-for="AccountOwnerId" asp-items="@ViewBag.UsersList" class="sf-select">
                            <option value="">- Select -</option>
                        </select>
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Demo Owner</label>
                        <select asp-for="DemoOwnerId" asp-items="@ViewBag.UsersList" class="sf-select">
                            <option value="">- Select -</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Lead Name <span class="text-danger">*</span></label>
                        <input asp-for="LeadName" class="sf-input" required style="font-weight: 600;" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Created Date & Time</label>
                        <input asp-for="CreatedDateAndTime" type="datetime-local" class="sf-input" />
                    </div>

                    <div class="col-md-6 form-group">
                        <label class="sf-label">Account Name (Lookup)</label>
                        <select asp-for="AccountId" asp-items="ViewBag.AccountsList" class="sf-select">
                            <option value="">- Select Account -</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Contact Name</label>
                        <input asp-for="ContactName" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Account Type</label>
                        <select asp-for="AccountType" class="sf-select">
                            <option value="None">-None-</option>
                            <option value="Individual">Individual</option>
                            <option value="Group">Group</option>
                            <option value="Institution">Institution</option>
                            <option value="Government Organisation">Government Organisation</option>
                        </select>
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Group Name</label>
                        <input asp-for="GroupName" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Mobile Number</label>
                        <div class="verify-group">
                            <input asp-for="MobileNumber" class="sf-input" id="MobileNumber" placeholder="+1 202-555-0117" />
                            <button type="button" class="btn-verify" onclick="verifyPhone('MobileNumber')">Verify</button>
                        </div>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Alternate Mobile</label>
                        <div class="verify-group">
                            <input asp-for="AlternateMobile" class="sf-input" id="AlternateMobile" placeholder="Optional..." />
                            <button type="button" class="btn-verify" onclick="verifyPhone('AlternateMobile')">Verify</button>
                        </div>
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Email ID</label>
                        <input asp-for="EmailID" class="sf-input" style="color: var(--theme-navy-primary);" placeholder="email@example.com" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Alternate Email ID</label>
                        <input asp-for="AlternateEmailID" class="sf-input" placeholder="Optional..." />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Social Lead ID</label>
                        <input asp-for="SocialLeadID" class="sf-input" />
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Pipeline <span class="text-danger">*</span></label>
                        <select asp-for="Pipeline" class="sf-select" required>
                            <option value="">-None-</option>
                            <option value="New Software">New Software</option>
                            <option value="Upgrade Software">Upgrade Software</option>
                            <option value="Sales Support">Sales Support</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Campaign Source</label>
                        <input asp-for="CampaignSource" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group" id="divMetaCampaign" style="display:none;">
                        <label class="sf-label">Meta Campaign Name</label>
                        <input asp-for="MetaCampaignName" class="sf-input" placeholder="Enter campaign name..." />
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Current Status</label>
                        <select asp-for="CurrentStatus" class="sf-select">
                            <option value="None">-None-</option>
                            <option value="User">User</option>
                            <option value="Non-User">Non-User</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Data Sources <span class="text-danger">*</span></label>
                        <select asp-for="DataSources" class="sf-select" id="DataSources" required>
                            <option value="None">-None-</option>
                            <option value="InboundCall">InboundCall</option>
                            <option value="Referral/Dealer">Referral/Dealer</option>
                            <option value="Meta Ads">Meta Ads</option>
                            <option value="Google AdWords">Google AdWords</option>
                            <option value="Outreach">Outreach</option>
                            <option value="Group Lead">Group Lead</option>
                            <option value="Institutiona">Institutional</option>
                            <option value="Webinar">Webinar</option>
                            <option value="KOMMO">KOMMO</option>
                            <option value="Google Organic SEO">Google Organic SEO</option>
                            <option value="Website Direct">Website Direct</option>
                            <option value="YouTube">YouTube</option>
                            <option value="LinkedIn">LinkedIn</option>
                            <option value="Instagram Organic">Instagram Organic</option>
                            <option value="Zoho Webinar">Zoho Webinar</option>
                            <option value="Reference Doctor">Reference Doctor</option>
                            <option value="Reference Dealer Partner">Reference Dealer Partner</option>
                            <option value="Free Trial Self Register">Free Trial Self Register</option>
                            <option value="Seminar Conference">Seminar Conference</option>
                            <option value="Cold Calling">Cold Calling</option>
                            <option value="WhatsApp Campaign">WhatsApp Campaign</option>
                            <option value="Email Campaign">Email Campaign</option>
                            <option value="Data Import Old DB">Data Import Old DB</option>
                            <option value="WHATSAPP - BJAIN RX LLP">WHATSAPP - BJAIN RX LLP</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group" id="divSeminarName" style="display:none;">
                        <label class="sf-label">Seminar Name</label>
                        <input asp-for="SeminarName" class="sf-input" placeholder="Enter seminar name..." />
                    </div>
                </div>

                <h3 class="pane-section-title">Other Details</h3>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="sf-label">New Software</label>
                        <input asp-for="NewSoftware" class="sf-input" />
                    </div>
                </div>

                <h3 class="pane-section-title">Lead Information</h3>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Stage</label>
                        <select asp-for="Stage" class="sf-select">
                            <option value="">-None-</option>
                            <option value="Open">Open</option>
                            <option value="Demo Scheduled">Demo Scheduled</option>
                            <option value="Demo Done">Demo Done</option>
                            <option value="Trial Offered">Trial Offered</option>
                            <option value="Direct Deal">Direct Deal</option>
                            <option value="Won">Won</option>
                            <option value="Lost">Lost</option>
                        </select>
                    </div>

                    <div class="col-md-4 form-group dynamic-stage-field demo-fields" style="display: none;">
                        <label class="sf-label">Demo Scheduled Date & Time</label>
                        <input asp-for="DemoScheduledDate" type="datetime-local" class="sf-input" />
                    </div>

                    <div class="col-md-4 form-group dynamic-stage-field trial-fields" style="display: none;">
                        <label class="sf-label">Trial Start Date</label>
                        <input asp-for="TrialStartDate" type="date" class="sf-input" />
                    </div>

                    <div class="col-md-4 form-group dynamic-stage-field trial-fields" style="display: none;">
                        <label class="sf-label">Trial End Date</label>
                        <input asp-for="TrialEndDate" type="date" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Lead Status</label>
                        <select asp-for="LeadStatus" class="sf-select">
                            <option value="">-None-</option>
                            <option value="Cold">Cold</option>
                            <option value="Not interested">Not interested</option>
                            <option value="Warm">Warm</option>
                            <option value="Hot">Hot</option>
                            <option value="ImportantContact">ImportantContact</option>
                            <option value="Not Answering">Not Answering</option>
                            <option value="InterestedCold">InterestedCold</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Budget</label>
                        <input asp-for="Budget" type="number" class="sf-input" />
                    </div>

                    <div class="col-md-4 form-group">
                        <label class="sf-label">Time period to Buy</label>
                        <input asp-for="TimePeriodToBuy" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Expected Revenue</label>
                        <input asp-for="ExpectedRevenue" type="number" class="sf-input" />
                    </div>
                    <div class="col-md-4 form-group">
                        <label class="sf-label">Probability (%)</label>
                        <input asp-for="Probability" type="number" class="sf-input" />
                    </div>
                </div>

                <!-- NOTES MODAL TRIGGER -->
                <div class="d-flex justify-content-between align-items-center mt-4 pb-2 mb-3" style="border-bottom: 1px solid var(--theme-border);">
                    <h3 class="pane-section-title border-0 m-0 p-0">Notes & Attachments</h3>
                    <button type="button" class="btn btn-sm" onclick="openNoteModal()" style="background-color: var(--theme-navy-light); color: var(--theme-navy-primary); font-weight: 600; border-radius: 6px; font-size: 0.8rem; padding: 6px 14px; border: 1px solid var(--theme-border); transition: all 0.2s;">
                        <i class="fa-solid fa-plus me-1"></i> Add Note
                    </button>
                </div>
                <div id="savedNotesContainer" class="mb-4"></div>
            </div>

            <!-- ==============================
         2. ADDRESS INFO TAB
    =============================== -->
            <div class="tab-pane fade" id="address" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <div class="sf-card">
                            <div class="sf-card-title">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                </svg>
                                Address 1
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="sf-label">Country / Region</label>
                                    <select asp-for="Addr1_Country" class="sf-select"><option value="">-None-</option></select>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="sf-label">State / Province</label>
                                    <select asp-for="Addr1_State" class="sf-select"><option value="">-None-</option></select>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="sf-label">City</label>
                                    <input asp-for="Addr1_City" class="sf-input" />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="sf-label">Zip / Postal Code</label>
                                    <input asp-for="Addr1_Zip" class="sf-input" />
                                </div>
                                <div class="col-md-12 form-group">
                                    <label class="sf-label">Street Address</label>
                                    <input asp-for="Addr1_Street" class="sf-input" />
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="sf-label">Flat / House No.</label>
