            <div class="modal-header" style="background-color: #fef2f2; border-bottom: 1px solid #fee2e2;">
                <h5 class="modal-title fw-bold" style="color: #b91c1c;">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> Action Required
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
