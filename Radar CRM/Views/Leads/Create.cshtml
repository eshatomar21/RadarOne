    </div>
</form>

<!-- Modal declarations (Note, Deal confirmation, Error, Pending Reason) remain unchanged here for brevity but keep them exactly as they are in your code -->
<div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg" style="border: none; border-radius: 12px;">
            <div class="modal-header" style="background-color: #f8fafc; border-bottom: 1px solid var(--theme-border); border-radius: 12px 12px 0 0; padding: 20px 24px;">
                <h5 class="modal-title fw-bold" id="noteModalLabel" style="color: var(--theme-navy-primary); font-size: 1.15rem;">
                    <i class="fa-regular fa-pen-to-square text-primary me-2"></i> Add New Note
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="sf-label">Note Owner</label>
                        <select id="modalNoteOwner" class="sf-select"><option value="System User">System User</option></select>
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="sf-label">Date & Time</label>
                        <input type="text" id="modalNoteDateTime" class="sf-input" style="background-color: #f1f5f9; color: var(--theme-text-muted);" readonly />
                    </div>
                    <div class="col-md-12 form-group">
                        <label class="sf-label">Attachment</label>
                        <input type="file" id="modalNoteFile" class="sf-input" style="padding: 5px 12px;" />
