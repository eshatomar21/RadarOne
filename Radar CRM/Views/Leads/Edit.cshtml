        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Payment Status</div><div class="z-input-wrapper"><select asp-for="PaymentStatus" class="z-input"><option value="">-None-</option><option value="Paid">Paid</option><option value="Pending">Pending</option><option value="Partial">Partial</option><option value="Refunded">Refunded</option></select></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Customer Status</div><div class="z-input-wrapper"><select asp-for="CustomerStatus" class="z-input"><option value="">-None-</option><option value="Active User">Active User</option><option value="Non User">Non User</option><option value="Trail User">Trail User</option><option value="Lapsed">Lapsed</option></select></div></div></div>

        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Deal Type</div><div class="z-input-wrapper"><select asp-for="DealType" class="z-input"><option value="">-None-</option><option value="New Sale">New Sale</option><option value="Upgrade">Upgrade</option><option value="Add On">Add On</option><option value="Stock Key">Stock Key</option></select></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Package Selected</div><div class="z-input-wrapper"><select asp-for="PackageSelected" class="z-input"><option value="">-None-</option><option value="Starter (₹27k)">Starter (₹27k)</option><option value="Core (₹51k)">Core (₹51k)</option><option value="Plus (₹60k)">Plus (₹60k)</option><option value="Advance (₹80k)">Advance (₹80k)</option><option value="Expert (₹1.03L)">Expert (₹1.03L)</option><option value="Pro (₹1.84L)">Pro (₹1.84L)</option></select></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Deal Value (₹)</div><div class="z-input-wrapper"><input asp-for="DealValue" type="number" class="z-input" placeholder="0.00" /></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Discount (%)</div><div class="z-input-wrapper"><input asp-for="Discount" type="number" class="z-input" placeholder="0" /></div></div></div>

        <div class="col-12 mt-4">
            <label class="fw-bold mb-3" style="color:var(--theme-navy-primary);">Product Payments Section</label>
            <div class="table-responsive" style="overflow: visible;">
                <table class="table-payments w-100" id="paymentsTable">
                    <thead>
                        <tr>
                            <th style="width:15%;">Deal Type</th>
                            <th>Product Name</th>
                            <th style="width:10%;">Quantity</th>
                            <th style="width:12%;">Price</th>
                            <th style="width:12%;">Total</th>
                            <th style="width:12%;">Disc %</th>
                            <th style="width:15%;">Final Amt</th>
                            <th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="paymentTbody">
                        @if (Model?.PaymentRow != null && Model.PaymentRow.Count > 0)
                        {
                            for (int i = 0; i < Model.PaymentRow.Count; i++)
                            {
                                <tr class="payment-row">
                                    <input type="hidden" name="PaymentRow[@i].Id" value="@Model.PaymentRow[i].Id" />
                                    <td><select name="PaymentRow[@i].DealType" class="z-input"><option value="">-None-</option><option value="New Sale" selected="@(Model.PaymentRow[i].DealType == "New Sale" ? "selected" : null)">New Sale</option><option value="Upgrade" selected="@(Model.PaymentRow[i].DealType == "Upgrade" ? "selected" : null)">Upgrade</option><option value="Add On" selected="@(Model.PaymentRow[i].DealType == "Add On" ? "selected" : null)">Add On</option><option value="Stock Key" selected="@(Model.PaymentRow[i].DealType == "Stock Key" ? "selected" : null)">Stock Key</option><option value="Existing" selected="@(Model.PaymentRow[i].DealType == "Existing" ? "selected" : null)">Existing</option></select></td>
                                    <td><select asp-for="@Model.PaymentRow[i].ProductId" name="PaymentRow[@i].ProductId" asp-items="ViewBag.ProductsList" class="z-input product-select" onchange="productSelected(this)"></select><input type="hidden" name="PaymentRow[@i].ProductName" class="product-name-hidden" value="@Model.PaymentRow[i].ProductName" /></td>
                                    <td><input type="number" name="PaymentRow[@i].Quantity" value="@Model.PaymentRow[i].Quantity" class="z-input qty" onchange="calcRow(this)" /></td>
                                    <td><input type="number" name="PaymentRow[@i].ProductPrice" value="@Model.PaymentRow[i].ProductPrice" class="z-input price" onchange="calcRow(this)" /></td>
                                    <td><input type="number" name="PaymentRow[@i].Total" value="@Model.PaymentRow[i].Total" class="z-input total bg-light" readonly /></td>
                                    <td><input type="number" name="PaymentRow[@i].DiscountPercent" value="@Model.PaymentRow[i].DiscountPercent" class="z-input disc" onchange="calcRow(this)" /></td>
                                    <td><input type="number" name="PaymentRow[@i].FinalAmount" value="@Model.PaymentRow[i].FinalAmount" class="z-input final bg-light" readonly /></td>
                                    <td><button type="button" class="btn text-danger btn-sm" onclick="removeRow(this)"><i class="fa-solid fa-xmark"></i></button></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-start mt-2"><button type="button" class="btn btn-outline-primary btn-sm fw-bold" onclick="addRow()"><i class="fa-solid fa-plus me-1"></i> Add Row</button></div>

            <div class="row mt-4">
                <div class="col-12 text-end">
                    <div class="summary-box d-inline-block text-start">
                        <div class="summary-row"><span class="sf-label p-0 m-0">SubTotal</span><input asp-for="SubTotal" type="number" class="summary-input" id="subTotal" readonly /></div>
                        <div class="summary-row"><span class="sf-label p-0 m-0">Taxes (18%)</span><input asp-for="Taxes" type="number" class="summary-input" id="taxes" readonly /></div>
                        <div class="summary-row"><span class="sf-label p-0 m-0">Adjustment</span><input asp-for="Adjustment" type="number" class="summary-input" id="adjustment" onchange="calcGrand()" /></div>
                        <div class="summary-row"><span class="sf-label p-0 m-0 fw-bold">Grand Total</span><input asp-for="GrandTotal" type="number" class="summary-input fw-bold" id="grandTotal" readonly /></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mt-4"><div class="z-field-row"><div class="z-label">Payment Mode</div><div class="z-input-wrapper"><select asp-for="PaymentMode" class="z-input"><option value="">-None-</option><option value="Cash">Cash</option><option value="Card">Card</option><option value="Online">Online</option></select></div></div></div>
        <div class="col-md-6 mt-4"><div class="z-field-row"><div class="z-label">Payment Type</div><div class="z-input-wrapper"><select asp-for="PaymentType" class="z-input"><option value="">-None-</option><option value="Upfront">Upfront</option><option value="EMI - 3Months">EMI - 3Months</option><option value="EMI - 6Months">EMI - 6Months</option></select></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Remarks</div><div class="z-input-wrapper"><input asp-for="Remarks" class="z-input" /></div></div></div>
    </div>

    <!-- SEC 8: TRACKING & MORE -->
    <h5 class="z-section-title">Tracking & Conversations</h5>
    <div class="z-form-section row">
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Contact Person 1</div><div class="z-input-wrapper"><input asp-for="ContactPerson1" class="z-input" /></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Contact 1 Phone</div><div class="z-input-wrapper"><input asp-for="Contact1Phone" class="z-input" /></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Contact Person 2</div><div class="z-input-wrapper"><input asp-for="ContactPerson2" class="z-input" /></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Contact 2 Phone</div><div class="z-input-wrapper"><input asp-for="Contact2Phone" class="z-input" /></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Contact Person 3</div><div class="z-input-wrapper"><input asp-for="ContactPerson3" class="z-input" /></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Contact 3 Phone</div><div class="z-input-wrapper"><input asp-for="Contact3Phone" class="z-input" /></div></div></div>

        <div class="col-md-6 mt-3"><div class="z-field-row"><div class="z-label">First call Date</div><div class="z-input-wrapper"><input asp-for="FirstCallDate" type="date" class="z-input" /></div></div></div>
        <div class="col-md-6 mt-3"><div class="z-field-row"><div class="z-label">Last Contact Date</div><div class="z-input-wrapper"><input asp-for="LastContactDate" type="date" class="z-input" /></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Next follow-up Date</div><div class="z-input-wrapper"><input asp-for="NextFollowUpDate" type="date" class="z-input" /></div></div></div>

        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Interested package</div><div class="z-input-wrapper"><select asp-for="InterestedPackage" class="z-input"><option value="">-None-</option><option value="Basic">Basic</option><option value="Standard">Standard</option></select></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Lost Reason</div><div class="z-input-wrapper"><select asp-for="LostReason" class="z-input"><option value="">-None-</option><option value="Price">Price</option><option value="Competitor">Competitor</option></select></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Lead profile</div><div class="z-input-wrapper"><input asp-for="LeadProfile" class="z-input" /></div></div></div>
        <div class="col-md-6"><div class="z-field-row"><div class="z-label">Conversation Remarks</div><div class="z-input-wrapper"><input asp-for="ConversationRemarks" class="z-input" /></div></div></div>

        <div class="col-md-12 mt-3"><div class="z-field-row"><div class="z-label" style="width:17.5%;">General Description</div><div class="z-input-wrapper" style="width:82.5%;"><textarea asp-for="Description" rows="4" class="z-input"></textarea></div></div></div>
    </div>

    <!-- Edit Action Footer -->
    <div class="d-flex justify-content-end gap-3 p-4 bg-light border-top">
        <button type="button" class="btn btn-light border px-4 fw-bold" onclick="toggleView('detail')">Cancel</button>
        <button type="submit" class="btn text-white px-5 fw-bold" style="background:var(--theme-navy-primary);">Save Lead</button>
    </div>
</div>
</form>
</div>

