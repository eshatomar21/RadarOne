<div class="modal fade" id="directDealConfirmModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content shadow-lg" style="border: none; border-radius: 12px; padding: 20px;">
            <div class="modal-body pb-0">
                <p style="font-size: 1.1rem; color: #333; margin-bottom: 12px;">Are you sure you want to make the deal?</p>
                <div style="font-size: 0.95rem; color: #555; line-height: 1.5;">👉 Click 'OK' for Yes<br>👉 Click 'Cancel' for No</div>
            </div>
            <div class="modal-footer" style="border-top: none; justify-content: flex-end; padding-top: 20px;">
                <button type="button" class="btn btn-success" id="btnConfirmDirectDeal" style="padding: 6px 20px; font-weight: 500; border-radius: 4px;">OK</button>
                <button type="button" class="btn btn-light" id="btnCancelDirectDeal" data-bs-dismiss="modal" style="border: 1px solid #ccc; padding: 6px 16px; font-weight: 500; border-radius: 4px;">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="directDealErrorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content shadow-lg" style="border: none; border-radius: 12px; border-left: 5px solid #ef4444;">
            <div class="modal-body p-4 text-center">
                <i class="fa-solid fa-triangle-exclamation mb-3" style="font-size: 2.5rem; color: #ef4444;"></i>
                <h6 class="fw-bold text-dark">Please fill the form.</h6>
                <p class="text-muted mb-4">Product Payments Section cannot be empty for a Direct Deal.</p>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pendingReasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg" style="border-radius: 12px;">
            <div class="modal-header" style="background-color: #fef2f2; border-bottom: 1px solid #fee2e2;">
                <h5 class="modal-title fw-bold" style="color: #b91c1c;"><i class="fa-solid fa-circle-exclamation me-2"></i> Action Required</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px; font-size: 0.95rem;">
                Your profile is incomplete! <br><br>
                Please either <b>complete the full professional profile</b> (Doctor, Work Type, Clinic Type, Computer), or else <b>select a Profile Pending Reason</b> to save it as incomplete.
            </div>
            <div class="modal-footer" style="background-color: #f8fafc;">
                <button type="button" class="btn-sf-primary" data-bs-dismiss="modal" style="width: 100%;">Okay, I will fix it</button>
            </div>
        </div>
    </div>
</div>

