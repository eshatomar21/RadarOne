@model Radar_CRM.Models.Lead
@using System.Security.Claims

@{
    ViewData["Title"] = "Edit Lead";

    // Get logged-in user to set defaults
    string currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

    // Prepare Notes & Tasks for Detail View
    var allNotes = ViewBag.ExistingNotes as IEnumerable<Radar_CRM.Models.Notes> ?? new List<Radar_CRM.Models.Notes>();
    var topNotes = allNotes.Take(5).ToList();
    var extraNotes = allNotes.Skip(5).ToList();

    // 🚀 FIX: Load and separate tasks passed from Controller
    var allTasks = ViewBag.Tasks as IEnumerable<Radar_CRM.Models.Task> ?? new List<Radar_CRM.Models.Task>();

    var openTasks = allTasks.Where(t => t.Status != "Completed").OrderBy(t => t.DueDate).ToList();
    var closedTasks = allTasks.Where(t => t.Status == "Completed").OrderByDescending(t => t.DueDate).ToList();
    // Grab the most urgent open task for the Next Action panel
    var nextTask = openTasks.FirstOrDefault();
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-shadow-float: 0 20px 40px -10px rgba(30, 58, 138, 0.08);
    }

    body {
        background-color: var(--theme-bg-cream);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--theme-text-main);
        -webkit-font-smoothing: antialiased;
    }

    /* =========================================
                               DETAIL VIEW (QUICK VIEW) CSS
                               ========================================= */
    #detailViewContainer {
        display: flex;
        min-height: 100vh;
        background: #f5f6f8;
    }

    /* Left Sidebar (Related List) - STICKY */
    .detail-sidebar {
        width: 240px;
        background-color: var(--theme-navy-primary);
        color: white;
        padding: 20px 0;
        flex-shrink: 0;
        height: 100vh;
        position: sticky;
        top: 0;
        overflow-y: auto;
    }

        .detail-sidebar h6 {
            padding: 0 20px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 15px;
            color: #bfdbfe;
        }

    .related-list-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .related-list-menu li {
            padding: 10px 20px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: 0.2s;
            border-left: 3px solid transparent;
        }

            .related-list-menu li:hover {
                background-color: rgba(255, 255, 255, 0.1);
                border-left-color: white;
            }

            .related-list-menu li i {
                width: 20px;
                margin-right: 8px;
            }

    /* Main Detail Content */
    .detail-main {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        background: #f5f6f8;
    }

    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 30px;
        border-bottom: 1px solid var(--theme-border);
        background: white;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .detail-content {
        padding: 20px 30px;
        overflow-y: auto;
    }

    .detail-section-card {
        background: white;
        border: 1px solid var(--theme-border);
        border-radius: 8px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }

    /* Chevron Stage Bar */
    .sf-chevron-bar {
        list-style: none;
        padding: 0;
        margin: 0 0 24px 0;
        display: flex;
        background: var(--theme-surface);
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        overflow: hidden;
    }

        .sf-chevron-bar li {
            flex: 1;
            text-align: center;
            padding: 10px 0;
            position: relative;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--theme-text-main);
            background: var(--theme-surface);
        }

            .sf-chevron-bar li::after, .sf-chevron-bar li::before {
                content: " ";
                position: absolute;
                top: 0;
                right: -16px;
                width: 0;
                height: 0;
                border-top: 20px solid transparent;
                border-bottom: 20px solid transparent;
                border-left: 16px solid var(--theme-border);
                z-index: 2;
            }

            .sf-chevron-bar li::after {
                right: -15px;
                border-left: 16px solid var(--theme-surface);
                z-index: 3;
            }

            .sf-chevron-bar li.active {
                color: #16a34a;
                background: #f0fdf4;
                font-weight: 600;
            }

                .sf-chevron-bar li.active::after {
                    border-left-color: #f0fdf4;
                }

            .sf-chevron-bar li:last-child::after, .sf-chevron-bar li:last-child::before {
                display: none;
            }

    .zoho-task-table {
        width: 100%;
        border-collapse: collapse;
    }

        .zoho-task-table th {
            border-bottom: 2px solid var(--theme-border);
            padding: 10px;
            font-size: 0.8rem;
            color: var(--theme-text-muted);
            text-align: left;
        }

        .zoho-task-table td {
            padding: 12px 10px;
            border-bottom: 1px solid var(--theme-border);
            font-size: 0.9rem;
        }

    /* =========================================
                               EDIT VIEW CSS (CLEAN ZOHO ALIGNMENT)
                               ========================================= */
    .z-edit-container {
        background: #fff;
        max-width: 1400px;
        margin: 20px auto;
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .z-edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 30px;
        border-bottom: 1px solid var(--theme-border);
        background: #f8fafc;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .z-section-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        padding: 15px 30px;
        margin: 0;
        border-bottom: 1px solid var(--theme-border);
        background: #f1f5f9;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .z-form-section {
        padding: 24px 30px;
        background: #fff;
        margin: 0;
        border-bottom: 1px solid var(--theme-border);
    }

    .z-field-row {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
        position: relative;
    }

    .z-label {
        width: 35%;
        text-align: right;
        padding-right: 20px;
        font-size: 0.85rem;
        color: #475569;
        font-weight: 600;
    }

    .z-input-wrapper {
        width: 65%;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Darker boundaries requested */
    .z-input {
        width: 100%;
        border: 1px solid #94a3b8;
        border-radius: 4px;
        padding: 6px 12px;
        font-size: 0.9rem;
        color: #1f2937;
        transition: 0.2s;
        background: #fff;
        height: 38px;
    }

        .z-input:focus {
            border-color: var(--theme-navy-primary);
            box-shadow: 0 0 0 2px var(--theme-navy-light);
            outline: none;
        }

        .z-input[readonly] {
            background-color: #f8fafc;
            color: #64748b;
            cursor: not-allowed;
        }

    textarea.z-input {
        height: auto;
    }

    /* Tables & Verifications inside Edit */
    .verify-btn {
        background: var(--theme-navy-light);
        color: var(--theme-navy-primary);
        border: 1px solid var(--theme-navy-primary);
        font-weight: 600;
        border-radius: 4px;
        padding: 0 16px;
        height: 38px;
        font-size: 0.85rem;
        cursor: pointer;
    }

        .verify-btn:hover {
            background: var(--theme-navy-primary);
            color: #fff;
        }

    .table-payments {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #94a3b8;
        border-radius: 4px;
        overflow: hidden;
        background: #fff;
    }

        .table-payments th {
            background-color: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #94a3b8;
        }

        .table-payments td {
            padding: 8px 12px;
            border-bottom: 1px solid #e2e8f0;
        }

        .table-payments .z-input {
            margin-bottom: 0;
        }

    .summary-box {
        border: 1px solid #94a3b8;
        border-radius: 4px;
        background: #f8fafc;
        padding: 16px;
        width: 320px;
        float: right;
        margin-top: 16px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #e2e8f0;
    }

        .summary-row:last-child {
            border-bottom: none;
            font-weight: 700;
            color: var(--theme-navy-primary);
        }

    .summary-input {
        width: 120px;
        text-align: right;
        border: 1px solid #94a3b8;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 0.85rem;
    }
</style>

<!-- ========================================================
     1. DEFAULT VIEW (ZOHO DETAIL / QUICK EDIT)
     ======================================================== -->
<div id="detailViewContainer">
    <!-- Left Sidebar: Related List -->
    <div class="detail-sidebar">
        <div class="px-4 mb-4 mt-2">
            <h5 class="fw-bold m-0 text-white">@Model.LeadName</h5>
            <small style="color: #bfdbfe;">Lead</small>
        </div>
        <h6>Related List</h6>
        <ul class="related-list-menu">
            <li onclick="window.scrollTo({top:0, behavior:'smooth'})"><i class="fa-solid fa-list-ul"></i> Overview</li>
            <li onclick="document.getElementById('detailNotesSection').scrollIntoView({behavior:'smooth'})"><i class="fa-regular fa-note-sticky"></i> Notes (@allNotes.Count())</li>
            <li onclick="document.getElementById('detailOpenTasksSection').scrollIntoView({behavior:'smooth'})"><i class="fa-solid fa-list-check"></i> Open Activities</li>
            <li onclick="document.getElementById('detailClosedTasksSection').scrollIntoView({behavior:'smooth'})"><i class="fa-solid fa-check-double"></i> Closed Activities</li>
            <li><i class="fa-solid fa-paperclip"></i> Attachments</li>
        </ul>
    </div>

    <!-- Main Detail Content -->
    <div class="detail-main">
        <div class="detail-header shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-light rounded-circle border" onclick="window.history.back();" style="width: 36px; height: 36px; padding: 0;"><i class="fa-solid fa-arrow-left"></i></button>
                <h4 class="m-0 fw-bold" style="color: var(--theme-navy-primary);">@Model.LeadName</h4>
            </div>
            <div>
                <button type="button" class="btn btn-light border fw-bold px-4" onclick="toggleView('edit')"><i class="fa-solid fa-pencil me-2"></i> Edit</button>
            </div>
        </div>

        <div class="detail-content">
            <!-- Stage Bar -->
            <div class="mb-4">
                <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; margin-bottom: 6px;">START &bull; @DateTime.Now.ToString("dd/MM/yyyy")</div>
                <ul class="sf-chevron-bar shadow-sm" id="detailChevronStageBar" style="pointer-events: none;">
                    <li data-val="Open">Open</li>
                    <li data-val="Demo Scheduled">Demo Scheduled</li>
                    <li data-val="Demo Done">Demo Done</li>
                    <li data-val="Trial Offered">Trial Offered</li>
                    <li data-val="Direct Deal">Direct Deal</li>
                    <li data-val="Won">Won</li>
                    <li data-val="Lost">Lost</li>
                </ul>
            </div>

            <!-- Quick Edit Section (Syncs to main form) -->
            <div class="detail-section-card">
                <h6 class="fw-bold border-bottom pb-2 mb-3" style="color: var(--theme-navy-primary);">Quick Info</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="row align-items-center">
                            <div class="col-4 text-muted fw-bold" style="font-size: 0.85rem;">Lead Owner</div>
                            <div class="col-8">
                                <select class="form-select form-select-sm border border-secondary" id="QuickLeadOwnerId" asp-items="ViewBag.UsersList" onchange="document.getElementById('LeadOwnerId').value = this.value;">
                                    <option value="">- Select -</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="row align-items-center">
                            <div class="col-4 text-muted fw-bold" style="font-size: 0.85rem;">Email ID</div>
                            <div class="col-8">
                                <input type="text" class="form-control form-control-sm border border-secondary" id="QuickEmailID" value="@Model.EmailID" onchange="document.getElementById('EmailID').value = this.value;" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="row align-items-center">
                            <div class="col-4 text-muted fw-bold" style="font-size: 0.85rem;">Mobile Number</div>
                            <div class="col-8">
                                <input type="text" class="form-control form-control-sm border border-secondary" id="QuickMobileNumber" value="@Model.MobileNumber" onchange="document.getElementById('MobileNumber').value = this.value;" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="row align-items-center">
                            <div class="col-4 text-muted fw-bold" style="font-size: 0.85rem;">Data Sources</div>
                            <div class="col-8">
                                <select class="form-select form-select-sm border border-secondary" id="QuickDataSources" onchange="document.getElementById('DataSources').value = this.value; document.getElementById('DataSources').dispatchEvent(new Event('change'));">
                                    <option value="">- None -</option>
                                    <option value="InboundCall">InboundCall</option>
                                    <option value="Referral/Dealer">Referral/Dealer</option>
                                    <option value="Meta Ads">Meta Ads</option>
                                    <option value="Google AdWords">Google AdWords</option>
                                    <option value="Outreach">Outreach</option>
                                    <option value="Group Lead">Group Lead</option>
                                    <option value="Institutiona">Institutional</option>
                                    <option value="Webinar">Webinar</option>
                                    <option value="KOMMO">KOMMO</option>
                                    <option value="Google Organic SEO">Google Organic SEO</option>
                                    <option value="Website Direct">Website Direct</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="row align-items-center">
                            <div class="col-4 text-muted fw-bold" style="font-size: 0.85rem;">Alt Mobile</div>
                            <div class="col-8">
                                <input type="text" class="form-control form-control-sm border border-secondary" id="QuickAlternateMobile" value="@Model.AlternateMobile" onchange="document.getElementById('AlternateMobile').value = this.value;" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="row align-items-center">
                            <div class="col-4 text-muted fw-bold" style="font-size: 0.85rem;">Lead Status</div>
                            <div class="col-8">
                                <select class="form-select form-select-sm border border-secondary" id="QuickLeadStatus" onchange="document.getElementById('LeadStatus').value = this.value;">
                                    <option value="">- None -</option>
                                    <option value="Cold">Cold</option>
                                    <option value="Not interested">Not interested</option>
                                    <option value="Warm">Warm</option>
                                    <option value="Hot">Hot</option>
                                    <option value="ImportantContact">ImportantContact</option>
                                    <option value="Not Answering">Not Answering</option>
                                    <option value="InterestedCold">InterestedCold</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Next Action -->
            <div class="detail-section-card">
                <h6 class="fw-bold border-bottom pb-2 mb-3" style="color: var(--theme-navy-primary);">Next Action</h6>
                <div class="p-3 rounded d-flex align-items-center" style="background-color: var(--theme-navy-light); border: 1px solid #bfdbfe;">
                    <span class="badge text-white me-3" style="background-color: var(--theme-navy-primary); font-size: 0.8rem; padding: 6px 10px;">ACTION</span>
                    <span class="fw-medium text-dark" id="nextActionDisplay">
                        @if (nextTask != null)
                        {
                            @($"{nextTask.Subject} - Due: {(nextTask.DueDate != null ? nextTask.DueDate.Value.ToString("dd MMM yyyy") : "N/A")}")
                        }
                        else
                        {
                            @:No upcoming actions scheduled.
                        }
                    </span>
                </div>
            </div>

            <!-- Notes Section -->
            <div id="detailNotesSection" class="detail-section-card">
                <h6 class="fw-bold mb-3 d-flex justify-content-between align-items-center border-bottom pb-2" style="color: var(--theme-navy-primary);">Notes <span class="badge bg-light text-dark border fw-normal">Recent First</span></h6>

                <div class="inline-note-editor mb-4 shadow-sm" style="border: 2px solid #ea580c; border-radius: 8px; background-color: #fff7ed; overflow: hidden;">
                    <div class="p-3">
                        <input type="text" id="inlineNoteTitle" class="form-control border-0 shadow-none mb-1" placeholder="Title" style="background: transparent; font-size: 1.05rem; font-weight: 700; color: #431407;" />
                        <textarea id="inlineNoteDesc" class="form-control border-0 shadow-none" rows="3" placeholder="What's this note about?" style="background: transparent; font-size: 0.95rem; color: #7c2d12; resize: none;"></textarea>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-2" style="background-color: #ffffff; border-top: 1px solid #fed7aa;">
                        <div class="d-flex gap-3 align-items-center ps-2">
                            <label for="inlineNoteFile" style="cursor: pointer; color: #ea580c; transition: 0.2s;" title="Attach File" onmouseover="this.style.color='#9a3412'" onmouseout="this.style.color='#ea580c'"><i class="fa-solid fa-paperclip fs-5"></i></label>
                            <input type="file" id="inlineNoteFile" style="display: none;" />
                            <select id="inlineNoteOwner" class="form-select form-select-sm border-0 shadow-none fw-semibold" asp-items="ViewBag.UsersList" style="width: 140px; background: transparent; color: #9a3412; cursor: pointer;">
                                <option value="">- System User -</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-light fw-bold px-3" onclick="clearInlineNote()" style="color: #9a3412; border: 1px solid #fed7aa;">Cancel</button>
                            <button type="button" class="btn btn-sm text-white fw-bold px-4" onclick="saveInlineNote()" style="background-color: #ea580c;">Save</button>
                        </div>
                    </div>
                </div>

                <div id="notesContainer">
                    @foreach (var note in topNotes)
                    {
                        <div class="p-3 mb-3 rounded shadow-sm" style="border-left: 4px solid var(--theme-navy-primary); background: #ffffff; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
                            <div class="d-flex align-items-center mb-1"><span class="fw-bold text-dark" style="font-size: 0.85rem;">@(note.NoteOwner?.fullName ?? "System User")</span><span class="text-muted ms-auto" style="font-size: 0.75rem;">@note.CreatedDateTime.ToString("MMM dd, yyyy hh:mm tt")</span></div>
                            <div class="mt-1 text-secondary" style="font-size: 0.9rem; white-space: pre-wrap;">@(!string.IsNullOrEmpty(note.NoteTitle) ? Html.Raw($"<b>{note.NoteTitle}</b><br>") : "")@note.Description</div>
                            @if (!string.IsNullOrEmpty(note.AttachmentFileName))
                            {
                                <div class="mt-2"><a href="@Url.Action("DownloadNoteFile", "Leads", new { noteId = note.Id })" target="_blank" class="text-decoration-none fw-semibold shadow-sm" style="font-size: 0.75rem; color: #ffffff; background: var(--theme-navy-primary); padding: 4px 10px; border-radius: 4px; display: inline-flex; align-items: center;"><i class="fa-solid fa-paperclip me-2"></i> @note.AttachmentFileName</a></div>
                            }
                        </div>
                    }
                    <div id="extraNotesContainer" style="display: none;">
                        @foreach (var note in extraNotes)
                        {
                            <div class="p-3 mb-3 rounded shadow-sm" style="border-left: 4px solid var(--theme-navy-primary); background: #ffffff; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
                                <div class="d-flex align-items-center mb-1"><span class="fw-bold text-dark" style="font-size: 0.85rem;">@(note.NoteOwner?.fullName ?? "System User")</span><span class="text-muted ms-auto" style="font-size: 0.75rem;">@note.CreatedDateTime.ToString("MMM dd, yyyy hh:mm tt")</span></div>
                                <div class="mt-1 text-secondary" style="font-size: 0.9rem; white-space: pre-wrap;">@(!string.IsNullOrEmpty(note.NoteTitle) ? Html.Raw($"<b>{note.NoteTitle}</b><br>") : "")@note.Description</div>
                                @if (!string.IsNullOrEmpty(note.AttachmentFileName))
                                {
                                    <div class="mt-2"><a href="@Url.Action("DownloadNoteFile", "Leads", new { noteId = note.Id })" target="_blank" class="text-decoration-none fw-semibold shadow-sm" style="font-size: 0.75rem; color: #ffffff; background: var(--theme-navy-primary); padding: 4px 10px; border-radius: 4px; display: inline-flex; align-items: center;"><i class="fa-solid fa-paperclip me-2"></i> @note.AttachmentFileName</a></div>
                                }
                            </div>
                        }
                    </div>
                    @if (extraNotes.Any())
                    {
                        <div class="text-center mt-3"><button id="viewPreviousNotesBtn" class="btn btn-light border text-primary text-sm w-100 fw-bold" onclick="toggleExtraNotes()">View Previous Notes</button></div>
                    }
                </div>
            </div>

            <!-- Open Tasks -->
            <div id="detailOpenTasksSection" class="detail-section-card">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h6 class="fw-bold m-0" style="color: var(--theme-navy-primary);">Open Activities</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="openTaskModal()"><i class="fa-solid fa-plus"></i> Add Task</button>
                </div>
                @if (openTasks.Any())
                {
                    <table class="zoho-task-table">
                        <thead><tr><th>Subject</th><th>Due Date</th><th>Priority</th><th>Status</th></tr></thead>
                        <tbody id="openTasksTbody">
                            @foreach (var t in openTasks)
                            {
                                <tr data-task-id="@t.Id">
                                    <td class="text-primary fw-medium">@t.Subject</td>
                                    <td>@(t.DueDate != null ? t.DueDate.Value.ToString("dd MMM yyyy") : "-")</td>
                                    <td>@t.Priority</td>
                                    <td>
                                        <select class="form-select form-select-sm border task-status-dropdown" onchange="updateTaskStatus(this, '@t.Id')" style="width: 130px; font-size: 0.8rem; background-color: #f8fafc; color: #1e3a8a; font-weight: 600;">
                                            <option value="Not Started" selected="@(t.Status == "Not Started" ? "selected" : null)">Not Started</option>
                                            <option value="In Progress" selected="@(t.Status == "In Progress" ? "selected" : null)">In Progress</option>
                                            <option value="Waiting" selected="@(t.Status == "Waiting" ? "selected" : null)">Waiting</option>
                                            <option value="Deferred" selected="@(t.Status == "Deferred" ? "selected" : null)">Deferred</option>
                                            <option value="Completed" selected="@(t.Status == "Completed" ? "selected" : null)">Completed</option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center text-muted py-4" id="emptyOpenTasksPlaceholder"><i class="fa-regular fa-folder-open mb-2 fs-4"></i><br />No open activities</div>
                }
            </div>

            <!-- Closed Tasks -->
            <div id="detailClosedTasksSection" class="detail-section-card">
                <h6 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--theme-navy-primary);">Closed Activities</h6>
                @if (closedTasks.Any())
                {
                    <table class="zoho-task-table" id="closedTasksTable">
                        <thead><tr><th>Subject</th><th>Due Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var t in closedTasks)
                            {
                                <tr data-task-id="@t.Id">
                                    <td class="text-secondary text-decoration-line-through">@t.Subject</td>
                                    <td>@(t.DueDate.HasValue ? t.DueDate.Value.ToString("dd MMM yyyy") : "-")</td>
                                    <td class="text-success fw-bold"><i class="fa-solid fa-check me-1"></i> Completed</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center text-muted py-4"><i class="fa-solid fa-box-archive mb-2 fs-4"></i><br />No closed activities</div>
                }
            </div>
                       
        </div>
    </div>
</div>


