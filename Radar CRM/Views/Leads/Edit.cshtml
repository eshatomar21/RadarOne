@model Radar_CRM.Models.Lead

@{
    ViewData["Title"] = "Edit Lead";
}

<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --theme-bg-cream: #Fdfbf7;
        --theme-surface: #ffffff;
        --theme-navy-primary: #1e3a8a;
        --theme-navy-hover: #1e40af;
        --theme-navy-light: #eff6ff;
        --theme-text-main: #1f2937;
        --theme-text-muted: #64748b;
        --theme-border: #e2e8f0;
        --theme-shadow-float: 0 20px 40px -10px rgba(30, 58, 138, 0.08);
    }

    body {
        background-color: var(--theme-bg-cream);
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--theme-text-main);
        -webkit-font-smoothing: antialiased;
    }

    .sf-container {
        background-color: var(--theme-surface);
        width: 98%;
        max-width: 1800px;
        margin: 30px auto;
        min-height: 90vh;
        border-radius: 16px;
        box-shadow: var(--theme-shadow-float);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(255, 255, 255, 0.5);
        overflow: hidden;
    }

    .sf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
        background-color: var(--theme-surface);
        border-bottom: 1px solid var(--theme-border);
    }

    .sf-header-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .sf-header-title h1 {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--theme-navy-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: -0.02em;
        }

        .sf-header-title .entity-type {
            color: var(--theme-navy-primary);
            font-weight: 600;
            font-size: 0.85rem;
            background: var(--theme-navy-light);
            padding: 6px 14px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

    .sf-close-btn {
        background: transparent;
        border: 1px solid var(--theme-border);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--theme-text-muted);
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .sf-close-btn:hover {
            background: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            border-color: var(--theme-navy-light);
            transform: rotate(90deg);
        }

    .btn-sf-primary {
        background-color: var(--theme-navy-primary);
        color: var(--theme-surface);
        border: none;
        padding: 10px 28px;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);
    }

        .btn-sf-primary:hover {
            background-color: var(--theme-navy-hover);
            box-shadow: 0 6px 16px rgba(30, 58, 138, 0.25);
            transform: translateY(-1px);
        }

    /* Chevron Stage Bar Styling */
    .sf-chevron-bar {
        list-style: none;
        padding: 0;
        margin: 0 0 24px 0;
        display: flex;
        background: var(--theme-surface);
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        overflow: hidden;
    }

        .sf-chevron-bar li {
            flex: 1;
            text-align: center;
            padding: 10px 0;
            position: relative;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--theme-text-main);
            cursor: pointer;
            background: var(--theme-surface);
            transition: background 0.2s;
        }

            .sf-chevron-bar li:hover {
                background: #f8fafc;
            }

            .sf-chevron-bar li::after, .sf-chevron-bar li::before {
                content: " ";
                position: absolute;
                top: 0;
                right: -16px;
                width: 0;
                height: 0;
                border-top: 20px solid transparent;
                border-bottom: 20px solid transparent;
                border-left: 16px solid var(--theme-border);
                z-index: 2;
            }

            .sf-chevron-bar li::after {
                right: -15px;
                border-left: 16px solid var(--theme-surface);
                z-index: 3;
                transition: border-left-color 0.2s;
            }

            .sf-chevron-bar li.active {
                color: #16a34a; /* Green text */
                background: #f0fdf4; /* Light green background */
            }

                .sf-chevron-bar li.active::after {
                    border-left-color: #f0fdf4;
                }

            .sf-chevron-bar li:hover::after {
                border-left-color: #f8fafc;
            }

            .sf-chevron-bar li.active:hover::after {
                border-left-color: #f0fdf4;
            }

            .sf-chevron-bar li:last-child::after, .sf-chevron-bar li:last-child::before {
                display: none;
            }

    .sf-tabs {
        display: flex;
        border-bottom: 1px solid var(--theme-border);
        padding: 0 40px;
        background-color: var(--theme-surface);
        gap: 40px;
        margin: 0;
    }

    .sf-tab {
        background: none;
        border: none;
        padding: 20px 0;
        color: var(--theme-text-muted);
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        margin-bottom: -1px;
        transition: all 0.2s;
    }

        .sf-tab:hover {
            color: var(--theme-navy-primary);
        }

        .sf-tab.active {
            color: var(--theme-navy-primary);
            border-bottom: 3px solid var(--theme-navy-primary);
            font-weight: 600;
        }

    .form-group {
        margin-bottom: 28px;
    }

    .sf-label {
        display: block;
        font-size: 0.85rem;
        color: var(--theme-text-muted);
        margin-bottom: 8px;
        font-weight: 500;
    }

    .sf-input, .sf-select {
        width: 100%;
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        padding: 6px 12px;
        height: 36px;
        font-size: 0.85rem;
        color: var(--theme-text-main);
        background-color: #fafaf9;
        transition: all 0.2s ease-in-out;
    }

        .sf-input:hover, .sf-select:hover {
            border-color: #cbd5e1;
            background-color: var(--theme-surface);
        }

        .sf-input:focus, .sf-select:focus {
            outline: none;
            border-color: var(--theme-navy-primary);
            background-color: var(--theme-surface);
            box-shadow: 0 0 0 3px var(--theme-navy-light);
        }

        .sf-input[readonly] {
            background-color: transparent;
            border-color: transparent;
            border-bottom: 1px dashed var(--theme-border);
            border-radius: 0;
            padding-left: 0;
            color: var(--theme-text-main);
            font-weight: 500;
            cursor: default;
            height: auto;
        }

    textarea.sf-input {
        height: auto;
    }

    .pane-section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        margin-top: 16px;
        padding-bottom: 0;
        border-bottom: none;
        letter-spacing: -0.01em;
    }

    .sf-card {
        border: 1px solid var(--theme-border);
        border-radius: 12px;
        padding: 32px;
        margin-bottom: 24px;
        background-color: var(--theme-surface);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        transition: box-shadow 0.3s ease;
    }

        .sf-card:hover {
            box-shadow: var(--theme-shadow-float);
        }

    .sf-card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--theme-navy-primary);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid var(--theme-border);
        padding-bottom: 16px;
    }

    .verify-group {
        display: flex;
        position: relative;
    }

        .verify-group .sf-input {
            padding-right: 90px;
        }

        .verify-group .btn-verify {
            position: absolute;
            right: 3px;
            top: 3px;
            bottom: 3px;
            border: none;
            background: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            font-weight: 600;
            border-radius: 4px;
            padding: 0 12px;
            font-size: 0.75rem;
            transition: all 0.2s;
            cursor: pointer;
        }

            .verify-group .btn-verify:hover {
                background: var(--theme-navy-primary);
                color: var(--theme-surface);
            }

    .table-payments {
        width: 100%;
        margin-bottom: 16px;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid var(--theme-border);
        border-radius: 8px;
        overflow: hidden;
        background: var(--theme-surface);
    }

        .table-payments th {
            background-color: var(--theme-navy-light);
            color: var(--theme-navy-primary);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 12px;
            border-bottom: 1px solid var(--theme-border);
            text-align: left;
        }

        .table-payments td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--theme-border);
        }

        .table-payments .sf-input {
            margin-bottom: 0;
        }

    .btn-add-row {
        background-color: #ffffff;
        color: #10b981;
        border: 1px solid #10b981;
        padding: 6px 16px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: 0.2s;
    }

        .btn-add-row:hover {
            background-color: #ecfdf5;
        }

    .summary-box {
        border: 1px solid var(--theme-border);
        border-radius: 8px;
        background: var(--theme-surface);
        padding: 16px;
        width: 300px;
        float: right;
        margin-top: 16px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--theme-bg-cream);
    }

        .summary-row:last-child {
            border-bottom: none;
            font-weight: 700;
            color: var(--theme-navy-primary);
        }

    .summary-input {
        width: 100px;
        text-align: right;
        border: 1px solid var(--theme-border);
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 0.85rem;
    }

    /* Layout Split Adjustments */
    .content-wrapper {
        display: flex;
        flex-grow: 1;
        flex-direction: row;
    }

    .main-col {
        flex: 1;
        border-right: 1px solid var(--theme-border);
        display: flex;
        flex-direction: column;
    }

    .sidebar-col {
        width: 360px;
        background-color: #f8fafc;
        padding: 24px;
        overflow-y: auto;
    }

    /* NEW SIDEBAR STYLES (Matching image_b1c60a.png) */
    .sidebar-wrapper {
        background-color: var(--theme-surface);
        border: 1px solid var(--theme-border);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .sidebar-header {
        background-color: #1e3a8a; /* Dark blue */
        color: white;
        padding: 14px 16px;
        font-weight: 700;
        font-size: 1.05rem;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 4px solid #f97316; /* Orange stripe */
    }

    .sidebar-content {
        padding: 20px;
    }

    .sidebar-section {
        margin-bottom: 24px;
    }

    .sidebar-section-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sidebar-add-btn {
        background: transparent;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        cursor: pointer;
        font-size: 12px;
        transition: all 0.2s;
    }

        .sidebar-add-btn:hover {
            background: #f1f5f9;
            color: #1e3a8a;
        }

    .sidebar-empty {
        font-size: 0.85rem;
        color: #94a3b8;
        font-style: italic;
    }

    .contact-card {
        border: 1px solid var(--theme-border);
        border-radius: 6px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.9rem;
        font-weight: 600;
        color: #334155;
        background-color: #ffffff;
    }

    /* Dynamic Transferred Notes Styling */
    .note-card {
        border: 1px solid var(--theme-border);
        border-left: 3px solid #1e3a8a; /* Exact left border match */
        border-radius: 6px;
        padding: 12px 14px;
        margin-bottom: 10px;
        background: white;
    }

    .note-header {
        font-size: 0.75rem;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .note-body {
        font-size: 0.85rem;
        color: #1f2937;
        white-space: pre-wrap;
    }
</style>

<form asp-action="Edit" novalidate method="post" id="leadForm" enctype="multipart/form-data">
    <!-- Essential for Edit Pages so the database knows which record to update -->
    <input type="hidden" asp-for="Id" />

    <div class="sf-container">

        <!-- HEADER -->
        <div class="sf-header">
            <div class="sf-header-title">
                <button type="button" class="sf-close-btn" onclick="window.history.back();">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <h1><span class="entity-type">Lead</span> Edit Lead</h1>
            </div>
            
        </div>

        <!-- NEW CONTENT WRAPPER: Main Content (Tabs) + Right Sidebar -->
        <div class="content-wrapper">

            <!-- MAIN LEFT COLUMN -->
            <div class="main-col">

                <!-- STAGE BAR (Chevron) -->
                <div style="padding: 24px 40px 0;">
                    <div style="font-size: 0.8rem; font-weight: 600; color: #475569; margin-bottom: 4px;">START</div>
                    <div style="font-size: 0.75rem; color: #94a3b8; margin-bottom: 8px;">@DateTime.Now.ToString("dd/MM/yyyy")</div>

                    <!-- Added pointer-events: none to disable clicking -->
                    <ul class="sf-chevron-bar" id="chevronStageBar" style="pointer-events: none; opacity: 0.9;">
                        <li data-val="Open">Open</li>
                        <li data-val="Demo Scheduled">Demo Scheduled</li>
                        <li data-val="Demo Done">Demo Done</li>
                        <li data-val="Trial Offered">Trial Offered</li>
                        <li data-val="Direct Deal">Direct Deal</li>
                        <li data-val="Won">Won</li>
                        <li data-val="Lost">Lost</li>
                    </ul>
                </div>

                <!-- TABS -->
                <ul class="nav sf-tabs" id="leadTabs" role="tablist">
                    <li class="nav-item" role="presentation"><button class="sf-tab active" data-bs-toggle="tab" data-bs-target="#main" type="button" role="tab">Main Info</button></li>
                    <li class="nav-item" role="presentation"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#address" type="button" role="tab">Address Info</button></li>
                    <li class="nav-item" role="presentation"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#professional" type="button" role="tab">Professional Details</button></li>
                    <li class="nav-item" role="presentation"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#deals" type="button" role="tab">Deals & Purchases</button></li>
                    <li class="nav-item" role="presentation"><button class="sf-tab" data-bs-toggle="tab" data-bs-target="#tracking" type="button" role="tab">Tracking & More</button></li>
                </ul>

                <div class="tab-content" id="leadTabsContent" style="padding: 24px 40px; flex-grow: 1; overflow-y: auto;">

                    <!-- ==============================
                 1. MAIN INFO TAB
            =============================== -->
                    <div class="tab-pane fade show active" id="main" role="tabpanel">
                        <h3 class="pane-section-title">Master Details</h3>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Lead Owner</label>
                                <select asp-for="LeadOwnerId" asp-items="@ViewBag.UsersList" class="sf-select">
                                    <option value="">- Select -</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Co-Owner</label>
                                <select asp-for="CoOwnerId" asp-items="@ViewBag.UsersList" class="sf-select">
                                    <option value="">- Select -</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Account Owner</label>
                                <select asp-for="AccountOwnerId" asp-items="@ViewBag.UsersList" class="sf-select">
                                    <option value="">- Select -</option>
                                </select>
                            </div>

                            <div class="col-md-4 form-group">
                                <label class="sf-label">Demo Owner</label>
                                <select asp-for="DemoOwnerId" asp-items="@ViewBag.UsersList" class="sf-select">
                                    <option value="">- Select -</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Lead Name <span class="text-danger">*</span></label>
                                <input asp-for="LeadName" class="sf-input" required style="font-weight: 600;" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Created Date & Time</label>
                                <input asp-for="CreatedDateAndTime" type="datetime-local" class="sf-input" />
                            </div>

                            <div class="col-md-6 form-group">
                                <label class="sf-label">Account Name (Lookup)</label>
                                <select asp-for="AccountId" asp-items="ViewBag.AccountsList" class="sf-select">
                                    <option value="">- Select Account -</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Contact Name</label>
                                <input asp-for="ContactName" class="sf-input" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Account Type</label>
                                <select asp-for="AccountType" class="sf-select">
                                    <option value="None">-None-</option>
                                    <option value="Individual">Individual</option>
                                    <option value="Group">Group</option>
                                    <option value="Institution">Institution</option>
                                    <option value="Government Organisation">Government Organisation</option>
                                </select>
                            </div>

                            <div class="col-md-6 form-group">
                                <label class="sf-label">Group Name</label>
                                <select asp-for="GroupName" asp-items="ViewBag.VendorsList" class="sf-select">
                                    <option value="">-Select Group Name-</option>
                                </select>
                            </div>

                            <div class="col-md-4 form-group">
                                <label class="sf-label">Mobile Number</label>
                                <div class="verify-group">
                                    <input asp-for="MobileNumber" class="sf-input" id="MobileNumber" placeholder="+1 202-555-0117" />
                                    <button type="button" class="btn-verify" onclick="verifyPhone('MobileNumber')">Verify</button>
                                </div>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Alternate Mobile</label>
                                <div class="verify-group">
                                    <input asp-for="AlternateMobile" class="sf-input" id="AlternateMobile" placeholder="Optional..." />
                                    <button type="button" class="btn-verify" onclick="verifyPhone('AlternateMobile')">Verify</button>
                                </div>
                            </div>

                            <div class="col-md-4 form-group">
                                <label class="sf-label">Email ID</label>
                                <input asp-for="EmailID" class="sf-input" style="color: var(--theme-navy-primary);" placeholder="email@example.com" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Alternate Email ID</label>
                                <input asp-for="AlternateEmailID" class="sf-input" placeholder="Optional..." />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Social Lead ID</label>
                                <input asp-for="SocialLeadID" class="sf-input" />
                            </div>

                            <div class="col-md-4 form-group">
                                <label class="sf-label">Pipeline <span class="text-danger">*</span></label>
                                <select asp-for="Pipeline" class="sf-select" required>
                                    <option value="">-None-</option>
                                    <option value="New Software">New Software</option>
                                    <option value="Upgrade Software">Upgrade Software</option>
                                    <option value="Sales Support">Sales Support</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Campaign Source</label>
                                <input asp-for="CampaignSource" class="sf-input" />
                            </div>
                            <div class="col-md-4 form-group" id="divMetaCampaign" style="display:none;">
                                <label class="sf-label">Meta Campaign Name</label>
                                <input asp-for="MetaCampaignName" class="sf-input" placeholder="Enter campaign name..." />
                            </div>

                            <div class="col-md-4 form-group">
                                <label class="sf-label">Current Status</label>
                                <select asp-for="CurrentStatus" class="sf-select">
                                    <option value="None">-None-</option>
                                    <option value="User">User</option>
                                    <option value="Non-User">Non-User</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Data Sources <span class="text-danger">*</span></label>
                                <select asp-for="DataSources" class="sf-select" id="DataSources" required>
                                    <option value="None">-None-</option>
                                    <option value="InboundCall">InboundCall</option>
                                    <option value="Referral/Dealer">Referral/Dealer</option>
                                    <option value="Meta Ads">Meta Ads</option>
                                    <option value="Google AdWords">Google AdWords</option>
                                    <option value="Outreach">Outreach</option>
                                    <option value="Group Lead">Group Lead</option>
                                    <option value="Institutiona">Institutional</option>
                                    <option value="Webinar">Webinar</option>
                                    <option value="KOMMO">KOMMO</option>
                                    <option value="Google Organic SEO">Google Organic SEO</option>
                                    <option value="Website Direct">Website Direct</option>
                                    <option value="YouTube">YouTube</option>
                                    <option value="LinkedIn">LinkedIn</option>
