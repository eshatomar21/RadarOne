                        <!-- SECTION 3: Dynamic Product Payments Table -->
                        <h3 class="pane-section-title mt-4">Product Payments Section</h3>
                        <div class="table-responsive" style="overflow: visible;">
                            <table class="table-payments" id="paymentsTable">
                                <thead>
                                    <tr>
                                        <th style="width:15%;">Deal Type</th>
                                        <th>Product Name</th>
                                        <th style="width:10%;">Quantity</th>
                                        <th style="width:12%;">Product Price(Rs.)</th>
                                        <th style="width:12%;">Total(Rs.)</th>
                                        <th style="width:12%;">Discount %(Rs.)</th>
                                        <th style="width:15%;">Final Amount(Rs.)</th>
                                        <th style="width:40px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="paymentTbody">
                                    @if (Model?.PaymentRow != null && Model.PaymentRow.Count > 0)
                                    {
                                        for (int i = 0; i < Model.PaymentRow.Count; i++)
                                        {
                                            <tr class="payment-row">
                                                <input type="hidden" name="PaymentRow[@i].Id" value="@Model.PaymentRow[i].Id" />
                                                <td>
                                                    <select name="PaymentRow[@i].DealType" class="sf-select">
                                                        <option value="">-None-</option>
                                                        <option value="New Sale" selected="@(Model.PaymentRow[i].DealType == "New Sale" ? "selected" : null)">New Sale</option>
                                                        <option value="Upgrade" selected="@(Model.PaymentRow[i].DealType == "Upgrade" ? "selected" : null)">Upgrade</option>
                                                        <option value="Add On" selected="@(Model.PaymentRow[i].DealType == "Add On" ? "selected" : null)">Add On</option>
                                                        <option value="Stock Key" selected="@(Model.PaymentRow[i].DealType == "Stock Key" ? "selected" : null)">Stock Key</option>
                                                        <option value="Existing" selected="@(Model.PaymentRow[i].DealType == "Existing" ? "selected" : null)">Existing</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <select asp-for="@Model.PaymentRow[i].ProductId" name="PaymentRow[@i].ProductId" asp-items="ViewBag.ProductsList" class="sf-select product-select" onchange="productSelected(this)">
                                                        <option value="0">-Select Product-</option>
                                                    </select>
                                                    <input type="hidden" name="PaymentRow[@i].ProductName" class="product-name-hidden" value="@Model.PaymentRow[i].ProductName" />
                                                </td>
                                                <td><input type="number" name="PaymentRow[@i].Quantity" value="@Model.PaymentRow[i].Quantity" class="sf-input qty" onchange="calcRow(this)" /></td>
                                                <td><input type="number" name="PaymentRow[@i].ProductPrice" value="@Model.PaymentRow[i].ProductPrice" class="sf-input price" onchange="calcRow(this)" /></td>
                                                <td><input type="number" name="PaymentRow[@i].Total" value="@Model.PaymentRow[i].Total" class="sf-input total" readonly style="background:#F8FAFC;" /></td>
                                                <td><input type="number" name="PaymentRow[@i].DiscountPercent" value="@Model.PaymentRow[i].DiscountPercent" class="sf-input disc" onchange="calcRow(this)" /></td>
                                                <td><input type="number" name="PaymentRow[@i].FinalAmount" value="@Model.PaymentRow[i].FinalAmount" class="sf-input final" readonly style="background:#F8FAFC;" /></td>
                                                <td>
                                                    <button type="button" style="width:24px;height:24px;background:transparent;border:none;" onclick="removeRow(this)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <!-- Fallback empty row index is securely 0 -->
                                        <tr class="payment-row">
                                            <td>
                                                <select name="PaymentRow[0].DealType" class="sf-select">
                                                    <option value="">-None-</option>
                                                    <option value="New Sale">New Sale</option>
                                                    <option value="Upgrade">Upgrade</option>
                                                    <option value="Add On">Add On</option>
                                                    <option value="Stock Key">Stock Key</option>
                                                    <option value="Existing">Existing</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select name="PaymentRow[0].ProductId" asp-items="ViewBag.ProductsList" class="sf-select product-select" onchange="productSelected(this)">
                                                    <option value="0">-Select Product-</option>
                                                </select>
                                                <input type="hidden" name="PaymentRow[0].ProductName" class="product-name-hidden" value="" />
                                            </td>
                                            <td><input type="number" name="PaymentRow[0].Quantity" class="sf-input qty" value="1" onchange="calcRow(this)" /></td>
                                            <td><input type="number" name="PaymentRow[0].ProductPrice" class="sf-input price" value="0" onchange="calcRow(this)" /></td>
                                            <td><input type="number" name="PaymentRow[0].Total" class="sf-input total" readonly style="background:#F8FAFC;" /></td>
                                            <td><input type="number" name="PaymentRow[0].DiscountPercent" class="sf-input disc" value="0" onchange="calcRow(this)" /></td>
                                            <td><input type="number" name="PaymentRow[0].FinalAmount" class="sf-input final" readonly style="background:#F8FAFC;" /></td>
                                            <td>
                                                <button type="button" style="width:24px;height:24px;background:transparent;border:none;" onclick="removeRow(this)">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-start mt-3">
                            <button type="button" class="btn-add-row" onclick="addRow()">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                Add row
                            </button>

                            <div class="summary-box m-0">
                                <div class="summary-row">
                                    <span class="sf-label p-0 m-0">SubTotal (Rs.)</span>
                                    <input asp-for="SubTotal" type="number" class="summary-input" id="subTotal" readonly style="background:#F8FAFC;" />
                                </div>
                                <div class="summary-row">
                                    <span class="sf-label p-0 m-0">Taxes (18%)</span>
                                    <input asp-for="Taxes" type="number" class="summary-input" id="taxes" value="0" readonly style="background:#F8FAFC;" />
                                </div>
                                <div class="summary-row">
                                    <span class="sf-label p-0 m-0">Adjustment (Rs.)</span>
                                    <input asp-for="Adjustment" type="number" class="summary-input" id="adjustment" value="0" onchange="calcGrand()" />
                                </div>
                                <div class="summary-row">
                                    <span class="sf-label p-0 m-0" style="color:var(--theme-navy-primary);">Grand Total (Rs.)</span>
                                    <input asp-for="GrandTotal" type="number" class="summary-input" id="grandTotal" readonly style="background:#F8FAFC; font-weight:bold; color:var(--theme-navy-primary);" />
                                </div>
                            </div>
                        </div>
                        <div style="clear:both;"></div>

                        <h3 class="pane-section-title mt-5">Payment Options</h3>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Payment Mode</label>
                                <select asp-for="PaymentMode" class="sf-select">
                                    <option value="">-None-</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Card">Card</option>
                                    <option value="Online">Online</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Payment Type</label>
                                <select asp-for="PaymentType" class="sf-select">
                                    <option value="">-None-</option>
                                    <option value="Upfront">Upfront</option>
                                    <option value="EMI - 3Months">EMI - 3Months</option>
                                    <option value="EMI - 6Months">EMI - 6Months</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Remarks</label>
                                <input asp-for="Remarks" class="sf-input" />
                            </div>
                        </div>
                    </div>

                    <!-- ==============================
                 5. TRACKING & MORE TAB
            =============================== -->
                    <div class="tab-pane fade" id="tracking" role="tabpanel">
                        <h3 class="pane-section-title">Additional Contacts</h3>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Contact Person 1</label>
                                <input asp-for="ContactPerson1" class="sf-input" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Contact 1 Phone</label>
                                <input asp-for="Contact1Phone" class="sf-input" />
                            </div>
                            <div class="col-md-4"></div>

                            <div class="col-md-4 form-group">
                                <label class="sf-label">Contact Person 2</label>
                                <input asp-for="ContactPerson2" class="sf-input" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Contact 2 Phone</label>
                                <input asp-for="Contact2Phone" class="sf-input" />
                            </div>
                            <div class="col-md-4"></div>

                            <div class="col-md-4 form-group">
                                <label class="sf-label">Contact Person 3</label>
                                <input asp-for="ContactPerson3" class="sf-input" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Contact 3 Phone</label>
                                <input asp-for="Contact3Phone" class="sf-input" />
                            </div>
                            <div class="col-md-4"></div>
                        </div>

                        <h3 class="pane-section-title">Conversation Details</h3>
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label class="sf-label">First call Date</label>
                                <input asp-for="FirstCallDate" type="date" class="sf-input" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Last Contact Date</label>
                                <input asp-for="LastContactDate" type="date" class="sf-input" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Next follow-up Date</label>
                                <input asp-for="NextFollowUpDate" type="date" class="sf-input" />
                            </div>

                            <div class="col-md-4 form-group">
                                <label class="sf-label">Interested package</label>
                                <select asp-for="InterestedPackage" class="sf-select">
                                    <option value="">-None-</option>
                                    <option value="Basic">Basic</option>
                                    <option value="Standard">Standard</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Lost Reason</label>
                                <select asp-for="LostReason" class="sf-select">
                                    <option value="">-None-</option>
                                    <option value="Price">Price</option>
                                    <option value="Competitor">Competitor</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="sf-label">Lead profile</label>
                                <input asp-for="LeadProfile" class="sf-input" />
                            </div>

                            <div class="col-md-6 form-group">
                                <label class="sf-label">Remarks/Notes</label>
                                <input asp-for="ConversationRemarks" class="sf-input" />
                            </div>

                            <div class="col-md-12 form-group mt-2">
                                <label class="sf-label">General Description</label>
                                <textarea asp-for="Description" rows="4" class="sf-input" style="height: auto; resize: vertical; padding: 12px;"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div> <!-- End of main col -->
            <!-- RIGHT SIDEBAR -->
            <div class="sidebar-col">
                <div class="sidebar-wrapper">
                    <div class="sidebar-header">
                        <i class="fa-solid fa-link" style="font-size: 1rem;"></i> Related Records
                    </div>
                    <div class="sidebar-content">

                        <!-- CONTACTS SECTION -->
                        <div class="sidebar-section">
                            <div class="sidebar-section-title">Contacts</div>
                            <div class="contact-card">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="fa-solid fa-user" style="color: #1e3a8a;"></i>
                                    <span>@(string.IsNullOrEmpty(Model?.ContactName) ? "No linked contact" : Model.ContactName)</span>
                                </div>
                                <i class="fa-solid fa-chevron-right text-muted" style="font-size: 0.8rem;"></i>
                            </div>
                        </div>

                        <!-- DEALS SECTION -->
                        <div class="sidebar-section">
                            <div class="sidebar-section-title">Deals</div>
                            <div class="sidebar-empty">No linked deals</div>
                        </div>

                        <div class="sidebar-section-title">
                            Tasks
                            <button type="button" class="sidebar-add-btn" data-bs-toggle="modal" data-bs-target="#quickTaskModal" title="Add Task">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>

                        <!-- RECENT NOTES SECTION -->
                        <div class="sidebar-section">
                            <div class="sidebar-section-title">
                                Recent Notes
                                <button type="button" class="sidebar-add-btn" onclick="openNoteModal()"><i class="fa-solid fa-plus"></i></button>
                            </div>

                            <!-- Target ID for sidebar note appending -->
                            <div id="savedNotesContainer">
                                @if (ViewBag.ExistingNotes != null)
                                {
                                    foreach (var note in ViewBag.ExistingNotes)
                                    {
                                        <div class="note-card">
                                            <div class="note-header">
                                                @note.CreatedDateTime.ToString("MMM dd") &bull; @(note.NoteOwner?.fullName ?? "System User")
                                            </div>
                                            <div class="note-body">@note.Description</div>
                                            @if (!string.IsNullOrEmpty(note.AttachmentFileName))
                                            {
                                                <div class="mt-2" style="font-size: 0.75rem;">
                                                    <a href="/Accounts/DownloadNoteFile?noteId=@note.Id" style="color: #3b82f6; text-decoration: none;">
                                                        <i class="fa-solid fa-paperclip me-1"></i>@note.AttachmentFileName
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                            <div class="text-end mt-3">
                                <a href="#" style="font-size: 0.85rem; font-weight: 600; color: #3b82f6; text-decoration: none;">View all notes <i class="fa-solid fa-arrow-right" style="font-size: 0.75rem; margin-left: 2px;"></i></a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div> <!-- End of content wrapper -->

        <div style="padding: 16px 40px; border-top: 1px solid var(--theme-border); background-color: #fafaf9; display: flex; justify-content: flex-end; gap: 16px;">
            <a asp-action="Index" class="btn" style="background: white; border: 1px solid var(--theme-border); color: var(--theme-text-muted); font-weight: 500; font-size: 0.95rem; padding: 8px 24px; border-radius: 8px; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn-sf-primary">Save Lead</button>
        </div>

    </div>

    <!-- THE MODAL HTML (Moved inside the form so file uploads might work if you add logic for it, but outside container is fine too as JS creates hidden inputs inside the container) -->
    <div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg" style="border: none; border-radius: 12px;">
                <div class="modal-header" style="background-color: #f8fafc; border-bottom: 1px solid var(--theme-border); border-radius: 12px 12px 0 0; padding: 20px 24px;">
                    <h5 class="modal-title fw-bold" id="noteModalLabel" style="color: var(--theme-navy-primary); font-size: 1.15rem;">
                        <i class="fa-regular fa-pen-to-square text-primary me-2"></i> Add New Note
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="sf-label">Note Owner</label>
                            <!-- Note: Using ViewBag.UsersList identical to your Create Page request -->
                            <select id="modalNoteOwner" class="sf-select" asp-items="ViewBag.UsersList">
                                <option value="System User">- System User -</option>
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="sf-label">Date & Time</label>
                            <input type="text" id="modalNoteDateTime" class="sf-input" style="background-color: #f1f5f9; color: var(--theme-text-muted);" readonly />
                        </div>
                        <div class="col-md-12 form-group">
                            <label class="sf-label">Attachment</label>
                            <input type="file" id="modalNoteFile" class="sf-input" style="padding: 5px 12px;" />
                        </div>
                        <div class="col-md-12 form-group m-0">
                            <label class="sf-label">Note Description</label>
                            <textarea id="modalNoteDesc" class="sf-input" style="height: auto; resize: vertical;" rows="4" placeholder="Write your note details here..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="background-color: #f8fafc; border-top: 1px solid var(--theme-border); border-radius: 0 0 12px 12px; padding: 16px 24px;">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border: 1px solid #cbd5e1; font-weight: 500; font-size: 0.9rem;">Cancel</button>
                    <!-- Trigger the fixed JS function -->
                    <button type="button" class="btn-sf-primary" onclick="saveNote()" style="font-weight: 600; font-size: 0.9rem; padding: 8px 24px;">Save Note</button>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- OTHER MODALS -->
