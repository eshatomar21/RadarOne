<!-- ========================================================
     PREMIUM PURPLE QUICK CREATE TASK MODAL (WITH MORE FIELDS)
     ======================================================== -->
<div class="modal fade" id="quickTaskModal" tabindex="-1" aria-labelledby="quickTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg" style="border: none; border-radius: 12px; overflow: hidden;">

            <div class="modal-header modal-purple-header" style="padding: 20px 24px;">
                <h5 class="modal-title fw-bold" id="quickTaskModalLabel" style="font-size: 1.15rem; display: flex; align-items: center; gap: 10px;">
                    <i class="fa-solid fa-check-square"></i> Add New Task
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Form posts directly to Tasks Controller -->
            <form asp-controller="Tasks" asp-action="Create" method="post">
                <div class="modal-body modal-purple-body" style="padding: 24px;">
                    <!-- CRITICAL: Associates this Task with the current Lead -->
                    <input type="hidden" name="LeadId" value="@Model.Id" />

                    <div class="row border-bottom border-light pb-3 mb-3">
                        <div class="col-md-12 form-group mb-3">
                            <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Subject <span class="text-danger">*</span></label>
                            <input name="Subject" class="sf-input w-100 bg-white" placeholder="E.g., Follow up call..." required />
                        </div>

                        <div class="col-md-6 form-group mb-3">
                            <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Due Date</label>
                            <input name="DueDate" type="date" class="sf-input w-100 bg-white" />
                        </div>

                        <div class="col-md-6 form-group mb-3">
                            <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Priority</label>
                            <select name="Priority" class="sf-select w-100 bg-white">
                                <option value="Highest">Highest</option>
                                <option value="High" selected>High</option>
                                <option value="Normal">Normal</option>
                                <option value="Low">Low</option>
                                <option value="Lowest">Lowest</option>
                            </select>
                        </div>

                        <div class="col-md-6 form-group mb-3">
                            <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Task Owner</label>
                            <select name="TaskOwnerId" asp-items="ViewBag.UsersList" class="sf-select w-100 bg-white">
                                <option value="">- Assign To -</option>
                            </select>
                        </div>

                        <!-- Toggles -->
                        <div class="col-md-6 form-group mb-3 d-flex align-items-end pb-2">
                            <div class="form-check form-switch d-flex align-items-center me-4">
                                <input class="form-check-input me-2" type="checkbox" id="modalReminderToggle">
                                <label class="form-check-label" style="font-weight: 500; color: #6b21a8;">Reminder</label>
                            </div>
                            <div class="form-check form-switch d-flex align-items-center">
                                <input class="form-check-input me-2" type="checkbox" id="modalRepeatToggle">
                                <label class="form-check-label" style="font-weight: 500; color: #6b21a8;">Repeat</label>
                            </div>
                        </div>

                        <div class="col-md-12 form-group m-0">
                            <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Description</label>
                            <textarea name="Description" class="sf-input w-100 bg-white" rows="2" placeholder="Task details..."></textarea>
                        </div>
                    </div>

                    <!-- Expandable "More Fields" Button -->
                    <div class="more-fields-btn shadow-sm" id="moreFieldsToggle" onclick="toggleMoreFields()">
                        <span>More Fields</span>
                        <i class="fa-solid fa-chevron-right" id="moreFieldsIcon"></i>
                    </div>

                    <!-- Hidden Extended Fields -->
                    <div id="moreFieldsContainer" style="display: none;">
                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Account Name</label>
                                <select name="AccountId" class="sf-select w-100 bg-white">
                                    <option value="">- Select Account -</option>
                                    @if (ViewBag.AccountsList != null)
                                    {
                                        foreach (var acc in (SelectList)ViewBag.AccountsList)
                                        {
                                            <option value="@acc.Value">@acc.Text</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Mobile</label>
                                <input name="Mobile" class="sf-input w-100 bg-white" placeholder="+1..." />
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Lead Status</label>
                                <select name="LeadStatus" class="sf-select w-100 bg-white">
                                    <option value="">-None-</option>
                                    <option value="Important contact">Important contact</option>
                                    <option value="Not a Doctor">Not a Doctor</option>
                                    <option value="Warm">Warm</option>
                                    <option value="Hot">Hot</option>
                                    <option value="Not Interested">Not Interested</option>
                                </select>
                            </div>

                            <div class="col-md-6 form-group mb-0">
                                <label class="sf-label w-100 mb-1" style="color: #6b21a8;">Status</label>
                                <select name="Status" class="sf-select w-100 bg-white">
                                    <option value="Not Started" selected>Not Started</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Deferred">Deferred</option>
                                    <option value="Completed">Completed</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer" style="background-color: #ffffff; border-top: 1px solid #e9d5ff; padding: 16px 24px;">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border: 1px solid #cbd5e1; font-weight: 500;">Cancel</button>
                    <button type="submit" class="btn-purple-primary">Save Task</button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Bootstrap JS bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // -----------------------------------------------------------------
    // CHEVRON STAGE BAR LOGIC
    // -----------------------------------------------------------------
    document.addEventListener("DOMContentLoaded", function () {
    const stageSelect = document.getElementById("actualStageSelect");
    const chevronItems = document.querySelectorAll("#chevronStageBar li");

    if (stageSelect && chevronItems.length > 0) {
    updateChevronBar(stageSelect.value);
    }

    function updateChevronBar(currentStage) {
    chevronItems.forEach(item => {
    item.classList.remove("active");
    item.innerHTML = item.getAttribute("data-val");
    });

    if (currentStage) {
    const activeItem = document.querySelector(`#chevronStageBar li[data-val="${currentStage}"]`);
    if (activeItem) {
    activeItem.classList.add("active");
    activeItem.innerHTML = currentStage + ' <i class="fa-solid fa-caret-down ms-1"></i>';
    }
    }
    }
    });

    // -----------------------------------------------------------------
    // FIXED NOTES JAVASCRIPT
    // -----------------------------------------------------------------
    function openNoteModal() {
    const now = new Date();
    document.getElementById('modalNoteDateTime').value = now.toLocaleString();
    document.getElementById('modalNoteFile').value = '';
    document.getElementById('modalNoteDesc').value = '';

    const modalEl = document.getElementById('noteModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
    }

    function saveNote() {
    const ownerDropdown = document.getElementById('modalNoteOwner');
    const ownerId = ownerDropdown.value;
    const ownerName = ownerId && ownerDropdown.selectedIndex !== -1 ? ownerDropdown.options[ownerDropdown.selectedIndex].text : "System User";
    const dateTime = document.getElementById('modalNoteDateTime').value;
    const desc = document.getElementById('modalNoteDesc').value;
    const fileInput = document.getElementById('modalNoteFile');
    const fileName = fileInput.files.length > 0 ? fileInput.files[0].name : '';

    if (!desc.trim() && !fileName) {
    alert('Please enter a description or attach a file.');
    return;
    }

    let fileHtml = fileName ? `<div class="mt-2 text-primary" style="font-size: 0.85rem; background: var(--theme-navy-light); padding: 4px 8px; border-radius: 4px; display: inline-block;"><i class="fa-solid fa-paperclip me-2"></i>${fileName}</div>` : '';

    // 1. Generate HTML with the hidden inputs for the Main Tab.
    // This ensures the data is physically inside your <form> tag and gets submitted to your backend.
    const mainNoteHtml = `
    <div class="mb-2 p-3 bg-white border rounded shadow-sm d-flex justify-content-between" style="border-left: 4px solid #1e3a8a !important;">
    <div>
    <strong style="color: var(--theme-navy-primary); font-size: 0.9rem;">${ownerName} <span class="badge bg-primary ms-2" style="font-size: 0.65rem;">New Note</span></strong>
    <div style="font-size: 0.85rem; color: var(--theme-text-main); margin-top:4px; white-space: pre-wrap;">${desc}</div>
    ${fileHtml}
    </div>
    <span class="text-muted" style="font-size: 0.75rem;">Just Now</span>
    <input type="hidden" name="SavedNoteOwner[]" value="${ownerId}" />
    <input type="hidden" name="SavedNoteDateTime[]" value="${dateTime}" />
    <input type="hidden" name="SavedNoteDesc[]" value="${desc}" />
    </div>`;

    // 2. Generate a visual-only copy for the Sidebar (no hidden inputs to prevent double-submitting)
    const sidebarNoteHtml = `
    <div class="note-card" style="border-left-color: #1e3a8a;">
    <div class="note-header">Just Now &bull; ${ownerName}</div>
    <div class="note-body">${desc}</div>
    ${fileHtml}
    </div>`;

    // 3. Append to Main Tab
    const mainContainer = document.getElementById('notesContainer');
    if (mainContainer) {
    mainContainer.insertAdjacentHTML('afterbegin', mainNoteHtml);
    } else {
    console.error("Main notes container not found!");
    }

    // 4. Append to Sidebar
    const sidebarContainer = document.getElementById('savedNotesContainer');
    if (sidebarContainer) {
    sidebarContainer.insertAdjacentHTML('afterbegin', sidebarNoteHtml);
    }

    // Remove the "No notes found" placeholder if it exists
    const placeholder = document.getElementById('noNotesPlaceholder');
    if (placeholder) placeholder.remove();

    // 5. Hide Modal cleanly
    const modalEl = document.getElementById('noteModal');
    const modalInstance = bootstrap.Modal.getInstance(modalEl);
    if (modalInstance) {
    modalInstance.hide();
    }
    }

    // -----------------------------------------------------------------
    // OTHER EXISTING SCRIPTS
    // -----------------------------------------------------------------
    const dataSourcesEl = document.getElementById('DataSources');
    if (dataSourcesEl) {
    dataSourcesEl.addEventListener('change', function () {
    const val = this.value;
    const divMeta = document.getElementById('divMetaCampaign');
    const divSeminar = document.getElementById('divSeminarName');
    if (divMeta) divMeta.style.display = (val === 'Meta Ads') ? 'block' : 'none';
    if (divSeminar) divSeminar.style.display = (val === 'Seminar Conference') ? 'block' : 'none';
    });
    }

    function verifyPhone(fieldId) {
    const phoneEl = document.getElementById(fieldId);
    const mainMobileEl = document.getElementById('MobileNumber');
    const altMobileEl = document.getElementById('AlternateMobile');

    if (!phoneEl) return;
    const phone = phoneEl.value.trim();
    const mainMobile = mainMobileEl ? mainMobileEl.value.trim() : '';
    const altMobile = altMobileEl ? altMobileEl.value.trim() : '';

    if (!phone) {
    alert('Please enter a phone number first before verifying.');
    return;
    }

    if (mainMobile && altMobile && mainMobile === altMobile) {
    alert('❌ Mobile Number and Alternate Mobile cannot be the exact same!');
    return;
    }

    fetch('/Leads/CheckDuplicatePhone?phone=' + encodeURIComponent(phone))
    .then(response => response.json())
    .then(data => {
    if (data.isDuplicate) alert('⚠️ WARNING: This phone number already exists in another lead record!');
    else alert('✅ This number is valid and unique in the system.');
    })
    .catch(error => {
    console.error("Error verifying phone:", error);
    alert("Could not connect to the database to verify.");
    });
    }

    let isDirectDealConfirmed = false;
    const leadForm = document.getElementById('leadForm');

    if (leadForm) {
    leadForm.addEventListener('submit', function (e) {
    const stageSelect = document.getElementById('actualStageSelect');
    if (stageSelect) {
    const stageValue = stageSelect.value;
    if (stageValue === 'Direct Deal' && !isDirectDealConfirmed) {
    e.preventDefault();
    const confirmModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('directDealConfirmModal'));
    confirmModal.show();
    }
    }
    });
    }

    const btnCancelDirectDeal = document.getElementById('btnCancelDirectDeal');
    if (btnCancelDirectDeal) {
    btnCancelDirectDeal.addEventListener('click', function () {
    const stageSelect = document.getElementById('actualStageSelect');
    if (stageSelect) {
    stageSelect.value = '';
    stageSelect.dispatchEvent(new Event('change'));
    }
    });
    }

    const btnConfirmDirectDeal = document.getElementById('btnConfirmDirectDeal');
    if (btnConfirmDirectDeal) {
    btnConfirmDirectDeal.addEventListener('click', function () {
    bootstrap.Modal.getOrCreateInstance(document.getElementById('directDealConfirmModal')).hide();
    const paymentRows = document.querySelectorAll('#paymentTbody .payment-row');
    let hasValidPayment = false;

    paymentRows.forEach(row => {
    const productNameInput = row.querySelector('input[name*="ProductName"]');
    const totalInput = row.querySelector('.total');

    const productName = productNameInput ? productNameInput.value.trim() : '';
    const total = totalInput ? parseFloat(totalInput.value) : 0;

    if (productName !== '' && total > 0) hasValidPayment = true;
    });

    if (!hasValidPayment) {
    const stageSelect = document.getElementById('actualStageSelect');
    if (stageSelect) {
    stageSelect.value = '';
    stageSelect.dispatchEvent(new Event('change'));
    }
    bootstrap.Modal.getOrCreateInstance(document.getElementById('directDealErrorModal')).show();
    } else {
    isDirectDealConfirmed = true;
    if (leadForm) leadForm.submit();
    }
    });
    }

    let productPrices = {};
    try {
    productPrices = @Html.Raw(Json.Serialize(ViewBag.ProductPrices ?? new Dictionary<int, decimal>()));
    } catch(e) {
    console.error("Failed to parse product prices", e);
    }

    const productOptionsHtml = `
    <option value="0">-Select Product-</option>
    @if (ViewBag.ProductsList != null)
    {
        foreach (var item in (SelectList)ViewBag.ProductsList)
        {
            <option value="@item.Value">@item.Text</option>
        }
    }
    `;

    let rowCount = @(Model?.PaymentRow != null && Model.PaymentRow.Count > 0 ? Model.PaymentRow.Count : 1);
    function addRow() {
    const tbody = document.getElementById('paymentTbody');
    if(!tbody) return;
    const tr = document.createElement('tr');
    tr.className = 'payment-row';
    tr.innerHTML = `
    <td><select name="PaymentRow[${rowCount}].DealType" class="sf-select"><option value="">-None-</option><option value="New Sale">New Sale</option><option value="Upgrade">Upgrade</option><option value="Add On">Add On</option><option value="Stock Key">Stock Key</option><option value="Existing">Existing</option></select></td>
    <td>
    <select name="PaymentRow[${rowCount}].ProductId" class="sf-select product-select" onchange="productSelected(this)">${productOptionsHtml}</select>
    <input type="hidden" name="PaymentRow[${rowCount}].ProductName" class="product-name-hidden" value="" />
    </td>
    <td><input type="number" name="PaymentRow[${rowCount}].Quantity" class="sf-input qty" value="1" onchange="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRow[${rowCount}].ProductPrice" class="sf-input price" value="0" onchange="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRow[${rowCount}].Total" class="sf-input total" readonly style="background:#F8FAFC;" /></td>
    <td><input type="number" name="PaymentRow[${rowCount}].DiscountPercent" class="sf-input disc" value="0" onchange="calcRow(this)" /></td>
    <td><input type="number" name="PaymentRow[${rowCount}].FinalAmount" class="sf-input final" readonly style="background:#F8FAFC;" /></td>
    <td><button type="button" style="width:24px;height:24px;background:transparent;border:none;" onclick="removeRow(this)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></td>
    `;
    tbody.appendChild(tr);
    rowCount++;
    }

    function productSelected(selectElem) {
    const selectedId = selectElem.value;
    const price = productPrices[selectedId] || 0;
    const productName = selectElem.options[selectElem.selectedIndex].text;
    const row = selectElem.closest('tr');

    const nameHiddenInput = row.querySelector('.product-name-hidden');
    if (nameHiddenInput) {
    nameHiddenInput.value = (selectedId === "0") ? "" : productName;
    }

    const priceInput = row.querySelector('.price');
    if(priceInput) {
    priceInput.value = price;
    calcRow(priceInput);
    }
    }

    function removeRow(btn) {
    const row = btn.closest('tr');
    if(row) {
    row.remove();
    calcGrand();
    }
    }

    function calcRow(input) {
    const row = input.closest('tr');
    if(!row) return;
    const qty = parseFloat(row.querySelector('.qty').value) || 0;
    const price = parseFloat(row.querySelector('.price').value) || 0;
    const disc = parseFloat(row.querySelector('.disc').value) || 0;
    const total = qty * price;
    const discountAmt = total * (disc / 100);
    const finalAmt = total - discountAmt;

    const totalEl = row.querySelector('.total');
    const finalEl = row.querySelector('.final');
    if(totalEl) totalEl.value = total.toFixed(2);
    if(finalEl) finalEl.value = finalAmt.toFixed(2);

    calcGrand();
    }

    function calcGrand() {
    let sub = 0;
    document.querySelectorAll('.final').forEach(el => {
    sub += parseFloat(el.value) || 0;
    });
    const subTotalEl = document.getElementById('subTotal');
    if(subTotalEl) subTotalEl.value = sub.toFixed(2);

    const taxAmount = sub * 0.18;
    const taxesEl = document.getElementById('taxes');
    if(taxesEl) taxesEl.value = taxAmount.toFixed(2);

    const adjEl = document.getElementById('adjustment');
    const adj = adjEl ? (parseFloat(adjEl.value) || 0) : 0;

    const grand = sub + taxAmount - adj;
    const grandTotalEl = document.getElementById('grandTotal');
    if(grandTotalEl) grandTotalEl.value = grand.toFixed(2);
    }

    let globalRegionData = [];
    // ==========================================
    // DYNAMIC CASCADING ADDRESS DROPDOWNS
    // ==========================================
    document.addEventListener("DOMContentLoaded", function () {

    // Read existing values from the model if editing a saved account
    const existingCountry1 = '@Html.Raw(Model?.Addr1_Country ?? "")';
    const existingCountry2 = '@Html.Raw(Model?.Addr2_Country ?? "")';
    const existingState1 = '@Html.Raw(Model?.Addr1_State ?? "")';
    const existingState2 = '@Html.Raw(Model?.Addr2_State ?? "")';
    const existingCity1 = '@Html.Raw(Model?.Addr1_City ?? "")';
    const existingCity2 = '@Html.Raw(Model?.Addr2_City ?? "")';
    const existingZip1 = '@Html.Raw(Model?.Addr1_Zip ?? "")';
    const existingZip2 = '@Html.Raw(Model?.Addr2_Zip ?? "")';

    // 1. Fetch Countries on page load
    fetch('/Postcode/GetCountries')
    .then(res => {
    if (!res.ok) throw new Error("Server returned status: " + res.status);
    return res.json();
    })
    .then(countries => {
    populateDropdown('Addr1_Country', countries, 'Select Country', existingCountry1);
    populateDropdown('Addr2_Country', countries, 'Select Country', existingCountry2);

    // Trigger the cascade automatically if editing a saved record
    if (existingCountry1) triggerChange('Addr1_Country');
    if (existingCountry2) triggerChange('Addr2_Country');
    })
    .catch(err => console.error("Error loading countries:", err));

    // 2. Initialize Cascading Logic for both addresses
    setupCascadingDropdowns('Addr1_Country', 'Addr1_State', 'Addr1_City', 'Addr1_Zip', existingState1, existingCity1, existingZip1);
    setupCascadingDropdowns('Addr2_Country', 'Addr2_State', 'Addr2_City', 'Addr2_Zip', existingState2, existingCity2, existingZip2);
    });

    // Helper function to build dropdown options and pre-select if editing
    function populateDropdown(dropdownId, dataList, defaultText, selectedValue = "") {
    const dropdown = document.getElementById(dropdownId);
    if (!dropdown) return;

    dropdown.innerHTML = '<option value="">- ' + defaultText + ' -</option>';
    dataList.forEach(item => {
    const opt = document.createElement('option');
    opt.value = item;
    opt.textContent = item;
    if (item === selectedValue) {
    opt.selected = true;
    }
    dropdown.appendChild(opt);
    });
    }

    // Helper to manually trigger a change event programmatically
    function triggerChange(elementId) {
    const el = document.getElementById(elementId);
    if (el) el.dispatchEvent(new Event('change'));
    }

    // Master function to handle the Country -> State -> City -> Zip flow
    function setupCascadingDropdowns(countryId, stateId, cityId, zipId, defaultState = "", defaultCity = "", defaultZip = "") {
    const countryEl = document.getElementById(countryId);
    const stateEl = document.getElementById(stateId);
    const cityEl = document.getElementById(cityId);
    const zipEl = document.getElementById(zipId);

    // Country Change -> Load States
    if (countryEl) {
    countryEl.addEventListener('change', function () {
    const country = this.value;
    if (stateEl) stateEl.innerHTML = '<option value="">- Select State -</option>';
    if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

    if (country) {
    fetch('/Postcode/GetStates?country=' + encodeURIComponent(country))
    .then(res => res.json())
    .then(states => {
    populateDropdown(stateId, states, 'Select State', defaultState);
    if (defaultState) {
    triggerChange(stateId);
    defaultState = ""; // clear after first load
    }
    })
    .catch(err => console.error("Error fetching States:", err));
    }
    });
    }

    // State Change -> Load Cities
    if (stateEl) {
    stateEl.addEventListener('change', function () {
    const state = this.value;
    if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

    if (state) {
    fetch('/Postcode/GetCities?state=' + encodeURIComponent(state))
    .then(res => res.json())
    .then(cities => {
    populateDropdown(cityId, cities, 'Select City', defaultCity);
    if (defaultCity) {
    triggerChange(cityId);
    defaultCity = ""; // clear after first load
    }
    })
    .catch(err => console.error("Error fetching Cities:", err));
    }
    });
    }

    // City Change -> Fetch and Populate Zip Code Dropdown
    if (cityEl) {
    cityEl.addEventListener('change', function () {
    const city = this.value;
    const state = stateEl ? stateEl.value : '';

    if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

    if (city && state) {
    fetch('/Postcode/GetZipCodes?city=' + encodeURIComponent(city) + '&state=' + encodeURIComponent(state))
    .then(res => res.json())
    .then(zipCodes => {
    populateDropdown(zipId, zipCodes, 'Select Zip Code', defaultZip);
    defaultZip = ""; // clear after first load
    })
    .catch(err => console.error("Error fetching Zip Codes:", err));
    }
    });
    }
    }

    function toggleMoreFields() {
    const container = document.getElementById("moreFieldsContainer");
    const btn = document.getElementById("moreFieldsToggle");

    if (container.style.display === "none") {
    container.style.display = "block";
    btn.classList.add("expanded");
    } else {
    container.style.display = "none";
    btn.classList.remove("expanded");
    }
    }
</script>