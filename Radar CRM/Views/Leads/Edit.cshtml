     ======================================================== -->
<div class="modal fade" id="quickTaskModal" tabindex="-1" aria-labelledby="quickTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">

            <!-- Header -->
            <div class="modal-header align-items-center" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 20px 24px;">
                <h5 class="modal-title fw-bold d-flex align-items-center" id="quickTaskModalLabel" style="color: var(--theme-navy-primary); font-size: 1.25rem;">
                    <div class="me-3 d-flex align-items-center justify-content-center" style="background-color: var(--theme-navy-light); color: var(--theme-navy-primary); width: 42px; height: 42px; border-radius: 10px; font-size: 1.1rem; border: 1px solid #bfdbfe;">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    Add New Task
                </h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Body -->
            <form asp-controller="Tasks" asp-action="Create" method="post">
                <div class="modal-body" style="padding: 24px 32px; background-color: #ffffff;">
                    <input type="hidden" name="LeadId" value="@Model.Id" />

                    <div class="row g-3">
                        <!-- g-3 applies proper spacing between rows/columns -->

                        <div class="col-md-12 mb-2">
                            <label class="form-label fw-bold mb-1" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Subject <span class="text-danger">*</span></label>
                            <input name="Subject" class="form-control bg-light" placeholder="E.g., Follow up call..." required style="border: 1px solid #cbd5e1; height: 42px;" />
                        </div>

                        <!-- 🚀 Due Day & Due Date Calculation -->
                        <div class="col-md-3 mb-2">
                            <label class="form-label fw-bold mb-1" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Due In (Days)</label>
                            <input type="number" id="TaskDueDays" class="form-control bg-light" placeholder="e.g. 8" style="border: 1px solid #cbd5e1; height: 42px;" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label fw-bold mb-1" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Due Date</label>
                            <input name="DueDate" id="TaskDueDate" type="date" class="form-control bg-light" style="border: 1px solid #cbd5e1; height: 42px;" />
                        </div>

                        <div class="col-md-5 mb-2">
                            <label class="form-label fw-bold mb-1" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Priority</label>
                            <select name="Priority" class="form-select bg-light" style="border: 1px solid #cbd5e1; height: 42px;">
                                <option value="Highest">Highest</option>
                                <option value="High" selected>High</option>
                                <option value="Normal">Normal</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold mb-1" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Task Owner</label>
                            <select name="TaskOwnerId" id="taskOwnerDropdown" asp-items="ViewBag.UsersList" class="form-select bg-light" style="border: 1px solid #cbd5e1; height: 42px;">
                                <option value="">- Assign To -</option>
                            </select>
                        </div>

                        <!-- Toggles for Repeat & Reminder -->
                        <div class="col-md-12 mb-3">
                            <div class="d-flex align-items-center gap-4 p-3 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="form-check form-switch m-0 p-0 d-flex align-items-center gap-2 ps-2">
                                    <input class="form-check-input m-0" type="checkbox" id="modalRepeatToggle" onchange="document.getElementById('modalRepeatPanel').style.display = this.checked ? 'block' : 'none';" style="cursor: pointer; width: 36px; height: 18px;">
                                    <label class="form-check-label fw-bold" for="modalRepeatToggle" style="color: var(--theme-navy-primary); cursor: pointer;">Repeat</label>
                                </div>
                                <div class="form-check form-switch m-0 p-0 d-flex align-items-center gap-2 ps-4">
                                    <input class="form-check-input m-0" type="checkbox" id="modalReminderToggle" onchange="document.getElementById('modalReminderPanel').style.display = this.checked ? 'block' : 'none';" style="cursor: pointer; width: 36px; height: 18px;">
                                    <label class="form-check-label fw-bold" for="modalReminderToggle" style="color: var(--theme-navy-primary); cursor: pointer;">Reminder</label>
                                </div>
                            </div>
                        </div>

                        <!-- Repeat Panel -->
                        <div class="col-md-12" id="modalRepeatPanel" style="display: none;">
                            <div class="p-3 rounded mb-3" style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid var(--theme-navy-primary);">
                                <div class="row align-items-center mb-3">
                                    <div class="col-4 fw-bold" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Repeat type</div>
                                    <div class="col-8">
                                        <select class="form-select form-select-sm bg-white mb-2" style="border: 1px solid #cbd5e1;">
                                            <option>Daily</option>
                                            <option>Weekly</option>
                                            <option>Monthly</option>
                                            <option>Yearly</option>
                                        </select>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="modalExcludeWeekends">
                                            <label class="form-check-label text-muted" for="modalExcludeWeekends" style="font-size: 0.85rem;">Except weekends and holidays.</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 fw-bold" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Ends</div>
                                    <div class="col-8">
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="modalEndsRadio" id="modalEndsNever" checked>
                                            <label class="form-check-label fw-medium" for="modalEndsNever" style="font-size: 0.85rem;">Never</label>
                                        </div>
                                        <div class="form-check mb-2 d-flex align-items-center gap-2">
                                            <input class="form-check-input" type="radio" name="modalEndsRadio" id="modalEndsAfter">
                                            <label class="form-check-label fw-medium" for="modalEndsAfter" style="font-size: 0.85rem;">After</label>
                                            <input type="number" class="form-control form-control-sm w-25" value="1" style="border-color: #cbd5e1;">
                                            <span style="font-size: 0.85rem;">Times</span>
                                        </div>
                                        <div class="form-check d-flex align-items-center gap-2">
                                            <input class="form-check-input" type="radio" name="modalEndsRadio" id="modalEndsOn">
                                            <label class="form-check-label fw-medium" for="modalEndsOn" style="font-size: 0.85rem;">On</label>
                                            <input type="date" class="form-control form-control-sm w-50" style="border-color: #cbd5e1;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reminder Panel -->
                        <div class="col-md-12" id="modalReminderPanel" style="display: none;">
                            <div class="p-3 rounded mb-3" style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid var(--theme-navy-primary);">
                                <div class="form-check mb-3 d-flex align-items-center gap-2">
                                    <input class="form-check-input" type="radio" name="modalRemindRadio" id="modalRemindOnDate" checked>
                                    <label class="form-check-label fw-bold" for="modalRemindOnDate" style="font-size: 0.85rem; color: var(--theme-navy-primary);">On</label>
                                    <input type="date" class="form-control form-control-sm w-auto" style="border-color: #cbd5e1;">
                                    <span class="fw-bold" style="font-size: 0.85rem; color: var(--theme-navy-primary);">at</span>
                                    <input type="time" class="form-control form-control-sm w-auto" style="border-color: #cbd5e1;">
                                </div>

                                <div class="form-check mb-4 d-flex align-items-center gap-2">
                                    <input class="form-check-input" type="radio" name="modalRemindRadio" id="modalRemindDays">
                                    <label class="form-check-label fw-bold" for="modalRemindDays" style="font-size: 0.85rem; color: var(--theme-navy-primary);">On</label>
                                    <select class="form-select form-select-sm w-auto" style="border-color: #cbd5e1;">
                                        <option>1 Day(s)</option>
                                        <option>2 Day(s)</option>
                                        <option>3 Day(s)</option>
                                        <option>1 Week</option>
                                    </select>
                                    <span class="fw-bold" style="font-size: 0.85rem; color: var(--theme-navy-primary);">of due date at</span>
                                    <input type="time" class="form-control form-control-sm w-auto" style="border-color: #cbd5e1;">
                                </div>

                                <div class="row align-items-center mb-3">
                                    <div class="col-4 fw-bold" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Repeat type</div>
                                    <div class="col-8">
                                        <select class="form-select form-select-sm bg-white" style="border-color: #cbd5e1; height: 32px;">
                                            <option>None</option>
                                            <option>Daily</option>
                                            <option>Weekly</option>
                                            <option>Monthly</option>
                                            <option>Yearly</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row align-items-center">
                                    <div class="col-4 fw-bold" style="color: var(--theme-navy-primary); font-size: 0.9rem;">Notify</div>
                                    <div class="col-8">
                                        <select class="form-select form-select-sm bg-white" style="border-color: #cbd5e1; height: 32px;">
                                            <option>Email</option>
                                            <option>Popup</option>
                                            <option>Both</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer d-flex align-items-center justify-content-end" style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 16px 24px;">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal" style="border: 1px solid #cbd5e1; color: #475569; padding: 8px 24px;">Cancel</button>
                    <button type="submit" class="btn text-white fw-bold" style="background-color: var(--theme-navy-primary); border-radius: 6px; padding: 8px 24px; transition: 0.2s;">Save Task</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Bootstrap JS bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // =====================================
    // VIEW TOGGLE & SYNC LOGIC
    // =====================================
    function toggleView(view) {
        const detailView = document.getElementById('detailViewContainer');
        const editView = document.getElementById('editViewContainer');

        if (view === 'edit') {
            detailView.style.display = 'none';
            editView.style.display = 'block';
            updateChevronBars();
        } else {
            editView.style.display = 'none';
            detailView.style.display = 'flex';

            // Sync Quick Edit fields back from form
            const syncField = (quickId, realId) => {
                const q = document.getElementById(quickId);
                const r = document.getElementById(realId);
                if (q && r) q.value = r.value;
            };
            syncField('QuickLeadOwnerId', 'LeadOwnerId');
            syncField('QuickEmailID', 'EmailID');
            syncField('QuickMobileNumber', 'MobileNumber');
            syncField('QuickDataSources', 'DataSources');
            syncField('QuickAlternateMobile', 'AlternateMobile');
            syncField('QuickLeadStatus', 'LeadStatus');
        }
    }

    function toggleExtraNotes() {
        const extra = document.getElementById('extraNotesContainer');
        const btn = document.getElementById('viewPreviousNotesBtn');
        if (extra.style.display === 'none') {
            extra.style.display = 'block';
            btn.innerText = 'Hide Previous Notes';
        } else {
            extra.style.display = 'none';
            btn.innerText = 'View Previous Notes';
        }
    }

    function updateChevronBars() {
        const stageSelect = document.getElementById("actualStageSelect");
        if (!stageSelect) return;
        const currentStage = stageSelect.value;

        const allItems = document.querySelectorAll(".sf-chevron-bar li");
        allItems.forEach(item => {
            item.classList.remove("active");
            item.innerHTML = item.getAttribute("data-val");
        });

        if (currentStage) {
            const activeItems = document.querySelectorAll(`.sf-chevron-bar li[data-val="${currentStage}"]`);
            activeItems.forEach(activeItem => {
                activeItem.classList.add("active");
                activeItem.innerHTML = currentStage + ' <i class="fa-solid fa-caret-down ms-1"></i>';
            });
        }
    }

    // =====================================
    // AJAX TASK SUBMISSION & STATUS UPDATE
    // =====================================
    document.addEventListener("DOMContentLoaded", function () {
        const taskForm = document.querySelector('#quickTaskModal form');

        if (taskForm) {
            taskForm.addEventListener('submit', function (e) {
                e.preventDefault();

                const submitBtn = taskForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Saving...';
                submitBtn.disabled = true;

                const formData = new FormData(taskForm);

                fetch(taskForm.action, {
                    method: 'POST',
                    body: formData
                })
                    .then(response => {
                        if (response.ok || response.redirected) {
                            const modalEl = document.getElementById('quickTaskModal');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();

                            const subject = formData.get('Subject');
                            const dueDate = formData.get('DueDate');
                            const priority = formData.get('Priority');

                            let formattedDate = "-";
                            if (dueDate) {
                                const parts = dueDate.split('-');
                                if (parts.length === 3) {
                                    const dateObj = new Date(parts[0], parts[1] - 1, parts[2]);
                                    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                                    formattedDate = ('0' + dateObj.getDate()).slice(-2) + " " + months[dateObj.getMonth()] + " " + dateObj.getFullYear();
                                }
                            }

                            // 1. Update Next Action Card
                            const nextActionHeaders = document.querySelectorAll('.detail-section-card h6');
                            nextActionHeaders.forEach(h => {
                                if (h.textContent.includes('Next Action')) {
                                    const nextActionSpan = h.nextElementSibling.querySelector('.fw-medium.text-dark');
                                    if (nextActionSpan) nextActionSpan.innerHTML = `${subject} - Due: ${formattedDate}`;
                                }
                            });

                            // 2. Add Row to Open Activities Table (With Dropdown)
                            const openTasksSection = document.getElementById('detailOpenTasksSection');
                            if (openTasksSection) {
                                let tbody = openTasksSection.querySelector('tbody');
                                if (!tbody) {
                                    openTasksSection.innerHTML = `
                                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                            <h6 class="fw-bold m-0" style="color: var(--theme-navy-primary);">Open Activities</h6>
                                            <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="openTaskModal()"><i class="fa-solid fa-plus"></i> Add Task</button>
                                        </div>
                                        <table class="zoho-task-table" id="openTasksTable">
                                            <thead><tr><th>Subject</th><th>Due Date</th><th>Priority</th><th>Status</th></tr></thead>
                                            <tbody></tbody>
                                        </table>
                                    `;
                                    tbody = openTasksSection.querySelector('tbody');
                                }

                                const tr = document.createElement('tr');
                                tr.innerHTML = `
                                    <td class="text-primary fw-medium">${subject}</td>
                                    <td>${formattedDate}</td>
                                    <td>${priority}</td>
                                    <td>
                                        <select class="form-select form-select-sm border task-status-dropdown" onchange="updateTaskStatus(this, '0')" style="width: 130px; font-size: 0.8rem; background-color: #f8fafc;">
                                            <option value="Not Started" selected>Not Started</option>
                                            <option value="In Progress">In Progress</option>
                                            <option value="Waiting">Waiting</option>
                                            <option value="Deferred">Deferred</option>
                                            <option value="Completed">Completed</option>
                                        </select>
                                    </td>
                                `;
                                tbody.insertBefore(tr, tbody.firstChild);
                            }

                            // Reset Form
                            taskForm.reset();
                            submitBtn.innerHTML = originalText;
                            submitBtn.disabled = false;
                            const dueDaysEl = document.getElementById('TaskDueDays');
                            if (dueDaysEl) dueDaysEl.value = '';

                        } else {
                            alert("There was an issue saving the task to the database.");
                            submitBtn.innerHTML = originalText;
                            submitBtn.disabled = false;
                        }
                    })
                    .catch(err => {
                        console.error("Fetch error: ", err);
                        alert("Network connection error occurred.");
                        submitBtn.innerHTML = originalText;
                        submitBtn.disabled = false;
                    });
            });
        }
    });

    // 🚀 NEW: Function to Update Task Status via AJAX
    function updateTaskStatus(selectElem, taskId) {
        const newStatus = selectElem.value;
        const row = selectElem.closest('tr');

        selectElem.disabled = true; // Lock dropdown while saving

        const formData = new URLSearchParams();
        formData.append('id', taskId);
        formData.append('status', newStatus);

        // Adjust the URL if your controller routing is different
        fetch('/Tasks/UpdateStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        })
            .then(response => {
                selectElem.disabled = false;
                if (response.ok) {
                    if (newStatus === 'Completed') {
                        moveTaskToClosed(row);
                    }
                } else {
                    alert('Failed to update task status in DB.');
                    selectElem.value = 'Not Started';
                }
            })
            .catch(err => {
                selectElem.disabled = false;
                console.error('Error updating task:', err);
            });
    }

    // Move row from Open Activities to Closed Activities visually without refreshing page
    function moveTaskToClosed(row) {
        const subject = row.cells[0].innerText;
        const dueDate = row.cells[1].innerText;

        const today = new Date();
        const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const closedDate = ('0' + today.getDate()).slice(-2) + " " + months[today.getMonth()] + " " + today.getFullYear();

        const newRow = document.createElement('tr');
        newRow.innerHTML = `
                <td class="text-secondary text-decoration-line-through">${subject}</td>
                <td class="text-muted">${dueDate}</td>
                <td class="text-muted fw-bold">${closedDate}</td>
            `;

        let closedSection = document.getElementById('detailClosedTasksSection');
        let closedTbody = closedSection.querySelector('tbody');

        // If table doesn't exist yet, create it
        if (!closedTbody) {
            closedSection.innerHTML = `
                    <h6 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--theme-navy-primary);">Closed Activities</h6>
                    <table class="zoho-task-table" id="closedTasksTable">
                        <thead><tr><th>Subject</th><th>Due Date</th><th>Closed Time</th></tr></thead>
                        <tbody></tbody>
                    </table>
                `;
            closedTbody = closedSection.querySelector('tbody');
        }

        // Inject into top of closed list
        closedTbody.insertBefore(newRow, closedTbody.firstChild);
        row.remove(); // Remove from open list

        // Update Next action if table becomes empty
        const openTbody = document.getElementById('openTasksTbody');
        if (openTbody && openTbody.children.length === 0) {
            document.getElementById('nextActionDisplay').innerText = "No upcoming actions scheduled.";
        } else if (openTbody && openTbody.children.length > 0) {
            const nextRow = openTbody.children[0];
            document.getElementById('nextActionDisplay').innerText = `${nextRow.cells[0].innerText} - Due: ${nextRow.cells[1].innerText}`;
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const quickOwner = document.getElementById('QuickLeadOwnerId');
        if (quickOwner) quickOwner.value = '@Model.LeadOwnerId';

        const noteOwner = document.getElementById('inlineNoteOwner');
        if (noteOwner) noteOwner.value = '@currentUserId';

        const stgSelect = document.getElementById("actualStageSelect");
        if (stgSelect) {
            stgSelect.addEventListener('change', updateChevronBars);
            updateChevronBars();
        }

        // TASK DUE DATE CALCULATION LOGIC
        const dueDaysInput = document.getElementById('TaskDueDays');
        const dueDateInput = document.getElementById('TaskDueDate');
        if (dueDaysInput && dueDateInput) {
            dueDaysInput.addEventListener('input', function () {
                if (this.value) {
                    let d = new Date();
                    d.setDate(d.getDate() + parseInt(this.value));
                    // Formats date to YYYY-MM-DD to bind with input[type=date]
                    const year = d.getFullYear();
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    const day = String(d.getDate()).padStart(2, '0');
                    dueDateInput.value = `${year}-${month}-${day}`;
                } else {
                    dueDateInput.value = '';
                }
            });
            dueDateInput.addEventListener('change', function () {
                if (this.value) {
                    let d = new Date(this.value);
                    let today = new Date();
                    d.setHours(0, 0, 0, 0);
                    today.setHours(0, 0, 0, 0);
                    let diffTime = d.getTime() - today.getTime();
                    let diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
                    dueDaysInput.value = diffDays;
                } else {
                    dueDaysInput.value = '';
                }
            });
        }
    });

    // =====================================
    // INLINE NOTES JAVASCRIPT
    // =====================================
    function clearInlineNote() {
        const titleInput = document.getElementById('inlineNoteTitle');
        const descInput = document.getElementById('inlineNoteDesc');
        const fileInput = document.getElementById('inlineNoteFile');
        if (titleInput) titleInput.value = '';
        if (descInput) descInput.value = '';
        if (fileInput) fileInput.value = '';
    }

    function saveInlineNote() {
        const titleEl = document.getElementById('inlineNoteTitle');
        const descEl = document.getElementById('inlineNoteDesc');
        const fileInput = document.getElementById('inlineNoteFile');

        const title = titleEl ? titleEl.value.trim() : '';
        const desc = descEl ? descEl.value.trim() : '';
        const fileName = fileInput && fileInput.files.length > 0 ? fileInput.files[0].name : '';

        const ownerDropdown = document.getElementById('inlineNoteOwner');
        const ownerId = ownerDropdown ? ownerDropdown.value : '';
        const ownerName = ownerDropdown && ownerDropdown.selectedIndex > -1 ? ownerDropdown.options[ownerDropdown.selectedIndex].text : 'System User';
        const dateTime = new Date().toLocaleString();

        if (!desc && !fileName && !title) {
            alert('Please enter a title, content, or attach a file.');
            return;
        }

        let finalDescription = desc;
        if (title) finalDescription = `[ ${title.toUpperCase()} ]\n${desc}`;

        let titleHtml = title ? `<div class="fw-bold mb-1" style="font-size: 0.95rem; color: #431407;">${title}</div>` : '';
        let fileHtml = fileName ? `
                                        <div class="mt-2">
                                            <span class="fw-semibold shadow-sm" style="font-size: 0.75rem; color: #ffffff; background: var(--theme-navy-primary); padding: 4px 10px; border-radius: 4px; display: inline-flex; align-items: center;">
                                                <i class="fa-solid fa-paperclip me-2"></i> ${fileName}
                                            </span>
                                        </div>` : '';

        const mainNoteHtml = `
                                        <div class="p-3 mb-3 rounded shadow-sm" style="border-left: 4px solid var(--theme-navy-primary); background: #ffffff; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-1" style="border-bottom: 1px solid #e2e8f0;">
                                                <span class="fw-bold text-dark" style="font-size: 0.85rem;">
                                                    <i class="fa-solid fa-circle-user me-1 text-muted"></i> ${ownerName}
                                                </span>
                                                <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">${dateTime}</span>
                                            </div>
                                            ${titleHtml}
                                            <div style="font-size: 0.85rem; color: #475569; white-space: pre-wrap; line-height: 1.4;">${desc}</div>
                                            ${fileHtml}
                                            <input type="hidden" name="SavedNoteOwner[]" value="${ownerId}" form="leadForm" />
                                            <input type="hidden" name="SavedNoteDateTime[]" value="${dateTime}" form="leadForm" />
                                            <input type="hidden" name="SavedNoteDesc[]" value="${finalDescription}" form="leadForm" />
                                        </div>`;

        const mainContainer = document.getElementById('notesContainer');
        if (mainContainer) mainContainer.insertAdjacentHTML('afterbegin', mainNoteHtml);

        clearInlineNote();
    }

    function openTaskModal() {
        const ownerDropdown = document.getElementById('taskOwnerDropdown');
        if (ownerDropdown) ownerDropdown.value = '@currentUserId';

        const modalEl = document.getElementById('quickTaskModal');
        if (modalEl) {
            // 🚀 FIX: Safely move modal to the root body to escape the blurred backdrop
            if (modalEl.parentNode !== document.body) {
                document.body.appendChild(modalEl);
            }
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    // =====================================
    // FORM BEHAVIORS (Payments, Verification)
    // =====================================
    const dataSourcesEl = document.getElementById('DataSources');
    if (dataSourcesEl) {
        dataSourcesEl.addEventListener('change', function () {
            const val = this.value;
            const divMeta = document.getElementById('divMetaCampaign');
            const divSeminar = document.getElementById('divSeminarName');
            if (divMeta) divMeta.style.display = (val === 'Meta Ads') ? 'block' : 'none';
            if (divSeminar) divSeminar.style.display = (val === 'Seminar Conference') ? 'block' : 'none';
        });
    }

    function verifyPhone(fieldId) {
        const phoneEl = document.getElementById(fieldId);
        const mainMobileEl = document.getElementById('MobileNumber');
        const altMobileEl = document.getElementById('AlternateMobile');

        if (!phoneEl) return;
        const phone = phoneEl.value.trim();
        const mainMobile = mainMobileEl ? mainMobileEl.value.trim() : '';
        const altMobile = altMobileEl ? altMobileEl.value.trim() : '';

        if (!phone) {
            alert('Please enter a phone number first before verifying.');
            return;
        }
        if (mainMobile && altMobile && mainMobile === altMobile) {
            alert('❌ Mobile Number and Alternate Mobile cannot be the exact same!');
            return;
        }

        fetch('@Url.Action("CheckDuplicatePhone", "Accounts")?phone=' + encodeURIComponent(phone))
            .then(response => response.json())
            .then(data => {
                if (data.isDuplicate) alert('⚠️ WARNING: This phone number already exists in another record!');
                else alert('✅ This number is valid and unique in the system.');
            })
            .catch(error => {
                console.error("Error verifying phone:", error);
                alert("Could not connect to the database to verify.");
            });
    }

    let isDirectDealConfirmed = false;
    const leadForm = document.getElementById('leadForm');

    if (leadForm) {
        leadForm.addEventListener('submit', function (e) {
            const stageSelect = document.getElementById('actualStageSelect');
            if (stageSelect) {
                const stageValue = stageSelect.value;
                if (stageValue === 'Direct Deal' && !isDirectDealConfirmed) {
                    e.preventDefault();
                    const confirmModalEl = document.getElementById('directDealConfirmModal');
                    if (confirmModalEl) {
                        // 🚀 FIX: Move confirm modal to body
                        if (confirmModalEl.parentNode !== document.body) {
                            document.body.appendChild(confirmModalEl);
                        }
                        bootstrap.Modal.getOrCreateInstance(confirmModalEl).show();
                    }
                }
            }
        });
    }

    const btnCancelDirectDeal = document.getElementById('btnCancelDirectDeal');
    if (btnCancelDirectDeal) {
        btnCancelDirectDeal.addEventListener('click', function () {
            const stageSelect = document.getElementById('actualStageSelect');
            if (stageSelect) {
                stageSelect.value = '';
                stageSelect.dispatchEvent(new Event('change'));
            }
        });
    }

    const btnConfirmDirectDeal = document.getElementById('btnConfirmDirectDeal');
    if (btnConfirmDirectDeal) {
        btnConfirmDirectDeal.addEventListener('click', function () {
            const confirmModalEl = document.getElementById('directDealConfirmModal');
            if (confirmModalEl) bootstrap.Modal.getOrCreateInstance(confirmModalEl).hide();

            const paymentRows = document.querySelectorAll('#paymentTbody .payment-row');
            let hasValidPayment = false;

            paymentRows.forEach(row => {
                const productNameInput = row.querySelector('input[name*="ProductName"]');
                const totalInput = row.querySelector('.total');
                const productName = productNameInput ? productNameInput.value.trim() : '';
                const total = totalInput ? parseFloat(totalInput.value) : 0;
                if (productName !== '' && total > 0) hasValidPayment = true;
            });

            if (!hasValidPayment) {
                const stageSelect = document.getElementById('actualStageSelect');
                if (stageSelect) {
                    stageSelect.value = '';
                    stageSelect.dispatchEvent(new Event('change'));
                }
                const errorModalEl = document.getElementById('directDealErrorModal');
                if (errorModalEl) {
                    // 🚀 FIX: Move error modal to body
                    if (errorModalEl.parentNode !== document.body) {
                        document.body.appendChild(errorModalEl);
                    }
                    bootstrap.Modal.getOrCreateInstance(errorModalEl).show();
                }
            } else {
                isDirectDealConfirmed = true;
                if (leadForm) leadForm.submit();
            }
        });
    }

    let productPrices = {};
    try {
        productPrices = @Html.Raw(Json.Serialize(ViewBag.ProductPrices ?? new Dictionary<int, decimal>()));
    } catch (e) {
        console.error("Failed to parse product prices", e);
    }

    const productOptionsHtml = `
                                    <option value="0">-Select Product-</option>
                                    @if (ViewBag.ProductsList != null)
                                    {
                                                                foreach (var item in (SelectList)ViewBag.ProductsList)
                                                                {
                                                                                            <option value="@item.Value">@item.Text</option>
                                                                }
                                    }
                                    `;

    let rowCount = @(Model?.PaymentRow != null && Model.PaymentRow.Count > 0 ? Model.PaymentRow.Count : 1);
    function addRow() {
        const tbody = document.getElementById('paymentTbody');
        if (!tbody) return;
        const tr = document.createElement('tr');
        tr.className = 'payment-row';
        tr.innerHTML = `
                                        <td><select name="PaymentRow[${rowCount}].DealType" class="z-input"><option value="">-None-</option><option value="New Sale">New Sale</option><option value="Upgrade">Upgrade</option><option value="Add On">Add On</option><option value="Stock Key">Stock Key</option><option value="Existing">Existing</option></select></td>
                                        <td>
                                        <select name="PaymentRow[${rowCount}].ProductId" class="z-input product-select" onchange="productSelected(this)">${productOptionsHtml}</select>
                                        <input type="hidden" name="PaymentRow[${rowCount}].ProductName" class="product-name-hidden" value="" />
                                        </td>
                                        <td><input type="number" name="PaymentRow[${rowCount}].Quantity" class="z-input qty" value="1" onchange="calcRow(this)" /></td>
                                        <td><input type="number" name="PaymentRow[${rowCount}].ProductPrice" class="z-input price" value="0" onchange="calcRow(this)" /></td>
                                        <td><input type="number" name="PaymentRow[${rowCount}].Total" class="z-input total bg-light" readonly /></td>
                                        <td><input type="number" name="PaymentRow[${rowCount}].DiscountPercent" class="z-input disc" value="0" onchange="calcRow(this)" /></td>
                                        <td><input type="number" name="PaymentRow[${rowCount}].FinalAmount" class="z-input final bg-light" readonly /></td>
                                        <td><button type="button" class="btn text-danger btn-sm" onclick="removeRow(this)"><i class="fa-solid fa-xmark"></i></button></td>
                                        `;
        tbody.appendChild(tr);
        rowCount++;
    }

    function productSelected(selectElem) {
        const selectedId = selectElem.value;
        const price = productPrices[selectedId] || 0;
        const productName = selectElem.options[selectElem.selectedIndex].text;
        const row = selectElem.closest('tr');

        const nameHiddenInput = row.querySelector('.product-name-hidden');
        if (nameHiddenInput) nameHiddenInput.value = (selectedId === "0") ? "" : productName;

        const priceInput = row.querySelector('.price');
        if (priceInput) {
            priceInput.value = price;
            calcRow(priceInput);
        }
    }

    function removeRow(btn) {
        const row = btn.closest('tr');
        if (row) {
            row.remove();
            calcGrand();
        }
    }

    function calcRow(input) {
        if (input) {
            const row = input.closest('tr');
            if (row) {
                const qty = parseFloat(row.querySelector('.qty').value) || 0;
                const price = parseFloat(row.querySelector('.price').value) || 0;
                const disc = parseFloat(row.querySelector('.disc').value) || 0;
                const total = qty * price;
                const discountAmt = total * (disc / 100);
                const finalAmt = total - discountAmt;

                const totalEl = row.querySelector('.total');
                const finalEl = row.querySelector('.final');
                if (totalEl) totalEl.value = total.toFixed(2);
                if (finalEl) finalEl.value = finalAmt.toFixed(2);
            }
        }
        calcGrand();
    }

    function calcGrand() {
        let sub = 0;
        document.querySelectorAll('.final').forEach(el => {
            sub += parseFloat(el.value) || 0;
        });
        const subTotalEl = document.getElementById('subTotal');
        if (subTotalEl) subTotalEl.value = sub.toFixed(2);

        const taxAmount = sub * 0.18;
        const taxesEl = document.getElementById('taxes');
        if (taxesEl) taxesEl.value = taxAmount.toFixed(2);

        const adjEl = document.getElementById('adjustment');
        const adj = adjEl ? (parseFloat(adjEl.value) || 0) : 0;

        const grand = sub + taxAmount - adj;
        const grandTotalEl = document.getElementById('grandTotal');
        if (grandTotalEl) grandTotalEl.value = grand.toFixed(2);
    }

    // ==========================================
    // DYNAMIC CASCADING ADDRESS DROPDOWNS
    // ==========================================
    document.addEventListener("DOMContentLoaded", function () {
        const existingCountry1 = '@Html.Raw(Model?.Addr1_Country ?? "")';
        const existingCountry2 = '@Html.Raw(Model?.Addr2_Country ?? "")';
        const existingState1 = '@Html.Raw(Model?.Addr1_State ?? "")';
        const existingState2 = '@Html.Raw(Model?.Addr2_State ?? "")';
        const existingCity1 = '@Html.Raw(Model?.Addr1_City ?? "")';
        const existingCity2 = '@Html.Raw(Model?.Addr2_City ?? "")';
        const existingZip1 = '@Html.Raw(Model?.Addr1_Zip ?? "")';
        const existingZip2 = '@Html.Raw(Model?.Addr2_Zip ?? "")';

        fetch('@Url.Action("GetCountries", "Postcode")')
            .then(res => {
                if (!res.ok) throw new Error("Server returned status: " + res.status);
                return res.json();
            })
            .then(countries => {
                populateDropdown('Addr1_Country', countries, 'Select Country', existingCountry1);
                populateDropdown('Addr2_Country', countries, 'Select Country', existingCountry2);

                if (existingCountry1) triggerChange('Addr1_Country');
                if (existingCountry2) triggerChange('Addr2_Country');
            })
            .catch(err => console.error("Error loading countries:", err));

        setupCascadingDropdowns('Addr1_Country', 'Addr1_State', 'Addr1_City', 'Addr1_Zip', existingState1, existingCity1, existingZip1);
        setupCascadingDropdowns('Addr2_Country', 'Addr2_State', 'Addr2_City', 'Addr2_Zip', existingState2, existingCity2, existingZip2);
    });

    function populateDropdown(dropdownId, dataList, defaultText, selectedValue = "") {
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;
        dropdown.innerHTML = '<option value="">- ' + defaultText + ' -</option>';
        dataList.forEach(item => {
            const opt = document.createElement('option');
            opt.value = item;
            opt.textContent = item;
            if (item === selectedValue) opt.selected = true;
            dropdown.appendChild(opt);
        });
    }

    function triggerChange(elementId) {
        const el = document.getElementById(elementId);
        if (el) el.dispatchEvent(new Event('change'));
    }

    function setupCascadingDropdowns(countryId, stateId, cityId, zipId, defaultState = "", defaultCity = "", defaultZip = "") {
        const countryEl = document.getElementById(countryId);
        const stateEl = document.getElementById(stateId);
        const cityEl = document.getElementById(cityId);
        const zipEl = document.getElementById(zipId);

        if (countryEl) {
            countryEl.addEventListener('change', function () {
                const country = this.value;
                if (stateEl) stateEl.innerHTML = '<option value="">- Select State -</option>';
                if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                if (country) {
                    fetch('@Url.Action("GetStates", "Postcode")?country=' + encodeURIComponent(country))
                        .then(res => res.json())
                        .then(states => {
                            populateDropdown(stateId, states, 'Select State', defaultState);
                            if (defaultState) {
                                triggerChange(stateId);
                                defaultState = "";
                            }
                        })
                        .catch(err => console.error("Error fetching States:", err));
                }
            });
        }

        if (stateEl) {
            stateEl.addEventListener('change', function () {
                const state = this.value;
                if (cityEl) cityEl.innerHTML = '<option value="">- Select City -</option>';
                if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                if (state) {
                    fetch('@Url.Action("GetCities", "Postcode")?state=' + encodeURIComponent(state))
                        .then(res => res.json())
                        .then(cities => {
                            populateDropdown(cityId, cities, 'Select City', defaultCity);
                            if (defaultCity) {
                                triggerChange(cityId);
                                defaultCity = "";
                            }
                        })
                        .catch(err => console.error("Error fetching Cities:", err));
                }
            });
        }

        if (cityEl) {
            cityEl.addEventListener('change', function () {
                const city = this.value;
                const state = stateEl ? stateEl.value : '';
                if (zipEl) zipEl.innerHTML = '<option value="">- Select Zip Code -</option>';

                if (city && state) {
                    fetch('@Url.Action("GetZipCodes", "Postcode")?city=' + encodeURIComponent(city) + '&state=' + encodeURIComponent(state))
                        .then(res => res.json())
                        .then(zipCodes => {
                            populateDropdown(zipId, zipCodes, 'Select Zip Code', defaultZip);
                            defaultZip = "";
                        })
                        .catch(err => console.error("Error fetching Zip Codes:", err));
                }
            });
        }
    }
</script>