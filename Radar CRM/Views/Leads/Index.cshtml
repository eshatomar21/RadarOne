document.addEventListener('change', function (e) {
        
        // A. Enable toggles only when a Due Date is selected
        if (e.target && e.target.id === 'modalDueDate') {
            const hasDate = !!e.target.value;
            const repeatToggle = document.getElementById('modalRepeatToggle');
            const reminderToggle = document.getElementById('modalReminderToggle');
            const repeatHelpText = document.getElementById('modalRepeatHelpText');
            const repeatPanel = document.getElementById('modalRepeatPanel');
            const reminderPanel = document.getElementById('modalReminderPanel');

            if (repeatToggle) repeatToggle.disabled = !hasDate;
            if (reminderToggle) reminderToggle.disabled = !hasDate;

            if (hasDate) {
                if (repeatHelpText) repeatHelpText.style.display = 'none';
            } else {
                if (repeatHelpText) repeatHelpText.style.display = 'inline';
                if (repeatToggle) repeatToggle.checked = false;
                if (reminderToggle) reminderToggle.checked = false;
                if (repeatPanel) repeatPanel.style.display = 'none';
                if (reminderPanel) reminderPanel.style.display = 'none';
            }
        }

        // B. Handle Repeat Toggle visibility
        if (e.target && e.target.id === 'modalRepeatToggle') {
            const repeatPanel = document.getElementById('modalRepeatPanel');
            if (repeatPanel) {
                repeatPanel.style.display = e.target.checked ? 'block' : 'none';
            }
        }

        // C. Handle Reminder Toggle visibility
        if (e.target && e.target.id === 'modalReminderToggle') {
            const reminderPanel = document.getElementById('modalReminderPanel');
            if (reminderPanel) {
                reminderPanel.style.display = e.target.checked ? 'block' : 'none';
            }
        }
    });


