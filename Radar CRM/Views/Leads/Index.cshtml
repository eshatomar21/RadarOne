                            <input class="form-check-input" type="checkbox" checked style="background-color: #22c55e; border-color: #22c55e; width: 36px; height: 20px;">
                        </div>
                    </div>

                    <div id="criteriaRowsContainer">
                        <!-- First Row (Default) -->
                        <div class="criteria-row-builder d-flex align-items-center gap-2 mb-2">
                            <div class="criteria-num" style="width: 30px; height: 30px; border: 1px solid #cbd5e1; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; color: #64748b; font-weight: 600; flex-shrink: 0;">1</div>

                            <select class="form-select criteria-builder-select cv-module" disabled style="max-width: 150px;">
                                <option value="Leads" selected>Leads</option>
                            </select>

                            <!-- Field Selection -->
                            <select class="form-select criteria-builder-select cv-field" style="max-width: 200px;" onchange="handleCriteriaFieldChange(this)">
                                <option value="" disabled selected>None</option>
                                @foreach (var prop in tableProps)
                                {
                                    <option value="@prop.Name">@prop.Name</option>
                                }
                            </select>

                            <select class="form-select criteria-builder-select cv-condition" style="max-width: 150px;">
                                <option value="" disabled selected>None</option>
                            </select>

                            <div class="cv-value-container d-flex" style="flex-grow:1;">
                                <input type="text" class="form-control criteria-builder-input cv-value" placeholder="Value" style="width: 100%;">
                            </div>

                            <button type="button" class="btn btn-link text-success p-1 add" onclick="addCriteriaRow()"><i class="fa-solid fa-circle-plus fs-5"></i></button>
                        </div>
                    </div>

                    <div class="criteria-pattern-box mt-3 ps-5">
                        <span class="text-muted fw-semibold me-3" style="font-size: 0.85rem;">Criteria Pattern <i class="fa-regular fa-circle-question"></i></span>
                        <span class="fw-bold" id="criteriaPatternText" style="color: #1e293b;">( 1 )</span>
                        <a href="#" class="ms-2 text-decoration-none fw-semibold" style="color: #16a34a; font-size: 0.85rem;">Edit Pattern</a>
                    </div>
                </div>

                <!-- Related Modules Criteria Card -->
                <div class="related-modules-card shadow-sm mb-4">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <h6 class="m-0 fw-bold" style="color: #1e293b; font-size: 0.95rem;">Related Modules Criteria</h6>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" style="width: 36px; height: 20px;">
                        </div>
                    </div>
                    <p class="text-muted m-0" style="font-size: 0.85rem;">It helps to filter record based on related module values.</p>
                </div>

                <!-- Choose Column for Default List View -->
                <div class="bg-white p-4 rounded-3 border shadow-sm mt-4" style="border-color: var(--border-soft) !important;">
                    <h6 class="fw-bold m-0 text-dark d-flex align-items-center gap-2">Choose Column for Default List View <i class="fa-solid fa-circle-info text-muted fs-6"></i></h6>

                    <div class="columns-container d-flex gap-4 mt-3">
                        <!-- Available Columns -->
                        <div class="columns-box-wrapper w-50">
                            <label class="text-muted fw-semibold mb-2" style="font-size: 0.85rem;">Available</label>
                            <div class="columns-box border rounded p-2" id="availableColumnsBox" style="height: 250px; overflow-y: auto; background: #f8fafc;">
                                <div class="mb-2" style="position: sticky; top: 0; z-index: 5;">
                                    <div class="input-group input-group-sm border rounded bg-white">
                                        <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                        <input type="text" class="form-control border-0 shadow-none" placeholder="Search..." id="searchAvailableCols" onkeyup="filterColumns('availableColumnsBox', 'searchAvailableCols')">
                                    </div>
                                </div>
                                @foreach (var prop in tableProps)
                                {
                                    <div class="column-item p-2 mb-1 bg-white border rounded d-flex justify-content-between align-items-center" style="cursor: pointer; font-size: 0.85rem;" onclick="moveColumn(this, 'selectedColumnsBox')">
                                        <span class="flex-grow-1">@prop.Name</span> <i class="fa-solid fa-arrow-right text-primary"></i>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Selected Columns -->
                        <div class="columns-box-wrapper w-50">
                            <label class="text-muted fw-semibold mb-2" style="font-size: 0.85rem;">Selected</label>
                            <div class="columns-box border rounded p-2" id="selectedColumnsBox" style="height: 250px; overflow-y: auto; background: #ffffff;">
                                <!-- Default starting items -->
                                <div class="column-item p-2 mb-1 border rounded d-flex justify-content-between align-items-center" style="background: #f1f5f9; cursor: pointer; font-size: 0.85rem;" onclick="moveColumn(this, 'availableColumnsBox')">
                                    <i class="fa-solid fa-grip-vertical text-muted me-2"></i> <span class="flex-grow-1">LeadName</span> <i class="fa-solid fa-xmark text-danger ms-2"></i>
                                </div>
                                <div class="column-item p-2 mb-1 border rounded d-flex justify-content-between align-items-center" style="background: #f1f5f9; cursor: pointer; font-size: 0.85rem;" onclick="moveColumn(this, 'availableColumnsBox')">
                                    <i class="fa-solid fa-grip-vertical text-muted me-2"></i> <span class="flex-grow-1">MobileNumber</span> <i class="fa-solid fa-xmark text-danger ms-2"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    // 🚀 INJECT C# DATA ARRAYS DIRECTLY INTO JS
    const ownerOptionsList = [
        @if (ViewBag.UsersList != null) { foreach (var user in (SelectList)ViewBag.UsersList) { <text>"@Html.Raw(user.Text)",</text> } }
    ];
    const vendorOptionsList = [
        @if (ViewBag.VendorsList != null) { foreach (var vendor in (SelectList)ViewBag.VendorsList) { <text>"@Html.Raw(vendor.Text)",</text> } }
    ];

    const defaultVisibleColumns = ["LeadName", "MobileNumber", "LeadStatus", "Stage", "CreatedDateAndTime"];
    let currentNoteLeadId = null;
    let allRows = [];
    let currentVisibleRows = [];
    let hiddenCols = new Set();
    let sortStates = {}; 

    // Map of fields to selectable dropdown arrays
    const criteriaFilterOptionsMap = {
        "GroupName": vendorOptionsList,
        "LeadStatus": ["Important contact", "Not a Doctor", "Warm", "Hot", "Not Interested", "Rining", "Wrong Number/Invalid Number", "Already Using Another Software", "Price Concern", "Student", "Offer made"],
        "Stage": ["Open", "Contacted", "Demo Scheduled", "Trial Initiated", "Proposal Sent", "Closed Won", "Closed Lost"],
        "CurrentStatus": ["User", "Non-User"],
        "AccountType": ["Individual", "Group", "Institution", "Government Organisation"],
        "DataSources": ["InboundCall", "Referral/Dealer", "Meta Ads", "Google AdWords", "Outreach", "Group Lead", "Institutional", "Webinar", "Website Direct", "YouTube", "LinkedIn", "Cold Calling", "WhatsApp Campaign"],
        "CampaignSource": ["Meta Ads", "Google AdWords", "Webinar", "Outreach", "Direct"],
        "IsHomeopathicDoctor": ["Yes — MD(Homeopathy)", "Yes - BHMS", "Pursuing BHMS", "Not a Homeopath Doctor", "Yes", "No"],
        "ClinicType": ["Own", "Visiting", "Hospital Attached", "Govt.service", "Chain Clinics"],
        "WorkType": ["Practicing", "Job", "Research", "others"],
        "HasComputer": ["Yes", "No"],
        "Qualification": ["BHMS", "MD", "BAMS", "Student"],
        "PaymentType": ["Upfront", "EMI - 3Months", "EMI - 6Months"],
        "PaymentStatus": ["Paid", "Pending", "Partial", "Refunded"],
        "CurrentlyUsingSoftware": ["Yes", "No"]
    };

    const criteriaFieldOptions = `@foreach (var prop in tableProps) { <option value="@prop.Name">@prop.Name</option> }`;

    window.initializeTooltips = function() {
        setTimeout(() => {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                const existing = bootstrap.Tooltip.getInstance(tooltipTriggerEl);
                if (existing) existing.dispose();
                return new bootstrap.Tooltip(tooltipTriggerEl, { html: true, sanitize: false });
            });
        }, 500);
    };

    document.addEventListener("DOMContentLoaded", function () {
        allRows = Array.from(document.querySelectorAll('tbody tr.lead-row'));
        currentVisibleRows = [...allRows];

        const style = document.createElement('style');
        style.id = 'dynamic-col-styles';
        document.head.appendChild(style);

        restoreColumnOrder();

        const savedHidden = JSON.parse(localStorage.getItem('crm_hidden_cols_leads') || '[]');
        hiddenCols = new Set(savedHidden);

        setupColumnToggles();
        setupFilterInteractions();
        setupLazyDatalists();
        refreshVisibleRows();
        setupFileUpload();
        restorePinnedFilters();
        renderCustomViews();
        renderSavedSidebarFilters();
        restoreSidebarFiltersFromUrl();
        setupExcelResizing();
        initializeTooltips();

        if (localStorage.getItem('crm_filter_hidden') === 'true') {
            document.getElementById('filterSidebarWrapper').classList.add('hidden-sidebar');
        }
    });

    function refreshVisibleRows() {
        currentVisibleRows = [];
        allRows.forEach(r => {
            const sidebarHidden = r.classList.contains('filtered-out');
            let colHidden = false;
            for (const key in r.dataset) {
                if (key.startsWith('colFilter_') && r.dataset[key] === "hidden") {
                    colHidden = true; break;
                }
            }
            if (!sidebarHidden && !colHidden) {
                r.style.display = '';
                currentVisibleRows.push(r);
            } else {
                r.style.display = 'none';
            }
        });

        const originalTotal = document.getElementById('pageInfo') ? document.getElementById('pageInfo').innerText.match(/\d+ total/)?.[0]?.replace(' total', '') : allRows.length;
        const displayCount = (currentVisibleRows.length === allRows.length) ? (originalTotal || allRows.length) : currentVisibleRows.length + ' (Filtered)';
        
        const topCountBadge = document.getElementById('topTotalCount');
        const bottomCountBadge = document.getElementById('bottomTotalCount');
        if (topCountBadge) topCountBadge.innerText = displayCount;
        if (bottomCountBadge) bottomCountBadge.innerText = displayCount;

        updateSelectedCount();
    }

    // ==========================================
    // 3. FILTERING & SEARCHING
    // ==========================================
    function togglePinFilter(event, iconElement, isRestoring = false) {
        if(event) event.stopPropagation();

        const item = iconElement.closest('.filter-field-item');
        const pinnedWrapper = document.getElementById('pinnedFilters');
        const pinnedContainer = document.getElementById('pinnedItemsContainer');
        const unpinnedContainer = document.getElementById('sidebarList');

        if (iconElement.classList.contains('fa-regular')) {
            iconElement.classList.replace('fa-regular', 'fa-solid');
            iconElement.style.color = '#eab308';
            pinnedContainer.appendChild(item);
            pinnedWrapper.style.display = 'block';
        } else {
            iconElement.classList.replace('fa-solid', 'fa-regular');
            iconElement.style.color = '#cbd5e1';
            unpinnedContainer.appendChild(item);
            if (pinnedContainer.children.length === 0) {
                pinnedWrapper.style.display = 'none';
            }
        }

        if (!isRestoring) {
            const pinnedIds = Array.from(pinnedContainer.children).map(el => el.querySelector('.field-checkbox').id);
            localStorage.setItem('crm_pinned_filters_leads', JSON.stringify(pinnedIds));
        }
    }

    function restorePinnedFilters() {
        const pinnedIds = JSON.parse(localStorage.getItem('crm_pinned_filters_leads') || '[]');
        pinnedIds.forEach(id => {
            const cb = document.getElementById(id);
            if (cb) {
                const icon = cb.closest('.filter-field-item').querySelector('.pin-filter-btn');
                if (icon) togglePinFilter(null, icon, true);
            }
        });
    }

    function toggleDateInputs(selectElement) {
        const wrapper = selectElement.closest('.filter-expanded-area');
        const val2 = wrapper.querySelector('.date-val-2');
        if (val2) {
            val2.style.display = selectElement.value === 'between' ? 'block' : 'none';
        }
    }

    function setupFilterInteractions() {
        document.querySelectorAll('.field-checkbox').forEach(cb => {
            cb.addEventListener('change', function() {
                const item = this.closest('.filter-field-item');
                if(this.checked) item.classList.add('active');
                else {
                    item.classList.remove('active');
                    const textVal = item.querySelector('.text-val');
                    const dateVal1 = item.querySelector('.date-val-1');
                    const dateVal2 = item.querySelector('.date-val-2');

                    if (textVal) textVal.value = '';
                    if (dateVal1) dateVal1.value = '';
                    if (dateVal2) dateVal2.value = '';
                }
            });
        });
    }

    function filterSidebarItems() {
        const q = document.getElementById('sidebarSearch').value.toLowerCase();
        document.querySelectorAll('#sidebarList .filter-field-item').forEach(item => {
            const label = item.querySelector('label').innerText.toLowerCase();
            item.style.display = label.includes(q) ? '' : 'none';
        });
    }

    // ==========================================
    // 🚀 NEW FEATURE: SAVE INDIVIDUAL FIELD FILTERS
    // ==========================================
    function saveFieldFilter(event, iconEl, fieldName) {
        event.stopPropagation();
       
        const item = iconEl.closest('.filter-field-item');
        const cb = item.querySelector('.field-checkbox');
       
        if(!cb.checked) {
            alert("Please check the box and set a value before saving this filter.");
            return;
        }

        const condition = item.querySelector('.condition-select').value;
        const isDate = item.dataset.fieldType === "date";
        let val = isDate ? item.querySelector('.date-val-1').value : item.querySelector('.condition-val').value;

        if(!val && condition !== 'is_empty' && condition !== 'is_not_empty') {
            alert("Please enter a value before saving.");
            return;
        }

        let savedFilters = JSON.parse(localStorage.getItem('crm_saved_sidebar_filters_leads') || '[]');
        savedFilters.push({ fieldName, condition, val, isDate, id: Date.now() });
        localStorage.setItem('crm_saved_sidebar_filters_leads', JSON.stringify(savedFilters));
       
        renderSavedSidebarFilters();
    }

    function renderSavedSidebarFilters() {
        const section = document.getElementById('savedFiltersSection');
        const container = document.getElementById('savedFiltersContainer');
        let savedFilters = JSON.parse(localStorage.getItem('crm_saved_sidebar_filters_leads') || '[]');

        if(savedFilters.length === 0) {
            section.style.display = 'none';
            return;
        }

        section.style.display = 'block';
        container.innerHTML = '';
        savedFilters.forEach(f => {
            const badge = document.createElement('div');
            badge.className = 'badge bg-white text-dark border shadow-sm p-2 d-flex align-items-center gap-2';
            badge.innerHTML = `
                <span onclick="applySavedSidebarFilter(${f.id})" style="cursor:pointer;" title="Click to instantly apply this filter">
                    <i class="fa-solid fa-filter text-primary me-1"></i> ${f.fieldName} ${f.condition} <span class="text-primary">${f.val}</span>
                </span>
                <i class="fa-solid fa-xmark text-danger" style="cursor:pointer; opacity: 0.6;" onclick="deleteSavedSidebarFilter(${f.id}, event)" title="Remove"></i>
            `;
            container.appendChild(badge);
        });
    }

    function applySavedSidebarFilter(id) {
        let savedFilters = JSON.parse(localStorage.getItem('crm_saved_sidebar_filters_leads') || '[]');
        let f = savedFilters.find(x => x.id === id);
        if(!f) return;

        const activeFilters = [{
            LogicalOperator: "",
            ColumnName: f.fieldName,
            Condition: f.condition,
            Value: f.val,
            IsDate: f.isDate
        }];

        document.body.style.cursor = 'wait';
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('advancedFilters', JSON.stringify(activeFilters));
        urlParams.set('page', 1);
        urlParams.set('_t', Date.now());
        window.location.href = window.location.pathname + '?' + urlParams.toString();
    }

    function deleteSavedSidebarFilter(id, event) {
        event.stopPropagation();
        let savedFilters = JSON.parse(localStorage.getItem('crm_saved_sidebar_filters_leads') || '[]');
        savedFilters = savedFilters.filter(x => x.id !== id);
        localStorage.setItem('crm_saved_sidebar_filters_leads', JSON.stringify(savedFilters));
        renderSavedSidebarFilters();
    }

   function restoreSidebarFiltersFromUrl() {
        const urlParams = new URLSearchParams(window.location.search);
        const filtersParam = urlParams.get('advancedFilters');
       
        if (filtersParam) {
            try {
                const activeFilters = JSON.parse(filtersParam);
                activeFilters.forEach(f => {
                    // 🚀 FIX: Strip "Id" when looking for the checkbox in the UI
                    let searchColName = f.ColumnName;
                    if (searchColName.endsWith("Id") && !document.getElementById('chk_' + searchColName)) {
                        searchColName = searchColName.replace("Id", "");
                    }

                    const chk = document.getElementById('chk_' + searchColName);
                    if (chk) {
                        chk.checked = true;
                        const item = chk.closest('.filter-field-item');
                        item.classList.add('active');

                        const condSelect = item.querySelector('.condition-select');
                        if (condSelect) {
                            Array.from(condSelect.options).forEach(opt => {
                                if (opt.value.toLowerCase() === f.Condition.toLowerCase()) condSelect.value = opt.value;
                            });
                        }

                        if (f.IsDate) {
                            const vals = f.Value.split('|');
                            const date1 = item.querySelector('.date-val-1');
                            if (date1) date1.value = vals[0];
                           
                            if (vals.length > 1) {
                                const date2 = item.querySelector('.date-val-2');
                                if (date2) {
                                    date2.value = vals[1];
                                    date2.style.display = 'block';
                                }
                            }
                        } else {
                            const textVal = item.querySelector('.condition-val');
                            if (textVal) textVal.value = f.Value;
                        }
                    }
                });
            } catch(e) { console.error("Error restoring filters", e); }
        }
    }

    // ==========================================
    // 🚀 NEW: SAVE & RESTORE COLUMN ORDER
    // ==========================================
    function saveColumnOrder() {
        const menu = document.getElementById("columnToggleMenu");
        const items = menu.querySelectorAll("li.draggable-col-item");
        const order = Array.from(items).map(li => li.dataset.colIndex);
        localStorage.setItem('crm_col_order_leads', JSON.stringify(order));
    }

    function restoreColumnOrder() {
        const savedOrder = JSON.parse(localStorage.getItem('crm_col_order_leads'));
        if (!savedOrder || savedOrder.length === 0) return;

        const table = document.querySelector("#leadsTable");
        const theadRow = table.querySelector("thead tr");
        const actionsTh = theadRow.querySelector('.sticky-actions');

        // 1. Reorder the TH headers
        savedOrder.forEach(colIdx => {
            const th = theadRow.querySelector(`th[data-col-index="${colIdx}"]`);
            if (th && actionsTh) {
                theadRow.insertBefore(th, actionsTh);
            }
        });

        // 2. Reorder the TD cells in all rows
        allRows.forEach(row => {
            const actionsTd = row.querySelector('.sticky-actions');
            savedOrder.forEach(colIdx => {
                const td = row.querySelector(`td[data-col-index="${colIdx}"]`);
                if (td && actionsTd) {
                    row.insertBefore(td, actionsTd);
                }
            });
        });
    }

    // ==========================================
    // 🚀 DYNAMIC CUSTOM VIEWS & CRITERIA BUILDER
    // ==========================================
    function openCustomViewModal() {
        const modalEl = document.getElementById('createCustomViewModal');
        if (!modalEl) return;
        document.body.appendChild(modalEl);
        modalEl.style.zIndex = "9999";
       
        try {
            const myModal = new bootstrap.Modal(modalEl);
            myModal.show();
        } catch (error) {
            if (typeof $ !== 'undefined') {
                $(modalEl).modal('show');
            }
        }
    }

    function renderCustomViews() {
        const container = document.getElementById('customViewsTabsContainer');
        const menu = document.getElementById('unpinnedViewsMenu');
        const savedViews = JSON.parse(localStorage.getItem('crm_user_views_leads')) || [];

        const urlParams = new URLSearchParams(window.location.search);
        const activeViewName = urlParams.get('activeView') || 'All Leads';

        if(container) {
            container.innerHTML = `<a href="#" class="view-tab ${activeViewName === 'All Leads' ? 'active shadow-sm' : ''}" onclick="applyCustomView('All Leads', [])">All Leads</a>`;
        }

        if(menu) {
            const unpinnedItems = menu.querySelectorAll('.unpinned-item');
            unpinnedItems.forEach(item => item.remove());
        }

        savedViews.forEach(view => {
            const isActive = activeViewName === view.name;
            const filterStr = JSON.stringify(view.filters).replace(/"/g, '&quot;');

            if (view.isPinned !== false) {
                const tabHtml = `
                    <div class="view-tab ${isActive ? 'active shadow-sm' : ''} d-flex align-items-center gap-2" style="${isActive ? 'background-color: #eff6ff;' : ''}">
                        <i class="fa-solid fa-thumbtack pin-icon" style="color: ${isActive ? 'var(--primary-blue)' : '#64748b'}; cursor: pointer; transform: rotate(-45deg); transition: 0.2s;" onclick="toggleViewPinStatus('${view.name}', event)" title="Unpin View"></i>
