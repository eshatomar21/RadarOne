    window.sortTableByCol = function(colIndex, sortDir) {
        // 1. Get the exact column name from the table header attribute
        const th = document.querySelector(`th[data-col-index="${colIndex}"]`);
        if (!th) return;

        const colName = th.getAttribute("data-col-name");
        if (!colName) return;

        // 2. Keep existing parameters (filters, active views, etc.)
        const urlParams = new URLSearchParams(window.location.search);
        
        // 3. Set the new sorting parameters
        urlParams.set('sortCol', colName);
        urlParams.set('sortDir', sortDir);
        urlParams.set('page', 1); // Reset to page 1 when sorting changes
        urlParams.set('_t', Date.now()); // Prevent browser caching

        // 4. Redirect to backend to fetch sorted data
        document.body.style.cursor = 'wait';
        window.location.href = window.location.pathname + '?' + urlParams.toString();
    };

    async function saveNoteAjax() {
        const title = document.getElementById('newNoteTitle').value;
        const text = document.getElementById('newNoteText').value;
        const attachment = document.getElementById('noteAttachment').files[0];
        const ownerId = document.getElementById('noteOwnerId').value;
        const btn = document.getElementById('btnSaveNote');

        if (!text.trim() && !attachment && !title.trim()) return;

        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        btn.disabled = true;

        const formData = new FormData();
        formData.append('leadId', currentNoteLeadId);
        formData.append('noteTitle', title);
        formData.append('description', text);
        formData.append('ownerId', ownerId);
        if (attachment) formData.append('attachment', attachment);

        try {
            const response = await fetch('@Url.Action("SaveNoteAjax", "Leads")', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();

            if (data.success && data.note) {
                const fallbackMsg = document.querySelector('#notesTimelineList p.text-muted');
                if (fallbackMsg && fallbackMsg.innerText.includes('No historical notes')) fallbackMsg.closest('.position-relative').remove();

                const owner = data.note.ownerName || 'System';
                const time = data.note.createdDateTime || 'Just now';
                const desc = data.note.description || text;
                const savedTitle = data.note.noteTitle || title;
                const file = data.note.attachmentFileName || null;

                appendNoteToUI(owner, time, savedTitle, desc, file);

                document.getElementById('newNoteTitle').value = '';
                document.getElementById('newNoteText').value = '';
                document.getElementById('noteAttachment').value = '';
            } else {
                alert("Failed to save note: " + (data.message || "Unknown error"));
            }
        } catch (e) {
            alert("Network error while saving note.");
        } finally {
            btn.innerHTML = 'Save Note';
            btn.disabled = false;
        }
    }

