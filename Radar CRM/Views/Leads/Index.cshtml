   function saveAndApplyCustomView() {
        const viewName = document.getElementById('customViewName').value.trim();
        if (!viewName) {
            alert("Please enter a Custom View Name.");
            return;
        }

       const activeFilters = [];

        document.querySelectorAll('#criteriaRowsContainer .criteria-row-builder').forEach((row, index) => {
            let field = row.querySelector('.cv-field').value;
            const condition = row.querySelector('.cv-condition').value;
            const val = row.querySelector('.cv-value').value;

            // 🚀 FIX: Map navigational names to Foreign Keys
            if (field === "AccountOwner" || field === "CoOwner" || field === "LeadOwner" || field === "DemoOwner") {
                field += "Id";
            }

            let logicOperator = "AND";
            if (index > 0 && row.previousElementSibling && row.previousElementSibling.classList.contains('criteria-connector-vertical')) {
                logicOperator = row.previousElementSibling.querySelector('.cv-logic').value;
            }

            if (field && condition) {
                if (!val && !condition.includes('empty')) return; // Skip incomplete

                activeFilters.push({
                    LogicalOperator: index === 0 ? "" : logicOperator,
                    ColumnName: field,
                    Condition: condition,
                    Value: val || "",
                    IsDate: field.toLowerCase().includes('date') || field.toLowerCase().includes('time')
                });
            }
        });

        if (activeFilters.length === 0) {
            alert("Please specify at least one valid complete criteria.");
            return;
        }

        let savedViews = JSON.parse(localStorage.getItem('crm_user_views_leads')) || [];
        savedViews = savedViews.filter(v => v.name !== viewName);
        savedViews.push({ name: viewName, isPinned: true, filters: activeFilters });
        localStorage.setItem('crm_user_views_leads', JSON.stringify(savedViews));

        bootstrap.Modal.getInstance(document.getElementById('createCustomViewModal')).hide();
        applyCustomView(viewName, activeFilters);
    }

    function applyCustomView(viewName, filterObj) {
        document.body.style.cursor = 'wait';
        const urlParams = new URLSearchParams(window.location.search);

        if (viewName === 'All Leads' || filterObj.length === 0) {
            urlParams.delete('advancedFilters');
        } else {
            urlParams.set('advancedFilters', JSON.stringify(filterObj));
        }

        urlParams.set('activeView', viewName);
        urlParams.set('page', 1);
        urlParams.set('_t', Date.now());

        window.location.href = window.location.pathname + '?' + urlParams.toString();
    }

    function toggleViewPinStatus(viewName, event) {
        if(event) {
            event.stopPropagation();
            event.preventDefault();
        }
        let savedViews = JSON.parse(localStorage.getItem('crm_user_views_leads')) || [];
        const viewIndex = savedViews.findIndex(v => v.name === viewName);
        if(viewIndex > -1) {
            savedViews[viewIndex].isPinned = !savedViews[viewIndex].isPinned;
            localStorage.setItem('crm_user_views_leads', JSON.stringify(savedViews));
            renderCustomViews();
        }
    }

    function deleteCustomView(viewName, event) {
        if(event) {
            event.stopPropagation();
            event.preventDefault();
        }
        if(confirm(`Are you sure you want to delete the view "${viewName}"?`)) {
            let savedViews = JSON.parse(localStorage.getItem('crm_user_views_leads')) || [];
            savedViews = savedViews.filter(v => v.name !== viewName);
            localStorage.setItem('crm_user_views_leads', JSON.stringify(savedViews));

            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('activeView') === viewName) {
                applyCustomView('All Leads', []);
            } else {
                renderCustomViews();
            }
        }
    }

