        let sStartX, sStartWidth;
        sideResizer.addEventListener('mousedown', function (e) {
            sStartX = e.pageX;
            sStartWidth = sidebar.offsetWidth;
            document.addEventListener('mousemove', sideMouseMove);
            document.addEventListener('mouseup', sideMouseUp);
        });

           function sideMouseMove(e) {
            const newWidth = sStartWidth + (e.pageX - sStartX);
            if (newWidth > 200 && newWidth < 800) {
                sidebar.style.minWidth = `${newWidth}px`;
                sidebar.style.width = `${newWidth}px`;
            }
        }

        function sideMouseUp() {
            document.removeEventListener('mousemove', sideMouseMove);
            document.removeEventListener('mouseup', sideMouseUp);
        }
    }

