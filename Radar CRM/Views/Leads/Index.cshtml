    // Contextual dropdown builder based on field selected
    function handleCriteriaFieldChange(selectEl) {
        const row = selectEl.closest('.criteria-row-builder');
        const fieldName = selectEl.value;
        const valueContainer = row.querySelector('.cv-value-container');
        const conditionSelect = row.querySelector('.cv-condition');

        let conditionOptions = '';

        if (fieldName.includes("Owner") || fieldName === "CreatedBy" || fieldName === "ModifiedBy") {
            conditionOptions = '<option value="is">is</option><option value="is_not">is not</option><option value="is_empty">is empty</option><option value="is_not_empty">is not empty</option>';
            let datalistId = "dl_cv_owner_" + Date.now();
            let opts = `<datalist id="${datalistId}">`;
            ownerOptionsList.forEach(o => { opts += `<option value="${o}">${o}</option>`; });
            opts += `</datalist>`;
            valueContainer.innerHTML = `<input type="text" list="${datalistId}" class="form-control criteria-builder-input cv-value" placeholder="Select or type user..." style="width:100%;">${opts}`;
        }
        else if (criteriaFilterOptionsMap[fieldName]) {
            conditionOptions = '<option value="is">is</option><option value="is_not">is not</option><option value="is_empty">is empty</option><option value="is_not_empty">is not empty</option>';
            let opts = '<option value="" disabled selected>Select Value</option>';
