    function toggleAllRowCheckboxes(sourceCb) {
        currentVisibleRows.forEach(row => {
            const cb = row.querySelector('.row-cb');
            if(cb) cb.checked = sourceCb.checked;
        });
        updateSelectedCount();
    }

    function updateSelectedCount() {
        const selected = document.querySelectorAll('tbody .row-cb:checked').length;
        document.getElementById('selCount').innerText = selected;
        document.getElementById('bulkActionsContainer').style.display = selected > 0 ? 'flex' : 'none';

        const massUpdateCountDisplay = document.getElementById('massUpdateCountDisplay');
        if (massUpdateCountDisplay) massUpdateCountDisplay.innerText = selected;

        const totalVisible = currentVisibleRows.length;
        const selectAllCb = document.getElementById('selectAllCb');
        if(selectAllCb) selectAllCb.checked = (selected > 0 && selected === totalVisible);
    }

    function deleteSelected() {
        const selectedCbs = document.querySelectorAll('tbody .row-cb:checked');
        if(selectedCbs.length === 0) return;

        if(confirm(`Are you sure you want to delete ${selectedCbs.length} selected record(s)?`)) {
            let selectedIds = Array.from(selectedCbs).map(cb => parseInt(cb.value));

            fetch('@Url.Action("BulkDelete", "Leads")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(selectedIds)
            })
            .then(async response => {
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || `HTTP Error ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    selectedCbs.forEach(cb => {
                        const tr = cb.closest('tr');
                        tr.remove();
                        allRows = allRows.filter(r => r !== tr);
                    });
                    document.getElementById('selectAllCb').checked = false;
                    updateSelectedCount();
                    refreshVisibleRows();
                } else alert("Database Error: " + data.message);
            }).catch((err) => {
                console.error("Delete Error Details:", err);
                alert("Server Error Encountered:\n" + err.message.substring(0, 150));
            });
        }
    }



    function exportTableToCSV(filename) {
        const checkedCbs = document.querySelectorAll("tbody .row-cb:checked");
       
        if (checkedCbs.length === 0) {
            alert("Please select at least one record using the checkboxes before exporting.");
            return;
        }

        let csv = [];
        let headerRow = [];
        const table = document.getElementById("leadsTable");

        table.querySelectorAll("thead th[data-col-name]").forEach(th => {
            if(th.style.display !== 'none') headerRow.push(`"${th.querySelector('span').innerText.trim()}"`);
        });
        csv.push(headerRow.join(","));

        let targetRows = [];
        checkedCbs.forEach(cb => targetRows.push(cb.closest('tr')));

        targetRows.forEach(tr => {
            let rowData = [];
            tr.querySelectorAll("td[data-col-index]").forEach(td => {
                if(td.style.display !== 'none') {
                    let text = td.innerText.trim().replace(/"/g, '""');
                    rowData.push(`"${text}"`);
                }
            });
            csv.push(rowData.join(","));
        });

        let csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
        let downloadLink = document.createElement("a");
        downloadLink.download = filename;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }

    function setupFileUpload() {
        const fileInput = document.getElementById('fileUploadInput');
        if(!fileInput) return;

        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('uploadedFile', file);

            const uploadBtn = document.querySelector('button[onclick*="fileUploadInput"]');
            const originalHtml = uploadBtn.innerHTML;
            uploadBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Uploading...';
            uploadBtn.disabled = true;

            fetch('@Url.Action("UploadFile", "Leads")', {
                method: 'POST',
                body: formData
            })
            .then(async response => {
                if (response.ok) {
                    alert("Data uploaded successfully!");
                    window.location.reload();
                } else {
                    alert("Upload Failed: " + await response.text());
                    uploadBtn.innerHTML = originalHtml;
                    uploadBtn.disabled = false;
                }
            })
            .catch(error => {
                alert("Network error during upload.");
