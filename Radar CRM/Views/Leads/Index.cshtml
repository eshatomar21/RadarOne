        const q = searchInput.value.toLowerCase();
        const items = document.querySelectorAll('#columnToggleMenu .draggable-col-item');
        
        items.forEach(item => {
            const label = item.querySelector('label').innerText.toLowerCase();
            if (label.includes(q)) {
                item.classList.remove('d-none');
                item.classList.add('d-flex');
            } else {
                item.classList.remove('d-flex');
                item.classList.add('d-none');
            }
        });
    };

    // --- EXCEL RESIZING FOR LEADS ---
  function setupExcelResizing() {
        const table = document.getElementById('leadsTable');
        if (!table) return;

        // 🚀 SPEED FIX: table-layout: fixed means we ONLY size TH elements. TDs match instantly via CSS.
        table.style.tableLayout = "fixed";
        table.style.width = "100%"; 

        let savedWidths = JSON.parse(localStorage.getItem('crm_col_widths_leads')) || {};
        const cols = table.querySelectorAll('thead th:not(.sticky-cb):not(.sticky-actions):not(.dummy-filler-col)');
        
        cols.forEach(col => {
            col.style.position = 'relative';
            const colIndex = Array.from(col.parentNode.children).indexOf(col);
            
            let w = savedWidths[colIndex];
            if (!w) {
                const colName = col.getAttribute('data-col-name');
                if (colName === 'LeadName') w = '250px';
                else if (colName === 'Email') w = '220px';
                else w = '160px'; 
            }

            if (w) {
                col.style.width = w;
                col.style.minWidth = w;
                col.style.maxWidth = w;
            }

            const resizer = document.createElement('div');
            resizer.style.width = '8px';
            resizer.style.height = '100%';
            resizer.style.position = 'absolute';
            resizer.style.right = '0';
            resizer.style.top = '0';
            resizer.style.cursor = 'col-resize';
            resizer.style.userSelect = 'none';
            resizer.style.zIndex = '10';

            resizer.addEventListener('mouseenter', () => resizer.style.backgroundColor = '#93c5fd');
            resizer.addEventListener('mouseleave', () => resizer.style.backgroundColor = 'transparent');
            col.appendChild(resizer);

            let startX, startWidth;
            resizer.addEventListener('mousedown', function (e) {
                e.preventDefault();
                startX = e.pageX;
                startWidth = col.offsetWidth;
                document.body.style.cursor = 'col-resize';
                
                let animationFrameId;
                
                function mouseMoveHandler(e) {
                    if (animationFrameId) cancelAnimationFrame(animationFrameId);
                    animationFrameId = requestAnimationFrame(() => {
                        const newWidth = Math.max(90, startWidth + (e.pageX - startX));
                        col.style.width = `${newWidth}px`;
                        col.style.minWidth = `${newWidth}px`;
                        col.style.maxWidth = `${newWidth}px`;
                    });
                }

                function mouseUpHandler() {
                    document.body.style.cursor = 'default';
                    document.removeEventListener('mousemove', mouseMoveHandler);
                    document.removeEventListener('mouseup', mouseUpHandler);

                    savedWidths[colIndex] = col.style.width;
                    localStorage.setItem('crm_col_widths_leads', JSON.stringify(savedWidths));
                }

                document.addEventListener('mousemove', mouseMoveHandler);
                document.addEventListener('mouseup', mouseUpHandler);
            });
        });
    }
