                    <select id="noteOwnerId" class="form-select form-select-sm border-0 shadow-none fw-semibold" asp-items="ViewBag.UsersList" style="background-color: transparent; color: #475569; cursor: pointer; max-width: 130px;">
                        <option value="">System</option>
