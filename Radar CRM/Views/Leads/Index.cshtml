</div>

<!-- 🚀 Create Custom View Modal (Mounted at page root) -->
<div class="modal fade" id="createCustomViewModal" tabindex="-1" aria-hidden="true" style="z-index: 1055;">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content shadow-lg border-0" style="border-radius: 12px; background-color: #f8fafc;">

            <div class="modal-header bg-white border-bottom" style="padding: 16px 24px;">
                <input type="text" id="customViewName" class="form-control border-0 shadow-none fs-5 fw-bold w-50" placeholder="Enter Custom View Name" style="color: #0f172a;">
                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn-saas" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn-saas-primary px-4" onclick="saveAndApplyCustomView()">Save</button>
