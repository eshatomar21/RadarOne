    window.toggleSort = function(event, colIndex) {
        if(event) { event.stopPropagation(); event.preventDefault(); }
        let dir = sortStates[colIndex] === 'asc' ? 'desc' : 'asc';
        sortStates[colIndex] = dir;
        
        document.querySelectorAll('th .fa-arrow-up-a-z, th .fa-arrow-down-z-a').forEach(icon => {
            icon.className = 'fa-solid fa-sort text-muted header-action-icon';
            icon.style.color = '';
        });

        const currentIcon = event.currentTarget;
        currentIcon.className = dir === 'asc' ? 'fa-solid fa-arrow-up-a-z header-action-icon' : 'fa-solid fa-arrow-down-z-a header-action-icon';
        currentIcon.style.color = 'var(--primary-blue)';

        document.body.style.cursor = 'wait';
        setTimeout(() => {
            const tbody = document.getElementById("tableBody");
            let rowsToSort = Array.from(tbody.querySelectorAll('tr:not(#noRecordsRow)'));

            rowsToSort.sort((a, b) => {
                const aCol = a.querySelector(`td[data-col-index="${colIndex}"]`);
                const bCol = b.querySelector(`td[data-col-index="${colIndex}"]`);
                const aText = aCol ? aCol.textContent.trim().toLowerCase() : '';
                const bText = bCol ? bCol.textContent.trim().toLowerCase() : '';
                const aNum = parseFloat(aText);
                const bNum = parseFloat(bText);

                if (!isNaN(aNum) && !isNaN(bNum) && aText !== '' && bText !== '') {
                    return dir === 'asc' ? aNum - bNum : bNum - aNum;
                }
                if (aText < bText) return dir === 'asc' ? -1 : 1;
                if (aText > bText) return dir === 'asc' ? 1 : -1;
                return 0;
            });
            rowsToSort.forEach(row => tbody.appendChild(row));
            allRows = rowsToSort;
            document.body.style.cursor = 'default';
        }, 50);
    };

