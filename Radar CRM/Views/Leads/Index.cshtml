    function applyFilters() {
        const activeFilters = [];
        document.querySelectorAll('.filter-field-item.active').forEach(item => {
            const cb = item.querySelector('.field-checkbox');
            if (cb && cb.checked) {
                let colName = cb.value;
                const condition = item.querySelector('.condition-select').value;
                const isDate = item.dataset.fieldType === "date";

                // Safely grab correct values for dates vs text
                let val1 = isDate ? (item.querySelector('.date-val-1')?.value || '') : (item.querySelector('.condition-val')?.value.trim() || '');

                // 🚀 FIX: Map navigational properties directly to their Foreign Keys so the backend understands them
                if (colName === "AccountOwner" || colName === "CoOwner" || colName === "LeadOwner" || colName === "DemoOwner") {
                    colName += "Id";
                }

                // 🚀 FIX: Capture val2 for 'between' date conditions
                if (isDate && condition.toLowerCase().includes('between')) {
                    const val2 = item.querySelector('.date-val-2')?.value || '';
                    val1 = val1 + "|" + val2;
                }

                activeFilters.push({
                    LogicalOperator: "AND", // Sidebar always stacks as AND
                    ColumnName: colName,
                    Condition: condition,
                    Value: val1,
                    IsDate: isDate
                });
            }
        });

      if (activeFilters.length === 0) {
            window.location.href = window.location.pathname;
            return;
        }

        const filterStr = JSON.stringify(activeFilters);
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('advancedFilters', filterStr);
        urlParams.set('page', 1);
        urlParams.set('_t', Date.now());

        document.body.style.cursor = 'wait';
        window.location.href = window.location.pathname + '?' + urlParams.toString();
    }

