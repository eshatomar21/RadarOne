    }

    function setupLazyDatalists() {
        document.querySelectorAll('.condition-val').forEach(input => {
            input.addEventListener('focus', function() {
                const listId = this.getAttribute('list');
                if(!listId) return;

                const datalist = document.getElementById(listId);

                if(datalist && datalist.children.length === 0) {
                    const colName = listId.replace('dl_', '');
                    const th = document.querySelector(`th[data-col-name="${colName}"]`);

                    if(th) {
                        const colIndex = th.getAttribute('data-col-index');
                        let uniqueValues = new Set();

                        allRows.forEach(row => {
                            const td = row.querySelector(`td[data-col-index="${colIndex}"]`);
                            if(td) {
                                const text = td.innerText.trim();
                                if(text) uniqueValues.add(text);
                            }
                        });

                        let fragment = document.createDocumentFragment();
                        uniqueValues.forEach(val => {
                            let option = document.createElement("option");
                            option.value = val;
                            fragment.appendChild(option);
                        });
                        datalist.appendChild(fragment);
                    }
                }
            });
        });
    }

    function toggleColumnVisibility(idx, isVisible, isRestoring = false) {
        const idxStr = idx.toString();
        if(isVisible) hiddenCols.delete(idxStr);
        else hiddenCols.add(idxStr);

        let css = '';
        hiddenCols.forEach(colIdx => {
            css += `table#leadsTable th[data-col-index="${colIdx}"], table#leadsTable td[data-col-index="${colIdx}"] { display: none !important; }\n`;
        });
        document.getElementById('dynamic-col-styles').innerHTML = css;

        if (!isRestoring) {
            localStorage.setItem('crm_hidden_cols_leads', JSON.stringify(Array.from(hiddenCols)));
        }
    }

    function setupColumnToggles() {
        const table = document.querySelector("#leadsTable");
        const theadRows = table.querySelectorAll("thead tr:first-child th[data-col-index]");
        const columnMenu = document.getElementById("columnToggleMenu");
        // REPLACE columnMenu.innerHTML = ''; WITH THIS:
        columnMenu.innerHTML = `
        <li class="px-2 pb-2 mb-2 border-bottom" style="position: sticky; top: 0; background: white; z-index: 10;">
            <div class="input-group input-group-sm border rounded">
                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" class="form-control border-0 shadow-none" placeholder="Search columns..." id="manageColSearch" onkeyup="filterManageColumns()">
            </div>
        </li>
    `;

        const hasSavedState = localStorage.getItem('crm_hidden_cols_leads') !== null;

        theadRows.forEach((th) => {
