    let draggedItem = null;
    function handleDragStart(e) {
        draggedItem = this;
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', this.dataset.colIndex);
        setTimeout(() => this.classList.add('dragging'), 0);
    }
    function handleDragOver(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; return false; }
    function handleDragEnter(e) { this.classList.add('over'); }
    function handleDragLeave(e) { this.classList.remove('over'); }
    function handleDrop(e) {
        e.stopPropagation();
        this.classList.remove('over');
        if (draggedItem !== this) {
            let parent = this.parentNode;
            let siblings = Array.from(parent.children);
            let insertAfter = siblings.indexOf(draggedItem) < siblings.indexOf(this);

            if (insertAfter) this.after(draggedItem);
            else this.before(draggedItem);

            reorderTableColumns(draggedItem.dataset.colIndex, this.dataset.colIndex, insertAfter);
           
            // 🚀 FIX: Save the new column order to LocalStorage immediately
            saveColumnOrder();
        }
        return false;
    }
    function handleDragEnd(e) {
        this.classList.remove('dragging');
        document.querySelectorAll('.draggable-col-item').forEach(item => item.classList.remove('over'));
    }

    function reorderTableColumns(draggedIdx, targetIdx, insertAfter) {
        document.body.style.cursor = 'wait';
        setTimeout(() => {
            const table = document.querySelector("#leadsTable");
            const theadRow = table.querySelector("thead tr");
            const draggedTh = theadRow.querySelector(`th[data-col-index="${draggedIdx}"]`);
            const targetTh = theadRow.querySelector(`th[data-col-index="${targetIdx}"]`);

            if (insertAfter) targetTh.after(draggedTh);
            else targetTh.before(draggedTh);

            const chunkSize = 150;
            let i = 0;
            function processChunk() {
                const end = Math.min(i + chunkSize, allRows.length);
                for(; i < end; i++) {
                    const row = allRows[i];
                    const draggedTd = row.querySelector(`td[data-col-index="${draggedIdx}"]`);
                    const targetTd = row.querySelector(`td[data-col-index="${targetIdx}"]`);
                    if(draggedTd && targetTd) {
                        if (insertAfter) targetTd.after(draggedTd);
                        else targetTd.before(draggedTd);
                    }
                }
                if (i < allRows.length) requestAnimationFrame(processChunk);
                else document.body.style.cursor = 'default';
            }
            requestAnimationFrame(processChunk);
        }, 10);
    }

   window.filterManageColumns = function () {
        const searchInput = document.getElementById('manageColSearch');
